---
// Shared skeleton for the five service pages. It fixes the *system*
// (typography, spacing, CTA, motion) but deliberately leaves composition
// open: each page supplies its own visual and can insert extra sections
// through the default slot, so the five pages do not read as one template.
import SiteLayout from './SiteLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Viz from '../components/Viz.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { SERVICES } from '../lib/site';

interface Props {
  slug: string;
  data: {
    viz: string;
    eyebrow: string;
    h1a: string;
    h1b: string;
    lead: string;
    symptomsTitle: string;
    symptoms: readonly string[];
    buildTitle: string;
    build: readonly { t: string; d: string }[];
    closing: string;
    closingBody: string;
    note: string;
  };
  title: string;
  description: string;
  /** 'rail' = symptoms as a numbered rail, 'grid' = two column list */
  symptomsStyle?: 'rail' | 'grid';
}
const { slug, data, title, description, symptomsStyle = 'rail' } = Astro.props;
const others = SERVICES.filter((s) => s.slug !== slug);
---

<SiteLayout title={title} description={description}>
  <ScrollReveal />

  <!-- Hero: type first, then the page's own dominant visual -->
  <section class="sp-hero">
    <div class="u-container sp-hero__type">
      <p class="t-eyebrow">{data.eyebrow}</p>
      <h1 class="sp-hero__h1">
        <span>{data.h1a}</span>
        <span class="sp-hero__h1b">{data.h1b}</span>
      </h1>
      <p class="sp-hero__lead">{data.lead}</p>
    </div>
  </section>

  <section class="section--navy sp-stage">
    <div class="u-container">
      <Viz kind={data.viz as any} />
    </div>
    <p class="u-container sp-stage__note">{data.note}</p>
  </section>

  <!-- Symptoms: "is this you?" -->
  <section class="section">
    <div class="u-container">
      <div class="lede">
        <h2 class="t-h2">{data.symptomsTitle}</h2>
      </div>
      <ul class:list={['sym', `sym--${symptomsStyle}`]}>
        {
          data.symptoms.map((s, i) => (
            <li class="sym__item" data-reveal style={`--i:${i}`}>
              <span class="sym__q" aria-hidden="true">״</span>
              <span class="sym__t">{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What we actually build -->
  <section class="section section--gray">
    <div class="u-container">
      <div class="lede">
        <h2 class="t-h2">{data.buildTitle}</h2>
      </div>
      <div class="build">
        {
          data.build.map((b, i) => (
            <article class="build__item" data-reveal style={`--i:${i}`}>
              <span class="build__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h3">{b.t}</h3>
              <p class="build__d">{b.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <slot />

  <!-- Other services. Deliberately small: a quiet way out of the page,
       not a second sales pitch competing with the closing CTA. -->
  <nav class="more-svc" aria-label="שירותים נוספים">
    <div class="u-container more-svc__in">
      <span class="more-svc__k">שירותים נוספים</span>
      <ul class="more-svc__list">
        {
          others.map((o) => (
            <li>
              <a class="more-svc__a" href={`/services/${o.slug}/`}>
                {o.name}
                <span class="arrow-inline" aria-hidden="true">←</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <ClosingCta heading={data.closing} body={data.closingBody} />
</SiteLayout>

<style>
  .sp-hero {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .sp-hero__type {
    max-width: 60rem;
  }
  .sp-hero__h1 {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.1rem + 4.2vw, 4.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-block: 1.25rem 1.5rem;
  }
  .sp-hero__h1b {
    color: var(--color-royal);
  }
  .sp-hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  .sp-stage {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sp-stage__note {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.6);
    max-width: 64ch;
    border-inline-start: 3px solid rgba(41, 151, 255, 0.5);
    padding-inline-start: 1rem;
  }

  /* Symptoms.
     These are sentences the visitor might say out loud, so they are set as
     quoted fragments in bubbles rather than as a numbered list. The stagger
     stops five bubbles from reading as a table. */
  .sym {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }
  .sym--rail {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .sym--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* every other bubble sits lower, the way a conversation staggers */
  .sym--rail .sym__item:nth-child(even) {
    margin-block-start: clamp(1rem, 2.5vw, 2rem);
  }

  .sym__item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem)
      clamp(1.375rem, 2.5vw, 1.875rem);
    background: var(--color-surface-2);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    border-end-end-radius: 0.25rem;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 90ms),
      translate 600ms var(--ease-out) calc(var(--i) * 90ms),
      border-color var(--dur) var(--ease-out);
  }
  .sym__item:hover {
    border-color: var(--color-line-strong);
  }
  /* the bubble tail, on the reading-start side */
  .sym__item::after {
    content: '';
    position: absolute;
    bottom: -1px;
    inset-inline-end: -1px;
    width: 1.125rem;
    height: 1.125rem;
    background: var(--color-surface-2);
    border-inline-end: 1px solid var(--color-line);
    border-block-end: 1px solid var(--color-line);
    border-end-start-radius: 1rem;
  }

  :global(html.reveal-ready) .sym__item {
    opacity: 0;
    translate: 0 14px;
  }
  :global(html.reveal-ready) .sym__item.is-in {
    opacity: 1;
    translate: 0 0;
  }

  .sym__q {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 0.8;
    color: var(--color-electric);
    flex: none;
  }
  .sym__t {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
  }

  /* Build */
  .build {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 5rem);
  }
  .build__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 100ms),
      translate 600ms var(--ease-out) calc(var(--i) * 100ms);
  }
  :global(html.reveal-ready) .build__item {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .build__item.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .build__n {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    font-weight: 700;
    color: var(--color-electric);
  }
  .build__d {
    color: var(--color-ink-2);
    max-width: 46ch;
  }

  /* Other services: one compact row, not a section */
  .more-svc {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface-2);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }
  .more-svc__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .more-svc__k {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
  }
  .more-svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .more-svc__a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }
  .more-svc__a:hover {
    color: var(--color-royal);
  }
  .more-svc__a .arrow-inline {
    color: var(--color-electric);
  }

  @media (max-width: 860px) {
    .sym--rail,
    .sym--grid,
    .build {
      grid-template-columns: 1fr;
    }
    .sym--rail .sym__item:nth-child(even) {
      margin-block-start: 0;
    }
    .more-svc__list {
      gap: 0.5rem 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sym__item,
    .build__item {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
