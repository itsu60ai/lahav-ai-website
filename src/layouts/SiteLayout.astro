---
// The global site shell: header + footer around every public page.
// BaseLayout stays a thin document wrapper (head/meta) so /system/ can keep
// using it without inheriting nav/footer that don't belong on an internal
// review page.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader currentPath={currentPath} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>
