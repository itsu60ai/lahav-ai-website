---
// The global site shell: header + footer around every public page.
// BaseLayout stays a thin document wrapper (head/meta) so /system/ can keep
// using it without inheriting nav/footer that don't belong on an internal
// review page.
//
// Motion is mounted once here rather than per page, so every public page
// gets the same motion language automatically and no page can drift.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Motion from '../components/Motion.astro';
import SiteDock from '../components/SiteDock.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Pages whose first section is a saturated colour block need a solid
      header from the start: a royal CTA on a royal hero is invisible. */
  headerSolid?: boolean;
}
const { title, description, noindex = false, headerSolid = false } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader currentPath={currentPath} solid={headerSolid} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  <SiteDock />
  <Motion />
</BaseLayout>
