---
// The global site shell: header + footer around every public page.
// BaseLayout stays a thin document wrapper (head/meta) so /system/ can keep
// using it without inheriting nav/footer that don't belong on an internal
// review page.
//
// Motion is mounted once here rather than per page, so every public page
// gets the same motion language automatically and no page can drift.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Motion from '../components/Motion.astro';
import SiteDock from '../components/SiteDock.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** an id from the media table, for a page-specific social preview
      image. Falls back to BaseLayout's default when absent. */
  image?: string;
  /** Pages whose first section is a saturated colour block need a solid
      header from the start: a royal CTA on a royal hero is invisible. */
  headerSolid?: boolean;
  /** From the calling page's own `resolvePreview()`. Threaded down to
      every shared component that reads Settings or a service's name, so
      an authenticated `?preview=1` request sees the DRAFT WhatsApp
      number/CTA label/service names everywhere on the page, not just in
      that page's own content (2026-09-01, SOURCE_OF_TRUTH.md F-35/F-37).
      Omitted (false) on pages that never call resolvePreview -- they
      only ever show published content, which is the correct default. */
  preview?: boolean;
}
const { title, description, noindex = false, image, headerSolid = false, preview = false } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<BaseLayout title={title} description={description} noindex={noindex} image={image && `/api/media/${image}`} preview={preview}>
  <SiteHeader currentPath={currentPath} solid={headerSolid} preview={preview} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter preview={preview} />
  <SiteDock preview={preview} />
  <Motion />
</BaseLayout>
