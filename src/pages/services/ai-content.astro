---
// AI CONTENT service page.
//
// SCOPE NOTE (internal, PL-15): the exact client-facing package for this
// service is still being defined. That is a REVIEW_NOTES item, not
// something the marketing page announces, so this page presents only the
// approved sequence: מטרה עסקית, בריף, טיוטה בסיוע AI, בקרה ואישור, שימוש.
//
// The internal Auto Publish capability is NEVER presented as a client
// feature. Publishing always runs through the client.
import ServicePage from '../../layouts/ServicePage.astro';
import { SERVICE_PAGES } from '../../lib/site';
const data = SERVICE_PAGES['ai-content'];

// The line that actually differentiates the offer: where the machine
// stops and the business owner starts.
const boundary = [
  {
    side: 'ai',
    label: 'מה AI עושה טוב',
    items: ['מוציא אתכם מהדף הריק', 'מציע זוויות וכותרות', 'כותב טיוטה ראשונה מהר', 'שומר על מבנה עקבי'],
  },
  {
    side: 'you',
    label: 'מה נשאר אצלכם',
    items: ['להחליט מה נכון להגיד', 'לתקן מה שלא מדויק', 'לשמור על הקול שלכם', 'לאשר לפני שזה יוצא'],
  },
];
---

<ServicePage
  slug="ai-content"
  data={data}
  title="יצירת תוכן באמצעות AI | LAHAV AI"
  description="תהליך תוכן מסודר: מטרה עסקית, בריף, טיוטה בעזרת AI, בדיקה ואישור שלכם, ורק אז שימוש."
  symptomsStyle="grid"
>
  <!-- AI content only: where the machine stops -->
  <section class="ai-line u-section band">
    <div class="u-container u-container--wide">
      <div class="ai-line__head">
        <p class="t-eyebrow" data-reveal>הקו שלא זז</p>
        <h2 class="ai-line__h t-display-3" data-reveal style="--mo-delay:90ms">AI כותב טיוטה.<br />אתם מחליטים מה יוצא.</h2>
        <p class="t-lead ai-line__lead" data-reveal style="--mo-delay:180ms">
          זה לא סייג משפטי, זו צורת העבודה. טקסט שיוצא בשם העסק שלכם צריך
          לעבור דרך מישהו שמכיר את הלקוחות, ולא רק דרך מודל.
        </p>
      </div>

      <div class="ai-cols">
        {
          boundary.map((c) => (
            <div class:list={['ai-col', `ai-col--${c.side}`]} data-reveal>
              <p class="ai-col__label">{c.label}</p>
              <ul class="ai-col__list">
                {c.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .ai-line__head { max-width: 46rem; }
    .ai-line__h { margin-block: 0.75rem 1.25rem; }
    .ai-line__lead { max-width: 52ch; }
    .ai-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
      margin-top: clamp(2rem, 4vw, 3rem);
    }
    /* Hairline columns, not cards: the two sides are separated by a rule
       and by weight, the way the rest of the site separates anything. */
    .ai-col {
      padding-top: 1.25rem;
      border-top: 2px solid var(--color-line-strong);
    }
    /* The client side is the one that carries the brand weight. */
    .ai-col--you { border-top-color: var(--color-royal); }
    .ai-col__label {
      font-size: var(--text-micro);
      font-weight: 700;
      letter-spacing: 0.09em;
      color: var(--color-ink-3);
      margin-bottom: 1.25rem;
    }
    .ai-col--you .ai-col__label { color: var(--color-royal); }
    .ai-col__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }
    .ai-col__list li {
      position: relative;
      padding-inline-start: 1.5rem;
      font-size: var(--text-body-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
    }
    .ai-col--you .ai-col__list li {
      color: var(--color-ink);
      font-weight: 600;
    }
    .ai-col__list li::before {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      top: 0.65em;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-line-strong);
    }
    .ai-col--you .ai-col__list li::before {
      background: var(--color-electric);
    }
    @media (max-width: 720px) {
      .ai-cols {
        grid-template-columns: 1fr;
      }
    }
  </style>
</ServicePage>
