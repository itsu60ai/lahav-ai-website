---
// SERVICES INDEX. Its own job: help a visitor decide *which* service fits.
// Composition is a chooser, not a repeat of Home: a "start from your
// problem" table that maps a symptom to a service, then full-width
// service rows. No hero stage, no pain grid, no process here.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Viz from '../../components/Viz.astro';
import DiscoveryPitch from '../../components/DiscoveryPitch.astro';
import { SERVICE_ICONS } from '../../lib/icons';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { SERVICES } from '../../lib/site';

// Each row: a problem stated in the owner's words, and where it leads.
const chooser = [
  { problem: 'אף אחד לא באמת יודע מה קורה עם הפניות', slug: 'crm', name: 'מערכות CRM חכמות' },
  { problem: 'חצי מהיום הולך על עבודה שחוזרת על עצמה', slug: 'automations', name: 'אוטומציות עסקיות' },
  { problem: 'נכנסים לאתר ולא משאירים פרטים', slug: 'web-development', name: 'פיתוח אתרים' },
  { problem: 'משלמים על מערכות ועדיין עובדים באקסל', slug: 'app-development', name: 'פיתוח אפליקציות' },
  { problem: 'יודעים שצריך לכתוב, ואף פעם אין זמן', slug: 'ai-content', name: 'יצירת תוכן באמצעות AI' },
];
---

<SiteLayout
  title="השירותים שלנו | LAHAV AI"
  description="חמישה תחומי שירות: מערכות CRM, אוטומציות עסקיות, פיתוח אתרים, פיתוח אפליקציות ויצירת תוכן באמצעות AI."
>
  <ScrollReveal />

  <section class="sv-hero">
    <div class="u-container">
      <p class="t-eyebrow">השירותים שלנו</p>
      <h1 class="t-display-2 sv-hero__h1">לא צריך לדעת מה אתם צריכים.<br />רק מה לא עובד.</h1>
      <p class="sv-hero__lead">
        אף אחד לא אמור להגיע לכאן ולדעת אם הוא צריך CRM או אוטומציה. תגידו לנו
        מה תקוע, ומשם נבין יחד מה נכון לבנות ובאיזה סדר.
      </p>
    </div>
  </section>

  <!-- The chooser: problem on the right, service on the left -->
  <section class="section-tight chooser-sec">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">מתחילים מהבעיה</p>
        <h2 class="t-h2 chooser__h">מה מהדברים האלה קורה אצלכם?</h2>
        <p class="t-lead chooser__lead">
          בחרו את המשפט שהכי מזכיר את המצב שלכם. משם כבר ברור לאן זה מוביל.
        </p>
      </div>
      <ul class="chooser">
        {
          chooser.map((c, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="ch" href={`/services/${c.slug}/`}>
                <span class="ch__problem">{c.problem}</span>
                <span class="ch__to">
                  <span class="ch__tolabel">מוביל אל</span>
                  <span class="ch__name">
                    {c.name}
                    <span class="ch__sep" aria-hidden="true">←</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <DiscoveryPitch variant="services" />

  <!-- One connected picture -->
  <section class="section section--navy">
    <div class="u-container">
      <div class="lede lede--center">
        <p class="t-eyebrow">איך זה מתחבר</p>
        <h2 class="t-display-2">אף אחד לא צריך<br />את כל החמישה</h2>
        <p class="t-lead">
          כמעט תמיד מתחילים מחלק אחד, זה שפותר את מה שהכי כואב עכשיו. השאר
          מחכה, ומתחבר בהמשך בלי לשבור את מה שכבר עובד.
        </p>
      </div>
      <Viz kind="services" />
    </div>
  </section>

  <!-- The five, each with real room -->
  <section class="section">
    <div class="u-container">
      {
        SERVICES.map((s, i) => (
          <article class:list={['row', s.featured && 'row--featured']} data-reveal>
            <div class="row__meta">
              <span class="row__mark" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={SERVICE_ICONS[s.slug]}
                />
              </span>
              <span class="row__n tabular">{String(i + 1).padStart(2, '0')}</span>
              {s.featured && <span class="chip">שירות מוביל</span>}
            </div>
            <div class="row__body">
              <h2 class:list={[s.featured ? 't-h1' : 't-h2', 'row__name']}>{s.name}</h2>
              <p class="row__lead">{s.lead}</p>
              <p class="row__text">{s.pain}</p>
              <a class="link-arrow" href={`/services/${s.slug}/`}>
                לפרטים על השירות <span class="arrow-inline" aria-hidden="true">←</span>
              </a>
            </div>
          </article>
        ))
      }
      <p class="pricing">
        אין מחירון קבוע. המחיר נקבע אחרי שיחת היכרות ואפיון, לפי מה שהעסק באמת צריך.
      </p>
    </div>
  </section>

  <ClosingCta
    heading="לא בטוחים מאיפה להתחיל?"
    body="זה בסדר גמור. שיחה של 30 דקות בדרך כלל מספיקה כדי להבין מה הדבר הראשון שכדאי לסדר."
  />
</SiteLayout>

<style>
  .sv-hero {
    padding-top: clamp(8rem, 16vh, 12rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    background: var(--gradient-hero);
  }
  .sv-hero__h1 {
    margin-block: 1rem 1.5rem;
  }
  .sv-hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 54ch;
  }

  .section-tight {
    padding-block: var(--space-section-tight);
  }
  .chooser__h {
    margin-block: 1rem 1rem;
  }
  .chooser__lead {
    color: var(--color-ink-2);
    max-width: 46rem;
  }
  .chooser {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .chooser li {
    transition:
      opacity 500ms var(--ease-out) calc(var(--i) * 80ms),
      translate 500ms var(--ease-out) calc(var(--i) * 80ms);
  }
  :global(html.reveal-ready) .chooser li {
    opacity: 0;
    translate: 0 12px;
  }
  :global(html.reveal-ready) .chooser li.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .ch {
    display: grid;
    grid-template-columns: 1fr minmax(0, 0.7fr);
    align-items: center;
    gap: 1.25rem;
    padding-block: clamp(1.1rem, 2.2vw, 1.6rem);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-out);
  }
  .ch:hover {
    background: var(--color-surface-2);
  }
  /* The visitor's own problem is the loudest thing on the row, because it
     is the thing they are scanning for. The destination is second. */
  .ch__problem {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 1.15vw, 1.9375rem);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .ch__to {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }
  .ch__tolabel {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
  }
  .ch__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 700;
    color: var(--color-electric);
    line-height: 1.3;
  }
  .ch__sep {
    color: var(--color-electric);
    font-weight: 700;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-line);
    transition: opacity 700ms var(--ease-out), translate 700ms var(--ease-out);
  }
  :global(html.reveal-ready) .row {
    opacity: 0;
    translate: 0 18px;
  }
  :global(html.reveal-ready) .row.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .row--featured {
    border-top-color: var(--color-line-strong);
  }
  .row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }
  /* A visual anchor per service, so the five entries can be told apart at
     a glance instead of being read one by one. */
  .row__mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px solid var(--color-line);
    color: var(--color-electric);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }
  .row__mark svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .row:hover .row__mark {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-electric);
  }
  .row--featured .row__mark {
    background: color-mix(in srgb, var(--color-royal) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-royal) 28%, transparent);
  }
  .row__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    line-height: 1;
  }
  .row__name {
    margin-bottom: 0.75rem;
  }
  .row__lead {
    font-size: var(--text-lead);
    font-weight: 600;
    color: var(--color-electric);
    line-height: 1.5;
    margin-bottom: 0.875rem;
    max-width: 42ch;
  }
  .row__text {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-ink-2);
    max-width: 62ch;
    margin-bottom: 1.25rem;
  }
  .pricing {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
    color: var(--color-ink-3);
    max-width: 60ch;
  }

  @media (max-width: 860px) {
    .ch {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .row__meta {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chooser li,
    .row {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
