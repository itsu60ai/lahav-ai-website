---
// SERVICES INDEX, V3.
//
// Its own job: help a visitor decide *which* service fits. Composition is
// a chooser, not a repeat of Home. Rebuilt into the site's editorial
// language: type-led opener, a marquee of the five names, symptoms as
// oversized hairline rows, the אפיון position, one connected picture on
// navy, then the five services at real scale.
//
// CLAIM DISCIPLINE unchanged: no prices, no timelines, no results, no
// client names, and the אפיון block says what WE do without ever
// characterising anyone else.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Viz from '../../components/Viz.astro';
import { SERVICE_ICONS } from '../../lib/icons';
import { SERVICES } from '../../lib/site';

// Each row: a problem stated in the owner's words, and where it leads.
const chooser = [
  { problem: 'אף אחד לא באמת יודע מה קורה עם הפניות', slug: 'crm', name: 'מערכות CRM חכמות' },
  { problem: 'חצי מהיום הולך על עבודה שחוזרת על עצמה', slug: 'automations', name: 'אוטומציות עסקיות' },
  { problem: 'נכנסים לאתר ולא משאירים פרטים', slug: 'web-development', name: 'פיתוח אתרים' },
  { problem: 'משלמים על מערכות ועדיין עובדים באקסל', slug: 'app-development', name: 'פיתוח אפליקציות' },
  { problem: 'יודעים שצריך לכתוב, ואף פעם אין זמן', slug: 'ai-content', name: 'יצירת תוכן באמצעות AI' },
];

// The אפיון position, previously its own component. It is the one thing
// that has to be visible on this page before a visitor picks a service.
const discovery = [
  { t: 'נשאל הרבה שאלות', d: 'איך פנייה מגיעה אליכם, מי נוגע בה, איפה היא נתקעת, ומה קורה כשמישהו בחופש.' },
  { t: 'נגיד גם מה לא לבנות', d: 'לפעמים המסקנה היא שחצי מהרעיון מיותר, או שעדיף להתחיל ממשהו אחר לגמרי.' },
  { t: 'ההתאמה היא לכם', d: 'לא נתאים את העסק שלכם לחבילה מוכנה. המערכת נבנית סביב איך שאתם עובדים.' },
];
---

<SiteLayout
  title="השירותים שלנו | LAHAV AI"
  description="חמישה תחומי שירות: מערכות CRM, אוטומציות עסקיות, פיתוח אתרים, פיתוח אפליקציות ויצירת תוכן באמצעות AI."
>
  <!-- ═════════ opener ═════════ -->
  <section class="sv-hero band band--hero">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>השירותים שלנו</p>
      <h1 class="sv-hero__h1 t-display-1">
        <span class="mo-line" style="--mo-delay:70ms"><span>לא צריך לדעת</span></span>
        <span class="mo-line" style="--mo-delay:170ms"><span>מה אתם צריכים.</span></span>
        <span class="mo-line" style="--mo-delay:270ms"><span class="sv-hero__accent">רק מה לא עובד.</span></span>
      </h1>
      <p class="sv-hero__lead" data-reveal style="--mo-delay:380ms">
        אף אחד לא אמור להגיע לכאן ולדעת אם הוא צריך CRM או אוטומציה. תגידו לנו
        מה תקוע, ומשם נבין יחד מה נכון לבנות ובאיזה סדר.
      </p>
    </div>
  </section>

  <!-- ═════════ the five, as a moving rail ═════════ -->
  <div class="mo-marquee sv-rail" aria-hidden="true">
    <div class="mo-marquee__track">
      {SERVICES.map((s) => (
        <span class="sv-rail__item">
          {s.name}
          <span class="sv-rail__dot">•</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ═════════ chooser ═════════ -->
  <section class="chooser-sec u-section band">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>מתחילים מהבעיה</p>
      <h2 class="chooser__h t-display-3" data-reveal style="--mo-delay:90ms">
        מה מהדברים האלה<br />קורה אצלכם?
      </h2>
      <ul class="chooser">
        {chooser.map((c, i) => (
          <li class="ch-row" data-reveal style={`--mo-delay:${i * 70}ms`}>
            <a class="ch" href={`/services/${c.slug}/`}>
              <span class="ch__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="ch__problem">״{c.problem}״</span>
              <span class="ch__to">
                <span class="ch__tolabel">מוביל אל</span>
                <span class="ch__name">{c.name}</span>
              </span>
              <span class="ch__arrow arrow-inline" aria-hidden="true">←</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ the אפיון position ═════════ -->
  <section class="disc band band--blue u-section">
    <div class="u-container u-container--wide disc__grid">
      <div class="disc__intro">
        <p class="t-eyebrow" data-reveal>לפני שבוחרים שירות</p>
        <h2 class="disc__title">
          <span class="mo-line" style="--mo-delay:60ms"><span>קודם מבינים.</span></span>
          <span class="mo-line" style="--mo-delay:160ms"><span class="disc__accent">רק אחר כך בונים.</span></span>
        </h2>
        <p class="disc__lead" data-reveal style="--mo-delay:260ms">
          לכן אף אחד לא צריך להגיע לכאן ולדעת איזה שירות הוא צריך. זה מה
          שנברר יחד.
        </p>
      </div>
      <ol class="disc__points" data-stagger style="--mo-step:90ms">
        {discovery.map((p, i) => (
          <li class="disc__point" data-reveal>
            <span class="disc__pn tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="disc__pt">{p.t}</h3>
            <p class="disc__pd">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ one connected picture ═════════ -->
  <section class="sv-map band band--navy u-section">
    <div class="u-container u-container--wide">
      <div class="sv-map__head">
        <p class="t-eyebrow" data-reveal>איך זה מתחבר</p>
        <h2 class="sv-map__h t-display-3" data-reveal style="--mo-delay:90ms">
          אף אחד לא צריך<br />את כל החמישה
        </h2>
        <p class="sv-map__lead t-lead" data-reveal style="--mo-delay:180ms">
          כמעט תמיד מתחילים מחלק אחד, זה שפותר את מה שהכי כואב עכשיו. השאר
          מחכה, ומתחבר בהמשך בלי לשבור את מה שכבר עובד.
        </p>
      </div>
      <div class="sv-map__art" data-clip>
        <Viz kind="services" />
      </div>
    </div>
  </section>

  <!-- ═════════ the five, each with real room ═════════ -->
  <section class="rows-sec u-section band">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow rows-sec__k" data-reveal>מה אנחנו בונים</p>
      <ul class="svc-rows">
        {SERVICES.map((s, i) => (
          <li class="svc-row" data-reveal style={`--mo-delay:${i * 60}ms`}>
            <a class="svc" href={`/services/${s.slug}/`}>
              <span class="svc__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__mark" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={SERVICE_ICONS[s.slug]}
                />
              </span>
              <span class="svc__main">
                <span class="svc__name">{s.name}</span>
                <span class="svc__lead">{s.lead}</span>
                <span class="svc__text">{s.pain}</span>
              </span>
              <span class="svc__arrow arrow-inline" aria-hidden="true">←</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="pricing" data-reveal>
        אין מחירון קבוע. המחיר נקבע אחרי שיחת היכרות ואפיון, לפי מה שהעסק
        באמת צריך.
      </p>
    </div>
  </section>

  <ClosingCta
    heading="לא בטוחים מאיפה להתחיל?"
    body="זה בסדר גמור. שיחה של 30 דקות בדרך כלל מספיקה כדי להבין מה הדבר הראשון שכדאי לסדר."
  />
</SiteLayout>

<style>
  /* ══════ opener ══════ */
  .sv-hero {
    padding-top: clamp(9rem, 20svh, 14rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .sv-hero__h1 { display: flex; flex-direction: column; margin-block: 1rem 2rem; }
  .sv-hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sv-hero__lead { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 48ch; }

  /* ══════ marquee rail ══════ */
  .sv-rail {
    border-block: 1px solid var(--color-line);
    padding-block: clamp(0.75rem, 1.6vw, 1.25rem);
    background: var(--color-surface);
  }
  .sv-rail__item {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    opacity: 0.16;
    white-space: nowrap;
  }
  .sv-rail__dot { color: var(--color-electric); opacity: 1; margin-inline: 0.5em; }

  /* ══════ chooser ══════ */
  .chooser__h { margin-block: 0.75rem clamp(2rem, 4vw, 3.5rem); }
  .chooser { list-style: none; margin: 0; padding: 0; }
  .ch-row { border-top: 1px solid var(--color-line-strong); }
  .ch-row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .ch {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 0.8fr) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem);
    text-decoration: none;
    color: inherit;
  }
  .ch__n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); color: var(--color-electric); }
  .ch__problem {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    transition: color var(--dur) var(--ease-out);
  }
  .ch-row:hover .ch__problem { color: var(--color-royal); }
  .ch__to { display: flex; flex-direction: column; gap: 0.25rem; }
  .ch__tolabel { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.08em; color: var(--color-ink-3); }
  .ch__name { font-size: var(--text-small); font-weight: 700; color: var(--color-royal); }
  .ch__arrow { color: var(--color-royal); justify-self: end; }
  .ch-row:hover .ch__arrow { transform: translateX(-5px); }

  /* ══════ the אפיון position ══════ */
  .disc__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .disc__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-display-3);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-block: 0.75rem 1.25rem;
    color: #fff;
  }
  .disc__accent { color: rgba(255, 255, 255, 0.5); }
  .disc__lead { font-size: var(--text-lead); line-height: 1.55; color: rgba(255, 255, 255, 0.82); max-width: 40ch; }
  .disc__points { list-style: none; margin: 0; padding: 0; }
  .disc__point {
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .disc__point:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.22); }
  .disc__pn { font-family: var(--font-display); font-weight: 700; font-size: var(--text-micro); color: rgba(255, 255, 255, 0.55); }
  .disc__pt {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    margin-block: 0.35rem 0.5rem;
  }
  .disc__pd { color: rgba(255, 255, 255, 0.78); line-height: 1.65; max-width: 52ch; }

  /* ══════ connected picture ══════ */
  .sv-map__head { max-width: 46rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .sv-map__h { color: #fff; margin-block: 0.75rem 1.25rem; }
  .sv-map__art { border-radius: var(--radius-xl); overflow: hidden; }

  /* ══════ the five ══════ */
  .rows-sec__k { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .svc-rows { list-style: none; margin: 0; padding: 0; }
  .svc-row { border-top: 1px solid var(--color-line-strong); }
  .svc-row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .svc {
    display: grid;
    grid-template-columns: 3rem 3rem minmax(0, 1fr) 2rem;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: start;
    padding-block: clamp(1.75rem, 3.2vw, 3rem);
    text-decoration: none;
    color: inherit;
  }
  .svc__n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); color: var(--color-electric); padding-top: 0.5rem; }
  .svc__mark {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-royal);
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .svc__mark :global(svg) { width: 1.375rem; height: 1.375rem; }
  .svc-row:hover .svc__mark { background: var(--color-royal); border-color: var(--color-royal); color: #fff; }
  .svc__main { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  .svc__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    transition: color var(--dur) var(--ease-out);
  }
  .svc-row:hover .svc__name { color: var(--color-royal); }
  .svc__lead { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 44ch; }
  .svc__text { font-size: var(--text-small); line-height: 1.7; color: var(--color-ink-3); max-width: 64ch; }
  .svc__arrow { color: var(--color-royal); justify-self: end; padding-top: 0.5rem; }
  .svc-row:hover .svc__arrow { transform: translateX(-5px); }

  .pricing {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: var(--text-small);
    color: var(--color-ink-3);
    max-width: 60ch;
  }

  @media (max-width: 900px) {
    .ch {
      grid-template-columns: 2.25rem 1fr 1.25rem;
      gap: 0.875rem;
    }
    /* the destination moves under the problem instead of beside it */
    .ch__to { grid-column: 2; }
    .disc__grid { grid-template-columns: 1fr; }
    .svc { grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem; gap: 0.875rem; }
    .svc__mark { display: none; }
  }
</style>
