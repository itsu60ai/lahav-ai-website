---
// SERVICES INDEX, V4.
//
// Layout taken from the reference's own services template (the mirrored
// /expertise page in docs/reference/stg/v2): a giant ghost word fixed
// behind the page, and full-bleed colour blocks scrolling over it.
//
// One deliberate departure: the reference sets the service name in
// oversized LATIN. LAHAV sets it in oversized HEBREW. Giant English
// display words were removed from this site on 31.08.2026, and the point
// of the exercise is that Hebrew typography carries the composition on
// its own.
//
// CLAIM DISCIPLINE unchanged: no prices, no timelines, no results, no
// client names.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import Curve from '../../components/Curve.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Viz from '../../components/Viz.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import { SERVICES } from '../../lib/site';

const SITE_KEY = turnstileSiteKey();

// Each row: a problem stated in the owner's words, and where it leads.
const chooser = [
  { problem: 'אף אחד לא באמת יודע מה קורה עם הפניות', slug: 'crm', name: 'מערכות CRM חכמות' },
  { problem: 'חצי מהיום הולך על עבודה שחוזרת על עצמה', slug: 'automations', name: 'אוטומציות עסקיות' },
  { problem: 'נכנסים לאתר ולא משאירים פרטים', slug: 'web-development', name: 'פיתוח אתרים' },
  { problem: 'משלמים על מערכות ועדיין עובדים באקסל', slug: 'app-development', name: 'פיתוח אפליקציות' },
  { problem: 'יודעים שצריך לכתוב, ואף פעם אין זמן', slug: 'ai-content', name: 'יצירת תוכן באמצעות AI' },
];

// The אפיון position. It has to be visible before a visitor picks.
const discovery = [
  { t: 'נשאל הרבה שאלות', d: 'איך פנייה מגיעה אליכם, מי נוגע בה, איפה היא נתקעת, ומה קורה כשמישהו בחופש.' },
  { t: 'נגיד גם מה לא לבנות', d: 'לפעמים המסקנה היא שחצי מהרעיון מיותר, או שעדיף להתחיל ממשהו אחר לגמרי.' },
  { t: 'ההתאמה היא לכם', d: 'לא נתאים את העסק שלכם לחבילה מוכנה. המערכת נבנית סביב איך שאתם עובדים.' },
];
---

<SiteLayout
  title="השירותים שלנו | LAHAV AI"
  description="חמישה תחומי שירות: מערכות CRM, אוטומציות עסקיות, פיתוח אתרים, פיתוח אפליקציות ויצירת תוכן באמצעות AI."
>
  <!-- ========= opener ========= -->
  <section class="sv-hero band band--hero">
    <div class="u-container u-container--wide sv-hero__grid">
      <div>
        <p class="t-eyebrow" data-reveal>השירותים שלנו</p>
        <h1 class="sv-hero__h1 t-display-1">
          <span class="mo-line" style="--mo-delay:70ms"><span>לא צריך לדעת</span></span>
          <span class="mo-line" style="--mo-delay:170ms"><span class="sv-hero__accent">מה אתם צריכים.</span></span>
        </h1>
        <p class="sv-hero__lead" data-reveal style="--mo-delay:300ms">
          תגידו לנו מה תקוע, ומשם נבין יחד מה נכון לבנות ובאיזה סדר.
        </p>
      </div>
      <div class="sv-hero__art" data-clip>
        <Viz kind="services" />
      </div>
    </div>
  </section>

  <!-- ========= the five, as colour blocks over a ghost word ========= -->
  <section class="blocks" aria-label="השירותים">
    <span class="blocks__ghost" aria-hidden="true">שירותים</span>
    <ul class="blocks__list">
      {SERVICES.map((s, i) => (
        <li class={`blocks__item blocks__item--${s.tone}`}>
          <a class="blocks__a" href={`/services/${s.slug}/`}>
            <span class="blocks__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="blocks__name">{s.name}</span>
            <span class="blocks__rule" aria-hidden="true"></span>
            <span class="blocks__lead">{s.lead}</span>
            <span class="blocks__go">
              לראות איך זה עובד <span class="arrow-inline" aria-hidden="true">←</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ========= chooser ========= -->
  <section class="chooser-sec u-section band">
    <Curve tone="surface" shape="slope" />
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>מתחילים מהבעיה</p>
      <h2 class="chooser__h t-display-3" data-reveal style="--mo-delay:90ms">
        מה מהדברים האלה<br />קורה אצלכם?
      </h2>
      <ul class="chooser">
        {chooser.map((c, i) => (
          <li class="ch-row" data-reveal style={`--mo-delay:${i * 70}ms`}>
            <a class="ch" href={`/services/${c.slug}/`}>
              <span class="ch__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="ch__problem">״{c.problem}״</span>
              <span class="ch__to">
                <span class="ch__tolabel">מוביל אל</span>
                <span class="ch__name">{c.name}</span>
              </span>
              <span class="ch__arrow arrow-inline" aria-hidden="true">←</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========= the אפיון position ========= -->
  <section class="disc band band--navy u-section">
    <Curve tone="navy" shape="wave" flip />
    <div class="u-container u-container--wide disc__grid">
      <div class="disc__intro">
        <p class="t-eyebrow" data-reveal>לפני שבוחרים שירות</p>
        <h2 class="disc__title">
          <span class="mo-line" style="--mo-delay:60ms"><span>אף פעם לא</span></span>
          <span class="mo-line" style="--mo-delay:160ms"><span class="disc__accent">מתחילים מהכלי.</span></span>
        </h2>
        <p class="disc__lead" data-reveal style="--mo-delay:260ms">
          לכן אף אחד לא צריך להגיע לכאן ולדעת איזה שירות הוא צריך. זה מה
          שנברר יחד.
        </p>
      </div>
      <ol class="disc__points">
        {discovery.map((p, i) => (
          <li class="disc__point" data-reveal style={`--mo-delay:${i * 90}ms`}>
            <span class="disc__pn tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="disc__pt">{p.t}</h3>
            <p class="disc__pd">{p.d}</p>
          </li>
        ))}
      </ol>
      <p class="pricing" data-reveal>
        אין מחירון קבוע. המחיר נקבע אחרי שיחת היכרות ואפיון, לפי מה שהעסק
        באמת צריך.
      </p>
    </div>
  </section>

  <ContactBlock
    siteKey={SITE_KEY}
    heading="תכתבו לנו איפה זה נתקע."
    body="לא צריך להתכונן או לדעת מראש מה רוצים לבנות. מספיק לספר מה קורה היום."
    curve={false}
  />
</SiteLayout>

<style>
  /* ====== opener ====== */
  .sv-hero {
    padding-top: clamp(9rem, 20svh, 14rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .sv-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .sv-hero__h1 { display: flex; flex-direction: column; margin-block: 1rem 2rem; }
  .sv-hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sv-hero__lead { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 46ch; }
  .sv-hero__art {
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-navy);
    padding: clamp(1rem, 2vw, 1.75rem);
  }

  /* ====== colour blocks over a ghost word ====== */
  /* The reference fixes an enormous word behind the page and scrolls the
     blocks over it, so the gaps between blocks reveal a slice of it. */
  .blocks {
    position: relative;
    background: var(--color-surface);
    isolation: isolate;
  }
  .blocks__ghost {
    position: sticky;
    top: 38vh;
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 16rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.8;
    text-align: center;
    color: var(--color-ink);
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .blocks__list {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: -22vh 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vw, 9rem);
  }
  .blocks__a {
    display: block;
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.25rem, 6vw, 6rem);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .blocks__item:hover .blocks__a { transform: scale(1.008); }
  .blocks__n {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.65;
  }
  /* The service name IS the display type here, in Hebrew. */
  .blocks__name {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 6.5rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-top: 0.3em;
  }
  .blocks__rule {
    display: block;
    width: min(18rem, 40%);
    height: 1px;
    margin: clamp(1rem, 2.5vw, 1.75rem) auto;
    background: currentColor;
    opacity: 0.35;
  }
  .blocks__lead {
    display: block;
    text-align: center;
    max-width: 46ch;
    margin-inline: auto;
    font-size: var(--text-lead);
    line-height: 1.55;
    opacity: 0.9;
  }
  .blocks__go {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 700;
    font-size: var(--text-small);
  }
  .blocks__item:hover .blocks__go .arrow-inline { transform: translateX(-6px); }

  /* one colour per service, all drawn from the brand palette */
  .blocks__item--royal    { background: var(--color-royal); color: #fff; }
  .blocks__item--navy     { background: var(--color-navy);  color: #fff; }
  .blocks__item--electric { background: #2997ff; color: #fff; }
  .blocks__item--warm     { background: var(--color-warm-2); color: var(--color-ink); }
  .blocks__item--deep     { background: #16308c; color: #fff; }

  /* ====== chooser ====== */
  .chooser-sec { position: relative; overflow: visible; }
  .chooser__h { margin-block: 0.75rem clamp(2rem, 4vw, 3.5rem); }
  .chooser { list-style: none; margin: 0; padding: 0; }
  .ch-row { border-top: 1px solid var(--color-line-strong); }
  .ch-row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .ch {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 0.8fr) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem);
    text-decoration: none;
    color: inherit;
  }
  .ch__n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); color: var(--color-electric); }
  .ch__problem {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    transition: color var(--dur) var(--ease-out);
  }
  .ch-row:hover .ch__problem { color: var(--color-royal); }
  .ch__to { display: flex; flex-direction: column; gap: 0.25rem; }
  .ch__tolabel { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.08em; color: var(--color-ink-3); }
  .ch__name { font-size: var(--text-small); font-weight: 700; color: var(--color-royal); }
  .ch__arrow { color: var(--color-royal); justify-self: end; }
  .ch-row:hover .ch__arrow { transform: translateX(-5px); }

  /* ====== the אפיון position ====== */
  .disc { position: relative; overflow: visible; }
  .disc__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .disc__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-display-3);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-block: 0.75rem 1.25rem;
    color: #fff;
  }
  .disc__accent { color: rgba(255, 255, 255, 0.5); }
  .disc__lead { font-size: var(--text-lead); line-height: 1.55; color: rgba(255, 255, 255, 0.82); max-width: 40ch; }
  .disc__points { list-style: none; margin: 0; padding: 0; }
  .disc__point {
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .disc__point:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.22); }
  .disc__pn { font-family: var(--font-display); font-weight: 700; font-size: var(--text-micro); color: rgba(255, 255, 255, 0.55); }
  .disc__pt {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    margin-block: 0.35rem 0.5rem;
  }
  .disc__pd { color: rgba(255, 255, 255, 0.78); line-height: 1.65; max-width: 52ch; }
  .pricing {
    grid-column: 1 / -1;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.62);
    max-width: 60ch;
  }

  @media (max-width: 900px) {
    .sv-hero__grid { grid-template-columns: 1fr; }
    .sv-hero__art { order: -1; max-width: 30rem; }
    .blocks__ghost { top: 30vh; }
    .blocks__list { margin-top: -18vh; gap: 2.5rem; }
    .ch { grid-template-columns: 2.25rem 1fr 1.25rem; gap: 0.875rem; }
    .ch__to { grid-column: 2; }
    .disc__grid { grid-template-columns: 1fr; }
  }
</style>
