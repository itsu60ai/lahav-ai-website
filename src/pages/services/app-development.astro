---
export const prerender = false;

import ServicePage from '../../layouts/ServicePage.astro';
import { serviceDefault, toServicePageData, getPublicContent, getDraftContent } from '../../lib/cms/content.ts';
import { resolvePreview } from '../../lib/cms/preview.ts';

const SLUG = 'app-development';
const { services: servicesStore } = Astro.locals.stores!;
const preview = await resolvePreview(Astro, Astro.locals.stores!);
const content = preview
  ? await getDraftContent(servicesStore, SLUG, serviceDefault(SLUG))
  : await getPublicContent(servicesStore, SLUG, serviceDefault(SLUG));
const data = toServicePageData(SLUG, content);

// App only: the honest half of the offer. Custom software is the most
// expensive answer on this site, so the page says out loud when it is the
// wrong one. No prices, no timelines, no comparisons to named tools.
const verdict = [
  {
    side: 'no',
    label: 'כנראה שלא צריך לבנות',
    items: [
      'הצורך נפתר בהגדרה נכונה של כלי שכבר יש לכם',
      'התהליך עדיין משתנה כל חודש',
      'רק אדם אחד עובד ככה, ובאופן זמני',
      'הבעיה האמיתית היא מי אחראי, לא באיזה כלי',
    ],
  },
  {
    side: 'yes',
    label: 'כאן זה מתחיל להיות מוצדק',
    items: [
      'התהליך יציב, חוזר, וכולם עובדים לפיו',
      'הצוות המציא עקיפות ידניות קבועות',
      'המידע מפוזר בין כמה מקומות ואף אחד לא מחזיק את התמונה',
      'זה משהו שהעסק עושה כל יום, לא פעם ברבעון',
    ],
  },
];
---

<ServicePage
  slug="app-development"
  data={data}
  title={content.seo.title}
  description={content.seo.description}
  noindex={content.seo.noindex}
  image={content.seo.ogImage || undefined}
  symptomsStyle="rail"
  preview={preview}
>
  <!-- App only: when NOT to build -->
  <section class="ad-sec u-section band">
    <div class="u-container u-container--wide">
      <div class="ad-sec__head">
        <p class="t-eyebrow" data-reveal>לפני שמתלהבים</p>
        <h2 class="ad-sec__h t-display-3" data-reveal style="--mo-delay:90ms">
          לבנות זה הפתרון היקר.<br />לא תמיד הוא הנכון.
        </h2>
        <p class="t-lead ad-sec__lead" data-reveal style="--mo-delay:180ms">
          אם באפיון יסתבר שהצורך שלכם נפתר בלי לבנות כלום, נגיד את זה. זה
          חוסך לכם כסף, וחוסך לנו פרויקט שלא היה צריך לקרות.
        </p>
      </div>
      <div class="ad-cols">
        {verdict.map((c, i) => (
          <div class={`ad-col ad-col--${c.side}`} data-reveal style={`--mo-delay:${i * 120}ms`}>
            <p class="ad-col__label">{c.label}</p>
            <ul class="ad-col__list">
              {c.items.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .ad-sec__head { max-width: 46rem; }
    .ad-sec__h { margin-block: 0.75rem 1.25rem; }
    .ad-sec__lead { max-width: 52ch; }
    .ad-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.5rem, 4vw, 4rem);
      margin-top: clamp(2rem, 4vw, 3.5rem);
    }
    /* hairline heads, same separation language as the rest of the site */
    .ad-col { padding-top: 1.25rem; border-top: 2px solid var(--color-line-strong); }
    .ad-col--yes { border-top-color: var(--color-royal); }
    .ad-col__label {
      font-family: var(--font-display);
      font-size: clamp(1.125rem, 1.7vw, 1.5rem);
      font-weight: 800;
      letter-spacing: normal;
      color: var(--color-ink-3);
      margin-bottom: 1.25rem;
    }
    .ad-col--yes .ad-col__label { color: var(--color-royal); }
    .ad-col__list { list-style: none; margin: 0; padding: 0; }
    .ad-col__list li {
      position: relative;
      padding-block: 0.8rem;
      padding-inline-start: 1.75rem;
      font-size: var(--text-body-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
      border-top: 1px solid var(--color-line);
    }
    .ad-col__list li:first-child { border-top: 0; }
    .ad-col--yes .ad-col__list li { color: var(--color-ink); font-weight: 600; }
    .ad-col__list li::before {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      top: 1.5em;
      width: 1rem;
      height: 2px;
      background: var(--color-line-strong);
    }
    .ad-col--yes .ad-col__list li::before { background: var(--color-electric); }
    @media (max-width: 760px) { .ad-cols { grid-template-columns: 1fr; } }
  </style>
</ServicePage>
