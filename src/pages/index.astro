---
// HOME — first production page. Structural/content hierarchy follows the
// approved Stitch reference (03_STITCH_FINAL/01-home); visual execution is
// elevated per the Visual Upgrade Brief and decision F-1.
//
// Copy status: first AI draft, written against R9 (truth rules) and the
// approved constants in src/lib/site.ts. Not yet human-approved for public
// launch (R10) — flagged in the implementation report, not in the markup.
import SiteLayout from '../layouts/SiteLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { SERVICES, PROCESS, WHATSAPP_HREF, CTA_PRIMARY } from '../lib/site';

const featured = SERVICES.filter((s) => s.featured);
const rest = SERVICES.filter((s) => !s.featured);
---

<SiteLayout
  title="LAHAV AI — מערכות AI ואוטומציות לעסקים קטנים ובינוניים"
  description="LAHAV AI בונה מערכות CRM, אוטומציות ותוכנה מותאמת לעסקים קטנים ובינוניים בישראל. שיחת Discovery ראשונה ללא התחייבות."
>
  <!-- ============ HERO — light, with an integrated dark cinematic panel (F-1) ============ -->
  <section class="hero">
    <div class="u-container hero__grid u-editorial u-editorial--reverse">
      <div class="hero__visual">
        <div class="panel-dark hero__panel">
          <svg viewBox="0 0 560 480" role="img" aria-label="תרשים: תהליכים עסקיים מפוזרים מתחברים למערכת אחת מרכזית" class="hero__svg">
            <defs>
              <linearGradient id="heroCore" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#2997FF"></stop>
                <stop offset="100%" stop-color="#1D4ED8"></stop>
              </linearGradient>
              <radialGradient id="heroGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#2997FF" stop-opacity=".5"></stop>
                <stop offset="100%" stop-color="#2997FF" stop-opacity="0"></stop>
              </radialGradient>
            </defs>

            <circle cx="290" cy="248" r="170" fill="url(#heroGlow)"></circle>

            <g class="panel-flow-line" stroke="rgba(41,151,255,.5)" stroke-width="1.5" fill="none">
              <path d="M470 96 L340 96 L340 200"></path>
              <path d="M486 248 L360 248"></path>
              <path d="M470 400 L340 400 L340 296"></path>
              <path d="M240 248 L90 248"></path>
              <path d="M240 150 L140 150 L140 210"></path>
              <path d="M240 346 L140 346 L140 286"></path>
            </g>

            <g fill="rgba(255,255,255,.05)" stroke="rgba(255,255,255,.18)">
              <rect x="470" y="70" width="72" height="52" rx="12"></rect>
              <rect x="486" y="222" width="72" height="52" rx="12"></rect>
              <rect x="470" y="374" width="72" height="52" rx="12"></rect>
              <rect x="30" y="222" width="72" height="52" rx="12"></rect>
              <rect x="80" y="124" width="72" height="52" rx="12"></rect>
              <rect x="80" y="320" width="72" height="52" rx="12"></rect>
            </g>

            <g fill="#fff">
              <circle class="panel-node-pulse" cx="506" cy="96" r="4" style="animation-delay:0ms"></circle>
              <circle class="panel-node-pulse" cx="522" cy="248" r="4" style="animation-delay:400ms"></circle>
              <circle class="panel-node-pulse" cx="506" cy="400" r="4" style="animation-delay:800ms"></circle>
              <circle class="panel-node-pulse" cx="66" cy="248" r="4" style="animation-delay:1200ms"></circle>
              <circle class="panel-node-pulse" cx="116" cy="150" r="4" style="animation-delay:1600ms"></circle>
              <circle class="panel-node-pulse" cx="116" cy="346" r="4" style="animation-delay:2000ms"></circle>
            </g>

            <rect x="240" y="188" width="100" height="120" rx="20" fill="url(#heroCore)"></rect>
            <g fill="rgba(255,255,255,.92)">
              <rect x="260" y="222" width="60" height="7" rx="3.5"></rect>
              <rect x="260" y="242" width="44" height="7" rx="3.5" opacity=".7"></rect>
              <rect x="260" y="262" width="52" height="7" rx="3.5" opacity=".5"></rect>
            </g>
          </svg>
        </div>
      </div>

      <div class="hero__text">
        <p class="hero__eyebrow">מערכות AI לעסקים קטנים ובינוניים</p>
        <h1 class="t-display-1 hero__title">מערכות AI ואוטומציות<br />שעושות סדר בעסק שלך</h1>
        <p class="t-lead hero__lead">
          אנחנו בונים מערכות CRM, אוטומציות ותוכנה מותאמת לעסקים קטנים ובינוניים בישראל —
          כדי שתפסיקו לעבוד ידנית ותתחילו לשלוט בתהליכים.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary btn-lg" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
          <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23Z"
              ></path></svg
            >
            שיחה בוואטסאפ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BUSINESS-FIRST / PAIN RECOGNITION ============ -->
  <section class="section section--gray">
    <div class="u-container u-editorial">
      <div>
        <p class="t-eyebrow">איפה זה נתקע היום</p>
        <h2 class="t-h2 pain__title">יותר מדי עבודה ידנית.<br />פחות מדי שליטה.</h2>
        <p class="t-lead pain__lead">
          כשמידע מפוזר בין מערכות, מעקבים נעשים ידנית ותהליכים תלויים בזיכרון של אנשים —
          העסק מאבד זמן, סדר והזדמנויות.
        </p>
        <p class="t-body pain__statement">
          אנחנו לא מתחילים מהטכנולוגיה. קודם מבינים איך העסק עובד היום, איפה נמצאים
          צווארי הבקבוק ומה באמת צריך להשתפר — ורק לאחר מכן בוחרים את הפתרון המתאים.
        </p>
      </div>

      <ul class="pain-list">
        <li class="pain-list__item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"
            ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h8"></path></svg
          >
          <div>
            <h3 class="t-h3">כפילות ועבודה ידנית</h3>
            <p class="t-small">אותם נתונים מוזנים שוב במקומות שונים, ומשימות רוטיניות גוזלות שעות.</p>
          </div>
        </li>
        <li class="pain-list__item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"
            ><path d="M12 3 2 20h20L12 3Z"></path><path d="M12 10v4"></path><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"></circle></svg
          >
          <div>
            <h3 class="t-h3">לידים ומשימות שנופלים בין הכיסאות</h3>
            <p class="t-small">בלי מעקב מסודר, פניות נשארות ללא מענה ומשימות מתעכבות.</p>
          </div>
        </li>
        <li class="pain-list__item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"
            ><path d="M3 3l18 18"></path><path d="M10.6 5.1A9.7 9.7 0 0 1 12 5c5 0 9 5 9 7a11 11 0 0 1-2.2 3.1M6.2 6.7C3.9 8.2 3 10.4 3 12c0 2 4 7 9 7 1.4 0 2.7-.4 3.8-1"></path></svg
          >
          <div>
            <h3 class="t-h3">אין תמונה אחת ברורה של מה קורה בעסק</h3>
            <p class="t-small">המידע מפוזר בין כלים שונים — וקשה לקבל החלטה על בסיס נתונים.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ CONNECTED SYSTEMS — bespoke dark panel ============ -->
  <section class="section">
    <div class="u-container u-editorial">
      <div class="panel-dark systems__panel">
        <svg viewBox="0 0 480 380" role="img" aria-label="תרשים: לידים, משימות, תקשורת ומידע מתחברים למערכת CRM מרכזית">
          <defs>
            <linearGradient id="sysCore" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2997FF"></stop>
              <stop offset="100%" stop-color="#1D4ED8"></stop>
            </linearGradient>
          </defs>
          <g class="panel-flow-line" stroke="rgba(41,151,255,.42)" stroke-width="1.5" fill="none">
            <path d="M410 90 L280 90 L280 150"></path>
            <path d="M410 190 L320 190"></path>
            <path d="M410 290 L280 290 L280 230"></path>
            <path d="M160 190 L70 190"></path>
          </g>
          <g fill="rgba(255,255,255,.05)" stroke="rgba(255,255,255,.18)">
            <rect x="410" y="64" width="58" height="52" rx="12"></rect>
            <rect x="410" y="164" width="58" height="52" rx="12"></rect>
            <rect x="410" y="264" width="58" height="52" rx="12"></rect>
            <rect x="16" y="164" width="58" height="52" rx="14"></rect>
          </g>
          <g font-family="Assistant, sans-serif" font-size="13" fill="rgba(255,255,255,.75)" text-anchor="middle">
            <text x="439" y="130">לידים</text>
            <text x="439" y="230">תקשורת</text>
            <text x="439" y="330">מידע</text>
            <text x="45" y="230">משימות</text>
          </g>
          <g fill="#fff">
            <circle class="panel-node-pulse" cx="439" cy="90" r="4" style="animation-delay:0ms"></circle>
            <circle class="panel-node-pulse" cx="439" cy="190" r="4" style="animation-delay:500ms"></circle>
            <circle class="panel-node-pulse" cx="439" cy="290" r="4" style="animation-delay:1000ms"></circle>
            <circle class="panel-node-pulse" cx="45" cy="190" r="4" style="animation-delay:1500ms"></circle>
          </g>
          <rect x="200" y="150" width="160" height="80" rx="18" fill="url(#sysCore)"></rect>
          <g fill="rgba(255,255,255,.94)" font-family="Heebo, sans-serif" font-weight="700" font-size="17" text-anchor="middle">
            <text x="280" y="197">מערכת CRM</text>
          </g>
        </svg>
      </div>

      <div class="systems__text">
        <p class="t-eyebrow">מערכת אחת מחוברת</p>
        <h2 class="t-h2">כל התהליכים במקום אחד, במקום חמישה כלים מנותקים</h2>
        <p class="t-lead">
          במקום כלים מפוזרים שאף אחד לא באמת מסתכל עליהם יחד, אנחנו בונים מערכת אחת
          שמרכזת לידים, משימות, תקשורת ומידע — ומדברת עם עצמה.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES — editorial, not a five-card grid ============ -->
  <section class="section section--gray" id="services">
    <div class="u-container">
      <div class="section-head">
        <p class="t-eyebrow">השירותים שלנו</p>
        <h2 class="t-h2">פתרונות שנבנים סביב העסק שלך</h2>
        <p class="t-lead">
          אנחנו לא מתחילים מהטכנולוגיה. קודם מבינים את התהליך העסקי — ורק אחר כך בונים
          את המערכת המתאימה.
        </p>
      </div>

      <div class="services__featured">
        {
          featured.map((s, i) => (
            <article class={`u-editorial services__row ${i % 2 === 1 ? 'u-editorial--reverse' : ''}`}>
              <div class="services__visual">
                <div class="panel-dark services__panel">
                  <svg viewBox="0 0 200 160" role="img" aria-hidden="true">
                    {s.slug === 'crm' ? (
                      <>
                        <circle cx="100" cy="80" r="60" fill="rgba(41,151,255,.14)" />
                        <g stroke="rgba(41,151,255,.5)" stroke-width="1.5" fill="none">
                          <path d="M60 50 L100 80 L60 110" />
                          <path d="M140 50 L100 80 L140 110" />
                        </g>
                        <rect x="80" y="60" width="40" height="40" rx="10" fill="var(--color-electric)" />
                      </>
                    ) : (
                      <>
                        <circle cx="100" cy="80" r="60" fill="rgba(41,151,255,.1)" />
                        <g stroke="rgba(41,151,255,.5)" stroke-width="1.5" fill="none" stroke-dasharray="4 5">
                          <path d="M46 55 H80" />
                          <path d="M46 105 H80" />
                          <path d="M120 80 H154" />
                        </g>
                        <g fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.5">
                          <rect x="30" y="45" width="26" height="20" rx="5" />
                          <rect x="30" y="95" width="26" height="20" rx="5" />
                          <circle cx="164" cy="80" r="11" />
                        </g>
                        <rect x="80" y="58" width="40" height="44" rx="11" fill="var(--color-royal)" />
                        <path d="M97 68 93 80 99 80 95 94 108 76 101 76 105 68Z" fill="#fff" />
                      </>
                    )}
                  </svg>
                </div>
              </div>
              <div class="services__text">
                <span class="chip">שירות מוביל</span>
                <h3 class="t-h1 services__name">{s.name}</h3>
                <p class="t-lead">{s.blurb}</p>
                <a class="btn btn-tertiary" href={`/services/${s.slug}/`}>
                  למידע נוסף <span class="arrow-inline" aria-hidden="true">←</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="services__rest">
        {
          rest.map((s) => (
            <div class="services__rest-item">
              <h3 class="t-h3">{s.name}</h3>
              <p class="t-small">{s.blurb}</p>
              <a class="btn btn-tertiary" href={`/services/${s.slug}/`}>
                למידע נוסף <span class="arrow-inline" aria-hidden="true">←</span>
              </a>
            </div>
          ))
        }
      </div>

      <p class="t-small services__pricing">
        התמחור נקבע לאחר שיחת Discovery ואפיון, בהתאם לתהליכים ולצרכים של העסק.
      </p>
    </div>
  </section>

  <!-- ============ PROCESS — bespoke timeline, not numbered cards ============ -->
  <section class="section">
    <div class="u-container">
      <div class="section-head">
        <p class="t-eyebrow">איך אנחנו עובדים</p>
        <h2 class="t-h2">מתהליך עסקי לפתרון שעובד</h2>
        <p class="t-lead">כל פרויקט מתקדם בתהליך מסודר, עם נקודות בדיקה ברורות בכל שלב.</p>
      </div>

      <ol class="timeline">
        {
          PROCESS.map((p) => (
            <li class="timeline__item">
              <span class="timeline__dot">{p.n}</span>
              <span class="t-small timeline__label">{p.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ ABOUT / FOUNDER TEASER ============ -->
  <section class="section section--gray">
    <div class="u-container u-editorial">
      <div>
        <p class="t-eyebrow">מי אנחנו</p>
        <h2 class="t-h2">איתן להב — מייסד ובונה מערכות AI</h2>
        <p class="t-lead about__lead">
          LAHAV AI נולדה מתוך תובנה פשוטה: לרוב העסקים לא חסר עוד כלי — חסר חיבור בין
          המערכות הקיימות, יש יותר מדי עבודה ידנית, ותהליכים שהולכים ומסתבכים.
        </p>
        <p class="t-body">
          הגישה שלנו מתחילה תמיד באותה נקודה: להבין איפה העבודה נתקעת, מה גוזל זמן ואיפה
          מידע הולך לאיבוד — ורק אחר כך לבחור את הטכנולוגיה הנכונה.
        </p>
        <a class="btn btn-tertiary about__link" href="/about/">
          עוד עלינו <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>

      <div class="about__visual" aria-hidden="true">
        <svg viewBox="0 0 260 260" role="presentation">
          <defs>
            <linearGradient id="founderMono" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0%" stop-color="#0B1530"></stop>
              <stop offset="55%" stop-color="#1D4ED8"></stop>
              <stop offset="100%" stop-color="#2997FF"></stop>
            </linearGradient>
          </defs>
          <rect width="260" height="260" rx="28" fill="var(--color-surface-2)"></rect>
          <path
            d="M76 66 L76 158 Q76 178 96 178 L152 178 Q170 178 180 160 L204 66"
            fill="none"
            stroke="url(#founderMono)"
            stroke-width="15"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <path d="M204 66 L228 158" fill="none" stroke="#2997FF" stroke-width="15" stroke-linecap="round"></path>
          <circle cx="204" cy="142" r="8" fill="#1D4ED8"></circle>
        </svg>
        <p class="t-micro about__visual-caption">תמונת המייסד תתווסף בקרוב</p>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="יש תהליך בעסק שהגיע הזמן לעשות בו סדר?"
    body="בואו נבין יחד מה קורה היום בעסק, ואיפה אפשר לחסוך זמן ולהחזיר שליטה."
  />
</SiteLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(3rem, 6vw, 5.5rem) var(--space-section);
    overflow: clip;
  }
  .hero__grid {
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-royal);
    background: color-mix(in srgb, var(--color-royal) 9%, transparent);
    border-radius: var(--radius-full);
    padding: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .hero__title {
    margin-bottom: 1.5rem;
  }
  .hero__lead {
    max-width: 46ch;
    margin-bottom: 2.25rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero__panel {
    aspect-ratio: 7 / 6;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2rem);
  }
  .hero__svg {
    width: 100%;
    height: auto;
  }

  /* ---------- Pain recognition ---------- */
  .pain__title {
    margin-bottom: 1.25rem;
  }
  .pain__lead {
    margin-bottom: 1.5rem;
  }
  .pain__statement {
    color: var(--color-ink-2);
    font-weight: 500;
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1rem;
  }
  .pain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }
  .pain-list__item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-block: clamp(1.25rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--color-line);
  }
  .pain-list__item:last-child {
    border-bottom: 0;
  }
  .pain-list__item svg {
    color: var(--color-royal);
    flex: 0 0 auto;
    margin-top: 0.25rem;
  }

  /* ---------- Connected systems ---------- */
  .systems__panel {
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .systems__panel svg {
    width: 100%;
    height: auto;
  }

  /* ---------- Services ---------- */
  .section-head {
    max-width: 66ch;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .services__featured {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 6vw, 6rem);
  }
  .services__row {
    align-items: center;
  }
  .services__panel {
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .services__panel svg {
    width: 65%;
    height: auto;
  }
  .services__name {
    margin-block: 1rem 1.25rem;
  }

