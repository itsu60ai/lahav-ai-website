---
// HOME, V3.
//
// Section rhythm mapped from the reference package, with LAHAV content
// in each slot:
//   1  hero        full-viewport, oversized stacked statement, guide
//                  character centred, floating product cards, disc CTA
//   2  marquee     continuous type strip, breaks the hero cleanly
//   3  problem     editorial hairline list (the reference's two-column
//                  pattern: heavy heading one side, prose the other)
//   4  core        full-bleed blue contrast band, orbit diagram
//   5  services    pinned storytelling: sticky index, panels swap
//   6  process     numbered editorial rows
//   7  founder     asymmetric portrait + statement
//   8  cta         handled by the footer's oversized closing block
import SiteLayout from '../layouts/SiteLayout.astro';
import SplitLines from '../components/SplitLines.astro';
import Avatar from '../components/Avatar.astro';
import FloatingCards from '../components/FloatingCards.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import Viz from '../components/Viz.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import { SERVICES, PROCESS, WHATSAPP_HREF, CTA_PRIMARY, FOUNDER } from '../lib/site';

const pains = [
  { t: 'המידע מפוזר', d: 'חלק בוואטסאפ, חלק במייל, חלק באקסל, וחלק בראש של מישהו. אף אחד לא רואה את התמונה המלאה.' },
  { t: 'אותה עבודה, שוב', d: 'מעתיקים פרטים בין מערכות, ממלאים את אותם טפסים, שולחים את אותן הודעות. כל יום מחדש.' },
  { t: 'פניות שנשכחות', d: 'מישהו השאיר פרטים ולא חזרו אליו בזמן. עד שנזכרים, הפנייה כבר התקררה.' },
  { t: 'קשה לדעת מה קורה', d: 'שאלה פשוטה כמו "כמה פניות היו החודש" דורשת לעבור בין כמה מקומות.' },
];

const marquee = ['CRM', 'אוטומציות', 'אתרים', 'אפליקציות', 'תוכן AI', 'אפיון', 'אינטגרציות'];

// One line per service panel: the guide narrates the section as it
// scrolls. Content only, so rewriting what it says is a data edit.
const avatarLines = [
  'כל לקוח במקום אחד, בלי לחפש בשיחות ישנות.',
  'מה שחוזר על עצמו רץ לבד. ההחלטות נשארות אצלכם.',
  'אתר שמוביל לצעד הבא, לא רק נראה טוב.',
  'כשאין מערכת שמתאימה לכם, בונים אחת שכן.',
  'טיוטה ראשונה מהר. מה שיוצא עדיין עובר דרככם.',
];
---

<SiteLayout
  title="LAHAV AI, מערכות ואוטומציות שעושות סדר בעסק"
  description="בונים לעסקים קטנים ובינוניים בישראל מערכות CRM, אוטומציות ופתרונות דיגיטליים שמחברים את התהליכים בעסק. פחות עבודה ידנית, יותר שליטה."
>
  <!-- ═════════ 1. HERO ═════════ -->
  <section class="hero band band--hero">
    <FloatingCards />

    <!-- The character is a layer BEHIND the statement, not a block after
         it: that layering is what lets the whole act sit in one screen. -->
    <div class="hero__figure" aria-hidden="false">
      <Avatar size="lg" class="hero__avatar" />
    </div>

    <div class="u-container u-container--wide hero__inner">
      <p class="hero__eyebrow t-eyebrow" data-reveal>מערכות AI ואוטומציה לעסקים</p>

      <h1 class="hero__title t-display-1">
        <span class="mo-line" style="--mo-delay:60ms"><span class="t-latin hero__latin">Less busywork.</span></span>
        <span class="mo-line" style="--mo-delay:150ms"><span>פחות עבודה ידנית.</span></span>
        <span class="mo-line" style="--mo-delay:240ms"><span class="hero__accent">יותר שליטה בעסק.</span></span>
      </h1>

      <div class="hero__foot">
        <p class="hero__lead" data-reveal style="--mo-delay:340ms">
          נבין איך העסק עובד היום, ונבנה מערכת שלוקחת על עצמה את מה שחוזר.
        </p>
        <div class="hero__actions" data-reveal style="--mo-delay:420ms">
          <a class="btn btn-primary" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
          <a class="btn btn-secondary" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
            <WhatsApp />
            וואטסאפ
          </a>
        </div>
      </div>
    </div>

    <a class="hero__disc btn-disc" href={CTA_PRIMARY.href} data-magnetic="0.18">
      שיחת<br />היכרות
    </a>

    <span class="hero__scroll" aria-hidden="true"></span>
  </section>

  <!-- ═════════ 2. MARQUEE ═════════ -->
  <div class="band band--navy mq" aria-hidden="true">
    <div class="mo-marquee" style="--mo-speed:44s;--mo-gap:clamp(2rem,5vw,5rem)">
      <div class="mo-marquee__track">
        {marquee.map((w) => <span class="mq__item">{w}</span>)}
      </div>
    </div>
  </div>

  <!-- ═════════ 3. PROBLEM ═════════ -->
  <section class="u-section band">
    <div class="u-container u-container--wide">
      <div class="prob__head">
        <p class="t-eyebrow" data-reveal>נשמע מוכר?</p>
        <SplitLines
          class="t-display-2 prob__title"
          lines={['לא חסר לכם עוד כלי.', 'חסר שהכלים ידברו.']}
          step={100}
        />
      </div>

      <ul class="prob__list" data-stagger style="--mo-step:110ms">
        {pains.map((p, i) => (
          <li class="prob__row" data-reveal>
            <span class="prob__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="prob__t t-display-3">{p.t}</h3>
            <p class="prob__d">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ 4. CORE (full-bleed contrast) ═════════ -->
  <section class="u-section band band--blue core">
    <span class="core__ghost t-ghost" aria-hidden="true" data-parallax="0.22">SYSTEM</span>

    <div class="u-container u-container--wide core__inner">
      <div class="core__copy">
        <p class="t-eyebrow" data-reveal>התוצאה</p>
        <SplitLines
          class="t-display-2"
          lines={['ככה זה נראה', 'כשהכל מדבר.']}
          step={100}
        />
        <p class="t-lead core__lead" data-reveal style="--mo-delay:220ms">
          מישהו משאיר פרטים באתר. הפנייה נרשמת לבד, מקבלת מענה ראשוני, נכנסת
          למעקב, ומזכירה לכם לחזור אליה בזמן. אף אחד לא העתיק שורה.
        </p>
      </div>

      <div class="core__viz" data-clip style="--mo-delay:160ms">
        <Viz kind="crm" />
      </div>
    </div>
  </section>

  <!-- ═════════ 5. SERVICES (pinned storytelling) ═════════ -->
  <section class="svc" data-swap-root>
    <div class="u-container u-container--wide svc__grid">
      <!-- pinned index: highlights whichever panel is in view -->
      <aside class="svc__index">
        <div class="mo-sticky svc__sticky">
          <p class="t-eyebrow">מה אנחנו בונים</p>
          <Avatar lines={avatarLines} size="sm" class="svc__guide" />
          <ol class="svc__nums">
            {SERVICES.map((s, i) => (
              <li class="svc__num" data-swap-index={i}>
                <span class="svc__num-n tabular">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc__num-t">{s.short}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <div class="svc__panels">
        {SERVICES.map((s, i) => (
          <article class="svc__panel">
            <p class="svc__panel-n t-eyebrow">שירות {String(i + 1).padStart(2, '0')}</p>
            <h3 class="svc__panel-t t-display-2" data-reveal>{s.name}</h3>
            <p class="svc__panel-lead t-lead" data-reveal style="--mo-delay:90ms">{s.lead}</p>
            <p class="svc__panel-pain" data-reveal style="--mo-delay:160ms">{s.pain}</p>
            <ul class="svc__points" data-reveal style="--mo-delay:230ms">
              {s.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a class="link-arrow" href={`/services/${s.slug}/`}>
              עוד על {s.short} <span class="arrow-inline" aria-hidden="true">←</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ 6. PROCESS ═════════ -->
  <section class="u-section band band--warm">
    <div class="u-container u-container--wide">
      <div class="proc__head">
        <p class="t-eyebrow" data-reveal>איך זה עובד</p>
        <SplitLines class="t-display-2" lines={['מה קורה מרגע', 'שאמרתם כן.']} step={100} />
      </div>

      <ol class="proc__list" data-stagger style="--mo-step:90ms">
        {PROCESS.map((p) => (
          <li class="proc__row" data-reveal>
            <span class="proc__n tabular">{p.n}</span>
            <h3 class="proc__t t-h2">{p.label}</h3>
            <p class="proc__d">{p.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ 7. FOUNDER ═════════ -->
  <section class="u-section band fnd">
    <div class="u-container u-container--wide fnd__grid">
      <div class="fnd__art" data-clip>
        <FounderPortrait scale="home" sizes="(max-width: 1024px) 70vw, 30rem" />
      </div>

      <div class="fnd__copy">
        <p class="t-eyebrow" data-reveal>מי עומד מאחורי זה</p>
        <SplitLines class="t-display-3 fnd__name" lines={[FOUNDER.name]} />
        <p class="fnd__role" data-reveal style="--mo-delay:120ms">{FOUNDER.role}</p>
        <p class="fnd__p" data-reveal style="--mo-delay:180ms">
          הקמתי את LAHAV AI בגלל משהו שראיתי חוזר בעסק אחרי עסק: כמעט תמיד לא
          חסרים כלים. חסר שהם ידברו. המידע מתפזר, העבודה הידנית מצטברת, ודברים
          שהיו פשוטים כשהייתם שלושה נהיים מסורבלים כשאתם חמישה עשר.
        </p>
        <p class="fnd__p" data-reveal style="--mo-delay:240ms">
          לכן אני מתחיל מהעסק, לא מהטכנולוגיה. קודם נבין איפה העבודה נתקעת ומה
          גוזל לכם את הזמן. רק אחר כך נבחר כלים.
        </p>
        <a class="link-arrow" href="/about/" data-reveal style="--mo-delay:300ms">
          עוד עלינו <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ══════ hero ══════
     One screen, three layers: floating cards (z1), the character (z2),
     the statement (z3). The type overlaps the character deliberately,
     which is what keeps the whole act inside a single viewport instead
     of becoming a tall stack. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: clamp(6rem, 11svh, 8.5rem) clamp(2rem, 5svh, 3.5rem);
    overflow: clip;
  }

  .hero__figure {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding-top: 8svh;
    pointer-events: none;
  }
  .hero__figure :global(.av) { pointer-events: auto; }
  /* sized off the viewport height so it can never push the page taller */
  .hero__figure :global(.av--lg) { --av-size: clamp(8rem, 34svh, 17rem); }
  .hero__figure :global(.av__speech) {
    font-size: clamp(0.95rem, 1.25vw, 1.2rem);
    max-width: 24ch;
    min-height: 3.6em;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    text-align: center;
    align-self: start;
    pointer-events: none;
  }
  .hero__inner a { pointer-events: auto; }
  .hero__eyebrow { margin-bottom: clamp(0.75rem, 1.5vw, 1.25rem); }
  .hero__title { margin-inline: auto; }
  .hero__latin { font-size: 0.6em; opacity: 0.45; }
  .hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* supporting copy sits at the bottom of the screen, small, so the
     statement keeps the weight */
  .hero__foot {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(-20rem, -26svh, -14rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero__lead {
    font-size: var(--text-body);
    color: var(--color-ink-2);
    max-width: 40ch;
    margin: 0;
  }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.625rem; }
  .hero__actions .btn { min-height: 48px; padding-inline: 1.4rem; font-size: var(--text-small); }

  .hero__disc {
    position: absolute;
    z-index: 4;
    bottom: clamp(3rem, 8svh, 5.5rem);
    inset-inline-end: clamp(1.5rem, 6vw, 6rem);
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    inset-inline-start: 50%;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(180deg, transparent, var(--color-ink-3));
    opacity: 0.5;
    animation: hero-scroll 2.4s var(--ease-inout) infinite;
  }
  @keyframes hero-scroll {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.2; }
    50%      { transform: scaleY(1); transform-origin: top; opacity: 0.6; }
  }

  /* ══════ marquee ══════ */
  .mq { padding-block: clamp(1.25rem, 2.5vw, 2rem); }
  .mq__item {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
  .mq__item::after {
    content: '—';
    margin-inline-start: clamp(2rem, 5vw, 5rem);
    color: var(--color-electric);
  }

  /* ══════ problem ══════ */
  .prob__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .prob__title { margin-top: 1rem; }
  .prob__list { list-style: none; margin: 0; padding: 0; }
  .prob__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    border-top: 1px solid var(--color-line);
  }
  .prob__row:last-child { border-bottom: 1px solid var(--color-line); }
  .prob__n { font-family: var(--font-display); font-weight: 700; color: var(--color-electric); font-size: var(--text-small); }
  .prob__d { color: var(--color-ink-2); max-width: 46ch; }

  /* ══════ core ══════ */
  .core { position: relative; }
  .core__ghost {
    position: absolute;
    top: 6%;
    inset-inline-start: 50%;
    transform: translateX(50%);
    z-index: 0;
  }
  .core__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .core__lead { margin-top: 1.5rem; }
  .core__viz { border-radius: var(--radius-xl); overflow: hidden; }

  /* ══════ services ══════ */
  .svc { padding-block: var(--space-section); }
  .svc__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .svc__sticky { top: 18vh; }
  /* the guide narrates this section: it is pinned with the index and its
     line changes as each service panel comes up */
  .svc__guide { margin-block: 1.25rem; align-items: flex-start; }
  .svc__guide :global(.av__speech) {
    text-align: start;
    font-size: var(--text-body);
    max-width: 22ch;
    min-height: 3.2em;
  }
  .svc__nums { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .svc__num {
    display: flex; align-items: baseline; gap: 0.75rem;
    padding-block: 0.5rem;
    color: var(--color-ink-3);
    border-top: 1px solid var(--color-line);
    transition: color var(--dur) var(--ease-out);
  }
  .svc__num-n { font-size: var(--text-micro); font-weight: 700; }
  .svc__num-t { font-family: var(--font-display); font-size: var(--text-h3); font-weight: 800; }
  /* the pinned index highlights whichever panel Motion says is current */
  .svc[data-swap='0'] .svc__num:nth-child(1),
  .svc[data-swap='1'] .svc__num:nth-child(2),
  .svc[data-swap='2'] .svc__num:nth-child(3),
  .svc[data-swap='3'] .svc__num:nth-child(4),
  .svc[data-swap='4'] .svc__num:nth-child(5) { color: var(--color-royal); }

  .svc__panels { display: flex; flex-direction: column; gap: clamp(4rem, 10vw, 9rem); }
  .svc__panel { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .svc__panel-t { max-width: 14ch; }
  .svc__panel-pain { color: var(--color-ink-2); max-width: 52ch; }
  .svc__points { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svc__points li {
    font-size: var(--text-small);
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    color: var(--color-ink-2);
  }

  /* ══════ process ══════ */
  .proc__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .proc__list { list-style: none; margin: 0; padding: 0; }
  .proc__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem);
    border-top: 1px solid var(--color-line-strong);
  }
  .proc__row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .proc__n { font-family: var(--font-display); font-weight: 800; color: var(--color-electric); }
  .proc__d { color: var(--color-ink-2); max-width: 52ch; }

  /* ══════ founder ══════ */
  .fnd__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .fnd__art { border-radius: var(--radius-xl); overflow: hidden; }
  .fnd__name { margin-top: 0.75rem; }
  .fnd__role {
    font-size: var(--text-small); font-weight: 700; color: var(--color-royal);
    direction: ltr; text-align: start; margin-block: 0.5rem 1.5rem;
  }
  .fnd__p { color: var(--color-ink-2); margin-bottom: 1rem; max-width: 54ch; }

  /* ══════ responsive ══════ */
  @media (max-width: 1024px) {
    .core__inner, .fnd__grid { grid-template-columns: 1fr; }
    .svc__grid { grid-template-columns: 1fr; }
    /* the pinned index becomes a horizontal strip above the panels */
    .svc__sticky { position: static; }
    .svc__nums { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; }
    .svc__num { border-top: 0; padding: 0.4rem 0.8rem; border: 1px solid var(--color-line); border-radius: var(--radius-full); }
    .fnd__art { max-width: 26rem; }
  }
  @media (max-width: 760px) {
    .prob__row, .proc__row { grid-template-columns: 3rem 1fr; }
    .prob__d, .proc__d { grid-column: 2; }

    /* Mobile hero is recomposed, not shrunk: the statement owns the top
       of the screen and the character sits in the lower half, so the two
       never overlap on a narrow viewport. */
    .hero { padding-top: 6.5rem; }
    /* sized so each authored Hebrew line still fits on ONE rendered line
       at 360px, which is what keeps the statement reading as a statement */
    .hero__title { font-size: clamp(1.75rem, 8.2vw, 2.5rem); }
    .hero__lead { font-size: var(--text-small); max-width: 32ch; }
    .hero__figure {
      inset: auto 0 0 0;
      height: 52svh;
      padding-top: 0;
      align-items: center;
    }
    .hero__figure :global(.av--lg) { --av-size: clamp(7rem, 26svh, 11rem); }

    .hero__foot { bottom: auto; top: calc(100% + 1rem); }
    .hero__actions { width: 100%; }
    .hero__actions .btn { flex: 1 1 auto; }

    .hero__disc {
      inset-inline-end: 1rem;
      bottom: 2rem;
      width: 6.5rem;
      font-size: var(--text-small);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll { animation: none; }
  }
</style>
