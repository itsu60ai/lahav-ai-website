---
// HOME. Redesigned around one goal: a non technical Israeli business owner
// understands what LAHAV AI does, and what to do next, within seconds.
//
// Rhythm: light (hero, explainer, pain) -> dark (system + services, the
// major visual moment) -> light (process, founder) -> dark (closing CTA).
//
// Copy status: draft written against R9 truth rules and the approved facts
// in src/lib/site.ts. Awaiting human approval per R10.
import SiteLayout from '../layouts/SiteLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { SERVICES, PROCESS, WHATSAPP_HREF, CTA_PRIMARY, FOUNDER } from '../lib/site';

const featured = SERVICES.filter((s) => s.featured);
const rest = SERVICES.filter((s) => !s.featured);

const pains = [
  {
    title: 'המידע מפוזר בכל מקום',
    body: 'חלק בוואטסאפ, חלק במייל, חלק באקסל, וחלק בראש של מישהו. אף אחד לא רואה את התמונה המלאה.',
  },
  {
    title: 'אותה עבודה, שוב ושוב',
    body: 'מעתיקים פרטים בין מערכות, ממלאים את אותם טפסים, שולחים את אותן הודעות. כל יום מחדש.',
  },
  {
    title: 'פניות שנשכחות',
    body: 'מישהו השאיר פרטים ולא חזרו אליו בזמן. עד שנזכרים, הוא כבר סגר עם מישהו אחר.',
  },
  {
    title: 'קשה לדעת מה קורה',
    body: 'שאלה פשוטה כמו "כמה פניות היו החודש" דורשת חצי שעה של חיפושים.',
  },
];
---

<SiteLayout
  title="LAHAV AI, מערכות ואוטומציות שעושות סדר בעסק"
  description="בונים לעסקים קטנים ובינוניים בישראל מערכות CRM ואוטומציות שמחברות את כל מה שקורה בעסק למקום אחד. פחות עבודה ידנית, יותר שליטה."
>
  <ScrollReveal />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero">
    <div class="u-container hero__grid">
      <div class="hero__text">
        <p class="hero__eyebrow">מערכות AI ואוטומציה לעסקים</p>
        <h1 class="t-display-1 hero__title">
          פחות עבודה ידנית.<br />
          <span class="hero__title-accent">יותר שליטה בעסק.</span>
        </h1>
        <p class="hero__lead">
          אנחנו בונים מערכות CRM ואוטומציות לעסקים קטנים ובינוניים בישראל.
          במקום עשרה כלים שלא מדברים ביניהם, מערכת אחת שעושה סדר ועובדת בשבילכם.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary btn-lg" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
          <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23Z"
              ></path></svg
            >
            שיחה בוואטסאפ
          </a>
        </div>
        <p class="hero__note">שיחת היכרות של 30 דקות, נבין יחד איפה יש מה לשפר.</p>
      </div>

      <div class="hero__visual panel-dark">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- ═══════════════ EXPLAINER ═══════════════ -->
  <section class="section explain">
    <div class="u-container explain__inner">
      <h2 class="t-h2 explain__title">רגע, מה זה בעצם אומר?</h2>
      <div class="explain__body">
        <p class="explain__p explain__p--lead">
          "אוטומציה" נשמעת כמו מילה גדולה, אבל הרעיון פשוט.
        </p>
        <p class="explain__p">
          בכל עסק יש עשרות פעולות קטנות שנעשות ביד, כל יום: להעתיק פרטים של פנייה
          ממקום למקום, לשלוח את אותה הודעה בפעם המאה, לזכור לחזור למישהו, לעדכן טבלה.
          כל פעולה כזו לוקחת דקה. ביחד הן לוקחות לכם את היום.
        </p>
        <p class="explain__p explain__p--strong">
          מה שאנחנו עושים זה להעביר את הפעולות האלה למערכת שעושה אותן לבד.
          אתם נשארים עם ההחלטות, היא לוקחת את השאר.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PAIN ═══════════════ -->
  <section class="section section--gray pain">
    <div class="u-container">
      <div class="pain__head">
        <p class="t-eyebrow">נשמע מוכר?</p>
        <h2 class="t-h2">
          לרוב העסקים לא חסר עוד כלי.<br />
          חסר להם שהכלים ידברו ביניהם.
        </h2>
      </div>

      <ul class="pain__list">
        {
          pains.map((p, i) => (
            <li class="pain__item" data-reveal style={`--i:${i}`}>
              <span class="pain__num tabular">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="t-h3">{p.title}</h3>
                <p class="t-body pain__body">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════════ DARK ACT: system + services ═══════════════ -->
  <div class="act-dark">
    <!-- ---- connected system ---- -->
    <section class="section sysflow">
      <div class="u-container sysflow__grid">
        <div class="sysflow__text">
          <p class="t-eyebrow sysflow__eyebrow">התוצאה</p>
          <h2 class="t-h2 sysflow__title">המערכות בעסק מתחילות לעבוד יחד</h2>
          <p class="sysflow__lead">
            פנייה שנכנסת מהאתר נרשמת לבד, מקבלת מענה ראשוני, נכנסת למעקב,
            ומזכירה לכם לחזור אליה. בלי שאף אחד העתיק שורה אחת.
          </p>
        </div>

        <div class="sysflow__viz" data-reveal>
          <svg viewBox="0 0 520 330" role="img" aria-label="איור: פנייה נכנסת עוברת ארבעה שלבים אוטומטיים עד למעקב">
            <defs>
              <linearGradient id="sfCore" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#2997FF"></stop>
                <stop offset="100%" stop-color="#1D4ED8"></stop>
              </linearGradient>
            </defs>

            <!-- the connecting spine, drawn on scroll -->
            <path
              class="sf__spine"
              d="M452 62 L300 62 Q262 62 262 100 L262 132 Q262 168 224 168 L120 168 Q84 168 84 204 L84 244 Q84 278 122 278 L300 278"
              fill="none"
              stroke="rgba(41,151,255,.45)"
              stroke-width="2"
              stroke-linecap="round"
            ></path>

            <g class="sf__stops">
              <g class="sf__stop" style="--d:120ms">
                <rect x="374" y="38" width="132" height="48" rx="14"></rect>
                <text x="440" y="68" text-anchor="middle">פנייה נכנסת</text>
              </g>
              <g class="sf__stop" style="--d:420ms">
                <rect x="146" y="144" width="146" height="48" rx="14"></rect>
                <text x="219" y="174" text-anchor="middle">נרשמת במערכת</text>
              </g>
              <g class="sf__stop" style="--d:720ms">
                <rect x="16" y="220" width="150" height="48" rx="14"></rect>
                <text x="91" y="250" text-anchor="middle">מענה ראשוני יוצא</text>
              </g>
              <g class="sf__stop sf__stop--end" style="--d:1020ms">
                <rect x="296" y="254" width="150" height="48" rx="14" fill="url(#sfCore)"></rect>
                <text x="371" y="284" text-anchor="middle" fill="#fff">נכנסת למעקב</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- ---- services: the major moment ---- -->
    <section class="section services" id="services">
      <div class="u-container">
        <div class="services__head">
          <p class="t-eyebrow services__eyebrow">מה אנחנו בונים</p>
          <h2 class="t-display-2 services__title">חמישה שירותים. מטרה אחת: שהעסק יעבוד חלק.</h2>
        </div>

        <!-- two lead services, full editorial rows -->
        <div class="services__lead-list">
          {
            featured.map((s, i) => (
              <article class="svc" data-reveal>
                <span class="svc__index tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="svc__main">
                  <h3 class="t-h1 svc__name">{s.name}</h3>
                  <p class="svc__lead">{s.lead}</p>
                  <p class="svc__pain">{s.pain}</p>
                  <a class="svc__link" href={`/services/${s.slug}/`}>
                    לפרטים על השירות
                    <span class="arrow-inline" aria-hidden="true">←</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <!-- remaining three, still fully readable, just tighter -->
        <div class="services__rest">
          {
            rest.map((s, i) => (
              <article class="svc-min" data-reveal style={`--i:${i}`}>
                <span class="svc-min__index tabular" aria-hidden="true">{String(i + 3).padStart(2, '0')}</span>
                <h3 class="t-h3 svc-min__name">{s.name}</h3>
                <p class="svc-min__lead">{s.lead}</p>
                <p class="svc-min__pain">{s.pain}</p>
                <a class="svc__link" href={`/services/${s.slug}/`}>
                  לפרטים
                  <span class="arrow-inline" aria-hidden="true">←</span>
                </a>
              </article>
            ))
          }
        </div>

        <p class="services__pricing">
          אין מחירון קבוע. המחיר נקבע אחרי שיחת היכרות ואפיון, לפי מה שהעסק באמת צריך.
        </p>
      </div>
    </section>
  </div>

  <!-- ═══════════════ PROCESS ═══════════════ -->
  <section class="section process">
    <div class="u-container">
      <div class="process__head">
        <p class="t-eyebrow">איך זה עובד</p>
        <h2 class="t-h2">שישה שלבים, בלי הפתעות באמצע</h2>
      </div>

      <ol class="process__list">
        {
          PROCESS.map((p, i) => (
            <li class="process__item" data-reveal style={`--i:${i}`}>
              <div class="process__marker" aria-hidden="true">
                <span class="process__num tabular">{p.n}</span>
              </div>
              <div class="process__content">
                <h3 class="t-h3 process__label">{p.label}</h3>
                <p class="process__what">{p.what}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════ FOUNDER ═══════════════ -->
  <section class="section section--gray founder">
    <div class="u-container founder__grid">
      <div class="founder__portrait" data-reveal>
        {FOUNDER.photoReady ? (
          <figure class="founder__photo">
            <img
              src={FOUNDER.photo}
              alt={FOUNDER.alt}
              width="600"
              height="750"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ) : (
        <>
        <div class="founder__frame">
          <svg viewBox="0 0 300 340" role="img" aria-label="מקום שמור לתמונת המייסד">
            <defs>
              <linearGradient id="fdMono" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0%" stop-color="#0B1530"></stop>
                <stop offset="55%" stop-color="#1D4ED8"></stop>
                <stop offset="100%" stop-color="#2997FF"></stop>
              </linearGradient>
            </defs>
            <path
              d="M92 96 L92 196 Q92 218 114 218 L172 218 Q190 218 200 200 L226 96"
              fill="none"
              stroke="url(#fdMono)"
              stroke-width="16"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <path d="M226 96 L252 196" fill="none" stroke="#2997FF" stroke-width="16" stroke-linecap="round"></path>
            <circle cx="226" cy="180" r="8.5" fill="#1D4ED8"></circle>
          </svg>
        </div>
        <p class="founder__caption">תמונת המייסד תתווסף בהמשך</p>
        </>
        )}
      </div>

      <div class="founder__text">
        <p class="t-eyebrow">מי עומד מאחורי זה</p>
        <h2 class="t-h2 founder__name">{FOUNDER.name}</h2>
        <p class="founder__role">{FOUNDER.role}</p>
        <p class="founder__body">
          הקמתי את LAHAV AI מתוך דבר אחד שראיתי חוזר בעסקים: לא חסרים כלים.
          חסר חיבור. יש יותר מדי עבודה ידנית, ותהליכים שמסתבכים ככל שהעסק גדל.
        </p>
        <p class="founder__body">
          לכן אני מתחיל תמיד מאותה נקודה: איפה העבודה נתקעת, מה גוזל זמן, ואיפה
          מידע הולך לאיבוד. רק אחרי שזה ברור, בוחרים טכנולוגיה ובונים.
        </p>
        <a class="svc__link founder__link" href="/about/">
          עוד עלינו
          <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="בואו נראה איפה אפשר לעשות סדר"
    body="שיחה של 30 דקות. נעבור על התהליכים שלכם, ונגיד בכנות איפה יש מה לשפר ואיפה פשוט לא צריך."
  />
</SiteLayout>

<style>
  /* ═══════════ HERO ═══════════ */
  .hero {
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(4rem, 7vw, 7rem);
    overflow: clip;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-royal);
    background: color-mix(in srgb, var(--color-royal) 8%, transparent);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.1rem;
    margin-bottom: 1.75rem;
  }
  /* Deliberately a step below --text-display-1: in a two column hero that
     size breaks the Hebrew into too many short lines, which reads as
     cramped rather than confident. This keeps the line count at two. */
  .hero__title {
    font-size: clamp(2.5rem, 1.15rem + 3.9vw, 4.875rem);
    line-height: 1.06;
    margin-bottom: 1.75rem;
  }
  .hero__title-accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 44ch;
    margin-bottom: 2.5rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero__note {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--color-ink-3);
  }
  .hero__visual {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    aspect-ratio: 6 / 5;
    display: grid;
    place-items: center;
  }

  /* ═══════════ EXPLAINER ═══════════ */
  .explain__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .explain__title {
    position: sticky;
    top: 120px;
  }
  .explain__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }
  .explain__p {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-ink-2);
    max-width: none;
  }
  .explain__p--lead {
    font-size: var(--text-lead);
    font-weight: 600;
    color: var(--color-ink);
  }
  .explain__p--strong {
    color: var(--color-ink);
    font-weight: 500;
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1.25rem;
  }

  /* ═══════════ PAIN ═══════════ */
  .pain__head {
    max-width: 46rem;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pain__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 6vw, 6rem);
  }
  .pain__item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 90ms),
      translate 600ms var(--ease-out) calc(var(--i) * 90ms);
  }
  .pain__item.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .pain__num {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
    padding-top: 0.35rem;
    flex: 0 0 auto;
  }
  .pain__body {
    color: var(--color-ink-2);
    margin-top: 0.5rem;
    max-width: 42ch;
  }

  /* ═══════════ DARK ACT ═══════════ */
  .act-dark {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.82);
    position: relative;
    overflow: clip;
  }
  .act-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(900px 520px at 82% 4%, rgba(41, 151, 255, 0.2), transparent 62%),
      radial-gradient(760px 520px at 10% 68%, rgba(29, 78, 216, 0.18), transparent 66%);
  }
  .act-dark > * {
    position: relative;
  }
  .act-dark :global(.t-h2),
  .act-dark :global(.t-h3),
  .act-dark :global(.t-display-2) {
    color: #fff;
  }
  .act-dark :global(.t-eyebrow) {
    color: var(--color-electric);
  }

  /* The two dark sections are one continuous act, so the seam between them
     is tighter than the gap between separate light/dark sections. */
  .sysflow {
    padding-bottom: clamp(2rem, 3vw, 3.5rem);
  }
  .services {
    padding-top: clamp(2.5rem, 4vw, 4.5rem);
  }

  /* ---- connected system ---- */
  .sysflow__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .sysflow__title {
    margin-block: 1rem 1.25rem;
  }
  .sysflow__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    max-width: 40ch;
  }
  .sysflow__viz svg {
    width: 100%;
    height: auto;
  }
  .sf__spine {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
  .sysflow__viz.is-in .sf__spine {
    animation: sf-draw 2000ms var(--ease-out) forwards;
  }
  @keyframes sf-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .sf__stop rect {
    fill: rgba(255, 255, 255, 0.06);
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1;
  }
  .sf__stop text {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    fill: rgba(255, 255, 255, 0.9);
  }
  .sf__stop {
    opacity: 0;
  }
  .sysflow__viz.is-in .sf__stop {
    animation: sf-stop-in 600ms var(--ease-out) calc(300ms + var(--d)) forwards;
  }
  @keyframes sf-stop-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---- services ---- */
  .services__head {
    max-width: 52rem;
