---
// HOME. Composition: big type statement, then a full-bleed dark stage that
// dominates the viewport, then the story runs problem -> result -> services
// -> process -> founder -> CTA.
//
// Unique to this page: the hero stage, the pain grid and the numbered
// editorial service act. No other page repeats this composition.
import SiteLayout from '../layouts/SiteLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import HeroStage from '../components/HeroStage.astro';
import ServiceShowcase from '../components/ServiceShowcase.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import DiscoveryPitch from '../components/DiscoveryPitch.astro';
import { CAPABILITY_ICONS } from '../lib/icons';
import Viz from '../components/Viz.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { SERVICES, PROCESS, WHATSAPP_HREF, CTA_PRIMARY, CAPABILITIES, FOUNDER } from '../lib/site';
import WhatsApp from '../components/icons/WhatsApp.astro';

const pains = [
  { t: 'המידע מפוזר בכל מקום', d: 'חלק בוואטסאפ, חלק במייל, חלק באקסל, וחלק בראש של מישהו. אף אחד לא רואה את התמונה המלאה.' },
  { t: 'אותה עבודה, שוב ושוב', d: 'מעתיקים פרטים בין מערכות, ממלאים את אותם טפסים, שולחים את אותן הודעות. כל יום מחדש.' },
  { t: 'פניות שנשכחות', d: 'מישהו השאיר פרטים ולא חזרו אליו בזמן. עד שנזכרים, הפנייה כבר התקררה.' },
  { t: 'קשה לדעת מה קורה', d: 'שאלה פשוטה כמו "כמה פניות היו החודש" דורשת לעבור בין כמה מקומות רק כדי להבין את התמונה.' },
];
---

<SiteLayout
  title="LAHAV AI, מערכות ואוטומציות שעושות סדר בעסק"
  description="בונים לעסקים קטנים ובינוניים בישראל מערכות CRM, אוטומציות ופתרונות דיגיטליים שמחברים את התהליכים בעסק. פחות עבודה ידנית, יותר שליטה."
>
  <ScrollReveal />

  <!-- ══════════ HERO: copy and visual in ONE first-screen act ══════════ -->
  <section class="hero">
    <div class="u-container hero__grid">
      <div class="hero__type">
        <p class="hero__eyebrow">מערכות AI ואוטומציה לעסקים</p>
        <h1 class="hero__title">
          פחות עבודה ידנית.<br />
          <span class="hero__accent">יותר שליטה בעסק.</span>
        </h1>
        <p class="hero__lead">
          נשב, נבין איך העסק שלכם עובד היום, ונבנה מערכת שלוקחת על עצמה את
          העבודה שחוזרת על עצמה. ההחלטות נשארות אצלכם.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary btn-lg" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
          <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
            <WhatsApp />
            שיחה בוואטסאפ
          </a>
        </div>
        <p class="hero__note">30 דקות, בלי התחייבות. נבין יחד איפה יש מה לשפר.</p>
      </div>

      <div class="hero__stage">
        <HeroStage />
      </div>
    </div>
  </section>

  <!-- ══════════ EXPLAINER ══════════ -->
  <section class="section explain">
    <div class="u-container explain__grid">
      <h2 class="t-h2 explain__q">רגע, מה זה בעצם אומר?</h2>
      <div class="explain__a">
        <p class="explain__lead">"אוטומציה" נשמעת כמו מילה גדולה. הרעיון מאחוריה פשוט.</p>
        <p class="explain__p">
          תחשבו על יום עבודה רגיל אצלכם. יש פעולות קטנות שחוזרות שוב ושוב:
          להעביר פרטים ממקום למקום, לשלוח הודעות מעקב, לזכור לחזור ללקוח,
          לעדכן מידע ידנית. כל אחת קטנה בפני עצמה, אבל ביחד הן מצטברות
          להרבה עבודה.
        </p>
        <p class="explain__strong">
          את כל אלה אפשר להגדיר פעם אחת ולתת למערכת לעשות. אתם נשארים עם
          ההחלטות. המערכת מטפלת בפעולות שהגדרנו מראש.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════ PAIN ══════════ -->
  <section class="section section--gray">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">נשמע מוכר?</p>
        <h2 class="t-h2">לרוב העסקים לא חסר עוד כלי.<br />חסר שהכלים ידברו ביניהם.</h2>
      </div>
      <ul class="pains">
        {
          pains.map((p, i) => (
            <li class="pain" data-reveal style={`--i:${i}`}>
              <span class="pain__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h3">{p.t}</h3>
              <p class="pain__d">{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════ RESULT: connected system, full dark section ══════════ -->
  <section class="section section--navy">
    <div class="u-container">
      <div class="lede lede--center">
        <p class="t-eyebrow">התוצאה</p>
        <h2 class="t-display-2">ככה זה נראה<br />כשהכל מדבר</h2>
        <p class="t-lead">
          מישהו משאיר פרטים באתר. הפנייה נרשמת לבד, מקבלת מענה ראשוני, נכנסת
          למעקב, ומזכירה לכם לחזור אליה בזמן. אף אחד לא העתיק שורה.
        </p>
      </div>
      <Viz kind="crm" class="home__viz" />

      <div class="caps">
        <p class="caps__label">תחומים שאנחנו עובדים בהם</p>
        <ul class="caps__list">
          {
            CAPABILITIES.map((c, i) => (
              <li class="cap" data-reveal style={`--i:${i}`}>
                <span class="cap__ico" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={CAPABILITY_ICONS[i % CAPABILITY_ICONS.length]}
                  />
                </span>
                <span class="cap__t">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ SERVICES: the commercial act ══════════ -->
  <section class="section services" id="services">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">מה אנחנו בונים</p>
        <h2 class="t-display-2">חמישה תחומים,<br />ואפשר להתחיל מאחד.</h2>
        <p class="t-lead services__hint">בחרו תחום כדי לראות איך הוא עובד בפועל.</p>
      </div>

      <ServiceShowcase />

      <p class="pricing-note">
        אין מחירון קבוע, כי אין שני עסקים זהים. המחיר נקבע אחרי שיחת היכרות
        ואפיון, לפי מה שאתם באמת צריכים ולא לפי חבילה.
      </p>
    </div>
  </section>

  <DiscoveryPitch variant="home" />

  <!-- ══════════ PROCESS ══════════ -->
  <section class="section section--gray">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">איך זה עובד</p>
        <h2 class="t-h2">מה קורה מרגע שאמרתם כן</h2>
      </div>
      <ol class="steps">
        {
          PROCESS.map((p, i) => (
            <li class="step" data-reveal style={`--i:${i}`}>
              <span class="step__n">{p.n}</span>
              <h3 class="t-h3 step__t">{p.label}</h3>
              <p class="step__d">{p.what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══════════ FOUNDER ══════════ -->
  <section class="section founder">
    <div class="u-container founder__grid">
      <FounderPortrait scale="home" sizes="(max-width: 1024px) 60vw, 26rem" />
      <div class="founder__text">
        <p class="t-eyebrow">מי עומד מאחורי זה</p>
        <h2 class="t-h2 founder__name">{FOUNDER.name}</h2>
        <p class="founder__role">{FOUNDER.role}</p>
        <p class="founder__p">
          הקמתי את LAHAV AI בגלל משהו שראיתי חוזר בעסק אחרי עסק: כמעט תמיד לא
          חסרים כלים. חסר שהם ידברו. המידע מתפזר, העבודה הידנית מצטברת, ודברים
          שהיו פשוטים כשהייתם שלושה נהיים מסורבלים כשאתם חמישה עשר.
        </p>
        <p class="founder__p">
          לכן אני מתחיל מהעסק, לא מהטכנולוגיה. קודם נבין איפה העבודה נתקעת ומה
          גוזל לכם את הזמן. רק אחר כך נבחר כלים ונבנה את המערכת שמתאימה לתהליך,
          ולא להפך.
        </p>
        <a class="link-arrow founder__link" href="/about/">
          עוד עלינו <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="בואו נראה איפה אפשר לעשות סדר"
    body="30 דקות. נעבור יחד על איך שאתם עובדים היום, ונגיד בכנות איפה יש מה לשפר ואיפה פשוט לא צריך."
  />
</SiteLayout>

<style>
  /* ---------- Hero ----------
     Copy and visual belong to the SAME first screen. The visual is a
     co-star, not a side illustration, so it takes the larger share. */
  .hero {
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem);
    background:
      radial-gradient(120% 90% at 85% 0%, rgba(41, 151, 255, 0.09), transparent 60%),
      radial-gradient(90% 80% at 10% 20%, rgba(29, 78, 216, 0.06), transparent 60%);
  }
  .hero__grid {
    display: grid;
    /* first column is the RIGHT one in RTL: the words come first */
    grid-template-columns: minmax(0, 48fr) minmax(0, 52fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-royal);
    background: color-mix(in srgb, var(--color-royal) 8%, transparent);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.1rem;
    margin-bottom: 1.5rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.375rem, 1rem + 3vw, 3.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 34ch;
    margin-bottom: 2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }
  /* slightly tighter than the global btn-lg so the pair fits the column */
  .hero__actions .btn {
    white-space: nowrap;
    padding-inline: 1.375rem;
  }
  .hero__note {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--color-ink-3);
  }
  /* The dark stage is its own object, not a full-bleed band, so the copy
     and the visual read as one composition. */
  .hero__stage {
    background: var(--color-navy);
    border-radius: clamp(1.25rem, 2vw, 2rem);
    padding: clamp(1.25rem, 2.5vw, 2.5rem);
    box-shadow: var(--shadow-lg);
  }

  /* ---------- Explainer ---------- */
  .explain__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .explain__q {
    position: sticky;
    top: 120px;
  }
  .explain__a {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }
  .explain__lead {
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.5;
    max-width: none;
  }
  .explain__p {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-ink-2);
    max-width: none;
  }
  .explain__strong {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    font-weight: 500;
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1.25rem;
    max-width: none;
  }

  /* ---------- Pain ---------- */
  .pains {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(3rem, 6vw, 6rem);
  }
  .pain {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 90ms),
      translate 600ms var(--ease-out) calc(var(--i) * 90ms);
  }
  :global(html.reveal-ready) .pain {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .pain.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .pain__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
  }
  .pain__d {
    color: var(--color-ink-2);
    max-width: 44ch;
  }

  /* ---------- Result ---------- */
  .home__viz {
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .caps {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .caps__label {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--color-electric);
    margin-bottom: 1.25rem;
  }
  .caps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.25rem;
    /* a hairline, not a card: nothing here is clickable */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition:
      opacity 500ms var(--ease-out) calc(var(--i) * 70ms),
      translate 500ms var(--ease-out) calc(var(--i) * 70ms);
  }
  :global(html.reveal-ready) .cap {
    opacity: 0;
    translate: 0 12px;
  }
  :global(html.reveal-ready) .cap.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .cap__ico {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    color: var(--color-electric);
  }
  .cap__ico svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .cap__t {
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.88);
  }

  /* ---------- Services ---------- */
  .services__hint {
    margin-top: 1rem;
    color: var(--color-ink-3);
  }
  .pricing-note {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    font-size: var(--text-small);
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1rem;
    max-width: 60ch;
  }

  /* ---------- Process ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-line-strong);
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 100ms),
      translate 600ms var(--ease-out) calc(var(--i) * 100ms),
      border-color 600ms var(--ease-out) calc(var(--i) * 100ms);
  }
  :global(html.reveal-ready) .step {
    opacity: 0;
    translate: 0 18px;
  }
  :global(html.reveal-ready) .step.is-in {
    opacity: 1;
    translate: 0 0;
    border-top-color: var(--color-royal);
  }
  .step__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
  }
  .step__d {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 36ch;
  }

  /* ---------- Founder ---------- */
  /* The portrait sits on the same baseline as the text block, with no
     frame around it, so the section reads as one composition. */
  .founder {
    overflow: hidden;
  }
  .founder__grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }
  .founder__text {
    padding-bottom: clamp(0.5rem, 2vw, 2rem);
  }
  .founder__name {
    margin-block: 0.75rem 0.25rem;
  }
  .founder__role {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-royal);
    direction: ltr;
    text-align: start;
    margin-bottom: 1.5rem;
  }
  .founder__p {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-ink-2);
    max-width: 54ch;
    margin-bottom: 1rem;
  }
  .founder__link {
    margin-top: 0.75rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .hero__grid,
    .explain__grid,
    .founder__grid {
      grid-template-columns: 1fr;
    }
    /* Mobile is recomposed, not shrunk: the words land first, then the
       visual gets the full width it needs to stay readable. */
    .hero__lead {
      max-width: 46ch;
    }
    .explain__q {
      position: static;
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .caps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .pains,
    .steps,
    .caps__list {
      grid-template-columns: 1fr;
    }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero__stage {
      padding: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pain,
    .step,
    .cap {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
