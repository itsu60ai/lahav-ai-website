---
// HOME. Composition: big type statement, then a full-bleed dark stage that
// dominates the viewport, then the story runs problem -> result -> services
// -> process -> founder -> CTA.
//
// Unique to this page: the hero stage, the pain grid and the numbered
// editorial service act. No other page repeats this composition.
import SiteLayout from '../layouts/SiteLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import HeroStage from '../components/HeroStage.astro';
import Viz from '../components/Viz.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { SERVICES, PROCESS, WHATSAPP_HREF, CTA_PRIMARY, CAPABILITIES, FOUNDER } from '../lib/site';

const featured = SERVICES.filter((s) => s.featured);
const rest = SERVICES.filter((s) => !s.featured);

const pains = [
  { t: 'המידע מפוזר בכל מקום', d: 'חלק בוואטסאפ, חלק במייל, חלק באקסל, וחלק בראש של מישהו. אף אחד לא רואה את התמונה המלאה.' },
  { t: 'אותה עבודה, שוב ושוב', d: 'מעתיקים פרטים בין מערכות, ממלאים את אותם טפסים, שולחים את אותן הודעות. כל יום מחדש.' },
  { t: 'פניות שנשכחות', d: 'מישהו השאיר פרטים ולא חזרו אליו בזמן. עד שנזכרים, הפנייה כבר התקררה.' },
  { t: 'קשה לדעת מה קורה', d: 'שאלה פשוטה כמו "כמה פניות היו החודש" דורשת לעבור בין כמה מקומות רק כדי להבין את התמונה.' },
];
---

<SiteLayout
  title="LAHAV AI, מערכות ואוטומציות שעושות סדר בעסק"
  description="בונים לעסקים קטנים ובינוניים בישראל מערכות CRM, אוטומציות ופתרונות דיגיטליים שמחברים את התהליכים בעסק. פחות עבודה ידנית, יותר שליטה."
>
  <ScrollReveal />

  <!-- ══════════ HERO: statement, then a stage that dominates ══════════ -->
  <section class="hero">
    <div class="u-container hero__type">
      <p class="hero__eyebrow">מערכות AI ואוטומציה לעסקים</p>
      <h1 class="hero__title">
        פחות עבודה ידנית.<br />
        <span class="hero__accent">יותר שליטה בעסק.</span>
      </h1>
      <p class="hero__lead">
        אנחנו בונים מערכות CRM, אוטומציות ופתרונות דיגיטליים שמחברים את התהליכים
        בעסק, מפחיתים עבודה ידנית ועושים סדר במה שקורה ביום-יום.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary btn-lg" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
        <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23Z"
            ></path></svg
          >
          שיחה בוואטסאפ
        </a>
      </div>
      <p class="hero__note">שיחת היכרות של 30 דקות, נבין יחד איפה יש מה לשפר.</p>
    </div>

    <div class="hero__stage section--navy">
      <HeroStage />
    </div>
  </section>

  <!-- ══════════ EXPLAINER ══════════ -->
  <section class="section explain">
    <div class="u-container explain__grid">
      <h2 class="t-h2 explain__q">רגע, מה זה בעצם אומר?</h2>
      <div class="explain__a">
        <p class="explain__lead">"אוטומציה" נשמעת כמו מילה גדולה, אבל הרעיון פשוט.</p>
        <p class="explain__p">
          בעסקים רבים יש המון פעולות קטנות שחוזרות על עצמן: להעביר פרטים ממקום למקום,
          לשלוח הודעות, לזכור לחזור ללקוחות ולעדכן מידע ידנית. כל פעולה קטנה בפני עצמה,
          אבל יחד הן מצטברות להרבה עבודה שלא באמת חייבת להיעשות ביד.
        </p>
        <p class="explain__strong">
          מה שאנחנו עושים זה להעביר את הפעולות האלה למערכת שעושה אותן לבד.
          אתם נשארים עם ההחלטות, היא לוקחת את השאר.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════ PAIN ══════════ -->
  <section class="section section--gray">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">נשמע מוכר?</p>
        <h2 class="t-h2">לרוב העסקים לא חסר עוד כלי.<br />חסר להם שהכלים ידברו ביניהם.</h2>
      </div>
      <ul class="pains">
        {
          pains.map((p, i) => (
            <li class="pain" data-reveal style={`--i:${i}`}>
              <span class="pain__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h3">{p.t}</h3>
              <p class="pain__d">{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════ RESULT: connected system, full dark section ══════════ -->
  <section class="section section--navy">
    <div class="u-container">
      <div class="lede lede--center">
        <p class="t-eyebrow">התוצאה</p>
        <h2 class="t-display-2">המערכות בעסק<br />מתחילות לעבוד יחד</h2>
        <p class="t-lead">
          פנייה שנכנסת מהאתר נרשמת לבד, מקבלת מענה ראשוני, נכנסת למעקב,
          ומזכירה לכם לחזור אליה. בלי שאף אחד העתיק שורה אחת.
        </p>
      </div>
      <Viz kind="crm" class="home__viz" />

      <div class="caps" data-reveal>
        <p class="caps__label">תחומים שאנחנו עובדים בהם</p>
        <ul class="caps__list">{CAPABILITIES.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ══════════ SERVICES: the commercial act ══════════ -->
  <section class="section services" id="services">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">מה אנחנו בונים</p>
        <h2 class="t-display-2">חמישה שירותים.<br />מטרה אחת: שהעסק יעבוד חלק.</h2>
      </div>

      {
        featured.map((s, i) => (
          <article class="svc" data-reveal>
            <div class="svc__head">
              <span class="svc__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="chip">שירות מוביל</span>
            </div>
            <h3 class="t-h1 svc__name">{s.name}</h3>
            <p class="svc__lead">{s.lead}</p>
            <p class="svc__body">{s.pain}</p>
            <a class="link-arrow" href={`/services/${s.slug}/`}>
              לפרטים על השירות <span class="arrow-inline" aria-hidden="true">←</span>
            </a>
          </article>
        ))
      }

      <div class="svc-rest">
        {
          rest.map((s, i) => (
            <article class="svc-min" data-reveal style={`--i:${i}`}>
              <span class="svc-min__n tabular">{String(i + 3).padStart(2, '0')}</span>
              <h3 class="t-h3">{s.name}</h3>
              <p class="svc-min__lead">{s.lead}</p>
              <p class="svc-min__body">{s.pain}</p>
              <a class="link-arrow" href={`/services/${s.slug}/`}>
                לפרטים <span class="arrow-inline" aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="pricing-note">
        אין מחירון קבוע. המחיר נקבע אחרי שיחת היכרות ואפיון, לפי מה שהעסק באמת צריך.
      </p>
    </div>
  </section>

  <!-- ══════════ PROCESS ══════════ -->
  <section class="section section--gray">
    <div class="u-container">
      <div class="lede">
        <p class="t-eyebrow">איך זה עובד</p>
        <h2 class="t-h2">תהליך ברור מהאפיון ועד המסירה</h2>
      </div>
      <ol class="steps">
        {
          PROCESS.map((p, i) => (
            <li class="step" data-reveal style={`--i:${i}`}>
              <span class="step__n">{p.n}</span>
              <h3 class="t-h3 step__t">{p.label}</h3>
              <p class="step__d">{p.what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══════════ FOUNDER ══════════ -->
  <section class="section founder">
    <div class="u-container founder__grid">
      <figure class="founder__photo" data-reveal>
        <img
          src={FOUNDER.photo}
          srcset={`${FOUNDER.photoSmall} 480w, ${FOUNDER.photo} 720w`}
          sizes="(max-width: 900px) 88vw, 34vw"
          alt={FOUNDER.alt}
          width="720"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="founder__text">
        <p class="t-eyebrow">מי עומד מאחורי זה</p>
        <h2 class="t-h2 founder__name">{FOUNDER.name}</h2>
        <p class="founder__role">{FOUNDER.role}</p>
        <p class="founder__p">
          הקמתי את LAHAV AI מתוך משהו שראיתי שוב ושוב בעסקים: הבעיה היא בדרך כלל
          לא שחסרים כלים, אלא שהכלים והתהליכים לא עובדים יחד. מידע מתפזר, עבודה
          ידנית מצטברת, ודברים פשוטים הופכים למסורבלים ככל שהעסק גדל.
        </p>
        <p class="founder__p">
          לכן אני מתחיל מהעסק ולא מהטכנולוגיה. קודם מבינים איפה העבודה נתקעת, מה
          גוזל זמן ומה צריך לעבוד פשוט יותר. רק אחר כך בוחרים את הכלים ובונים את
          המערכת שמתאימה לתהליך.
        </p>
        <a class="link-arrow founder__link" href="/about/">
          עוד עלינו <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="בואו נראה איפה אפשר לעשות סדר"
    body="שיחה של 30 דקות. נעבור על התהליכים שלכם, ונגיד בכנות איפה יש מה לשפר ואיפה פשוט לא צריך."
  />
</SiteLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(3rem, 7vw, 7rem);
  }
  .hero__type {
    /* wider than the standard container so the display line stays on two rows */
    max-width: 1360px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hero__eyebrow {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-royal);
    background: color-mix(in srgb, var(--color-royal) 8%, transparent);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.1rem;
    margin-bottom: 1.75rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--text-mega);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.75rem;
  }
  .hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .hero__note {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--color-ink-3);
  }
  .hero__stage {
    padding-block: clamp(1rem, 3vw, 2rem);
  }

  /* ---------- Explainer ---------- */
  .explain__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .explain__q {
    position: sticky;
    top: 120px;
  }
  .explain__a {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }
  .explain__lead {
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.5;
    max-width: none;
  }
  .explain__p {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    color: var(--color-ink-2);
    max-width: none;
  }
  .explain__strong {
    font-size: var(--text-body-lg);
    line-height: 1.75;
    font-weight: 500;
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1.25rem;
    max-width: none;
  }

  /* ---------- Pain ---------- */
  .pains {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(3rem, 6vw, 6rem);
  }
  .pain {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 90ms),
      translate 600ms var(--ease-out) calc(var(--i) * 90ms);
  }
  :global(html.reveal-ready) .pain {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .pain.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .pain__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
  }
  .pain__d {
    color: var(--color-ink-2);
    max-width: 44ch;
  }

  /* ---------- Result ---------- */
  .home__viz {
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .caps {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    transition: opacity 700ms var(--ease-out), translate 700ms var(--ease-out);
  }
  :global(html.reveal-ready) .caps {
    opacity: 0;
    translate: 0 14px;
  }
  :global(html.reveal-ready) .caps.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .caps__label {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--color-electric);
    margin-bottom: 1rem;
  }
  .caps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .caps__list li {
    font-size: var(--text-small);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.76);
    position: relative;
  }
  .caps__list li + li::before {
    content: '';
    position: absolute;
    inset-inline-end: -0.9rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(41, 151, 255, 0.6);
    translate: 0 -50%;
  }

  /* ---------- Services ---------- */
  .svc {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-line);
    transition: opacity 700ms var(--ease-out), translate 700ms var(--ease-out);
  }
  :global(html.reveal-ready) .svc {
    opacity: 0;
    translate: 0 20px;
  }
  :global(html.reveal-ready) .svc.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .svc__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .svc__n {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-electric);
    line-height: 1;
  }
  .svc__name {
    margin-bottom: 0.875rem;
  }
  .svc__lead {
    font-size: var(--text-lead);
    font-weight: 600;
    color: var(--color-royal);
    line-height: 1.5;
    margin-bottom: 1rem;
    max-width: 40ch;
  }
  .svc__body {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-ink-2);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .svc-rest {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-top: clamp(2rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-line-strong);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }
  .svc-min {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 110ms),
      translate 600ms var(--ease-out) calc(var(--i) * 110ms);
  }
  :global(html.reveal-ready) .svc-min {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .svc-min.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .svc-min__n {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    font-weight: 700;
    color: var(--color-electric);
  }
  .svc-min__lead {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-royal);
    line-height: 1.5;
  }
  .svc-min__body {
    font-size: var(--text-small);
    line-height: 1.65;
    color: var(--color-ink-2);
  }
  .svc-min .link-arrow {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .pricing-note {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    font-size: var(--text-small);
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1rem;
    max-width: 60ch;
  }

  /* ---------- Process ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-line-strong);
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 100ms),
      translate 600ms var(--ease-out) calc(var(--i) * 100ms),
      border-color 600ms var(--ease-out) calc(var(--i) * 100ms);
  }
  :global(html.reveal-ready) .step {
    opacity: 0;
    translate: 0 18px;
  }
  :global(html.reveal-ready) .step.is-in {
    opacity: 1;
    translate: 0 0;
    border-top-color: var(--color-royal);
  }
  .step__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
  }
  .step__d {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 36ch;
  }

  /* ---------- Founder ---------- */
  .founder__grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .founder__photo {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-surface-3);
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-lg);
    transition: opacity 700ms var(--ease-out), translate 700ms var(--ease-out);
  }
  :global(html.reveal-ready) .founder__photo {
