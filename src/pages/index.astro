---
// HOME, V3.
//
// Section rhythm mapped from the reference package, with LAHAV content
// in each slot:
//   1  hero        full-viewport, oversized stacked statement, guide
//                  character centred, floating product cards, disc CTA
//   2  marquee     continuous type strip, breaks the hero cleanly
//   3  problem     editorial hairline list (the reference's two-column
//                  pattern: heavy heading one side, prose the other)
//   4  core        full-bleed blue contrast band, orbit diagram
//   5  services    pinned storytelling: sticky index, panels swap
//   6  process     numbered editorial rows
//   7  founder     asymmetric portrait + statement
//   8  cta         handled by the footer's oversized closing block
export const prerender = false;

import SiteLayout from '../layouts/SiteLayout.astro';
import Curve from '../components/Curve.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { turnstileSiteKey } from '../lib/turnstile.ts';
import SplitLines from '../components/SplitLines.astro';
import Presenter from '../components/Presenter.astro';
import FloatingCards from '../components/FloatingCards.astro';
import PartnersJointPhoto from '../components/PartnersJointPhoto.astro';
import Flow from '../components/Flow.astro';
import { SERVICES, PROCESS } from '../lib/site';
import { SERVICE_ICONS } from '../lib/icons';
import { HOME_DEFAULT, getPublicContent, getDraftContent } from '../lib/cms/content.ts';
import { resolvePreview } from '../lib/cms/preview.ts';

const SITE_KEY = turnstileSiteKey();

// Website content CMS: the hero and this page's SEO come from the
// published draft in D1, falling back to the exact current approved
// copy (HOME_DEFAULT) if nothing is published yet or the read fails.
// See src/lib/cms/content.ts.
const { content: contentStore } = Astro.locals.stores!;
const preview = await resolvePreview(Astro, Astro.locals.stores!);
const home = preview
  ? await getDraftContent(contentStore, 'home', HOME_DEFAULT)
  : await getPublicContent(contentStore, 'home', HOME_DEFAULT);

// The four convictions, set as oversized HEBREW words. They used to be
// Latin (PROCESS / BUZZWORD / LESS / CONTROL); that was removed on
// 31.08.2026 along with every other giant English display word.
//
// Statements about how WE work, never about anyone else, and with no
// figures and no claims in them.
const beliefs = [
  {
    kicker: 'קודם הפיצוח, רק אז הטכנולוגיה',
    word: 'התהליך',
    body: 'אנחנו לא דוחפים מערכות סתם כי הן טרנדיות. לפני שאנחנו בוחרים כלי, אנחנו מבינים איך הכסף והלידים זזים אצלכם.',
  },
  {
    kicker: 'מדברים בגובה העיניים, בלי סינית',
    word: 'בעברית',
    body: 'לא נשגע אתכם עם מושגי פיתוח מסובכים או שמות קוד טכנולוגיים. נדבר איתכם על השורה התחתונה: מה זה משנה ליום-יום שלכם.',
  },
  {
    kicker: 'מינימום פיתוח, מקסימום יעילות',
    word: 'רק מה שצריך',
    body: 'אם אפשר לפתור בעיה באמצעות כלי קיים ופשוט במקום לבנות קוד יקר מאפס, נגיד לכם את זה מיד. אנחנו כאן כדי לחסוך לכם כסף.',
  },
  {
    kicker: 'השליטה נשארת בבעלותכם',
    word: 'השליטה אצלכם',
    body: 'המערכת פותרת את מה שאפשר להפוך לרובוטי. ההחלטות האסטרטגיות, שיקול הדעת והקשר האנושי נשארים שלכם ב-100%.',
  },
];

const pains = [
  { t: 'בלגן במידע', d: 'הכל מפוזר, חצי בראש שלכם. קצת בוואטסאפ, קצת במייל, טיפה באקסלים ודפים. אף אחד לא באמת יודע מה הסטטוס של כל לקוח.' },
  { t: 'עבודת נמלים סיזיפית', d: 'לעשות "העתק-הדבק" כל היום. אתם מוצאים את עצמכם מקלידים שוב ושוב את אותם הפרטים, שולחים אותן הודעות ומבזבזים שעות על משימות משעממות.' },
  { t: 'כסף שנזרק לפח', d: 'לקוחות שפשוט "נופלים בין הכיסאות". פנייה נכנסת, אף אחד לא מספיק לחזור אליה תוך 5 דקות, והלקוח כבר הלך למתחרים.' },
  { t: 'עיוורון ניהולי', d: 'אין לכם מושג מה המספרים. אם תרצו לדעת עכשיו כמה כסף נכנס החודש או כמה לידים סגרתם, תצטרכו לעשות דוקטורט בין 4 מערכות שונות.' },
];

const marquee = ['CRM', 'אוטומציות', 'אתרים', 'אפליקציות', 'תוכן AI', 'אפיון', 'אינטגרציות'];

// What the guide says when a visitor asks it to talk. Timed lines, so
// a real audio track can be dropped in later without touching markup.
// Truth rules apply here exactly as in page copy: no numbers, no
// results, no claims that cannot be stood behind.
// The hero presenter is a real recorded person now, so his words live in
// the audio and in public/presenter/he.vtt rather than in a caption array
// here. See src/components/Presenter.astro.

---

<SiteLayout
  title={home.seo.title}
  description={home.seo.description}
  noindex={home.seo.noindex}
  image={home.seo.ogImage || undefined}
  preview={preview}
>
  <!-- ═════════ 1. HERO ═════════ -->
  <section class="hero band band--hero">
    <FloatingCards />

    <!-- Reference composition: the statement owns the top of the screen,
         the character stands beneath it with the round talk trigger over
         its lower body. They sit in sequence, not stacked on top of each
         other, which is what keeps both legible. -->
    <div class="u-container u-container--wide hero__inner">
      <p class="hero__eyebrow t-eyebrow" data-reveal>{home.hero.eyebrow}</p>

      <h1 class="hero__title t-display-1">
        <span class="mo-line" style="--mo-delay:80ms"><span>{home.hero.headlineLine1}</span></span>
        <span class="mo-line" style="--mo-delay:190ms"><span class="hero__accent">{home.hero.headlineLine2}</span></span>
      </h1>

      <p class="hero__lead" data-reveal style="--mo-delay:330ms">
        {home.hero.lead}
      </p>
    </div>

    <div class="hero__figure">
      <Presenter
        idleWebm="/presenter/idle.webm"
        idleMp4="/presenter/idle.mp4"
        speakingSrc="/presenter/speaking.mp4"
        poster="/presenter/poster.webp"
        captions="/presenter/he.vtt"
        label="לחצו עליי"
        alt="המנחה של LAHAV AI"
        class="hero__presenter"
      />
    </div>

    <span class="hero__scroll" aria-hidden="true"></span>
  </section>

  <!-- ═════════ 2. MARQUEE ═════════ -->
  <div class="band band--navy mq" aria-hidden="true">
    <div class="mo-marquee" style="--mo-speed:44s;--mo-gap:clamp(2rem,5vw,5rem)">
      <div class="mo-marquee__track">
        {marquee.map((w) => <span class="mq__item">{w}</span>)}
      </div>
    </div>
  </div>

  <!-- ═════════ 3. PROBLEM ═════════ -->
  <section class="u-section band">
    <div class="u-container u-container--wide">
      <div class="prob__head">
        <p class="t-eyebrow" data-reveal>נשמע מוכר?</p>
        <SplitLines
          class="t-display-2 prob__title"
          lines={['ככה זה נראה כשהעסק', 'מנהל אתכם (במקום שאתם תנהלו אותו):']}
          step={100}
        />
      </div>

      <ul class="prob__list" data-stagger style="--mo-step:110ms">
        {pains.map((p, i) => (
          <li class="prob__row" data-reveal>
            <span class="prob__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="prob__t t-display-3">{p.t}</h3>
            <p class="prob__d">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ 4. THE CORE ═════════ -->
  <section class="core band band--blue">
    <Curve tone="blue" shape="wave" />

    <div class="u-container u-container--wide core__head">
      <p class="t-eyebrow core__k" data-reveal>הרעיון</p>
      <h2 class="core__h">
        <span class="mo-line" style="--mo-delay:80ms"><span>קליק אחד,</span></span>
        <span class="mo-line" style="--mo-delay:190ms"><span class="core__h-2">והכל מול העיניים שלכם.</span></span>
      </h2>
      <p class="core__sub" data-reveal style="--mo-delay:300ms">
        תארו לעצמכם בוקר שבו אתם פותחים מסך אחד מרכזי. הכל שם: הלידים, הפניות,
        המשימות של העובדים והמכירות. כשהכל זורם אוטומטית למקום אחד, אתם סוף סוף
        חוזרים לשלוט בעסק, להגדיל רווחים וליהנות משקט נפשי חסר תקדים.
      </p>
    </div>

    <!-- The core itself. One glowing centre, four capabilities orbiting
         it, drawn rather than photographed so nothing here implies a
         product screenshot or a result we cannot stand behind. -->
    <div class="core__stage" data-scale-in>
      <span class="core__orb" aria-hidden="true"></span>
      <span class="core__pulse core__pulse--1" aria-hidden="true"></span>
      <span class="core__pulse core__pulse--2" aria-hidden="true"></span>
      <span class="core__rings" aria-hidden="true">
        <span class="core__ring core__ring--1"><i></i></span>
        <span class="core__ring core__ring--2"><i></i></span>
        <span class="core__ring core__ring--3"><i></i></span>
      </span>
      <ul class="core__sats">
        <li class="core__sat core__sat--a"><span>פניות</span></li>
        <li class="core__sat core__sat--b"><span>לקוחות</span></li>
        <li class="core__sat core__sat--c"><span>משימות</span></li>
        <li class="core__sat core__sat--d"><span>מעקב</span></li>
      </ul>
    </div>

    <div class="u-container u-container--wide core__foot">
      <p class="core__lead" data-reveal>
        פנייה חמה נחתה מהאתר! המערכת כבר שלחה לה וואטסאפ, פתחה משימה ב-CRM
        ונעלה לכם פגישה ביומן ב-0 קליקים.
      </p>
      <div class="core__viz">
        <Flow
          tone="dark"
          stops={[
            { t: 'פנייה', s: 'נכנסת לבד' },
            { t: 'מענה', s: 'ראשוני ומיידי' },
            { t: 'מעקב', s: 'לא נשכח' },
            { t: 'לקוח', s: 'הכל במקום אחד' },
          ]}
          note="התרשים ממחיש את סדר הדברים. מה בדיוק ירוץ אצלכם ייקבע באפיון."
        />
      </div>
    </div>
  </section>

  <!-- ═════════ 5. WHAT WE BUILD ═════════ -->
  <!-- Cards on a rail, the way the reference presents its offering:
       one card per service, each self-contained, swipeable on a phone
       and three-up on a desktop. -->
  <section class="svc u-section band">
    <Curve tone="surface" shape="slope" />

    <div class="u-container u-container--wide svc__head">
      <p class="t-eyebrow" data-reveal>מה אנחנו בונים</p>
      <h2 class="svc__h t-display-2" data-reveal style="--mo-delay:80ms">הארסנל הדיגיטלי<br />שיזניק את העסק שלכם:</h2>
      <p class="svc__lead t-lead" data-reveal style="--mo-delay:160ms">
        חמישה כלים. כל אחד פותר כאב אחר. מתחילים ממה שהכי מפריע, וממשיכים משם.
      </p>
    </div>

    <ul class="svc__rail" data-svc-rail>
      {SERVICES.map((s, i) => (
        <li class="svc__card" data-reveal style={`--mo-delay:${i * 70}ms`}>
          <span class="svc__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" set:html={SERVICE_ICONS[s.slug]} />
          </span>
          <span class="svc__n tabular">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="svc__name">{s.name}</h3>
          <p class="svc__card-lead">{s.lead}</p>
          <ul class="svc__points">
            {s.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <a class="svc__go" href={`/services/${s.slug}/`}>
            לראות איך זה עובד <span class="arrow-inline" aria-hidden="true">←</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ═════════ 6. PROCESS ═════════ -->
  <section class="proc u-section band band--warm">
    <Curve tone="warm" shape="wave" flip />
    <div class="u-container u-container--wide">
      <div class="proc__head">
        <p class="t-eyebrow" data-reveal>איך זה מתנהל</p>
        <SplitLines class="t-display-2" lines={['תהליך העבודה:', 'שישה שלבים.']} step={100} />
      </div>

      <ol class="proc__list" data-stagger style="--mo-step:90ms">
        {PROCESS.map((p) => (
          <li class="proc__row" data-reveal>
            <span class="proc__n tabular">{p.n}</span>
            <h3 class="proc__t t-h2">{p.label}</h3>
            <p class="proc__d">{p.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ 7. WHAT WE BELIEVE ═════════ -->
  <!-- The reference's About block: a grid of oversized Latin words, each
       with a small Hebrew kicker above and Hebrew prose below. One word
       is struck through, which is the whole point of it. -->
  <section class="blf u-section band band--soft">
    <Curve tone="soft" shape="wave" />
    <div class="u-container u-container--wide">
      <div class="blf__head">
        <p class="t-eyebrow" data-reveal>אודות</p>
        <h2 class="blf__h t-display-3" data-reveal style="--mo-delay:80ms">
          איך אנחנו עובדים
        </h2>
      </div>

      <ul class="blf__grid">
        {beliefs.map((b, i) => (
          <li class="blf__item" data-reveal style={`--mo-delay:${i * 90}ms`}>
            <p class="blf__kicker">{b.kicker}</p>
            <p class="blf__word">{b.word}</p>
            <p class="blf__body">{b.body}</p>
          </li>
        ))}
      </ul>

      <a class="link-arrow blf__more" href="/about/" data-reveal>
        הסיפור המלא <span class="arrow-inline" aria-hidden="true">←</span>
      </a>
    </div>
  </section>

  <!-- ═════════ 8. PARTNERS TEASER ═════════ -->
  <section class="u-section band fnd">
    <Curve tone="surface" shape="slope" flip />
    <div class="u-container u-container--wide fnd__grid">
      <div class="fnd__art" data-clip>
        <PartnersJointPhoto />
      </div>

      <div class="fnd__copy">
        <p class="t-eyebrow" data-reveal>נעים להכיר</p>
        <SplitLines class="t-display-3 fnd__name" lines={['יחיאל ואיתן']} />
        <p class="fnd__role" data-reveal style="--mo-delay:120ms">השותפים מאחורי LAHAV AI</p>
        <p class="fnd__p" data-reveal style="--mo-delay:180ms">
          שני שותפים, גישה אחת: קודם להבין איך העסק עובד, אחר כך להחליט מה
          שווה לבנות.
        </p>
        <a class="link-arrow" href="/about/" data-reveal style="--mo-delay:240ms">
          עוד עלינו <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═════════ 9. CONTACT ═════════ -->
  <ContactBlock siteKey={SITE_KEY} preview={preview} />
</SiteLayout>

<style>
  /* ══════ hero ══════
     Sequence, not overlay: eyebrow, statement, then the character
     directly beneath it with the talk trigger over its lower body. The
     whole act is sized to land inside one screen. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* must clear the 86px fixed header at every viewport */
    padding-block: clamp(6.5rem, 10svh, 8rem) 0;
    overflow: clip;
  }

  .hero__inner { position: relative; z-index: 3; text-align: center; width: 100%; }
  .hero__eyebrow { margin-bottom: clamp(0.5rem, 1.2vw, 1rem); }
  /* Height-aware, not just width-aware. On a wide-but-short screen
     (1920x988, the reference recording's own viewport) a pure vw size
     eats the room the character needs, and the character is the point of
     this hero. The svh term is what keeps the whole act on one screen. */
  .hero__title {
    /* max-content, so the box hugs the glyphs. A full-width centred
       heading box reaches the hero cards at the edges even though the
       text never does, which is both untruthful layout and a real
       click-target overlap. */
    max-width: max-content;
    margin-inline: auto;
    font-size: min(8.4vw, 13.5svh, 11rem);
  }
  .hero__lead {
    max-width: 44ch;
    margin-inline: auto;
    margin-top: clamp(0.75rem, 1.6vw, 1.25rem);
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* the character claims whatever height is left below the statement */
  .hero__figure {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    /* bottom-aligned: the character stands on the fold the way the
       reference presenter stands on its floor, rather than floating in
       the middle of the leftover space */
    place-items: end center;
    width: 100%;
    padding-bottom: clamp(1.5rem, 3.5svh, 3rem);
    /* No negative margin. It was tuned for the drawn character, whose
       silhouette narrowed to a head at the top so copy could sit in the
       empty corners beside it. The presenter is a rectangular video with
       hard edges, and the same pull-up put its top edge 29px into the
       last line of the lead paragraph. */
    padding-top: clamp(0.5rem, 1.6svh, 1.25rem);
  }
  /* Height-driven, so the presenter can never push the hero past one
     screen on a short laptop. Width follows from the 3:4 source. */
  .hero__figure :global(.pr) { height: 100%; justify-content: center; }
  .hero__figure :global(.pr__figure) { width: max-content; }
  .hero__figure :global(.pr__idle) { height: min(42svh, 29vw); width: auto; }
  /* The figure HUGS the drawing rather than filling the hero column.
     While it was `height: 100%` the figure box was 576px tall on a phone
     around a 359px character, so a percentage placed inside it landed
     nowhere near the hip. `.av` still centres it vertically. */
  .hero__scroll {
    position: absolute;
    bottom: 1.25rem;
    inset-inline-start: 50%;
    width: 1px;
    height: 3rem;
    background: linear-gradient(180deg, transparent, var(--color-ink-3));
    opacity: 0.5;
    animation: hero-scroll 2.4s var(--ease-inout) infinite;
    z-index: 4;
  }
  @keyframes hero-scroll {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.2; }
    50%      { transform: scaleY(1); transform-origin: top; opacity: 0.6; }
  }

  /* ══════ marquee ══════ */
  .mq { padding-block: clamp(1.25rem, 2.5vw, 2rem); }
  .mq__item {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 3rem);
    font-weight: 900;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
  .mq__item::after {
    content: '—';
    margin-inline-start: clamp(2rem, 5vw, 5rem);
    color: var(--color-electric);
  }

  /* ══════ problem ══════ */
  .prob__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .prob__title { margin-top: 1rem; }
  .prob__list { list-style: none; margin: 0; padding: 0; }
  .prob__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    border-top: 1px solid var(--color-line);
  }
  .prob__row:last-child { border-bottom: 1px solid var(--color-line); }
  .prob__n { font-family: var(--font-display); font-weight: 700; color: var(--color-electric); font-size: var(--text-small); }
  .prob__d { color: var(--color-ink-2); max-width: 46ch; }

  /* ====== the core ====== */
  .core {
    position: relative;
    padding-block: var(--space-section);
    overflow: visible;
    text-align: center;
  }
  .core__head { position: relative; z-index: 2; }
  .core__k { color: rgba(255, 255, 255, 0.72); }
  .core__h {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-display-3);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: normal;
    margin-top: 0.75rem;
    color: #fff;
  }
  .core__h-2 { color: rgba(255, 255, 255, 0.62); }
  .core__sub {
    margin: 1rem auto 0;
    max-width: 46ch;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }

  /* The core: a lit centre with capabilities in orbit. Pure CSS, so it
     scales to any viewport and costs nothing to load. */
  .core__stage {
    position: relative;
    width: min(88vw, 34rem);
    aspect-ratio: 1;
