---
// CONTACT / DISCOVERY. Conversion page: booking is visually primary, the
// form is the fallback, WhatsApp is the third route. Composition is a
// two column split with the booking region reserved, not a marketing page.
//
// The booking provider is not chosen yet (O-7), so the region is a defined
// placeholder rather than a fake widget. No response time is promised.
export const prerender = false;

import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import { WHATSAPP_HREF, SERVICES, DISCOVERY_BOOKING_URL, DISCOVERY_CAL_LINK } from '../lib/site';
import WhatsApp from '../components/icons/WhatsApp.astro';

// The Turnstile SITE key is public by design (it is embedded in the page
// HTML for every visitor's browser). Only the SECRET key, used server-side
// in src/pages/api/contact.ts, is sensitive. Cloudflare's official
// always-pass test key is the fallback, so the form is fully testable
// before a real Turnstile widget is created in the client's own dashboard.
const TURNSTILE_SITE_KEY = (env as any).TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const url = new URL(Astro.request.url);
const sent = url.searchParams.get('sent') === '1';
const errorCode = url.searchParams.get('error');
const ERROR_MESSAGES: Record<string, string> = {
  validation: 'משהו בטופס לא תקין. אפשר לבדוק את הפרטים ולנסות שוב.',
  turnstile: 'לא הצלחנו לאמת שמדובר באדם. אפשר לרענן ולנסות שוב.',
  rate_limited: 'יותר מדי ניסיונות בזמן קצר. אפשר לנסות שוב בעוד כמה דקות.',
  bad_request: 'הבקשה לא התקבלה. אפשר לנסות שוב.',
};
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? 'לא הצלחנו לשלוח. אפשר לנסות שוב.') : null;
---

<SiteLayout
  title="צור קשר ותיאום שיחת היכרות | LAHAV AI"
  description="תכתבו לנו איפה זה נתקע. שיחת היכרות של 30 דקות, או פשוט השאירו פרטים ונחזור אליכם."
>
  <section class="ct-hero band band--hero">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>צור קשר</p>
      <h1 class="t-display-1 ct-hero__h1">
        <span class="mo-line" style="--mo-delay:80ms"><span>תכתבו לנו</span></span>
        <span class="mo-line" style="--mo-delay:180ms"><span class="ct-hero__accent">איפה זה נתקע.</span></span>
      </h1>
      <p class="ct-hero__lead" data-reveal style="--mo-delay:300ms">
        לא צריך להתכונן או לדעת מראש מה רוצים לבנות. מספיק לספר מה קורה
        היום.
      </p>
    </div>
  </section>

  <section class="ct-sec band">
    <div class="u-container u-container--wide ct-grid">
      <!-- PRIMARY: booking -->
      <div class="ct-primary" data-reveal>
        <div class="ct-primary__head">
          <span class="chip">הדרך המומלצת</span>
          <h2 class="ct-primary__h">שיחת היכרות</h2>
          <p class="ct-primary__lead">
            30 דקות, בזום או בטלפון. בלי מצגות, בלי הכנה מצדכם, ובלי התחייבות.
          </p>
        </div>

        <!-- The live booking calendar, embedded inline via Cal.com's own
             loader. Visitors book without leaving the site. If the widget
             script cannot load for any reason (network policy, blocker),
             the plain link right below it still opens the real calendar
             in its own tab, so there is never a dead end here. -->
        <div class="ct-booking">
          <div id="lahav-discovery-cal" class="ct-cal"></div>
          <a
            class="ct-booking__fallback"
            href={DISCOVERY_BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            אם היומן לא נטען, אפשר לפתוח אותו ישירות בלשונית חדשה
            <span class="arrow-inline" aria-hidden="true">←</span>
          </a>
        </div>

        <ul class="ct-what">
          <li>נבין איך העסק שלכם עובד היום</li>
          <li>נבין איפה מצטברת העבודה הידנית</li>
          <li>נגיד מה לדעתנו שווה לעשות, וגם מה ממש לא</li>
        </ul>

        <a class="btn btn-secondary ct-wa" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
          <WhatsApp />
          מעדיפים וואטסאפ? זה בסדר גמור.
        </a>
      </div>

      <!-- SECONDARY: form -->
      <div class="ct-form-wrap" data-reveal>
        <h2 class="ct-form__title">או פשוט השאירו פרטים</h2>
        <p class="ct-form__sub">נחזור אליכם ונתאם משם.</p>

        <div
          class:list={['ct-status', sent && 'is-success', errorMessage && 'is-error']}
          data-ct-status
          role="status"
          aria-live="polite"
          hidden={!sent && !errorMessage}
        >
          {sent && 'קיבלנו. נחזור אליכם.'}
          {errorMessage}
        </div>

        <form class="ct-form" method="post" action="/api/contact" novalidate data-ct-form>
          <div class="field">
            <label class="field-label" for="name">שם מלא</label>
            <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>

          <div class="field">
            <label class="field-label" for="phone">טלפון</label>
            <input class="input input-ltr" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" />
          </div>

          <div class="field">
            <label class="field-label" for="email">אימייל</label>
            <input class="input input-ltr" id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>

          <div class="field">
            <label class="field-label" for="service">מה מעניין אתכם</label>
            <select class="input" id="service" name="service">
              <option value="">עוד לא בטוח</option>
              {SERVICES.map((s) => <option value={s.slug}>{s.name}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="message">מה תקוע היום?</label>
            <textarea class="input" id="message" name="message" rows="4" required maxlength="4000"></textarea>
            <span class="field-hint">כמה מילים על מה שקורה היום יעזרו לנו להתכונן.</span>
          </div>

          <!-- Honeypot: invisible to a real visitor and to screen readers,
               but a plain text field a bot's autofill will often try to
               complete. Filling it silently drops the submission. -->
          <div class="ct-trap" aria-hidden="true">
            <label for="website_url">Website</label>
            <input
              id="website_url"
              name="website_url"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <input type="hidden" name="form_rendered_at" value={Date.now()} data-ct-rendered-at />

          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-ct-turnstile></div>

          <button class="btn btn-primary ct-submit" type="submit" data-ct-submit>שלחו ונחזור אליכם</button>

          <p class="ct-form__note">הפרטים מגיעים אלינו ישירות.</p>
        </form>
      </div>
    </div>
  </section>
</SiteLayout>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<!-- Cal.com inline embed. This is Cal's own official loader (verified
     against their public source, packages/embeds/embed-snippet), not a
     custom integration: it lazily fetches their embed script the first
     time Cal(...) is called, then renders the real calendar into the
     target div below. Free, no server involved, no floating widget. -->
<script is:inline define:vars={{ calLink: DISCOVERY_CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://cal.com/embed.js', 'init');

  Cal('init', { origin: 'https://cal.com' });
  Cal('inline', {
    elementOrSelector: '#lahav-discovery-cal',
    calLink: calLink,
    // column_view keeps the calendar and the time slots side by side, so
    // picking a day does not stack a long list of times underneath and
    // push the rest of the page down. month_view did exactly that.
    config: { layout: 'column_view' },
  });
</script>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-ct-form]');
    if (!form) return;
    const status = document.querySelector('[data-ct-status]');
    const submitBtn = form.querySelector('[data-ct-submit]');
    const renderedAtInput = form.querySelector('[data-ct-rendered-at]');
    // the hidden timestamp is set from server-render time in the HTML
    // already; nothing to do here besides leaving it untouched

    function showStatus(kind, text) {
      if (!status) return;
      status.hidden = false;
      status.textContent = text;
      status.classList.toggle('is-success', kind === 'success');
      status.classList.toggle('is-error', kind === 'error');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'שולח...';
      }

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          showStatus('success', 'קיבלנו. נחזור אליכם.');
          form.reset();
          if (renderedAtInput) renderedAtInput.value = String(Date.now());
          if (window.turnstile) window.turnstile.reset();
        } else {
          showStatus('error', data.error || 'לא הצלחנו לשלוח. אפשר לנסות שוב.');
          if (window.turnstile) window.turnstile.reset();
        }
      } catch {
        showStatus('error', 'לא הצלחנו לשלוח. אפשר לנסות שוב.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'שלחו ונחזור אליכם';
        }
      }
    });
  })();
</script>

<style>
  .ct-hero {
    padding-top: clamp(7rem, 12svh, 9.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .ct-hero__h1 {
    display: flex;
    flex-direction: column;
    margin-block: 1.25rem 1.75rem;
  }
  .ct-hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ct-hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 48ch;
  }

  .ct-sec { padding-block: 0 var(--space-section); }
  .ct-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  /* Primary card carries the visual weight */
  .ct-primary {
    background: linear-gradient(158deg, #17347f 0%, #1d4ed8 55%, #2564e0 100%);
    color: rgba(255, 255, 255, 0.82);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }
  .ct-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(700px 380px at 85% 0%, rgba(41, 151, 255, 0.24), transparent 62%);
  }
  .ct-primary > * {
    position: relative;
  }
  .ct-primary__h {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: normal;
    color: #fff;
    margin-block: 0.875rem 0.75rem;
  }
  .ct-primary__lead {
    color: rgba(255, 255, 255, 0.74);
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }
  .ct-booking {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* The widget paints its own white background, so this is a light card
     framed inside the dark primary panel, the same relationship the old
     placeholder box had. Cal.com auto-resizes its iframe to the full
     height of whatever it renders (a month grid plus every time slot for
     the picked day stacks vertically), which was pushing the whole
     contact page down. A fixed height with its own scrollbar keeps the
     card a fixed, predictable size regardless of how tall Cal's content
     gets. */
  .ct-cal {
    width: 100%;
    height: 34rem;
    border-radius: var(--radius-lg);
    overflow-y: auto;
    overflow-x: hidden;
    background: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }
  .ct-booking__fallback {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-micro);
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  .ct-booking__fallback:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ct-what {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ct-what li {
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.8);
    padding-inline-start: 1.5rem;
    position: relative;
    line-height: 1.55;
  }
  .ct-what li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-electric);
  }
  .ct-wa {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    width: 100%;
  }
  .ct-wa:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Form is deliberately quieter */
  .ct-form__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: normal;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
  }
  .ct-form__sub {
    font-size: var(--text-small);
    color: var(--color-ink-3);
    margin-bottom: 1.75rem;
  }
  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ct-submit {
    margin-top: 0.5rem;
    align-self: flex-start;
  }
  .ct-form__note {
    font-size: var(--text-micro);
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-line-strong);
    padding-inline-start: 0.875rem;
  }

  /* Honeypot: off-screen but not display:none, so it still reads as a
     real field to unsophisticated bots while being unreachable and
     invisible for a real visitor or a screen reader. */
  .ct-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .ct-status {
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.6;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md, 0.75rem);
    margin-bottom: 1.25rem;
  }
  .ct-status.is-success {
    background: #e7f6ec;
    color: #15803d;
    border: 1px solid #bfe6cc;
  }
  .ct-status.is-error {
    background: #fdf2f2;
    color: var(--color-error);
    border: 1px solid #e5b4b4;
  }

  @media (max-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr;
    }
    .ct-submit {
      width: 100%;
    }
    .ct-cal {
      height: 30rem;
    }
  }
</style>
