---
// 404, V3. Short and elegant, as instructed. One small branded
// broken-flow visual and clear routes back. No business claims, no
// cinematic page.
//
// Composition matches the rest of the site: an oversized ghost number
// behind display type, then the ways out as hairline rows rather than a
// centred row of buttons.
import SiteLayout from '../layouts/SiteLayout.astro';
import Viz from '../components/Viz.astro';
import { CTA_PRIMARY } from '../lib/site';

const routes = [
  { href: '/', label: 'לדף הבית', note: 'מה אנחנו עושים, בקצרה' },
  { href: '/services/', label: 'לשירותים', note: 'חמישה תחומים, אפשר להתחיל מהבעיה' },
  { href: '/articles/', label: 'למאמרים', note: 'AI, אוטומציה ומערכות עסקיות' },
  { href: CTA_PRIMARY.href, label: CTA_PRIMARY.label, note: '30 דקות, בלי התחייבות' },
];
---

<SiteLayout title="הדף לא נמצא | LAHAV AI" description="הקישור שהגעתם אליו לא קיים.">
  <section class="nf band band--hero">
    <span class="nf__ghost tabular" aria-hidden="true">404</span>

    <div class="u-container u-container--wide nf__inner">
      <div class="nf__type">
        <p class="t-eyebrow" data-reveal>404</p>
        <h1 class="nf__title">
          <span class="mo-line" style="--mo-delay:70ms"><span>הקישור הזה</span></span>
          <span class="mo-line" style="--mo-delay:170ms"><span class="nf__accent">לא מוביל לשום מקום.</span></span>
        </h1>
        <p class="nf__lead" data-reveal style="--mo-delay:280ms">
          כנראה שהעמוד הוסר או שהכתובת השתנתה. אפשר להמשיך מכאן.
        </p>

        <ul class="nf__routes">
          {routes.map((r, i) => (
            <li class="nf__route" data-reveal style={`--mo-delay:${340 + i * 70}ms`}>
              <a href={r.href}>
                <span class="nf__label">{r.label}</span>
                <span class="nf__note">{r.note}</span>
                <span class="nf__arrow arrow-inline" aria-hidden="true">←</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nf__art" data-clip>
        <Viz kind="broken" />
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6.5rem, 10svh, 8.5rem) var(--space-section-end);
  }
  /* the number is scenery, not content: it sits behind everything and is
     hidden from assistive tech */
  .nf__ghost {
    position: absolute;
    /* pushed clear of the reading column: it used to sit on top of the
       lead paragraph and the route list */
    /* fully clear of the reading column: it kept landing on the title
       and the lead at tablet and desktop widths */
    inset-block-start: 62%;
    inset-inline-start: -22vw;
    font-family: var(--font-display);
    font-size: clamp(12rem, 34vw, 34rem);
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.05em;
    color: var(--color-ink);
    opacity: 0.03;
    pointer-events: none;
    user-select: none;
  }
  .nf__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 6vw, 5rem);
    /* start, not center: centring the short type column against the tall
       art column opened a 250px band above the eyebrow on a tablet */
    align-items: start;
  }
  .nf__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-block: 1rem 1.5rem;
  }
  .nf__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf__lead {
    font-size: var(--text-lead);
    color: var(--color-ink-2);
    max-width: 42ch;
  }

  .nf__routes {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    max-width: 34rem;
  }
  .nf__route { border-top: 1px solid var(--color-line-strong); }
  .nf__route:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .nf__route a {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    text-decoration: none;
    color: inherit;
  }
  .nf__label {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    transition: color var(--dur) var(--ease-out);
  }
  .nf__route:hover .nf__label { color: var(--color-royal); }
  .nf__note { font-size: var(--text-small); color: var(--color-ink-3); }
  .nf__arrow { color: var(--color-royal); justify-self: end; }
  .nf__route:hover .nf__arrow { transform: translateX(-5px); }

  /* the broken-flow art is drawn for dark surfaces, so it gets its own
     dark stage rather than washing out on the light band */
  .nf__art {
    background: var(--color-navy);
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (max-width: 900px) {
    /* No room beside the reading column on a phone, so the watermark
       stops competing with the route list entirely. */
    .nf__ghost { display: none; }
    .nf__inner { grid-template-columns: 1fr; }
    .nf__art { order: -1; }
    .nf__note { display: none; }
    .nf__route a { grid-template-columns: minmax(0, 1fr) 1.25rem; }
  }
</style>
