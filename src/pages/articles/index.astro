---
// ARTICLES INDEX. Deliberately small and editorial. V1 launches with only
// 2-3 real articles (F-8), so there is no category system, no filters, no
// pagination and no fake archive. One list, generous type.
//
// D-Q3: the nav link stays hidden until real approved articles exist, so
// this page is reachable by direct link only for now.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { ARTICLES } from '../../lib/site';
---

<SiteLayout
  title="מאמרים | LAHAV AI"
  description="כתיבה קצרה ומעשית על סדר בעסק, אוטומציה ומערכות. בלי ז׳רגון."
>
  <ScrollReveal />

  <section class="ar-hero">
    <div class="u-container">
      <p class="t-eyebrow">מאמרים</p>
      <h1 class="t-display-2 ar-hero__h1">כתיבה קצרה על סדר בעסק</h1>
      <p class="ar-hero__lead">
        לא בלוג שמפרסם כל יום. כשיש משהו מעשי להגיד על תהליכים, מערכות
        ואוטומציה, אנחנו כותבים אותו כאן.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="u-container">
      {
        ARTICLES.length === 0 ? (
          <div class="ar-empty">
            <p class="ar-empty__title">עוד לא פרסמנו כאן</p>
            <p class="ar-empty__body">
              המאמרים הראשונים בדרך. בינתיים, אם יש שאלה ספציפית על העסק שלכם,
              עדיף פשוט לדבר.
            </p>
          </div>
        ) : (
          <ul class="ar-list">
            {ARTICLES.map((a, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a class="ar-item" href={`/articles/${a.slug}/`}>
                  <span class="ar-item__meta tabular">{a.date}</span>
                  <span class="ar-item__body">
                    <span class="ar-item__title">{a.title}</span>
                    <span class="ar-item__sum">{a.summary}</span>
                  </span>
                  <span class="arrow-inline ar-item__arr" aria-hidden="true">←</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <ClosingCta
    heading="יש שאלה שנוגעת דווקא לעסק שלכם?"
    body="שיחה של 30 דקות בדרך כלל עוזרת יותר מכל מאמר."
  />
</SiteLayout>

<style>
  .ar-hero {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ar-hero__h1 {
    margin-block: 1rem 1.25rem;
  }
  .ar-hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 54ch;
  }

  .ar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .ar-list li {
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 100ms),
      translate 600ms var(--ease-out) calc(var(--i) * 100ms);
  }
  :global(html.reveal-ready) .ar-list li {
    opacity: 0;
    translate: 0 14px;
  }
  :global(html.reveal-ready) .ar-list li.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .ar-item {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-out);
  }
  .ar-item:hover {
    background: var(--color-surface-2);
  }
  .ar-item__meta {
    font-size: var(--text-micro);
    color: var(--color-ink-3);
    font-weight: 600;
  }
  .ar-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ar-item__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .ar-item__sum {
    font-size: var(--text-small);
    color: var(--color-ink-2);
    line-height: 1.6;
    max-width: 60ch;
  }
  .ar-item__arr {
    color: var(--color-royal);
    font-weight: 700;
  }

  .ar-empty {
    border: 1px solid var(--color-line);
    border-inline-start: 3px solid var(--color-electric);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 52rem;
    background: var(--color-surface-2);
  }
  .ar-empty__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .ar-empty__body {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  @media (max-width: 760px) {
    .ar-item {
      grid-template-columns: 1fr auto;
      gap: 0.75rem 1rem;
    }
    .ar-item__meta {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ar-list li {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
