---
export const prerender = false;

// ARTICLES INDEX. Editorial, not a card grid: one featured piece carrying
// a real visual, then two secondary entries.
//
// Deliberately absent: filters, search, categories, pagination, post
// counts, view counts, share counts, author bylines. V1 launches with a
// handful of articles (F-8) and nothing here should imply an archive that
// does not exist.
//
// The three articles below are REVIEW PLACEHOLDERS, marked as such.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import Viz from '../../components/Viz.astro';

import { ARTICLE_KINDS } from '../../lib/cms/types.ts';

// Everything below is derived. Adding an article means adding it to
// ARTICLES with a `kind`; where it appears and how it is labelled follows
// from that, with nothing to maintain by hand.
// Only published articles. Drafts are invisible here by construction.
const ARTICLES = await Astro.locals.stores!.articles.list({ status: 'published' });
const guides = ARTICLES.filter((a) => a.kind === 'guide');
const hacks = ARTICLES.filter((a) => a.kind === 'hack');
const featured = guides.find((a) => a.featured) ?? guides[0];
const rest = guides.filter((a) => a.slug !== featured?.slug);
---

<SiteLayout
  title="מאמרים | LAHAV AI"
  description="כתיבה קצרה ומעשית על סדר בעסק, אוטומציה ומערכות. בלי ז׳רגון."
  noindex
>
  <ScrollReveal />

  <div class="rv-flag">
    <div class="u-container">
      מאמרים לדוגמה, לצורכי סקירת העיצוב בלבד. לא פורסמו ולא אושרו כתוכן עסקי.
    </div>
  </div>

  <section class="ar-hero">
    <div class="u-container ar-hero__in">
      <p class="t-eyebrow">מאמרים</p>
      <h1 class="ar-hero__h1">
        <span>דברים שכדאי לדעת</span>
        <span class="ar-hero__h1b">לפני שבונים משהו</span>
      </h1>
      <p class="ar-hero__lead">
        לא בלוג שמפרסם כל יום. כשיש משהו מעשי להגיד על תהליכים, מערכות
        ואוטומציה, אנחנו כותבים אותו כאן. בשפה של בעל עסק, לא של מתכנת.
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="feat" data-reveal>
        <div class="u-container">
          <a class="feat__a" href={`/articles/${featured.slug}/`}>
            <div class="feat__art on-dark">
              <Viz kind={featured.viz as any} />
            </div>
            <div class="feat__txt">
              <p class="feat__k">
                <span class="feat__lead-tag">{ARTICLE_KINDS[featured.kind].label}</span>
                <span class="feat__topic">{featured.topic}</span>
              </p>
              <h2 class="feat__t">{featured.title}</h2>
              <p class="feat__x">{featured.excerpt}</p>
              <p class="feat__act">
                <span class="feat__read">לקריאה</span>
                <span class="arrow-inline" aria-hidden="true">
                  ←
                </span>
                <span class="feat__time">{featured.readingTime}</span>
              </p>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="rest">
    <div class="u-container">
      <ul class="rest__list">
        {
          rest.map((a, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="rest__a" href={`/articles/${a.slug}/`}>
                <span class="rest__k">
                  <span class="rest__topic">{a.topic}</span>
                  <span class="rest__time">{a.readingTime}</span>
                </span>
                <span class="rest__t">{a.title}</span>
                <span class="rest__x">{a.excerpt}</span>
                <span class="rest__act">
                  לקריאה
                  <span class="arrow-inline" aria-hidden="true">
                    ←
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    hacks.length > 0 && (
      <section class="hax">
        <div class="u-container">
          <div class="hax__head">
            <div>
              <p class="t-eyebrow">טיפים מהירים</p>
              <h2 class="hax__h">דברים קטנים ב-AI שאפשר לעשות היום</h2>
            </div>
            <p class="hax__lead">
              כלים חינמיים, טריקים קצרים ודברים חדשים שכדאי להכיר. בלי להתקין
              כלום ובלי לשלם, ובלי להיות טכנולוגיים.
            </p>
          </div>

          <ul class="hax__list">
            {hacks.map((a, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a class="hax__a" href={`/articles/${a.slug}/`}>
                  <span class="hax__tag">{ARTICLE_KINDS[a.kind].label}</span>
                  <span class="hax__t">{a.title}</span>
                  <span class="hax__x">{a.excerpt}</span>
                  <span class="hax__act">
                    {a.readingTime}
                    <span class="arrow-inline" aria-hidden="true">
                      ←
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ClosingCta
    heading="יש שאלה שנוגעת דווקא לעסק שלכם?"
    body="שיחה של 30 דקות בדרך כלל עוזרת יותר מכל מאמר."
  />
</SiteLayout>

<style>
  .rv-flag {
    background: #fff4e5;
    border-bottom: 1px solid #f0c98a;
    color: #8a5300;
    font-size: var(--text-small);
    font-weight: 600;
    padding-block: 0.75rem;
  }

  /* ---- Hero ---- */
  .ar-hero {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .ar-hero__h1 {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.2rem + 5.4vw, 5.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-block: 1.25rem 1.5rem;
  }
  .ar-hero__h1b {
    color: var(--color-electric);
  }
  .ar-hero__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 40rem;
  }

  /* ---- Featured ---- */
  .feat {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .feat__a {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    text-decoration: none;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl, 1.5rem);
    background: var(--color-surface-2);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .feat__a:hover {
    border-color: var(--color-electric);
    box-shadow: var(--shadow-lg);
  }
  .feat__art {
    background: var(--color-navy);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  .feat__k {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .feat__lead-tag {
    font-size: var(--text-micro);
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--color-royal);
    border-radius: 999px;
    padding: 0.3125rem 0.75rem;
  }
  .feat__topic {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
  }
  .feat__t {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.875rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .feat__x {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-ink-2);
    margin-bottom: 1.5rem;
    max-width: 34rem;
  }
  .feat__act {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-electric);
  }
  .feat__time {
    margin-inline-start: 0.5rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink-3);
  }

  /* ---- Secondary ---- */
  .rest {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .rest__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .rest__list li {
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 110ms),
      translate 600ms var(--ease-out) calc(var(--i) * 110ms);
  }
  :global(html.reveal-ready) .rest__list li {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .rest__list li.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .rest__a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    background: #fff;
    transition:
      border-color var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .rest__a:hover {
    border-color: var(--color-electric);
    translate: 0 -4px;
  }
  .rest__k {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .rest__topic {
    color: var(--color-electric);
  }
  .rest__time {
    color: var(--color-ink-3);
    font-weight: 600;
  }
  .rest__t {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .rest__x {
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-ink-2);
    flex: 1;
  }
  .rest__act {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 700;
    color: var(--color-electric);
    margin-top: 0.25rem;
  }

  /* ---- Quick AI tips ----
     A visibly different format from the guides above: darker, tighter,
     more "here is a thing you can do now" than "here is how to think". */
  .hax {
    background: var(--color-navy);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hax__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: end;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .hax__h {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: 0.75rem;
  }
  .hax__lead {
    font-size: var(--text-body-lg);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
  }
  .hax__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .hax__list li {
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 110ms),
      translate 600ms var(--ease-out) calc(var(--i) * 110ms);
  }
  :global(html.reveal-ready) .hax__list li {
    opacity: 0;
    translate: 0 16px;
  }
  :global(html.reveal-ready) .hax__list li.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .hax__a {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.875rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }
  .hax__a:hover {
    border-color: var(--color-electric);
    background: rgba(41, 151, 255, 0.09);
  }
  .hax__tag {
    align-self: flex-start;
    font-size: var(--text-micro);
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-navy);
    background: var(--color-electric);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
  }
  .hax__t {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
  }
  .hax__x {
    font-size: var(--text-small);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
    flex: 1;
  }
  .hax__act {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
  }

  @media (max-width: 900px) {
    .feat__a {
      grid-template-columns: 1fr;
    }
    .rest__list,
    .hax__list,
    .hax__head {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rest__list li {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
