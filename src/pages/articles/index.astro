---
export const prerender = false;

// ARTICLES INDEX, V3.
//
// Rebuilt as an editorial journal in the same language as the rest of the
// site: a type-led opener, one lead piece given real scale, then the rest
// as oversized hairline rows that behave on hover. No card grid.
//
// Deliberately absent: filters, search, categories, pagination, post
// counts, view counts, share counts. V1 launches with a handful of
// articles (F-8) and nothing here should imply an archive that does not
// exist.
//
// Data contract is unchanged: published articles only, straight from the
// CMS store, drafts invisible by construction.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import Viz from '../../components/Viz.astro';
import { ARTICLE_KINDS } from '../../lib/cms/types.ts';

const SITE_KEY = turnstileSiteKey();
const ARTICLES = await Astro.locals.stores!.articles.list({ status: 'published' });
const guides = ARTICLES.filter((a) => a.kind === 'guide');
const featured = guides.find((a) => a.featured) ?? guides[0] ?? ARTICLES[0];
const rest = ARTICLES.filter((a) => a.slug !== featured?.slug);
const anyPlaceholder = ARTICLES.some((a) => a.isPlaceholder);
---

<SiteLayout
  title="מאמרים | LAHAV AI"
  description="מאמרים על AI, אוטומציה ומערכות עסקיות, עם דגש על מה שאפשר לקחת לעבודה."
  noindex={anyPlaceholder}
>
  {anyPlaceholder && (
    <div class="rv-flag">
      <div class="u-container u-container--wide">
        חלק מהמאמרים כאן הם תוכן לדוגמה, לצורכי סקירת העיצוב בלבד.
      </div>
    </div>
  )}

  <!-- ═════════ opener ═════════ -->
  <section class="ar-hero band band--hero">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>מאמרים</p>
      <h1 class="ar-hero__h1 t-display-1">
        <span class="mo-line" style="--mo-delay:80ms"><span>דברים שכדאי לדעת</span></span>
        <span class="mo-line" style="--mo-delay:190ms"><span class="ar-hero__accent">לפני שבונים.</span></span>
      </h1>
      <p class="ar-hero__lead" data-reveal style="--mo-delay:380ms">
        מאמרים על AI, אוטומציה ומערכות עסקיות, עם דגש על מה שאפשר לקחת
        לעבודה.
      </p>
    </div>
  </section>

  <!-- ═════════ lead piece ═════════ -->
  {featured && (
    <section class="feat band">
      <div class="u-container u-container--wide">
        <a class="feat__link" href={`/articles/${featured.slug}/`}>
          <div class="feat__art" data-clip>
            <div class="feat__stage on-dark">
              <Viz kind={featured.viz as any} />
            </div>
          </div>

          <div class="feat__copy">
            <p class="feat__kick">
              <span class="feat__kind">{ARTICLE_KINDS[featured.kind]?.label ?? featured.kind}</span>
              <span class="feat__topic">{featured.topic}</span>
              <span class="feat__time">{featured.readingTime}</span>
            </p>
            <h2 class="feat__t t-display-3" data-reveal>{featured.title}</h2>
            <p class="feat__x" data-reveal style="--mo-delay:110ms">{featured.excerpt}</p>
            <span class="link-arrow feat__go">
              לקריאה <span class="arrow-inline" aria-hidden="true">←</span>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ═════════ the rest, as editorial rows ═════════ -->
  {rest.length > 0 && (
    <section class="rows u-section band band--soft">
      <div class="u-container u-container--wide">
        <p class="t-eyebrow rows__k" data-reveal>עוד באותו נושא</p>
        <ul class="rows__list" data-stagger style="--mo-step:80ms">
          {rest.map((a, i) => (
            <li class="rows__row" data-reveal>
              <a class="rows__link" href={`/articles/${a.slug}/`}>
                <span class="rows__n tabular">{String(i + 1).padStart(2, '0')}</span>
                <span class="rows__main">
                  <span class="rows__meta">
                    <span class="rows__kind">{ARTICLE_KINDS[a.kind]?.label ?? a.kind}</span>
                    <span class="rows__topic">{a.topic}</span>
                    <span class="rows__time">{a.readingTime}</span>
                  </span>
                  <span class="rows__t">{a.title}</span>
                  <span class="rows__x">{a.excerpt}</span>
                </span>
                <span class="rows__arrow arrow-inline" aria-hidden="true">←</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {ARTICLES.length === 0 && (
    <section class="u-section band">
      <div class="u-container u-container--wide">
        <p class="t-lead">עוד אין כאן מאמרים.</p>
      </div>
    </section>
  )}

  <ContactBlock siteKey={SITE_KEY}
  />
</SiteLayout>

<style>
  .rv-flag {
    background: #fff4e5;
    border-bottom: 1px solid #f0c98a;
    color: #8a5300;
    font-size: var(--text-small);
    font-weight: 600;
    padding-block: 0.75rem;
    /* sits under the fixed header */
    padding-top: calc(0.75rem + 84px);
  }

  /* ══════ opener ══════ */
  .ar-hero {
    padding-top: clamp(8rem, 16svh, 12rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .rv-flag + .ar-hero { padding-top: clamp(3rem, 6vw, 5rem); }
  .ar-hero__h1 { display: flex; flex-direction: column; margin-block: 1rem 2rem; }
  .ar-hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .ar-hero__lead { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 46ch; }

  /* ══════ lead piece ══════ */
  .feat { padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem); }
  .feat__link {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .feat__art {
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  /* The site diagrams are authored for dark surfaces; on white they wash
     out completely. Same navy stage the article figures use. */
  .feat__stage {
    background: var(--color-navy);
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .feat__link:hover .feat__art { transform: scale(1.015); }
  .feat__kick {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem;
    font-size: var(--text-micro); font-weight: 700; margin-bottom: 1rem;
  }
  .feat__kind {
    color: #fff; background: var(--color-royal);
    border-radius: 999px; padding: 0.25rem 0.7rem; letter-spacing: 0.04em;
  }
  .feat__topic { color: var(--color-electric); letter-spacing: 0.06em; }
  .feat__time { color: var(--color-ink-3); }
  .feat__t { transition: color var(--dur) var(--ease-out); }
  .feat__link:hover .feat__t { color: var(--color-royal); }
  .feat__x { margin-top: 1rem; color: var(--color-ink-2); max-width: 46ch; }
  .feat__go { margin-top: 1.5rem; }

  /* ══════ rows ══════ */
  .rows { padding-top: clamp(3rem, 6vw, 5rem); }
  .rows__k { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .rows__list { list-style: none; margin: 0; padding: 0; }
  .rows__row { border-top: 1px solid var(--color-line-strong); }
  .rows__row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .rows__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 2.8vw, 2.5rem);
    text-decoration: none; color: inherit;
    transition: padding-inline var(--dur) var(--ease-out);
  }
  /* the row nudges toward the reading direction on hover */
  .rows__row:hover .rows__link { padding-inline-end: 0.75rem; }
  .rows__n { font-family: var(--font-display); font-weight: 700; color: var(--color-electric); font-size: var(--text-small); }
  .rows__main { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .rows__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; font-size: var(--text-micro); font-weight: 700; }
  .rows__kind { color: var(--color-royal); }
  .rows__topic { color: var(--color-electric); letter-spacing: 0.06em; }
  .rows__time { color: var(--color-ink-3); }
  .rows__t {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2.5rem);
    font-weight: 800; line-height: 1.12; letter-spacing: -0.015em;
    transition: color var(--dur) var(--ease-out);
  }
  .rows__row:hover .rows__t { color: var(--color-royal); }
  .rows__x { font-size: var(--text-small); color: var(--color-ink-3); max-width: 62ch; }
  .rows__arrow { color: var(--color-royal); justify-self: end; }
  .rows__row:hover .rows__arrow { transform: translateX(-5px); }

  @media (max-width: 900px) {
    .feat__link { grid-template-columns: 1fr; }
    .rows__link { grid-template-columns: 2.5rem 1fr 1.25rem; gap: 0.875rem; }
  }
</style>
