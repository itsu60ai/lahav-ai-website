---
// ABOUT, V3.
//
// Rebuilt to the same editorial language as Home, using the reference's
// story-page rhythm: a full-height type opener, a pinned portrait beside
// a scrolling first-person statement, a full-bleed contrast band for the
// belief, an oversized watermark section for the principles, then the
// approach as a diagram.
//
// Every factual sentence still traces to APPROVED_COPY.md or F-14.
// No years, no clients, no credentials, no employment history, no
// numbers of any kind.
import SiteLayout from '../layouts/SiteLayout.astro';
import SplitLines from '../components/SplitLines.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Viz from '../components/Viz.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import Avatar from '../components/Avatar.astro';
import { FOUNDER, PROCESS, SERVICES } from '../lib/site';

// The three beliefs. Short, declarative, one idea each: the reference
// states its principles as headline-sized statements with a single
// supporting line underneath.
const beliefs = [
  {
    k: 'Process first',
    t: 'קודם התהליך.',
    d: 'לא מתחילים מכלי. מתחילים מאיפה העבודה נתקעת, מה גוזל זמן, ומה חייב להיות פשוט יותר.',
  },
  {
    k: 'You decide',
    t: 'ההחלטות שלכם.',
    d: 'מה שחוזר על עצמו רץ לבד. כל מה שדורש שיקול דעת ממשיך להגיע אליכם, לא למערכת.',
  },
  {
    k: 'Say it straight',
    t: 'בלי מילים גדולות.',
    d: 'נגיד מה שווה לעשות, וגם מה ממש לא. גם כשהתשובה היא שלא צריך אותנו.',
  },
];

const guideLines = [
  'קודם נבין איפה העבודה נתקעת.',
  'ההחלטות תמיד נשארות אצלכם.',
  'ונגיד בכנות גם מה לא כדאי.',
];
---

<SiteLayout
  title="אודות | LAHAV AI"
  description="LAHAV AI מתמחה בתכנון ובהקמה של מערכות חכמות לעסקים. מתחילים מהתהליך העסקי, ורק אחר כך בוחרים טכנולוגיה."
>
  <!-- ═════════ 1. OPENER: type owns the screen ═════════ -->
  <section class="ab-hero band band--hero">
    <div class="u-container u-container--wide">
      <p class="t-eyebrow" data-reveal>אודות</p>
      <h1 class="ab-hero__h1 t-display-1">
        <span class="mo-line" style="--mo-delay:70ms"><span class="t-latin ab-hero__latin">Tools were never the problem.</span></span>
        <span class="mo-line" style="--mo-delay:170ms"><span>לא חסרים כלים.</span></span>
        <span class="mo-line" style="--mo-delay:270ms"><span class="ab-hero__accent">חסר שהם ידברו.</span></span>
      </h1>
      <p class="ab-hero__lead" data-reveal style="--mo-delay:380ms">
        מהמשפט הזה נולדה LAHAV AI, והוא עדיין נקודת הפתיחה של כל פרויקט.
      </p>
    </div>
    <span class="ab-hero__cue" aria-hidden="true"></span>
  </section>

  <!-- ═════════ 2. PINNED PORTRAIT + SCROLLING STATEMENT ═════════ -->
  <section class="ab-story band" data-swap-root>
    <div class="u-container u-container--wide ab-story__grid">
      <aside class="ab-story__side">
        <div class="mo-sticky ab-story__pin">
          <div class="ab-story__art" data-clip>
            <FounderPortrait scale="about" sizes="(max-width: 1024px) 60vw, 26rem" />
          </div>
          <p class="ab-story__name">{FOUNDER.name}</p>
          <p class="ab-story__role">{FOUNDER.role}</p>
        </div>
      </aside>

      <div class="ab-story__text">
        <p class="ab-story__p ab-story__p--lead" data-swap-index="0" data-reveal>
          הקמתי את LAHAV AI בגלל משהו שראיתי חוזר בעסק אחרי עסק: כמעט תמיד לא
          חסרים כלים. חסר שהם ידברו.
        </p>
        <p class="ab-story__p" data-swap-index="1" data-reveal>
          המידע מתפזר. העבודה הידנית מצטברת. ודברים שהיו פשוטים כשהייתם שלושה
          נהיים מסורבלים כשאתם חמישה עשר.
        </p>
        <p class="ab-story__p" data-swap-index="2" data-reveal>
          לכן אני מתחיל מהעסק, לא מהטכנולוגיה. קודם נשב ונבין איפה העבודה
          נתקעת ומה גוזל לכם את הזמן.
        </p>
        <p class="ab-story__p" data-reveal>
          רק אחר כך נבחר כלים ונבנה את המערכת שמתאימה לתהליך, ולא הפוך. זה
          נשמע מובן מאליו, וזה כמעט אף פעם לא מה שקורה.
        </p>
      </div>
    </div>
  </section>

  <!-- ═════════ 3. BELIEFS: full-bleed contrast band ═════════ -->
  <section class="ab-belief u-section band band--blue">
    <span class="ab-belief__ghost t-ghost" aria-hidden="true" data-parallax="0.2">HOW WE WORK</span>

    <div class="u-container u-container--wide ab-belief__inner">
      <div class="ab-belief__head">
        <p class="t-eyebrow" data-reveal>איך אנחנו עובדים</p>
        <SplitLines class="t-display-2" lines={['שלושה דברים', 'שלא מתפשרים עליהם.']} step={100} />
      </div>

      <ol class="ab-belief__list" data-stagger style="--mo-step:110ms">
        {beliefs.map((b, i) => (
          <li class="ab-belief__row" data-reveal>
            <span class="ab-belief__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <div class="ab-belief__body">
              <p class="ab-belief__k t-latin">{b.k}</p>
              <h3 class="ab-belief__t t-display-3">{b.t}</h3>
            </div>
            <p class="ab-belief__d">{b.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ 4. THE GUIDE, narrating the approach ═════════ -->
  <section class="ab-guide u-section band band--warm" data-swap-root>
    <div class="u-container u-container--wide ab-guide__grid">
      <div class="ab-guide__fig">
        <Avatar lines={guideLines} size="md" />
      </div>
      <div class="ab-guide__copy">
        <p class="t-eyebrow" data-reveal>הגישה</p>
        <SplitLines class="t-display-2 ab-guide__h" lines={['קודם התהליך.', 'אחר כך הטכנולוגיה.']} step={100} />
        <p class="t-lead ab-guide__lead" data-reveal style="--mo-delay:240ms">
          זה הסדר. לא הפוך. וכשעובדים ככה, המערכת מתאימה לעסק במקום שהעסק
          יתכופף לכלי.
        </p>
      </div>
    </div>

    <div class="u-container u-container--wide ab-guide__viz" data-clip>
      <Viz kind="about" />
    </div>
  </section>

  <!-- ═════════ 5. WHAT WE BUILD ═════════ -->
  <section class="ab-eco u-section band">
    <div class="u-container u-container--wide">
      <div class="ab-eco__head">
        <p class="t-eyebrow" data-reveal>מה אנחנו בונים</p>
        <SplitLines class="t-display-2" lines={['חמישה חלקים.', 'תהליך אחד.']} step={100} />
        <p class="t-lead ab-eco__lead" data-reveal style="--mo-delay:240ms">
          כמעט אף עסק לא צריך את כולם. מתחילים מהחלק שפותר את מה שהכי תקוע,
          והשאר מתחבר בהמשך.
        </p>
      </div>

      <ul class="ab-eco__list" data-stagger style="--mo-step:80ms">
        {SERVICES.map((s, i) => (
          <li class="ab-eco__row" data-reveal>
            <span class="ab-eco__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <a class="ab-eco__link" href={`/services/${s.slug}/`}>
              <span class="ab-eco__name t-display-3">{s.name}</span>
              <span class="ab-eco__lead-in">{s.lead}</span>
            </a>
            <span class="ab-eco__arrow arrow-inline" aria-hidden="true">←</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ 6. PROCESS ═════════ -->
  <section class="ab-proc u-section band band--soft">
    <div class="u-container u-container--wide">
      <div class="ab-proc__head">
        <p class="t-eyebrow" data-reveal>מה קורה בפועל</p>
        <SplitLines class="t-display-2" lines={['מרגע שאמרתם כן.']} step={100} />
      </div>
      <ol class="ab-proc__list" data-stagger style="--mo-step:80ms">
        {PROCESS.map((p) => (
          <li class="ab-proc__row" data-reveal>
            <span class="ab-proc__n tabular">{p.n}</span>
            <h3 class="ab-proc__t t-h2">{p.label}</h3>
            <p class="ab-proc__d">{p.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ClosingCta
    heading="נתחיל משיחה קצרה"
    body="30 דקות. נעבור על איך שאתם עובדים היום, ונגיד בכנות איפה יש מה לשפר ואיפה פשוט לא צריך."
  />
</SiteLayout>

<style>
  /* ══════ opener ══════ */
  .ab-hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(8rem, 16svh, 12rem) clamp(4rem, 8vh, 7rem);
  }
  .ab-hero__h1 { margin-block: 1rem 2rem; display: flex; flex-direction: column; }
  .ab-hero__latin { font-size: 0.4em; opacity: 0.4; }
  .ab-hero__accent {
    background: linear-gradient(100deg, #1d4ed8 0%, #2997ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .ab-hero__lead { font-size: var(--text-lead); color: var(--color-ink-2); max-width: 44ch; }
  .ab-hero__cue {
    position: absolute; bottom: 1.75rem; inset-inline-start: 50%;
    width: 1px; height: 3rem;
    background: linear-gradient(180deg, transparent, var(--color-ink-3));
    opacity: 0.5; animation: ab-cue 2.4s var(--ease-inout) infinite;
  }
  @keyframes ab-cue {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.2 }
    50%      { transform: scaleY(1);   transform-origin: top; opacity: 0.6 }
  }

  /* ══════ pinned portrait + statement ══════ */
  .ab-story { padding-block: var(--space-section); }
  .ab-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  /* A sticky child can only travel inside its PARENT's box, so the
     column has to fill the whole grid row. Without this the aside is
     only as tall as the portrait and nothing ever pins. */
  .ab-story__side { align-self: stretch; height: 100%; }
  .ab-story__pin { top: 16vh; }
  .ab-story__art { border-radius: var(--radius-xl); overflow: hidden; }
  .ab-story__name {
    font-family: var(--font-display); font-size: var(--text-h3);
    font-weight: 800; margin-top: 1.25rem;
  }
  .ab-story__role {
    font-size: var(--text-small); font-weight: 700; color: var(--color-royal);
    direction: ltr; text-align: start;
  }
  /* Each statement gets close to its own screen. That length is what
     gives the pinned portrait something to travel through, and what
     turns this from a paragraph stack into a scroll story. */
  .ab-story__text {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 30svh, 16rem);
    padding-block: clamp(1rem, 8svh, 5rem) clamp(3rem, 20svh, 10rem);
  }
  .ab-story__p {
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 34ch;
    font-weight: 500;
  }
  /* the first paragraph carries the weight, as a pull-quote would */
  .ab-story__p--lead {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.8rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    max-width: 22ch;
  }

  /* ══════ beliefs ══════ */
  .ab-belief { position: relative; }
  .ab-belief__ghost { position: absolute; top: 4%; inset-inline-start: 50%; transform: translateX(50%); z-index: 0; }
  .ab-belief__inner { position: relative; z-index: 1; }
  .ab-belief__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .ab-belief__list { list-style: none; margin: 0; padding: 0; }
  .ab-belief__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .ab-belief__row:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.22); }
  .ab-belief__n { font-family: var(--font-display); font-weight: 700; color: rgba(255,255,255,0.6); font-size: var(--text-small); }
  .ab-belief__k { font-size: var(--text-micro); opacity: 0.6; margin-bottom: 0.35rem; }
  .ab-belief__d { color: rgba(255, 255, 255, 0.82); max-width: 44ch; }

  /* ══════ guide + approach ══════ */
  .ab-guide__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .ab-guide__fig { display: grid; place-items: center; }
  .ab-guide__h { margin-block: 1rem 1.5rem; }
  .ab-guide__viz { border-radius: var(--radius-xl); overflow: hidden; }

  /* ══════ ecosystem ══════ */
  .ab-eco__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .ab-eco__lead { margin-top: 1.5rem; max-width: 48ch; }
  .ab-eco__list { list-style: none; margin: 0; padding: 0; }
  .ab-eco__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    border-top: 1px solid var(--color-line);
    transition: background-color var(--dur) var(--ease-out);
  }
  .ab-eco__row:last-child { border-bottom: 1px solid var(--color-line); }
  .ab-eco__row:hover { background: var(--color-surface-2); }
  .ab-eco__n { font-family: var(--font-display); font-weight: 700; color: var(--color-electric); font-size: var(--text-small); }
  .ab-eco__link {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    text-decoration: none; color: inherit;
  }
  .ab-eco__name { transition: color var(--dur) var(--ease-out); }
  .ab-eco__row:hover .ab-eco__name { color: var(--color-royal); }
  .ab-eco__lead-in { font-size: var(--text-small); color: var(--color-ink-3); max-width: 52ch; }
  .ab-eco__arrow { color: var(--color-royal); justify-self: end; }
  .ab-eco__row:hover .ab-eco__arrow { transform: translateX(-5px); }

  /* ══════ process ══════ */
  .ab-proc__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .ab-proc__list { list-style: none; margin: 0; padding: 0; }
  .ab-proc__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem);
    border-top: 1px solid var(--color-line-strong);
  }
  .ab-proc__row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .ab-proc__n { font-family: var(--font-display); font-weight: 800; color: var(--color-electric); }
  .ab-proc__d { color: var(--color-ink-2); max-width: 52ch; }

  /* ══════ responsive ══════ */
  @media (max-width: 1024px) {
    .ab-story__grid, .ab-guide__grid { grid-template-columns: 1fr; }
    .ab-story__pin { position: static; }
    .ab-story__art { max-width: 22rem; }
    .ab-guide__fig { justify-items: start; }
  }
  @media (max-width: 760px) {
    .ab-belief__row { grid-template-columns: 2.75rem 1fr; }
    .ab-belief__d { grid-column: 2; }
    .ab-proc__row { grid-template-columns: 3rem 1fr; }
    .ab-proc__d { grid-column: 2; }
    .ab-eco__row { grid-template-columns: 2.75rem 1fr 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-hero__cue { animation: none; }
  }
</style>
