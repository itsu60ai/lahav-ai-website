---
// PRIVACY. Honest, implementation-based copy: every claim here matches
// what the code actually does (see src/lib/leads/* for the contact/chat
// data path, hashIp() for the IP handling, spam.ts for Turnstile). No
// section describes a system that doesn't exist yet, except "מדידה
// ומעקב", which says plainly that no analytics tool is active.
//
// F-15: LAHAV AI is a brand, not a registered entity. Operator line is
// "Ethan Lahav / LAHAV AI". No company number, no address.
// NV-2: this is not legal advice and was not written or reviewed by a
// lawyer -- said outright in the page's own closing line. No compliance
// claim (GDPR/CCPA/etc.) is made anywhere.
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../lib/site';

const sections = [
  {
    h: 'מי מפעיל את האתר',
    p: [
      'האתר מופעל על ידי Ethan Lahav / LAHAV AI. אנחנו מותג עסקי ולא חברה רשומה, ולכן לא מוצגים כאן מספר חברה או כתובת רשומה.',
      'לכל שאלה בנושא הפרטיות אפשר לפנות אלינו דרך עמוד יצירת הקשר.',
    ],
  },
  {
    h: 'איזה מידע אנחנו אוספים',
    p: [
      'המידע היחיד שאנחנו אוספים ישירות הוא מה שאתם בוחרים למסור לנו: בטופס יצירת הקשר (שם, טלפון, אימייל, השירות שמעניין אתכם וההודעה שכתבתם), או בצ׳אט באתר, אם אתם משתמשים בו ומשאירים בו פרטים.',
      'כתובת ה-IP שממנה נשלחה פנייה לא נשמרת כמו שהיא. היא עוברת חישוב שהופך אותה לקוד שאי אפשר לשחזר ממנו את הכתובת המקורית, ומשמש רק כדי לזהות ניסיונות ספאם חוזרים — לא כדי לזהות אתכם אישית.',
      'ההגנה מפני בוטים בטופס (Cloudflare Turnstile) מופעלת על ידי Cloudflare, לא על ידינו, ולה יש מדיניות פרטיות משלה.',
      'אנחנו לא מבקשים ולא אוספים פרטי תשלום, מספרי זהות או מידע רגיש דרך האתר.',
    ],
  },
  {
    h: 'למה אנחנו משתמשים במידע',
    p: [
      'כדי לחזור אליכם ולהתקדם לשיחה. זהו. אנחנו לא מוכרים את הפרטים שלכם ולא מעבירים אותם לגורמים שלישיים לצורכי שיווק.',
    ],
  },
  {
    h: 'עוגיות ומעקב',
    p: [
      'האתר הזה לא משתמש בעוגיות פרסום או מעקב שיווקי. העוגייה היחידה שעשויה להישמר היא זו של Cloudflare Turnstile, לצורך ההגנה מפני בוטים בטפסים, לא לצורך זיהוי או מעקב אחריכם.',
      'כרגע אין באתר כלי מדידת שימוש (אנליטיקס) פעיל. אם וכשנפעיל כלי כזה, נעדכן כאן איזה כלי, מה הוא אוסף, ואיך אפשר לצאת ממנו.',
    ],
  },
  {
    h: 'שמירת מידע',
    p: [
      'פנייה שנשלחת דרך הטופס או הצ׳אט נשמרת במערכת שלנו כדי שנוכל לטפל בה ולחזור אליכם. אין כרגע מנגנון שמוחק פניות ישנות אוטומטית אחרי זמן קבוע — הן נשמרות עד שנפנה אותן בעצמנו או שתבקשו מאיתנו למחוק אותן.',
    ],
  },
  {
    h: 'הזכויות שלכם',
    p: [
      'אתם יכולים לפנות אלינו ולבקש לראות איזה מידע יש לנו עליכם, לתקן אותו, או לבקש שנמחק אותו. נטפל בבקשה כזו בעצמנו ידנית ונעדכן אתכם כשהיא בוצעה.',
    ],
  },
  {
    h: 'שינויים בעמוד הזה',
    p: [
      'העמוד הזה ישתנה ככל שהאתר והמערכות מאחוריו יתפתחו — למשל אם נוסיף כלי מדידה. כשנעדכן אותו, נעדכן גם את תאריך העדכון למטה.',
    ],
  },
];
---

<SiteLayout
  title="מדיניות פרטיות | LAHAV AI"
  description="איזה מידע נאסף באתר LAHAV AI, למה משתמשים בו, ואיך אפשר לפנות אלינו בנושא."
>
  <article class="pv">
    <header class="pv__head band band--hero">
      <div class="u-container u-container--wide">
        <p class="t-eyebrow" data-reveal>משפטי</p>
        <h1 class="pv__title">
          <span class="mo-line" style="--mo-delay:70ms"><span>מדיניות</span></span>
          <span class="mo-line" style="--mo-delay:170ms"><span>פרטיות</span></span>
        </h1>
        <p class="pv__intro" data-reveal style="--mo-delay:280ms">
          בקצרה: אנחנו אוספים רק את מה שאתם משאירים לנו בטופס, משתמשים בזה
          כדי לחזור אליכם, ולא מוכרים אותו לאף אחד.
        </p>
      </div>
    </header>

    <div class="u-container u-container--wide pv__body">
      {
        sections.map((s, i) => (
          <section class="pv__sec" data-reveal>
            <span class="pv__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <div class="pv__secbody">
              <h2 class="pv__h">{s.h}</h2>
              {s.p.map((t) => <p>{t}</p>)}
            </div>
          </section>
        ))
      }

      <p class="pv__updated">עודכן לאחרונה: ספטמבר 2026</p>
      <p class="pv__disclaimer">העמוד הזה כתוב בכנות, לפי מה שהאתר עושה בפועל — הוא לא נוסח או אושר על ידי עורך דין.</p>
      <p class="pv__legal">{SITE.legalLine}</p>
    </div>
  </article>
</SiteLayout>

<style>
  .pv__head { padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem); }
  .pv__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-display-1);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: normal;
    margin-block: 1rem 1.5rem;
  }
  .pv__intro {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 44ch;
  }
  .pv__body {
    max-width: 52rem;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 6rem);
    display: flex;
    flex-direction: column;
  }
  /* numbered hairline rows, the same separation language the rest of the
     site uses for lists */
  .pv__sec {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-line-strong);
  }
  .pv__secbody { display: flex; flex-direction: column; gap: 0.875rem; }
  .pv__h {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--color-ink);
  }
  .pv__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
    padding-top: 0.25rem;
  }
  .pv__sec p {
    font-size: var(--text-body-lg);
    line-height: 1.8;
    color: var(--color-ink-2);
    max-width: 62ch;
  }
  .pv__updated,
  .pv__disclaimer,
  .pv__legal {
    font-size: var(--text-small);
    color: var(--color-ink-3);
  }
  .pv__updated {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .pv__disclaimer { margin-top: 0.5rem; }
  .pv__legal { margin-top: 0.5rem; }

  @media (max-width: 640px) {
    .pv__sec { grid-template-columns: 2.25rem minmax(0, 1fr); gap: 0.875rem; }
  }
</style>
