---
// PORTFOLIO INDEX ("תיק עבודות").
//
// Structure matched to the client's reference agency portfolio page,
// seen on desktop via the client's own screenshots (2026-09-02):
//   1. a giant single-word watermark heading bleeding off both edges
//      (Hebrew here -- F-22 rules out giant English display type)
//   2. a short intro paragraph in a narrow column at the reading start
//   3. a TWO-column staggered gallery: tall media tiles (image, or a
//      muted autoplaying video), the second column offset downward so the
//      two columns never line up; the client's name and a one-line
//      tagline sit UNDER each tile, not on it
//   4. the site's own contact band
// Rebuilt in LAHAV's dark type/colour system, not the reference's CSS.
//
// EVERY item shown here is a fictional example (client decision,
// 2026-09-01) -- see docs/WEBSITE_CMS.md. Not linked from navigation and
// noindex by default until the client is ready to launch it for real.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import { PORTFOLIO_INDEX_DEFAULT, getPublicContent, getDraftContent } from '../../lib/cms/content.ts';
import type { PortfolioItemContent } from '../../lib/cms/content.ts';
import { resolvePreview } from '../../lib/cms/preview.ts';

const SITE_KEY = turnstileSiteKey();

const { content: contentStore, portfolioList } = Astro.locals.stores!;
const preview = await resolvePreview(Astro, Astro.locals.stores!);
const page = preview
  ? await getDraftContent(contentStore, 'portfolio', PORTFOLIO_INDEX_DEFAULT)
  : await getPublicContent(contentStore, 'portfolio', PORTFOLIO_INDEX_DEFAULT);

// In preview there is no "draft list" endpoint analogous to listPublished
// -- draft items are still individual rows scattered by id, not a single
// ordered list the way FAQ's draft state is. For the index page, preview
// therefore shows every non-deleted draft item (ignoring the enabled
// flag, so a not-yet-enabled item can still be checked before switching
// it on), sorted the same way the admin list is.
let items: { id: string; content: PortfolioItemContent }[];
if (preview) {
  const meta = await portfolioList.listDraftMeta();
  const { portfolio: portfolioContent } = Astro.locals.stores!;
  items = await Promise.all(
    meta.map(async (m) => {
      const raw = await portfolioContent.getDraftRaw(m.id);
      let content: any = {};
      try { content = raw ? JSON.parse(raw) : {}; } catch {}
      return { id: m.id, content };
    })
  );
} else {
  items = (await portfolioList.listPublished()) as { id: string; content: PortfolioItemContent }[];
}

// Two columns, dealt alternately, so the reading-start column holds
// items 0,2,4... and the far column 1,3,5... The far column is pushed
// down in CSS; that offset is what makes the reference's grid read as
// staggered rather than as rows.
const colA = items.filter((_, i) => i % 2 === 0);
const colB = items.filter((_, i) => i % 2 === 1);
const href = (c: PortfolioItemContent) => `/portfolio/${c.slug}/${preview ? '?preview=1' : ''}`;
---

<SiteLayout
  title={page.seo.title}
  description={page.seo.description}
  noindex={page.seo.noindex}
  image={page.seo.ogImage || undefined}
  preview={preview}
>
  <!-- ═══ 1. watermark heading, bleeding off both edges ═══ -->
  <section class="pf-mark band" aria-labelledby="pf-title">
    <h1 id="pf-title" class="pf-mark__word">
      <span class="sr-only">{page.hero.eyebrow}</span>
      <span class="pf-mark__run" aria-hidden="true">
        {Array.from({ length: 4 }).map(() => <span>{page.hero.eyebrow}</span>)}
      </span>
    </h1>
  </section>

  <!-- ═══ 2. the intro, a narrow column at the reading start ═══ -->
  <section class="pf-intro band">
    <div class="u-container u-container--wide">
      <p class="pf-intro__text" data-reveal>
        <span class="pf-intro__strong">{page.hero.headlineLine1} {page.hero.headlineLine2}</span>
        {' '}{page.hero.lead}
      </p>
    </div>
  </section>

  <!-- ═══ 3. the staggered two-column gallery ═══ -->
  {items.length === 0 ? (
    <section class="u-section band">
      <div class="u-container u-container--wide">
        <p class="pf-empty">עוד אין פרויקטים לדוגמה כאן.</p>
      </div>
    </section>
  ) : (
    <section class="pf-gallery band">
      <div class="u-container u-container--wide pf-cols">
        {[colA, colB].map((col, ci) => (
          <ul class:list={['pf-col', { 'pf-col--far': ci === 1 }]}>
            {col.map(({ content: c }, i) => (
              <li class:list={['pf-tile', { 'pf-tile--square': (i + ci) % 2 === 1 }]} data-reveal>
                <a class="pf-tile__link" href={href(c)}>
                  <span class="pf-tile__media">
                    {c.heroVideo ? (
                      <video
                        class="pf-tile__video"
                        src={c.heroVideo}
                        poster={c.heroImage ? `/api/media/${c.heroImage}` : undefined}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                      ></video>
                    ) : c.heroImage ? (
                      <img class="pf-tile__img" src={`/api/media/${c.heroImage}`} alt="" loading="lazy" />
                    ) : (
                      <span class="pf-tile__placeholder" aria-hidden="true" />
                    )}
                  </span>
                  <span class="pf-tile__caption">
                    <span class="pf-tile__name">{c.name}</span>
                    <span class="pf-tile__tag">{c.tagline || c.industry}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )}

  <ContactBlock siteKey={SITE_KEY} preview={preview} />
</SiteLayout>

<style>
  /* 1. Watermark: one word, set so large it leaves the viewport on both
     sides, in a whisper of the accent so it reads as texture. Clipped by
     the section, never by the page (no horizontal scrollbar). */
  .pf-mark {
    overflow: hidden;
    padding-top: clamp(6.5rem, 14vh, 10rem);
    padding-bottom: 0;
  }
  /* The word is wider than the screen, so instead of cropping it we let
     it drift: four copies on one line, sliding slowly toward the reading
     end and looping seamlessly (the run is 4 copies, the keyframe moves
     exactly half of it). Every letter passes through the viewport. */
  .pf-mark__word {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(7rem, 22vw, 20rem);
    line-height: 0.95;
    letter-spacing: normal;
    white-space: nowrap;
    user-select: none;
  }
  .pf-mark__run {
    display: inline-flex;
    gap: 0.35em;
    padding-inline-end: 0.35em;
    color: transparent;
    background: linear-gradient(180deg, rgba(41, 151, 255, 0.18), rgba(41, 151, 255, 0.06));
    -webkit-background-clip: text;
    background-clip: text;
    animation: pf-drift 40s linear infinite;
  }
  @keyframes pf-drift {
    from { transform: translateX(0); }
    to   { transform: translateX(50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-mark__run { animation: none; }
  }

  /* 2. Intro: the reference sets one paragraph in a narrow column at the
     reading start, larger than body copy, with the first sentence bold. */
  .pf-intro { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); }
  .pf-intro__text {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .pf-intro__strong { color: var(--color-ink); font-weight: 800; }

  .pf-empty { color: var(--color-ink-3); }

  /* 3. Gallery: two independent columns so the far one can start lower.
     Tiles alternate portrait / square within each column, which is the
     reference's rhythm (Keds tall, Polyron square, ...). */
  .pf-gallery { padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 10vw, 8rem); }
  .pf-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 5vw, 6.5rem);
    align-items: start;
  }
  .pf-col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 6.5rem);
  }
  .pf-col--far { padding-top: clamp(6rem, 18vw, 16rem); }

  .pf-tile__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .pf-tile__media {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .pf-tile--square .pf-tile__media { aspect-ratio: 1 / 1; }
  .pf-tile__img,
  .pf-tile__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms var(--ease-out);
  }
  .pf-tile__link:hover .pf-tile__img,
  .pf-tile__link:hover .pf-tile__video,
  .pf-tile__link:focus-visible .pf-tile__img,
  .pf-tile__link:focus-visible .pf-tile__video { transform: scale(1.03); }
  .pf-tile__placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-navy), var(--color-royal));
  }
  .pf-tile__caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.1rem;
  }
  .pf-tile__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-ink);
    transition: color var(--dur) var(--ease-out);
  }
  .pf-tile__link:hover .pf-tile__name { color: var(--color-electric); }
  .pf-tile__tag {
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  @media (max-width: 700px) {
    .pf-cols { grid-template-columns: 1fr; row-gap: clamp(3rem, 10vw, 4rem); }
    .pf-col--far { padding-top: 0; }
    .pf-intro__text { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-tile__img, .pf-tile__video { transition: none; }
  }
</style>
