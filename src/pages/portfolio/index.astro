---
// PORTFOLIO INDEX ("תיק עבודות").
//
// Structure matched to the client's Stitch reference "Premium Editorial
// Portfolio / portfolio_landing_page" (docs/reference/stitch-portfolio,
// 2026-09-02): a photographic hero band with a two-line headline, a lead
// and one ghost button; then a "selected works" header with a running
// counter and a hairline rule; then a THREE-column masonry of cards with
// the image on top and, underneath, a small mono category chip, the
// project name and a one-line description. Whitespace is generous and
// depth comes from hairlines and a 4px lift on hover, not shadows.
// Rebuilt in LAHAV's own tokens and type (Heebo/Assistant), RTL.
//
// EVERY item shown here is a fictional example (client decision,
// 2026-09-01) -- see docs/WEBSITE_CMS.md.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import { PORTFOLIO_INDEX_DEFAULT, getPublicContent, getDraftContent } from '../../lib/cms/content.ts';
import type { PortfolioItemContent } from '../../lib/cms/content.ts';
import { resolvePreview } from '../../lib/cms/preview.ts';

const SITE_KEY = turnstileSiteKey();
const { content: contentStore, portfolioList } = Astro.locals.stores!;
const preview = await resolvePreview(Astro, Astro.locals.stores!);
const page = preview
  ? await getDraftContent(contentStore, 'portfolio', PORTFOLIO_INDEX_DEFAULT)
  : await getPublicContent(contentStore, 'portfolio', PORTFOLIO_INDEX_DEFAULT);

let items: { id: string; content: PortfolioItemContent }[];
if (preview) {
  const meta = await portfolioList.listDraftMeta();
  const { portfolio: portfolioContent } = Astro.locals.stores!;
  items = await Promise.all(
    meta.map(async (m) => {
      const raw = await portfolioContent.getDraftRaw(m.id);
      let content: any = {};
      try { content = raw ? JSON.parse(raw) : {}; } catch {}
      return { id: m.id, content };
    })
  );
} else {
  items = (await portfolioList.listPublished()) as { id: string; content: PortfolioItemContent }[];
}

const href = (c: PortfolioItemContent) => `/portfolio/${c.slug}/${preview ? '?preview=1' : ''}`;
const media = (id: string) => `/api/media/${id}`;
const pad = (n: number) => String(n).padStart(2, '0');
// The hero photograph is the first project's own media, so the band is
// never a stock image and never empty when there is at least one item.
const heroItem = items[0]?.content;
// Masonry rhythm: the reference varies card heights. Every third card
// is portrait, the rest are 4:3, so no row lines up.
const ratio = (i: number) => (i % 3 === 1 ? 'pf-card--tall' : '');
---

<SiteLayout
  title={page.seo.title}
  description={page.seo.description}
  noindex={page.seo.noindex}
  image={page.seo.ogImage || undefined}
  preview={preview}
  headerSolid
>
  <!-- ═══ 1. hero band ═══ -->
  <section class="pf-hero band band--navy">
    {heroItem?.heroVideo ? (
      <video class="pf-hero__media" src={heroItem.heroVideo} poster={heroItem.heroImage ? media(heroItem.heroImage) : undefined} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    ) : heroItem?.heroImage ? (
      <img class="pf-hero__media" src={media(heroItem.heroImage)} alt="" />
    ) : (
      <span class="pf-hero__media pf-hero__placeholder" aria-hidden="true" />
    )}
    <span class="pf-hero__scrim" aria-hidden="true"></span>
    <div class="u-container pf-hero__in">
      <p class="pf-hero__eyebrow" data-reveal>{page.hero.eyebrow}</p>
      <h1 class="pf-hero__h1">
        <span class="mo-line" style="--mo-delay:80ms"><span>{page.hero.headlineLine1}</span></span>
        <span class="mo-line" style="--mo-delay:190ms"><span>{page.hero.headlineLine2}</span></span>
      </h1>
      <p class="pf-hero__lead" data-reveal style="--mo-delay:300ms">{page.hero.lead}</p>
      <a class="pf-ghost" href="#works" data-reveal style="--mo-delay:380ms">לצפייה בעבודות</a>
    </div>
  </section>

  <!-- ═══ 2. selected works ═══ -->
  <section id="works" class="pf-works band u-section">
    <div class="u-container u-container--wide">
      <header class="pf-works__head" data-reveal>
        <h2 class="pf-works__h">עבודות נבחרות</h2>
        <span class="pf-mono">{pad(1)} / {pad(items.length)}</span>
      </header>

      {items.length === 0 ? (
        <p class="pf-empty">עוד אין פרויקטים לדוגמה כאן.</p>
      ) : (
        <ul class="pf-grid">
          {items.map(({ content: c }, i) => (
            <li class:list={['pf-card', ratio(i)]} data-reveal style={`--mo-delay:${(i % 3) * 70}ms`}>
              <a class="pf-card__link" href={href(c)}>
                <span class="pf-card__media">
                  {c.heroVideo ? (
                    <video src={c.heroVideo} poster={c.heroImage ? media(c.heroImage) : undefined} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
                  ) : c.heroImage ? (
                    <img src={media(c.heroImage)} alt="" loading="lazy" />
                  ) : (
                    <span class="pf-card__placeholder" aria-hidden="true" />
                  )}
                </span>
                <span class="pf-card__body">
                  <span class="pf-chip">{c.industry}</span>
                  <span class="pf-card__name">{c.name}</span>
                  <span class="pf-card__desc">{c.tagline || c.challenge}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <ContactBlock siteKey={SITE_KEY} preview={preview} />
</SiteLayout>

<style>
  /* ── hero ───────────────────────────────────────────────────────── */
  .pf-hero {
    position: relative; overflow: hidden;
    min-height: clamp(26rem, 78svh, 44rem);
    display: flex; align-items: center;
    padding-top: clamp(5.5rem, 10svh, 7rem);
  }
  .pf-hero__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(1) contrast(1.05); }
  .pf-hero__placeholder { background: linear-gradient(135deg, var(--color-navy), var(--color-royal)); }
  .pf-hero__scrim { position: absolute; inset: 0; background: rgba(9, 15, 33, 0.58); }
  .pf-hero__in { position: relative; z-index: 1; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .pf-hero__eyebrow { margin: 0; font-size: var(--text-micro); font-weight: 800; letter-spacing: 0.14em; color: rgba(255,255,255,0.72); }
  .pf-hero__h1 {
    margin: 0; display: flex; flex-direction: column; align-items: center;
    font-family: var(--font-display); font-size: clamp(2.75rem, 7.5vw, 6.5rem);
    font-weight: 900; line-height: 1.05; letter-spacing: normal; color: #fff;
  }
  .pf-hero__lead { margin: 0; max-width: 44ch; font-size: var(--text-lead); line-height: 1.6; color: rgba(255,255,255,0.82); }
  .pf-ghost {
    display: inline-block; margin-top: .5rem; padding: .85rem 1.6rem;
    border: 1px solid rgba(255,255,255,0.7); border-radius: var(--radius-sm);
    font-size: var(--text-micro); font-weight: 800; letter-spacing: 0.12em; color: #fff; text-decoration: none;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .pf-ghost:hover { background: #fff; color: var(--color-navy); transform: translateY(-2px); }

  /* ── works ──────────────────────────────────────────────────────── */
  .pf-works__head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem;
    padding-bottom: 1rem; margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line-strong);
  }
  .pf-works__h { margin: 0; font-family: var(--font-display); font-size: var(--text-h2); font-weight: 900; letter-spacing: normal; color: var(--color-ink); }
  .pf-mono { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: var(--text-micro); letter-spacing: 0.1em; color: var(--color-ink-3); direction: ltr; }
  .pf-empty { color: var(--color-ink-3); }

  .pf-grid {
    list-style: none; margin: 0; padding: 0;
    columns: 3; column-gap: clamp(1.5rem, 2.5vw, 2rem);
  }
  .pf-card { break-inside: avoid; margin-bottom: clamp(1.5rem, 2.5vw, 2rem); }
  .pf-card__link {
    display: block; text-decoration: none; color: inherit;
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm); overflow: hidden;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .pf-card__link:hover, .pf-card__link:focus-visible {
    transform: translateY(-4px); border-color: var(--color-line-strong);
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }
  .pf-card__media { display: block; aspect-ratio: 4 / 3; background: var(--color-surface-2); overflow: hidden; }
  .pf-card--tall .pf-card__media { aspect-ratio: 4 / 5; }
  .pf-card__media img, .pf-card__media video { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 600ms var(--ease-out); }
  .pf-card__link:hover .pf-card__media img, .pf-card__link:hover .pf-card__media video { transform: scale(1.03); }
  .pf-card__placeholder { display: block; width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-navy), var(--color-royal)); }
  .pf-card__body { display: flex; flex-direction: column; align-items: flex-start; gap: .55rem; padding: 1.1rem 1.15rem 1.35rem; }
  .pf-chip {
    display: inline-block; padding: .3rem .6rem; border-radius: var(--radius-sm);
    background: var(--color-surface-3); color: var(--color-ink-2);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
  }
  .pf-card__name { font-family: var(--font-display); font-size: clamp(1.25rem, 1.6vw, 1.5rem); font-weight: 800; line-height: 1.2; color: var(--color-ink); }
  .pf-card__desc { font-size: var(--text-small); line-height: 1.55; color: var(--color-ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  @media (max-width: 960px) { .pf-grid { columns: 2; } }
  @media (max-width: 600px) { .pf-grid { columns: 1; } }
  @media (prefers-reduced-motion: reduce) { .pf-card__media img, .pf-card__media video, .pf-card__link { transition: none; } }
</style>
