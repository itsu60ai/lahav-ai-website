---
// PORTFOLIO DETAIL -- one example project, with a SEPARATE TEMPLATE PER
// SERVICE (client instruction, 2026-09-02: "we need a separate template
// for the portfolio for each service, designed accordingly, with images
// of the project").
//
// Shared frame (from the client's Stitch reference "Premium Editorial
// Portfolio / project_detail_page"): large title + lead, a sticky
// metadata sidebar at the reading start, a free-scrolling main column,
// the result as a pull-quote, a next-project row.
//
// What changes per kind (the main column):
//   web-development  a browser-window mock of the site we built (real
//                    screenshot if uploaded, else a drawn storefront using
//                    the project's own photo), then a phone view of the
//                    same site, then "what we built" as three benefits
//   crm              the CRM board itself (a lead card moving through the
//                    pipeline), then the lead's five stops as a flow, then
//                    the follow-up rules as a checklist
//   automations      the automation canvas with a pulse running through
//                    it and a live log, then the trigger/rule/action flow
//   app-development  the phone app first (two handsets), then the desktop
//                    admin, then the screens list
//   ai-content       the brief-to-draft editor, then the content pipeline
//   ''               generic dashboard mock
// Mocks are drawn DOM (src/components/ProjectMock.astro) dressed with the
// project's name, industry and photo; uploaded screenshots (gallery /
// mobileGallery) replace them when present. Mocks illustrate mechanisms
// and carry no metrics, per the truth rules.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ProjectMock from '../../components/ProjectMock.astro';
import Flow from '../../components/Flow.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import { resolvePreview } from '../../lib/cms/preview.ts';
import { SERVICE_PAGES } from '../../lib/site';
import type { PortfolioItemContent } from '../../lib/cms/content.ts';

const SITE_KEY = turnstileSiteKey();
const { portfolioList } = Astro.locals.stores!;
const { slug } = Astro.params;
const preview = await resolvePreview(Astro, Astro.locals.stores!);

let content: PortfolioItemContent | null = null;
if (preview) {
  const draft = await portfolioList.getDraftBySlug(String(slug));
  content = (draft?.content as PortfolioItemContent) ?? null;
} else {
  content = (await portfolioList.getPublishedBySlug(String(slug))) as PortfolioItemContent | null;
}
if (!content) return new Response(null, { status: 404, statusText: 'Not found' });
const item = content;

let next: PortfolioItemContent | null = null;
if (!preview) {
  const list = await portfolioList.listPublished();
  const idx = list.findIndex((r) => (r.content as PortfolioItemContent).slug === item.slug);
  if (idx !== -1 && list.length > 1) next = list[(idx + 1) % list.length].content as PortfolioItemContent;
}

type Kind = 'web-development' | 'crm' | 'automations' | 'app-development' | 'ai-content' | '';
const kind = ((item.serviceSlug as Kind) || '') as Kind;
const LABEL: Record<Kind, string> = {
  'web-development': 'פיתוח אתרים', crm: 'מערכת CRM', automations: 'אוטומציות',
  'app-development': 'פיתוח אפליקציה', 'ai-content': 'תוכן באמצעות AI', '': 'מערכת עסקית',
};
const services = (item.service || '').split(/[,،]/).map((s) => s.trim()).filter(Boolean);
const gallery = item.gallery ?? [];
const mobile = item.mobileGallery ?? [];
const media = (id: string) => `/api/media/${id}`;
const photo = item.heroImage ? media(item.heroImage) : '';
const flow = kind ? (SERVICE_PAGES as any)[kind]?.flow : null;
const build = kind ? ((SERVICE_PAGES as any)[kind]?.build as { t: string; d: string }[]) : null;

// per-kind section titles
const T: Record<Kind, { shot: string; second: string; built: string; flow: string }> = {
  'web-development': { shot: 'האתר שבנינו', second: 'ובנייד, אותו אתר', built: 'מה בנינו באתר', flow: 'המסלול שתכננו לגולש' },
  crm: { shot: 'מערכת ה-CRM שבנינו', second: 'החיים של פנייה במערכת', built: 'מה המערכת עושה לבד', flow: 'מסלול הלקוח' },
  automations: { shot: 'האוטומציה שרצה אצלם', second: 'איך זה עובד', built: 'מה רץ בלי אתם', flow: 'טריגר, כלל, פעולה' },
  'app-development': { shot: 'האפליקציה שבנינו', second: 'ומאחורי הקלעים: מסך הניהול', built: 'המסכים שנבנו', flow: 'מהצורך למסכים' },
  'ai-content': { shot: 'העורך שהטמענו', second: 'מבריף לפרסום', built: 'איך זה עובד אצלם', flow: 'מבריף לפרסום' },
  '': { shot: 'המערכת שבנינו', second: 'מה מתחבר למה', built: 'מה בנינו', flow: 'מה מתחבר למה' },
};
const t = T[kind];
---

<SiteLayout
  title={item.seo.title || `${item.name} | LAHAV AI`}
  description={item.seo.description}
  noindex={item.seo.noindex}
  image={item.seo.ogImage || undefined}
  preview={preview}
  headerSolid
>
  <!-- ═══ title ═══ -->
  <section class="pd-top band">
    <div class="u-container u-container--wide">
      <p class="pd-mono" data-reveal>{item.industry} · {LABEL[kind]}</p>
      <h1 class="pd-h1" data-reveal style="--mo-delay:60ms">{item.name}</h1>
      <p class="pd-lead" data-reveal style="--mo-delay:140ms">{item.tagline || item.challenge}</p>
    </div>
  </section>

  <section class="pd-body band">
    <div class="u-container u-container--wide pd-grid">

      <!-- ═══ sticky sidebar ═══ -->
      <aside class="pd-side" data-reveal>
        <div class="pd-side__card">
          {photo && <img class="pd-side__photo" src={photo} alt="" />}
          <dl class="pd-meta">
            <div class="pd-meta__row"><dt class="pd-mono">הלקוח</dt><dd>{item.name}</dd></div>
            <div class="pd-meta__row"><dt class="pd-mono">התחום</dt><dd>{item.industry}</dd></div>
            <div class="pd-meta__row"><dt class="pd-mono">סוג הפרויקט</dt><dd>{LABEL[kind]}</dd></div>
            <div class="pd-meta__row">
              <dt class="pd-mono">מה עשינו</dt>
              <dd class="pd-chips">{(services.length ? services : [LABEL[kind]]).map((s) => <span class="pd-chip">{s}</span>)}</dd>
            </div>
          </dl>
          <a class="pd-side__cta" href="/contact/">רוצה כזה לעסק שלי</a>
        </div>
      </aside>

      <!-- ═══ main column: the per-kind template ═══ -->
      <div class="pd-main">

        <!-- 1. the product, big -->
        <figure class="pd-fig" data-reveal>
          <p class="pd-mono pd-fig__k">{t.shot}</p>
          {gallery[0] ? (
            <span class="pd-frame"><span class="pd-frame__bar"><i></i><i></i><i></i></span><img src={media(gallery[0])} alt="" /></span>
          ) : kind === 'app-development' ? (
            <span class="pd-phones">
              <ProjectMock kind={kind} name={item.name} industry={item.industry} image={photo} device="phone" />
              <ProjectMock kind={kind} name={item.name} industry={item.industry} image={photo} device="phone" class="pd-phone--back" />
            </span>
          ) : (
            <ProjectMock kind={kind} name={item.name} industry={item.industry} image={photo} device="desktop" />
          )}
          <figcaption class="pd-mono pd-fig__cap">{gallery[0] ? 'צילום מסך מהפרויקט' : 'המחשה של המערכת, לא צילום מסך'}</figcaption>
        </figure>

        <!-- 2. the challenge -->
        <div class="pd-prose" data-reveal>
          <h2 class="pd-h2">האתגר</h2>
          <p>{item.challenge}</p>
          <h2 class="pd-h2">מה עשינו</h2>
          <p>{item.approach}</p>
        </div>

        <!-- 3. second view, per kind -->
        <div class="pd-second" data-reveal>
          <p class="pd-mono pd-fig__k">{t.second}</p>
          {kind === 'web-development' && (
            <div class="pd-two">
              <span class="pd-phones pd-phones--one">
                {mobile[0] ? <span class="pd-phone-img"><img src={media(mobile[0])} alt="" loading="lazy" /></span>
                  : <ProjectMock kind="app-development" name={item.name} industry={item.industry} image={photo} device="phone" />}
              </span>
              {gallery[1] ? (
                <span class="pd-frame"><span class="pd-frame__bar"><i></i><i></i><i></i></span><img src={media(gallery[1])} alt="" loading="lazy" /></span>
              ) : photo ? (
                <span class="pd-photo"><img src={photo} alt="" loading="lazy" /></span>
              ) : null}
            </div>
          )}
          {kind === 'crm' && flow && <Flow stops={flow} tone="light" />}
          {kind === 'automations' && flow && <Flow stops={flow} tone="light" />}
          {kind === 'app-development' && (
            gallery[1]
              ? <span class="pd-frame"><span class="pd-frame__bar"><i></i><i></i><i></i></span><img src={media(gallery[1])} alt="" loading="lazy" /></span>
              : <ProjectMock kind="crm" name={item.name} industry={item.industry} device="desktop" />
          )}
          {kind === 'ai-content' && flow && <Flow stops={flow} tone="light" />}
          {kind === '' && photo && <span class="pd-photo"><img src={photo} alt="" loading="lazy" /></span>}
        </div>

        <!-- 4. what we built, as benefits from that service page -->
        {build && (
          <div class="pd-built" data-reveal>
            <p class="pd-mono pd-fig__k">{t.built}</p>
            <ul class="pd-built__list">
              {build.slice(0, 3).map((b) => (
                <li><b>{b.t}</b><span>{b.d}</span></li>
              ))}
            </ul>
          </div>
        )}

        <!-- 5. extra uploaded screens -->
        {(gallery.length > 2 || mobile.length > 1) && (
          <div class="pd-two" data-reveal>
            {gallery.slice(2, 4).map((id) => (
              <span class="pd-frame"><span class="pd-frame__bar"><i></i><i></i><i></i></span><img src={media(id)} alt="" loading="lazy" /></span>
            ))}
            {mobile.slice(1, 3).map((id) => (
              <span class="pd-phones pd-phones--one"><span class="pd-phone-img"><img src={media(id)} alt="" loading="lazy" /></span></span>
            ))}
          </div>
        )}

        <!-- 6. result -->
        {item.result && (
          <blockquote class="pd-quote" data-reveal>
            <p>{item.result}</p>
            <footer class="pd-mono">מה יצא מזה</footer>
          </blockquote>
        )}

        <!-- 7. next -->
        {next && (
          <a class="pd-next" href={`/portfolio/${next.slug}/`} data-reveal>
            <span class="pd-next__text"><span class="pd-mono">הפרויקט הבא</span><span class="pd-next__name">{next.name}</span></span>
            <span class="pd-next__btn" aria-hidden="true">←</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <ContactBlock siteKey={SITE_KEY} preview={preview} />
</SiteLayout>

<style>
  .pd-mono { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--color-ink-3); }
  .pd-top { padding-top: clamp(7rem, 14svh, 10rem); padding-bottom: clamp(2rem, 5vw, 4rem); }
  .pd-h1 { margin: .75rem 0 1rem; font-family: var(--font-display); font-size: clamp(2.75rem, 7vw, 6rem); font-weight: 900; line-height: 1.05; letter-spacing: normal; color: var(--color-ink); }
  .pd-lead { margin: 0; max-width: 60ch; font-size: var(--text-lead); line-height: 1.6; color: var(--color-ink-2); }

  .pd-body { padding-bottom: clamp(4rem, 10vw, 8rem); }
  .pd-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .pd-side { position: sticky; top: 6rem; }
  .pd-side__card { background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: var(--radius-sm); padding: 1.1rem; }
  .pd-side__photo { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 1rem; }
  .pd-meta { margin: 0; }
  .pd-meta__row { padding: .85rem 0; border-top: 1px solid var(--color-line); }
  .pd-meta__row:first-child { border-top: 0; padding-top: 0; }
  .pd-meta dt { margin: 0 0 .3rem; } .pd-meta dd { margin: 0; font-weight: 700; color: var(--color-ink); }
  .pd-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .pd-chip { display: inline-block; padding: .3rem .6rem; border-radius: var(--radius-sm); background: var(--color-surface-3); color: var(--color-ink-2); font-family: ui-monospace, monospace; font-size: .72rem; font-weight: 700; }
  .pd-side__cta { display: block; margin-top: 1rem; padding: .8rem 1rem; border-radius: var(--radius-sm); background: var(--color-ink); color: var(--color-surface); text-align: center; text-decoration: none; font-weight: 800; font-size: var(--text-small); transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out); }
  .pd-side__cta:hover { transform: translateY(-2px); opacity: .92; }

  .pd-main { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); min-width: 0; }
  .pd-fig { margin: 0; }
  .pd-fig__k { margin: 0 0 .75rem; }
  .pd-fig__cap { display: block; margin-top: .6rem; text-align: end; }
  .pd-frame { display: block; border-radius: 10px; overflow: hidden; background: var(--color-surface-2); border: 1px solid var(--color-line); box-shadow: 0 30px 60px -24px rgba(0,0,0,.4); }
  .pd-frame__bar { display: flex; gap: .4rem; padding: .55rem .75rem; background: var(--color-surface-3); border-bottom: 1px solid var(--color-line); }
  .pd-frame__bar i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-line-strong); }
  .pd-frame img { display: block; width: 100%; height: auto; }
  .pd-photo { display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--color-line); }
  .pd-photo img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .pd-phones { display: flex; justify-content: center; align-items: flex-start; gap: 1.5rem; padding: 1.5rem; background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: 10px; }
  .pd-phones--one { padding: 1rem; }
  .pd-phones :global(.pm--phone) { flex: 0 0 min(18rem, 42%); }
  .pd-phones--one :global(.pm--phone) { flex-basis: min(16rem, 70%); }
  .pd-phone--back { transform: translateY(2.5rem) rotate(-3deg); opacity: .9; }
  .pd-phone-img { display: block; flex: 0 0 min(16rem, 70%); aspect-ratio: 9 / 19; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 0 0 1px var(--color-line), 0 24px 48px -24px rgba(0,0,0,.5); }
  .pd-phone-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .pd-two { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: clamp(1rem, 2.5vw, 2rem); align-items: start; }
  .pd-second { display: grid; gap: .75rem; }

  .pd-h2 { margin: 0 0 .75rem; font-family: var(--font-display); font-size: var(--text-h3); font-weight: 800; color: var(--color-ink); }
  .pd-prose p { margin: 0 0 1.5rem; font-size: var(--text-body-lg); line-height: 1.75; color: var(--color-ink-2); max-width: 70ch; }
  .pd-built__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .pd-built__list li { display: flex; flex-direction: column; gap: .4rem; padding: 1rem; border-radius: var(--radius-sm); background: var(--color-surface-2); border: 1px solid var(--color-line); }
  .pd-built__list b { font-family: var(--font-display); font-size: var(--text-body-lg); font-weight: 800; color: var(--color-ink); }
  .pd-built__list span { font-size: var(--text-small); line-height: 1.55; color: var(--color-ink-2); }

  .pd-quote { margin: 0; padding: .25rem 1.5rem; border-inline-start: 3px solid var(--color-ink); }
  .pd-quote p { margin: 0 0 .75rem; font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.45; color: var(--color-ink); }

  .pd-next { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line-strong); text-decoration: none; color: inherit; }
  .pd-next__text { display: flex; flex-direction: column; gap: .4rem; }
  .pd-next__name { font-family: var(--font-display); font-size: var(--text-h3); font-weight: 800; color: var(--color-ink); }
  .pd-next:hover .pd-next__name { color: var(--color-electric); }
  .pd-next__btn { flex: none; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 1px solid var(--color-ink); border-radius: var(--radius-sm); color: var(--color-ink); transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out); }
  .pd-next:hover .pd-next__btn { background: var(--color-ink); color: var(--color-surface); transform: translateX(-4px); }

  @media (max-width: 860px) {
    .pd-grid { grid-template-columns: 1fr; }
    .pd-side { position: static; }
    .pd-two, .pd-built__list { grid-template-columns: 1fr; }
  }
</style>
