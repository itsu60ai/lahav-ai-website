---
// PORTFOLIO DETAIL -- one example project.
//
// Only a PUBLISHED item resolves publicly; a draft-only or disabled item
// 404s exactly like a non-existent slug, unless the request is an
// authenticated ?preview=1 (see resolvePreview.ts), same rule the rest of
// the site's preview pages follow.
//
// Structure inspired by a reference agency's own case-study page: a
// full-bleed image dominates the opening view with the name overlaid
// directly on it, then the story reads as flowing narrative paragraphs,
// not boxed feature cards -- reworked with LAHAV's own type/colour
// system, not the reference's own CSS or copy. The first pass here used
// a small inset image beside a text column and three bordered mini-cards
// for the story; client feedback ("looks bad", with the reference's own
// case-study page attached) called for the bolder, more editorial
// treatment this version uses instead.
export const prerender = false;

import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Curve from '../../components/Curve.astro';
import { turnstileSiteKey } from '../../lib/turnstile.ts';
import { resolvePreview } from '../../lib/cms/preview.ts';
import type { PortfolioItemContent } from '../../lib/cms/content.ts';

const SITE_KEY = turnstileSiteKey();
const { portfolioList } = Astro.locals.stores!;
const { slug } = Astro.params;
const preview = await resolvePreview(Astro, Astro.locals.stores!);

let content: PortfolioItemContent | null = null;
if (preview) {
  const draft = await portfolioList.getDraftBySlug(String(slug));
  content = (draft?.content as PortfolioItemContent) ?? null;
} else {
  content = (await portfolioList.getPublishedBySlug(String(slug))) as PortfolioItemContent | null;
}

if (!content) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const item = content; // narrowed, non-null from here down

// "Next project": the next PUBLISHED item after this one, wrapping to
// the first when this is the last. Preview does not get a next-project
// link -- draft items aren't a single stable ordered list the way
// published ones are, and preview's purpose is checking one item, not
// browsing the set.
let next: { name: string; slug: string } | null = null;
if (!preview) {
  const list = await portfolioList.listPublished();
  const idx = list.findIndex((r) => (r.content as PortfolioItemContent).slug === item.slug);
  if (idx !== -1 && list.length > 1) {
    const nextContent = list[(idx + 1) % list.length].content as PortfolioItemContent;
    next = { name: nextContent.name, slug: nextContent.slug };
  }
}
---

<SiteLayout
  title={item.seo.title || `${item.name} | LAHAV AI`}
  description={item.seo.description}
  noindex={item.seo.noindex}
  image={item.seo.ogImage || undefined}
  preview={preview}
  headerSolid
>
  <section class="pd-hero band band--navy">
    {item.heroImage
      ? <img class="pd-hero__img" src={`/api/media/${item.heroImage}`} alt="" />
      : <span class="pd-hero__img pd-hero__placeholder" aria-hidden="true" />}
    <span class="pd-hero__scrim" aria-hidden="true"></span>
    <div class="u-container u-container--wide pd-hero__in">
      <p class="t-eyebrow" data-reveal>{item.industry}</p>
      <h1 class="pd-hero__h1" data-reveal style="--mo-delay:80ms">{item.name}</h1>
      {item.service && <p class="pd-hero__service" data-reveal style="--mo-delay:180ms">{item.service}</p>}
    </div>
  </section>

  <section class="pd-story u-section band">
    <Curve tone="surface" shape="wave" />
    <div class="u-container pd-story__col">
      <p class="pd-story__p" data-reveal>{item.challenge}</p>
      <p class="pd-story__p" data-reveal style="--mo-delay:90ms">{item.approach}</p>
      <p class="pd-story__p pd-story__p--result" data-reveal style="--mo-delay:180ms">{item.result}</p>
    </div>
  </section>

  {next && (
    <nav class="pd-next" aria-label="הפרויקט הבא">
      <div class="u-container u-container--wide pd-next__in">
        <span class="pd-next__k">הפרויקט הבא</span>
        <a class="pd-next__a" href={`/portfolio/${next.slug}/`}>
          {next.name}
          <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </nav>
  )}

  <ContactBlock siteKey={SITE_KEY} preview={preview} />
</SiteLayout>

<style>
  /* Full-bleed image hero, name overlaid directly on it -- the bolder
     treatment the reference case-study page uses, reworked with LAHAV's
     own dark-band convention (band--navy) instead of one-off colours, so
     the eyebrow/heading/link colour swap for a dark background comes
     from the same rule every other navy band on the site already uses. */
  .pd-hero {
    position: relative;
    min-height: clamp(26rem, 78svh, 44rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(5.5rem, 10svh, 7rem); /* clears the solid header */
  }
  .pd-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pd-hero__placeholder {
    background: linear-gradient(135deg, var(--color-navy), var(--color-royal));
  }
  /* Darkest at the top (header legibility) and bottom (footer-of-hero
     legibility), lighter through the middle so the photo still reads. */
  .pd-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 15, 33, 0.72) 0%,
      rgba(9, 15, 33, 0.38) 32%,
      rgba(9, 15, 33, 0.38) 60%,
      rgba(9, 15, 33, 0.75) 100%
    );
  }
  .pd-hero__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .pd-hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: normal;
    margin-block: 0.6rem 0.5rem;
    color: #fff;
    max-width: 18ch;
  }
  .pd-hero__service {
    font-size: var(--text-lead);
    color: rgba(255, 255, 255, 0.82);
    max-width: 40ch;
  }

  /* Story: flowing narrative paragraphs in one centred column, not
     boxed/bordered feature cards. */
  .pd-story { position: relative; overflow: visible; }
  .pd-story__col {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  .pd-story__p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: normal;
    color: var(--color-ink-2);
  }
  .pd-story__p--result {
    color: var(--color-ink);
    font-weight: 800;
  }

  .pd-next {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .pd-next__in { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem 1.5rem; }
  .pd-next__k { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.08em; color: var(--color-ink-3); }
  .pd-next__a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 800;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }
  .pd-next__a:hover { color: var(--color-royal); }
  .pd-next__a .arrow-inline { color: var(--color-electric); }

  @media (max-width: 560px) {
    .pd-hero { min-height: 22rem; }
  }
</style>
