---
export const prerender = false;

// Global settings. ADMIN only -- see require_('settings:sensitive') in
// /api/admin/settings.ts and /api/admin/settings/publish.ts. Draft/
// published, like every other public-facing content area (2026-09-01,
// SOURCE_OF_TRUTH.md F-35): "Save" writes a draft only, visible via
// `?preview=1` on any public page; "Publish" is the separate, explicit
// action that changes what a visitor sees.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { csrfFor } from '../../lib/cms/auth.ts';
import { can } from '../../lib/cms/types.ts';
import { SETTINGS_KEYS, SETTINGS_DEFAULT, SETTINGS_LABELS } from '../../lib/cms/content.ts';
import { getAiStores } from '../../lib/ai/context.ts';
import { ARM_CONFIRMATION_PHRASE } from '../api/admin/ai/auto-publish.ts';

const user = Astro.locals.user!;
if (!can(user, 'settings:sensitive')) return Astro.redirect('/admin', 302);

const { settings } = Astro.locals.stores!;
const draft = await settings.getDraft();
const meta = await settings.meta();
const csrf = await csrfFor(Astro.locals.sessionToken);

// ── AI engine section (Stage D). Read-only unless the user may manage
// settings; the write routes enforce the same permission server-side. ──
const mayManageEngine = can(user, 'settings:manage');
const aiStores = getAiStores();
const [ai, allowTopics, recentAutoPubs] = await Promise.all([
  aiStores.settings.get(),
  aiStores.allowlist.list(),
  aiStores.autoPublications.listRecent(5),
]);

const aiFlash = Astro.url.searchParams.get('ai');
const aiFlashN = Astro.url.searchParams.get('n');
const aiFlashDays = Astro.url.searchParams.get('days');
const AI_FLASH: Record<string, { text: string; ok: boolean }> = {
  saved: { text: 'הגדרות מנוע התוכן נשמרו', ok: true },
  nochange: { text: 'לא היה מה לשמור', ok: true },
  bademail: { text: 'כתובת האימייל אינה תקינה', ok: false },
  armed: { text: `פרסום אוטומטי הופעל ל-${aiFlashDays ?? ''} ימים, ואז ייכבה מעצמו`, ok: true },
  disarmed: { text: 'פרסום אוטומטי כובה', ok: true },
  killed: { text: `פרסום אוטומטי כובה, והוסרו מהאתר ${aiFlashN ?? '0'} מאמרים שפורסמו אוטומטית`, ok: true },
  badconfirm: { text: 'משפט האישור לא הוקלד במדויק, ולכן לא בוצע דבר', ok: false },
  noallowlist: { text: 'אי אפשר להפעיל פרסום אוטומטי לפני שמוסיפים לפחות נושא אחד לרשימת המאושרים', ok: false },
  topicadded: { text: 'הנושא נוסף לרשימה', ok: true },
  topicremoved: { text: 'הנושא הוסר מהרשימה', ok: true },
  badtopic: { text: 'לא הוזן נושא', ok: false },
};

const PROVIDER_OPTIONS: { v: string; label: string }[] = [
  { v: 'mock', label: 'בדיקה, ללא עלות (mock)' },
  { v: 'manual', label: 'הדבקה ידנית, ללא עלות (manual)' },
  { v: 'api', label: 'API בתשלום (api)' },
];
const RECOMMENDATION_OPTIONS: { v: string; label: string }[] = [
  { v: 'heuristic', label: 'חישוב אוטומטי, ללא עלות (heuristic)' },
];

const aiFmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const autoPublishArmed =
  ai.autoPublishEnabled &&
  !!ai.autoPublishExpiresAt &&
  new Date(ai.autoPublishExpiresAt).getTime() > Date.now();
---

<AdminLayout title="הגדרות כלליות">
  <div class="hd">
    <div>
      <h1 class="hd__h">הגדרות כלליות</h1>
      <p class="hd__sub">
        פרטים שחוזרים בכמה מקומות באתר: מספר וואטסאפ, קישור לתיאום שיחה,
        וטקסט כפתור הפעולה הראשי. "שמירה" שומרת טיוטה בלבד -- האתר החי
        ממשיך להראות את הערכים הקודמים עד "פרסום".
        <a href="/?preview=1" target="_blank" rel="noopener">תצוגה מקדימה בעמוד הבית</a>
      </p>
    </div>
    <div class="hd__acts">
      {meta.publishedAt && (
        <span class:list={['adm-pill', meta.hasUnpublishedChanges ? 'adm-pill--draft' : 'adm-pill--published']}>
          <span class="adm-dot"></span>
          {meta.hasUnpublishedChanges ? 'יש שינויים שלא פורסמו' : 'מפורסם ועדכני'}
        </span>
      )}
    </div>
  </div>

  <div class="card">
    {SETTINGS_KEYS.map((key) => (
      <div class="adm-field">
        <label class="adm-label" for={`f-${key}`}>{SETTINGS_LABELS[key]}</label>
        {key === 'whatsapp_message' ? (
          <textarea class="adm-textarea" id={`f-${key}`} data-key={key} rows="2">{draft[key] ?? SETTINGS_DEFAULT[key]}</textarea>
        ) : (
          <input
            class="adm-input"
            id={`f-${key}`}
            data-key={key}
            dir={key === 'whatsapp_number' || key === 'discovery_booking_url' ? 'ltr' : undefined}
            value={draft[key] ?? SETTINGS_DEFAULT[key]}
          />
        )}
      </div>
    ))}

    <div class="acts">
      <button class="adm-btn adm-btn--ghost" type="button" data-save>שמירת טיוטה</button>
      <button class="adm-btn adm-btn--primary" type="button" data-publish>פרסום</button>
      <span class="msg" data-msg></span>
    </div>
  </div>

  <!-- ─────────── AI content engine (Stage D) ───────────
       Added as its own section. Nothing above this line changed.
       These forms POST and redirect; they do not share the JSON save
       button above, on purpose: switching the engine to a paid mode and
       editing a phone number should not be the same click. -->
  <section class="ai">
    <h2 class="ai__h">מנוע תוכן AI</h2>
    <p class="ai__sub">
      כאן נקבע אם המנוע עובד בחינם או בתשלום, ואם מותר לו לפרסם באתר בלי שתאשרו כל מאמר.
      ברירת המחדל היא חינם לגמרי ובלי פרסום אוטומטי.
    </p>

    {
      aiFlash && AI_FLASH[aiFlash] && (
        <p class:list={['ai__flash', AI_FLASH[aiFlash].ok ? 'ai__flash--ok' : 'ai__flash--err']}>
          {AI_FLASH[aiFlash].text}
        </p>
      )
    }

    {
      !mayManageEngine && (
        <p class="ai__note">
          לצפייה בלבד. שינוי ההגדרות האלה דורש הרשאת ניהול הגדרות.
        </p>
      )
    }

    <!-- ── modes ── -->
    <form method="post" action={`/api/admin/ai/settings?csrf=${csrf}`} class="ai__card">
      <h3 class="ai__h3">מצב עבודה</h3>

      <div class="adm-field">
        <label class="adm-label" for="providerMode">איך נכתבות הכתבות</label>
        <select class="adm-select" id="providerMode" name="providerMode" disabled={!mayManageEngine}>
          {PROVIDER_OPTIONS.map((o) => (
            <option value={o.v} selected={ai.providerMode === o.v}>{o.label}</option>
          ))}
        </select>
        <p class="ai__hint">
          "בדיקה" מייצר טקסט לדוגמה בלבד. "הדבקה ידנית" מכין את הבקשה ואתם מדביקים את התשובה
          מהמנוי שכבר יש לכם, בלי עלות נוספת. "API" כותב בלחיצה אחת ומחייב את חשבון Anthropic.
        </p>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="recommendationMode">איך נבחרים הנושאים המומלצים</label>
        <select class="adm-select" id="recommendationMode" name="recommendationMode" disabled={!mayManageEngine}>
          {RECOMMENDATION_OPTIONS.map((o) => (
            <option value={o.v} selected={ai.recommendationMode === o.v}>{o.label}</option>
          ))}
        </select>
        <p class="ai__hint">
          בחירת הנושאים המומלצים רצה על חישוב חינמי מהנתונים שכבר נאספו. מצב AI בתשלום מחובר בארכיטקטורה אך טרם מומש, ולכן אינו ניתן לבחירה
          במקום לחשב משהו.
        </p>
      </div>

      <div class="adm-field">
        <input type="hidden" name="disclosureSubmitted" value="1" />
        <label class="ai__check">
          <input type="checkbox" name="disclosureEnabled" checked={ai.disclosureEnabled} disabled={!mayManageEngine} />
          <span>הוספת משפט גילוי נאות על שימוש ב-AI בתחתית כתבה</span>
        </label>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="autoPublishNotifyEmail">אימייל להתראות על פרסום אוטומטי</label>
        <input
          class="adm-input"
          id="autoPublishNotifyEmail"
          name="autoPublishNotifyEmail"
          type="email"
          dir="ltr"
          value={ai.autoPublishNotifyEmail}
          placeholder="ברירת מחדל: הכתובת המוגדרת במערכת"
          disabled={!mayManageEngine}
        />
      </div>

      {mayManageEngine && <button class="adm-btn adm-btn--primary" type="submit">שמירת מצב העבודה</button>}

      <p class="ai__meta">
        עודכן לאחרונה {aiFmt(ai.updatedAt)}{ai.updatedBy ? ` על ידי ${ai.updatedBy}` : ''}.
      </p>
    </form>

    <!-- ── auto publish ── -->
    <div class:list={['ai__card', 'ai__card--danger', autoPublishArmed && 'is-armed']}>
      <h3 class="ai__h3">
        פרסום אוטומטי
        <span class:list={['adm-pill', autoPublishArmed ? 'adm-pill--draft' : 'adm-pill--published']}>
          {autoPublishArmed ? 'מופעל' : 'כבוי'}
        </span>
      </h3>

      <p class="ai__hint">
        כשזה מופעל, המערכת עשויה לכתוב מאמר ולהעלות אותו לאתר בשמכם בלי שתאשרו אותו קודם.
        זו ההגדרה המשמעותית ביותר במסך הזה. היא כבויה כברירת מחדל, היא נכבית מעצמה בתאריך
        שתקבעו, ויש עליה מכסה שבועית קשיחה.
      </p>

      {
        autoPublishArmed ? (
          <div class="ai__status">
            <p>הופעל על ידי {ai.autoPublishArmedBy || 'לא ידוע'} בתאריך {aiFmt(ai.autoPublishArmedAt)}.</p>
            <p>ייכבה מעצמו בתאריך {aiFmt(ai.autoPublishExpiresAt)}.</p>
            <p>
              מכסה שבועית: {ai.autoPublishWeeklyCap} מאמרים. פורסמו השבוע: {ai.autoPublishCountThisWeek}.
            </p>
          </div>
        ) : (
          <div class="ai__status">
            <p>לא מפורסם דבר באופן אוטומטי. כל מאמר עולה לאתר רק אחרי שאתם לוחצים פרסום.</p>
            {ai.autoPublishKilledAt && (
              <p>הופסק בכיבוי חירום בתאריך {aiFmt(ai.autoPublishKilledAt)} על ידי {ai.autoPublishKilledBy}.</p>
            )}
          </div>
        )
      }

      {/* Layer 7: the topic allow list. An empty list blocks everything,
          which is why it is shown before the arming form and not after. */}
      <div class="ai__allow">
        <h4 class="ai__h4">נושאים שמותר לפרסם עליהם אוטומטית ({allowTopics.length})</h4>
        <p class="ai__hint">
          רשימה ריקה חוסמת הכול. מאמר ייכתב אוטומטית רק אם הנושא שלו מכיל אחת מהמילים כאן,
          וגם רק אם אדם סימן את המקור כמאומת.
        </p>
        {
          allowTopics.length > 0 && (
            <ul class="ai__topics">
              {allowTopics.map((t) => (
                <li class="ai__topic">
                  <span>{t.topic}</span>
                  {
                    mayManageEngine && (
                      <form method="post" action={`/api/admin/ai/auto-publish?csrf=${csrf}`}>
                        <input type="hidden" name="action" value="allow-remove" />
                        <input type="hidden" name="id" value={t.id} />
                        <button class="ai__x" type="submit" aria-label={`הסרת ${t.topic}`}>הסרה</button>
                      </form>
                    )
                  }
                </li>
              ))}
            </ul>
          )
        }
        {
          mayManageEngine && (
            <form method="post" action={`/api/admin/ai/auto-publish?csrf=${csrf}`} class="ai__inline">
              <input type="hidden" name="action" value="allow-add" />
              <input class="adm-input" name="topic" placeholder="לדוגמה: אוטומציות" required />
              <button class="adm-btn adm-btn--ghost" type="submit">הוספת נושא</button>
            </form>
          )
        }
      </div>

      {
        mayManageEngine && !autoPublishArmed && (
          <form method="post" action={`/api/admin/ai/auto-publish?csrf=${csrf}`} class="ai__arm">
            <input type="hidden" name="action" value="arm" />
            <h4 class="ai__h4">הפעלת פרסום אוטומטי</h4>

            <div class="ai__row">
              <div class="adm-field">
                <label class="adm-label" for="expiryDays">לכמה ימים (עד 90)</label>
                <input class="adm-input" id="expiryDays" name="expiryDays" type="number" min="1" max="90" value="30" />
              </div>
              <div class="adm-field">
                <label class="adm-label" for="weeklyCap">מקסימום מאמרים בשבוע (עד 10)</label>
                <input class="adm-input" id="weeklyCap" name="weeklyCap" type="number" min="1" max="10" value="1" />
              </div>
            </div>

            <div class="adm-field">
              <label class="adm-label" for="confirm">
                לאישור, הקלידו במדויק: {ARM_CONFIRMATION_PHRASE}
              </label>
              <input class="adm-input" id="confirm" name="confirm" autocomplete="off" required />
            </div>

            <button class="adm-btn adm-btn--danger" type="submit">הפעלת פרסום אוטומטי</button>
          </form>
        )
      }

      {
        mayManageEngine && autoPublishArmed && (
          <form method="post" action={`/api/admin/ai/auto-publish?csrf=${csrf}`} class="ai__inline">
            <input type="hidden" name="action" value="disarm" />
            <button class="adm-btn adm-btn--primary" type="submit">כיבוי פרסום אוטומטי</button>
          </form>
        )
      }

      {
        mayManageEngine && (
          <form method="post" action={`/api/admin/ai/auto-publish?csrf=${csrf}`} class="ai__kill">
            <input type="hidden" name="action" value="kill" />
            <h4 class="ai__h4">כיבוי חירום</h4>
            <p class="ai__hint">
              פעולה אחת שמכבה את הפרסום האוטומטי וגם מורידה מהאתר כל מאמר שפורסם אוטומטית
              בשבעת הימים האחרונים. התוכן עצמו נשמר וחוזר להיות טיוטה, שום דבר לא נמחק.
            </p>
            <button class="adm-btn adm-btn--danger" type="submit">כיבוי והסרת מה שפורסם אוטומטית</button>
          </form>
        )
      }

      {
        recentAutoPubs.length > 0 && (
          <div class="ai__log">
            <h4 class="ai__h4">מה פורסם אוטומטית לאחרונה</h4>
            <ul class="ai__topics">
              {recentAutoPubs.map((p) => (
                <li class="ai__topic">
                  <span>
                    {p.articleTitle} · {aiFmt(p.publishedAt)}
                    {p.unpublishedAt ? ` · הוסר על ידי ${p.unpublishedBy}` : ''}
                    {!p.notified && p.notifyError ? ' · שליחת ההתראה נכשלה' : ''}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</AdminLayout>

<script define:vars={{ csrf }}>
  const collect = () => {
    const values = {};
    document.querySelectorAll('[data-key]').forEach((el) => (values[el.dataset.key] = el.value));
    return values;
  };
  const msg = document.querySelector('[data-msg]');

  async function saveDraft() {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
      body: JSON.stringify({ values: collect() }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      msg.textContent = 'הטיוטה נשמרה';
      msg.className = 'msg is-ok';
    } else {
      const fieldErrors = data.fields ? Object.values(data.fields).join(' | ') : '';
      msg.textContent = fieldErrors || 'השמירה נכשלה';
      msg.className = 'msg is-err';
    }
    return res.ok;
  }

  document.querySelector('[data-save]')?.addEventListener('click', () => saveDraft());

  document.querySelector('[data-publish]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    btn.disabled = true;
    const saved = await saveDraft();
    if (!saved) { btn.disabled = false; return; }
    const res = await fetch('/api/admin/settings/publish', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
    });
    btn.disabled = false;
    if (res.ok) {
      location.reload();
    } else {
      msg.textContent = 'הפרסום נכשל';
      msg.className = 'msg is-err';
    }
  });
</script>

<style>
  .hd { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .hd__h { font-size: 1.5rem; font-weight: 800; margin: 0; }
  .hd__sub { color: var(--color-ink-3); margin: 0.35rem 0 0; max-width: 40rem; }
  .hd__sub a { color: var(--color-royal); }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    max-width: 34rem;
  }
  .adm-field { margin-bottom: 1.1rem; }
  .acts { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.5rem; }
  .msg { font-size: 0.85rem; }
  .msg.is-ok { color: #1a8a4a; }
  .msg.is-err { color: #c23; }

  /* see admin/faq.astro's comment on why this is :global here too */
  :global(.adm-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }
  :global(.adm-pill--published) { background: #e7f6ec; color: #15803d; }
  :global(.adm-pill--draft) { background: #f1f3f7; color: #55627a; }
  :global(.adm-dot) { width: 0.4375rem; height: 0.4375rem; border-radius: 50%; background: currentColor; }

  /* ── AI engine section ── */
  .ai { margin-top: 2.5rem; max-width: 44rem; }
  .ai__h { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.35rem; }
  .ai__sub { color: var(--color-ink-3); margin: 0 0 1rem; font-size: 0.9375rem; }
  .ai__note {
    font-size: 0.875rem;
    color: #8a5300;
    background: #fff4e5;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
  }
  .ai__flash {
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
  }
  .ai__flash--ok { background: #e7f6ec; color: #15803d; }
  .ai__flash--err { background: #fdeceb; color: #c23; }

  .ai__card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .ai__card--danger { border-color: #f0c98a; }
  .ai__card--danger.is-armed { border-color: #c23; box-shadow: 0 0 0 1px #c23; }
  .ai__h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ai__h4 { font-size: 0.9375rem; font-weight: 700; margin: 0 0 0.4rem; }
  .ai__hint { font-size: 0.8125rem; color: var(--color-ink-3); margin: 0.35rem 0 0; line-height: 1.55; }
  .ai__meta { font-size: 0.75rem; color: var(--color-ink-3); margin-top: 0.9rem; }
  .ai__check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; }
  .ai__status { font-size: 0.875rem; color: var(--color-ink-2); margin: 0.75rem 0; }
  .ai__status p { margin: 0 0 0.2rem; }

  .ai__allow, .ai__arm, .ai__kill, .ai__log {
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line);
  }
  .ai__topics { list-style: none; padding: 0; margin: 0.6rem 0; display: grid; gap: 0.35rem; }
  .ai__topic {
    display: flex;
    justify-content: space-between;
