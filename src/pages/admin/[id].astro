  }
  .bc-icon:hover { background: #f1f5f9; }
  .bc-chip__img { display: block; width: 100%; max-height: 22rem; object-fit: cover; }
  .bc-chip__svg { padding: 1rem; background: #17347f; }
  .bc-chip__note { margin: 0.9rem; font-size: 0.8125rem; color: #64748b; }
  .bc-chip__yt { position: relative; aspect-ratio: 16/9; background: #0b1530; }
  .bc-chip__yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .bc-chip__cap {
    display: block;
    width: 100%;
    margin-top: 0.6rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid #d5dbe6;
    border-radius: 0.4rem;
    font: inherit;
    font-size: 0.8125rem;
    color: #334155;
    background: #fff;
  }
  .bc-chip__status {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: #64748b;
    min-height: 1em;
  }
  .bc-chip--code .bc-chip__lang {
    font: inherit;
    font-size: 0.8125rem;
    border: 1px solid #d5dbe6;
    border-radius: 0.35rem;
    padding: 0.2rem 0.5rem;
    width: 10rem;
    direction: ltr;
  }
  .bc-chip__pre {
    margin: 0;
    padding: 0.9rem 1.1rem;
    background: #0d1730;
    color: #e2e8f0;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .bc-chip__pre code:focus { outline: none; }
