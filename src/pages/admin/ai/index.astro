---
// Stage C: the five-tab dashboard from docs/AI_ENGINE.md section 11.
//
//   LATEST     fresh opportunities from the radar, ranked
//   TRENDING   gaining attention now
//   EVERGREEN  durable topics worth owning
//   DRAFTS     generated, waiting for you
//   PUBLISHED  live, with whether you edited each one
//
// The tabs are plain links with a ?tab= query parameter, so they work with
// JavaScript switched off and each tab is its own shareable URL. No
// client-side script is needed and none is loaded.
//
// Nothing on this page calls a paid API. The recommendation card is the
// free heuristic (recommend/heuristic.ts) and every list below is a read of
// data the radar already collected.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../lib/cms/types.ts';
import { csrfFor } from '../../../lib/cms/auth.ts';
import { getAiStores } from '../../../lib/ai/context.ts';
import { CONTENT_KIND_LABELS } from '../../../lib/ai/types.ts';
import type { Opportunity } from '../../../lib/ai/types.ts';
import { getOrComputeRecommendation } from '../../../lib/ai/recommend/index.ts';
import { SERVICES } from '../../../lib/site.ts';

const user = Astro.locals.user!;
const csrf = await csrfFor(Astro.locals.sessionToken);
const mayCreate = can(user, 'article:create');
const mayDelete = can(user, 'article:delete');

const TABS = ['latest', 'trending', 'evergreen', 'drafts', 'published'] as const;
type Tab = (typeof TABS)[number];
const TAB_LABELS: Record<Tab, string> = {
  latest: 'חדש',
  trending: 'תופס תאוצה',
  evergreen: 'תוכן יסוד',
  drafts: 'טיוטות',
  published: 'פורסם',
};
const TAB_BLURB: Record<Tab, string> = {
  latest: 'הזדמנויות טריות שנאספו מהמקורות הרשמיים, לפי סדר רעננות.',
  trending: 'נושאים שיותר ממקור אחד ברדאר כיסה, או עדכונים שיצאו בשבועיים האחרונים.',
  evergreen: 'נושאים שלא מתיישנים, ששווה להיות הכתובת עליהם לאורך זמן.',
  drafts: 'טיוטות שנוצרו וממתינות לכם. אף אחת מהן אינה גלויה לציבור.',
  published: 'מה שכבר עלה לאתר, ואם ערכתם אותו לפני הפרסום.',
};

const tabParam = Astro.url.searchParams.get('tab');
const tab: Tab = (TABS as readonly string[]).includes(tabParam ?? '') ? (tabParam as Tab) : 'latest';

const aiStores = getAiStores();
const { articles } = Astro.locals.stores!;

const [opportunitiesRaw, generations, settings, recommendation, allArticles, recentFeedback] =
  await Promise.all([
    aiStores.opportunities.list({ status: 'new' }),
    aiStores.generations.list(),
    aiStores.settings.get(),
    getOrComputeRecommendation(aiStores),
    articles.list(),
    aiStores.feedback.listRecent(500),
  ]);

// ── filters for the three "ideas" tabs (latest/trending/evergreen) ──
// Plain query params, same pattern as the tab links: works with no
// client JS, and every combination is a shareable/bookmarkable URL.
// "מדינה" in the client's own words maps to source here, since every
// source is already either an Israeli/Hebrew outlet or an
// international one -- a country field would just duplicate that.
const KIND_FILTER_OPTIONS = Object.entries(CONTENT_KIND_LABELS) as [string, string][];
const DAYS_FILTER_OPTIONS: { value: string; label: string }[] = [
  { value: '', label: 'כל הזמנים' },
  { value: '1', label: '24 שעות אחרונות' },
  { value: '7', label: 'שבוע אחרון' },
  { value: '30', label: 'חודש אחרון' },
];
const sourceNames = Array.from(new Set(opportunitiesRaw.map((o) => o.sourceName))).sort((a, b) =>
  a.localeCompare(b, 'he')
);

const kindFilter = Astro.url.searchParams.get('kind') ?? '';
const sourceFilter = Astro.url.searchParams.get('source') ?? '';
const daysFilter = Astro.url.searchParams.get('days') ?? '';
const hasActiveFilter = !!(kindFilter || sourceFilter || daysFilter);

const opportunities = opportunitiesRaw.filter((o) => {
  if (kindFilter && o.contentKind !== kindFilter) return false;
  if (sourceFilter && o.sourceName !== sourceFilter) return false;
  if (daysFilter) {
    const days = Number(daysFilter);
    const ref = o.publishedAt ?? o.createdAt;
    if (!ref || Date.now() - new Date(ref).getTime() > days * 86_400_000) return false;
  }
  return true;
});

const opportunityById = new Map(opportunities.map((o) => [o.id, o]));
const articleById = new Map(allArticles.map((a) => [a.id, a]));

// ── which generations have a real edit recorded against them ──
// The brief for the PUBLISHED tab asks for "how much you edited it". The
// only truthful source for that is ai_feedback rows of kind 'edit'. There
// is no stored before/after diff to measure a percentage from, so this
// shows נערך / לא נערך rather than a number that would be invented.
const editedGenerations = new Set(
  recentFeedback.filter((f) => f.kind === 'edit').map((f) => f.generationId)
);

// ── tab contents, all derived from real stored fields ──
const RECENT_DAYS = 14;
const isRecent = (o: Opportunity) =>
  !!o.publishedAt && Date.now() - new Date(o.publishedAt).getTime() < RECENT_DAYS * 86_400_000;

// "Gaining attention" without inventing a metric: the heuristic
// recommender already clusters items that cover the same development
// across sources (relatedOpportunityIds). More than one source on one
// story is a real signal. A brand-new product update counts too.
const relatedIds = new Set<string>();
for (const pick of recommendation?.picks ?? []) {
  if (pick.relatedOpportunityIds.length > 0) {
    relatedIds.add(pick.opportunityId);
    for (const rid of pick.relatedOpportunityIds) relatedIds.add(rid);
  }
}

const latest = opportunities;
const trending = opportunities.filter(
  (o) => relatedIds.has(o.id) || ((o.contentKind === 'trend' || o.contentKind === 'release') && isRecent(o))
);
const evergreen = opportunities.filter((o) => o.contentKind === 'evergreen' || o.contentKind === 'comparison');

const withArticles = generations
  .filter((g) => g.articleId && articleById.has(g.articleId))
  .map((g) => ({ g, a: articleById.get(g.articleId!)! }));

const drafts = withArticles.filter((x) => x.a.status !== 'published');
const published = withArticles.filter((x) => x.a.status === 'published');

// pending manual pastes are drafts-in-waiting and belong on the drafts tab
const pendingPastes = generations.filter((g) => g.status === 'pending');

const TAB_COUNTS: Record<Tab, number> = {
  latest: latest.length,
  trending: trending.length,
  evergreen: evergreen.length,
  drafts: drafts.length + pendingPastes.length,
  published: published.length,
};

const VERIFICATION_LABEL: Record<string, string> = {
  unverified: 'לא מאומת',
  partial: 'אומת חלקית',
  verified: 'מאומת',
};
const PRIORITY_LABEL: Record<string, string> = { high: 'גבוהה', medium: 'בינונית', low: 'נמוכה' };
const MODE_LABEL: Record<string, string> = {
  mock: 'בדיקה (ללא עלות)',
  manual: 'הדבקה ידנית (ללא עלות)',
  api: 'API בתשלום',
};

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const backHere = `/admin/ai?tab=${tab}`;
const tabList = TABS.map((t) => ({ id: t, label: TAB_LABELS[t], count: TAB_COUNTS[t] }));
const currentList = tab === 'latest' ? latest : tab === 'trending' ? trending : evergreen;

// Feedback for "איסוף עדכונים עכשיו", which used to redirect back with no
// sign of whether anything actually happened. Read once, straight from
// collect.ts's own result, so this can never say something the collector
// itself didn't report.
const collected = Astro.url.searchParams.get('collected') === '1';
const collectStats = collected
  ? {
      created: Number(Astro.url.searchParams.get('created') ?? 0),
      fetched: Number(Astro.url.searchParams.get('fetched') ?? 0),
      dup: Number(Astro.url.searchParams.get('dup') ?? 0),
      errors: Number(Astro.url.searchParams.get('errors') ?? 0),
    }
  : null;
---

<AdminLayout title="מנוע תוכן AI">
  <div class="hd">
    <div>
      <h1 class="hd__h">מנוע תוכן AI</h1>
      <p class="hd__sub">
        מצב עבודה נוכחי: <strong>{MODE_LABEL[settings.providerMode] ?? settings.providerMode}</strong>
        · פרסום אוטומטי: <strong>{settings.autoPublishEnabled ? 'מופעל' : 'כבוי'}</strong>
      </p>
    </div>
    <div class="hd__acts">
      {
        collectStats && (
          <p class:list={['flash', collectStats.errors > 0 ? 'flash--err' : 'flash--ok']}>
            {collectStats.created > 0
              ? `נוספו ${collectStats.created} עדכונים חדשים (מתוך ${collectStats.fetched} שנסרקו, ${collectStats.dup} כבר היו קיימים).`
              : `לא נוסף כלום חדש (${collectStats.dup} מתוך ${collectStats.fetched} כבר היו קיימים אצלכם, אין עדכונים חדשים במקורות כרגע).`}
            {collectStats.errors > 0 && ` ${collectStats.errors} מקורות לא הצליחו להיסרק.`}
          </p>
        )
      }
      <a class="adm-btn adm-btn--ghost" href="/admin/ai/rules">הכללים שנלמדו</a>
      <a class="adm-btn adm-btn--ghost" href="/admin/ai/sources">מקורות סריקה</a>
      {
        mayCreate && (
          <form method="post" action={`/api/admin/ai/collect?csrf=${csrf}`}>
            <button class="adm-btn adm-btn--ghost" type="submit">איסוף עדכונים עכשיו</button>
          </form>
        )
      }
    </div>
  </div>

  <p class="foot-note">
    כל טיוטה שנוצרת כאן היא טיוטה רגילה במערכת התוכן, מסומנת "תוכן לדוגמה" ולא מפורסמת
    ולא מאונדקסת עד שתעברו עליה ותפרסמו בעצמכם.
  </p>

  <!-- ─────────── today's recommendation, kept at the top ─────────── -->
  <section class="card card--rec">
    <h2 class="card__h">
      מה כדאי לכתוב עליו היום
      <span class="adm-pill adm-pill--rec">
        {recommendation?.mode === 'heuristic' ? 'חישוב אוטומטי, ללא עלות' : 'AI'}
      </span>
    </h2>

    {
      !recommendation ? (
        <div class="empty">
          <p class="empty__t">אין עדיין מספיק נתונים להמלצה</p>
          <p class="empty__b">לחצו "איסוף עדכונים עכשיו" כדי לשלוף עדכונים, וההמלצה תופיע כאן אוטומטית.</p>
        </div>
      ) : (
        <div class="recs">
          {recommendation.picks.map((pick) => {
            const opp = opportunityById.get(pick.opportunityId);
            return (
              <div class="rec">
                <div class="rec__rank">{pick.rank}</div>
                <div class="rec__main">
                  <p class="rec__headline">{pick.headline}</p>
                  <p class="rec__reason"><strong>למה עכשיו:</strong> {pick.reason}</p>
                  <p class="rec__angle"><strong>זווית ל-LAHAV AI:</strong> {pick.angle}</p>
                  {opp && (
                    <div class="opp__meta">
                      <span>{opp.sourceName}</span>
                      {opp.publishedAt && <span>{fmt(opp.publishedAt)}</span>}
                      <span class:list={['adm-pill', `adm-pill--v-${opp.verification}`]}>
                        {VERIFICATION_LABEL[opp.verification]}
                      </span>
                      <a class="opp__src" href={opp.sourceUrl} target="_blank" rel="noopener">פתיחת המקור</a>
                    </div>
                  )}
                </div>
                {
                  mayCreate && (
                    <div class="rec__actions">
                      <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`}>
                        <input type="hidden" name="opportunityId" value={pick.opportunityId} />
                        <button class="adm-btn adm-btn--primary" type="submit">כתיבת מאמר אמיתי</button>
                      </form>
                      <form method="post" action={`/api/admin/ai/generate?csrf=${csrf}`}>
                        <input type="hidden" name="opportunityId" value={pick.opportunityId} />
                        <button class="adm-btn adm-btn--ghost" type="submit">טיוטת בדיקה</button>
                      </form>
                    </div>
                  )
                }
              </div>
            );
          })}
        </div>
      )
    }
  </section>

  <!-- ─────────── the five tabs ─────────── -->
  <nav class="tabs" aria-label="תצוגות מנוע התוכן">
    {
      tabList.map((t) => (
        <a
          class:list={['tabs__t', t.id === tab && 'is-on']}
          href={`/admin/ai?tab=${t.id}`}
          aria-current={t.id === tab ? 'page' : undefined}
        >
          {t.label}
          <span class="tabs__n">{t.count}</span>
        </a>
      ))
    }
  </nav>

  <p class="tabs__blurb">{TAB_BLURB[tab]}</p>

  {
    (tab === 'latest' || tab === 'trending' || tab === 'evergreen') && (
      <form class="filters" method="get" action="/admin/ai">
        <input type="hidden" name="tab" value={tab} />
        <div class="filters__field">
          <label class="filters__lbl" for="f-kind">סוג תוכן</label>
          <select class="adm-input filters__sel" id="f-kind" name="kind">
            <option value="">הכל</option>
            {KIND_FILTER_OPTIONS.map(([value, label]) => (
              <option value={value} selected={value === kindFilter}>{label}</option>
            ))}
          </select>
        </div>
        <div class="filters__field">
          <label class="filters__lbl" for="f-source">מקור</label>
          <select class="adm-input filters__sel" id="f-source" name="source">
            <option value="">כל המקורות</option>
            {sourceNames.map((name) => (
              <option value={name} selected={name === sourceFilter}>{name}</option>
            ))}
          </select>
        </div>
        <div class="filters__field">
          <label class="filters__lbl" for="f-days">פורסם</label>
          <select class="adm-input filters__sel" id="f-days" name="days">
            {DAYS_FILTER_OPTIONS.map((o) => (
              <option value={o.value} selected={o.value === daysFilter}>{o.label}</option>
            ))}
          </select>
        </div>
        <button class="adm-btn adm-btn--primary filters__go" type="submit">סינון</button>
        {hasActiveFilter && (
          <a class="adm-btn adm-btn--ghost filters__go" href={`/admin/ai?tab=${tab}`}>ניקוי סינון</a>
        )}
      </form>
    )
  }
  {
    hasActiveFilter && (tab === 'latest' || tab === 'trending' || tab === 'evergreen') && (
      <p class="filters__count">{currentList.length} תוצאות מתוך {opportunitiesRaw.length} לפי הסינון שבחרתם.</p>
    )
  }

  {
    (tab === 'latest' || tab === 'trending' || tab === 'evergreen') &&
      (currentList.length === 0 ? (
        <div class="card empty">
          <p class="empty__t">{hasActiveFilter ? 'אין תוצאות לסינון הזה' : 'אין כאן פריטים כרגע'}</p>
          <p class="empty__b">
            {hasActiveFilter
              ? 'נסו לנקות את הסינון או לבחור קריטריון אחר.'
              : 'לחצו "איסוף עדכונים עכשיו" כדי לשלוף עדכונים אמיתיים ממקורות רשמיים חינמיים.'}
          </p>
        </div>
      ) : (
        <div class="opps">
          {currentList.map((o) => (
            <article class="opp">
              <div class="opp__main">
                <a class="opp__title" href={o.sourceUrl} target="_blank" rel="noopener">{o.headline}</a>

                <div class="opp__meta">
                  <span>{o.sourceName}</span>
                  {o.publishedAt && <span>{fmt(o.publishedAt)}</span>}
                  <span class:list={['adm-pill', `adm-pill--v-${o.verification}`]}>
                    {VERIFICATION_LABEL[o.verification]}
                  </span>
                  <span class:list={['adm-pill', `adm-pill--p-${o.priority}`]}>עדיפות {PRIORITY_LABEL[o.priority]}</span>
                  <span class="opp__kind">{CONTENT_KIND_LABELS[o.contentKind]}</span>
                </div>

                <p class="opp__why"><strong>למה זה חשוב:</strong> {o.whyItMatters}</p>
                {o.suggestedAngle && <p class="opp__angle"><strong>זווית מוצעת:</strong> {o.suggestedAngle}</p>}

                {/* C3: verification state, its source link, and the action
                    that satisfies the fact gate, all visible before any click */}
                <div class="ver">
                  {
                    o.verification === 'verified' && o.verifiedBy ? (
                      <p class="ver__ok">
                        אומת על ידי {o.verifiedBy}{o.verifiedAt ? ` בתאריך ${fmt(o.verifiedAt)}` : ''}.
                        {o.verificationNote && <span class="ver__note"> {o.verificationNote}</span>}
                      </p>
                    ) : (
                      <p class="ver__warn">
                        {o.verification === 'partial'
                          ? 'אומת חלקית. חלק מהטענות עדיין לא נבדקו מול המקור.'
                          : 'הטענה עדיין לא נבדקה מול המקור. עד לאימות, בדיקת האמת של המערכת תסמן את הכתבה.'}
                      </p>
                    )
                  }

                  {
                    mayCreate && (
                      <form method="post" action={`/api/admin/ai/verify?csrf=${csrf}`} class="ver__form">
                        <input type="hidden" name="id" value={o.id} />
                        <input type="hidden" name="back" value={backHere} />
                        <a class="ver__link" href={o.sourceUrl} target="_blank" rel="noopener">
                          פתיחת המקור לקריאה
                        </a>
                        <input
                          class="adm-input ver__input"
                          type="text"
                          name="note"
                          value={o.verificationNote}
                          placeholder="מה בדקתם (לא חובה)"
                        />
                        {
                          o.verification === 'verified' ? (
                            <button class="adm-btn adm-btn--ghost ver__btn" type="submit" name="verification" value="unverified">
                              ביטול האימות
                            </button>
                          ) : (
                            <>
                              <button class="adm-btn adm-btn--primary ver__btn" type="submit" name="verification" value="verified">
                                אימתתי
                              </button>
                              <button class="adm-btn adm-btn--ghost ver__btn" type="submit" name="verification" value="partial">
                                אומת חלקית
                              </button>
                            </>
                          )
                        }
                      </form>
                    )
                  }
                </div>
              </div>

              {
                mayCreate && (
                  <div class="opp__actions">
                    <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`}>
                      <input type="hidden" name="opportunityId" value={o.id} />
                      <button class="adm-btn adm-btn--primary row__btn" type="submit">כתיבת מאמר אמיתי</button>
                    </form>
                    <form method="post" action={`/api/admin/ai/generate?csrf=${csrf}`}>
                      <input type="hidden" name="opportunityId" value={o.id} />
                      <button class="adm-btn adm-btn--ghost row__btn" type="submit">טיוטת בדיקה</button>
                    </form>
                    <form method="post" action={`/api/admin/ai/dismiss?csrf=${csrf}`}>
                      <input type="hidden" name="id" value={o.id} />
                      <button class="adm-btn adm-btn--ghost row__btn" type="submit">התעלמות</button>
                    </form>
                  </div>
                )
              }
            </article>
          ))}
        </div>
      ))
  }

  {
    tab === 'drafts' && (
      <div class="opps">
        {pendingPastes.map((g) => (
          <article class="opp">
            <div class="opp__main">
              <p class="opp__title">{g.brief.topic}</p>
              <div class="opp__meta">
                <span>{fmt(g.createdAt)}</span>
                <span class="adm-pill adm-pill--placeholder">ממתין להדבקת התשובה</span>
              </div>
              <p class="opp__why">
                הבקשה הוכנה ונשמרה. צריך להדביק את התשובה מהמנוי שלכם כדי להפוך אותה לטיוטה.
              </p>
            </div>
            <div class="opp__actions">
              <a class="adm-btn adm-btn--primary row__btn" href={`/admin/ai/manual/${g.id}`}>המשך הדבקה</a>
            </div>
          </article>
        ))}

        {drafts.map(({ g, a }) => {
          const blocking = g.gates.failures.filter((f) => f.severity === 'blocking').length;
          const review = g.gates.failures.filter((f) => f.severity === 'review').length;
          const opp = g.opportunityId ? opportunityById.get(g.opportunityId) : undefined;
          return (
            <article class="opp">
              <div class="opp__main">
                <p class="opp__title">{a.title}</p>
                <div class="opp__meta">
                  <span>נוצר {fmt(g.createdAt)}</span>
                  {opp && <span>{opp.sourceName}</span>}
                  {opp?.publishedAt && <span>{fmt(opp.publishedAt)}</span>}
                  {opp && (
                    <span class:list={['adm-pill', `adm-pill--v-${opp.verification}`]}>
                      {VERIFICATION_LABEL[opp.verification]}
                    </span>
                  )}
                  <span class:list={['adm-pill', blocking > 0 ? 'adm-pill--blocked' : review > 0 ? 'adm-pill--placeholder' : 'adm-pill--published']}>
                    {blocking > 0
                      ? `${blocking} חסימות לפני פרסום`
                      : review > 0
                        ? `${review} נקודות לבדיקה`
                        : 'עברה את כל הבדיקות'}
                  </span>
                </div>
                <p class="opp__why">{a.excerpt}</p>
                {opp && <p class="opp__angle"><strong>למה זה חשוב:</strong> {opp.whyItMatters}</p>}
              </div>
              <div class="opp__actions">
                <a class="adm-btn adm-btn--primary row__btn" href={`/admin/ai/${g.id}`}>בדיקה ופרטים</a>
                <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${a.id}`}>עריכה</a>
                {
                  mayDelete && (
                    <button class="adm-btn adm-btn--danger row__btn" type="button" data-discard-draft data-article-id={a.id} data-csrf={csrf}>
                      מחיקה
                    </button>
                  )
                }
              </div>
            </article>
          );
        })}

        {drafts.length === 0 && pendingPastes.length === 0 && (
          <div class="card empty">
            <p class="empty__t">אין טיוטות ממתינות</p>
            <p class="empty__b">בחרו נושא מלשונית "חדש" והתחילו כתיבה.</p>
          </div>
        )}
      </div>
    )
  }

  {
    tab === 'published' &&
      (published.length === 0 ? (
        <div class="card empty">
          <p class="empty__t">עוד לא פורסם מאמר שנוצר כאן</p>
          <p class="empty__b">מאמר עולה לאתר רק אחרי שאתם לוחצים פרסום בעורך.</p>
        </div>
      ) : (
        <div class="opps">
          {published.map(({ g, a }) => (
            <article class="opp">
              <div class="opp__main">
                <a class="opp__title" href={`/articles/${a.slug}`} target="_blank" rel="noopener">{a.title}</a>
                <div class="opp__meta">
                  <span>פורסם {fmt(a.publishedAt)}</span>
                  {/* Only what is actually derivable from ai_feedback edit
                      records. No percentage is shown, because none is stored. */}
                  <span class:list={['adm-pill', editedGenerations.has(g.id) ? 'adm-pill--rec' : 'adm-pill--draft']}>
                    {editedGenerations.has(g.id) ? 'נערך' : 'לא נערך'}
                  </span>
                  <span class:list={['adm-pill', g.gates.passed ? 'adm-pill--published' : 'adm-pill--placeholder']}>
                    {g.gates.passed ? 'עבר את כל הבדיקות' : `${g.gates.failures.length} הערות בבדיקה`}
                  </span>
                </div>
                <p class="opp__why">{a.excerpt}</p>
              </div>
              <div class="opp__actions">
                <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/ai/${g.id}`}>פרטי היצירה</a>
                <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${a.id}`}>עריכה</a>
              </div>
            </article>
          ))}
        </div>
      ))
  }

  <!-- ─────────── manual brief: for when you already know the topic ─────────── -->
  {
    mayCreate && (
      <details class="card card--collapsed">
        <summary class="card__h card__h--summary">כתיבת בריף בעצמכם (אופציונלי)</summary>
        <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`} class="brief-form">
          <div class="adm-field">
            <label class="adm-label" for="topic">נושא</label>
            <input class="adm-input" id="topic" name="topic" required placeholder="לדוגמה: איך לבחור מערכת CRM ראשונה" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="goal">מטרת הכתבה</label>
            <input class="adm-input" id="goal" name="goal" placeholder="מה הקורא צריך להבין בסוף" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="audience">קהל יעד</label>
            <input class="adm-input" id="audience" name="audience" placeholder="לדוגמה: בעלי עסקים קטנים ללא צוות טכני" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="contentKind">סוג תוכן</label>
            <select class="adm-select" id="contentKind" name="contentKind">
              {Object.entries(CONTENT_KIND_LABELS).map(([v, label]) => (
                <option value={v}>{label}</option>
              ))}
            </select>
          </div>
          <div class="adm-field">
            <label class="adm-label" for="serviceSlug">שירות רלוונטי</label>
            <select class="adm-select" id="serviceSlug" name="serviceSlug">
              <option value="">ללא</option>
              {SERVICES.map((s) => (
                <option value={s.slug}>{s.name}</option>
              ))}
            </select>
          </div>
          <div class="adm-field adm-field--wide">
            <label class="adm-label" for="notes">הערות (גם מקום להערה על טרנד שראיתם ברשת חברתית)</label>
            <textarea class="adm-textarea" id="notes" name="notes" rows={2} />
          </div>
          <div class="brief-actions">
            <button class="adm-btn adm-btn--primary" type="submit">כתיבת מאמר אמיתי</button>
            <button class="adm-btn adm-btn--ghost" type="submit" formaction={`/api/admin/ai/generate?csrf=${csrf}`}>
              טיוטת בדיקה בלבד
            </button>
          </div>
        </form>
      </details>
    )
  }
</AdminLayout>

