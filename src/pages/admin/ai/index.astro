---
// AI content engine, Stage A: opportunities (the radar) + a manual brief +
// recent generation history. See docs/AI_ENGINE.md. Everything here reads
// and writes through the SAME permission model as the rest of the admin —
// this page requires nothing new in middleware.ts.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../lib/cms/types.ts';
import { csrfFor } from '../../../lib/cms/auth.ts';
import { getAiStores } from '../../../lib/ai/context.ts';
import { CONTENT_KIND_LABELS } from '../../../lib/ai/types.ts';
import { getOrComputeRecommendation } from '../../../lib/ai/recommend/index.ts';
import { SERVICES } from '../../../lib/site.ts';

const user = Astro.locals.user!;
const csrf = await csrfFor(Astro.locals.sessionToken);
const mayCreate = can(user, 'article:create');

const aiStores = getAiStores();
const [opportunities, generations, settings, recommendation] = await Promise.all([
  aiStores.opportunities.list({ status: 'new' }),
  aiStores.generations.list(),
  aiStores.settings.get(),
  // Automatic, free, no button: computed on load (reusing a recent run
  // instead of recomputing every time) — see recommend/index.ts.
  getOrComputeRecommendation(aiStores),
]);
const recentGenerations = generations.slice(0, 10);
const opportunityById = new Map(opportunities.map((o) => [o.id, o]));

const VERIFICATION_LABEL: Record<string, string> = {
  unverified: 'לא מאומת',
  partial: 'אומת חלקית',
  verified: 'מאומת',
};
const PRIORITY_LABEL: Record<string, string> = { high: 'גבוהה', medium: 'בינונית', low: 'נמוכה' };

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---

<AdminLayout title="מנוע תוכן AI">
  <div class="hd">
    <div>
      <h1 class="hd__h">מנוע תוכן AI</h1>
      <p class="hd__sub">
        מצב עבודה נוכחי: <strong>{settings.providerMode === 'mock' ? 'בדיקה (ללא עלות)' : settings.providerMode}</strong>
        · הפעלה אוטומטית: <strong>{settings.autoPublishEnabled ? 'פעילה' : 'כבויה'}</strong>
      </p>
    </div>
    {
      mayCreate && (
        <form method="post" action={`/api/admin/ai/collect?csrf=${csrf}`}>
          <button class="adm-btn adm-btn--ghost" type="submit">איסוף עדכונים עכשיו</button>
        </form>
      )
    }
  </div>

  <p class="foot-note">
    כל טיוטה שנוצרת כאן היא טיוטה רגילה במערכת התוכן, מסומנת "תוכן לדוגמה" ולא מפורסמת
    ולא מאונדקסת עד שתעברו עליה ותפרסמו בעצמכם. שום דבר כאן לא יכול לפרסם לבד.
  </p>

  <!-- ─────────── today's recommendations: the primary interaction ─────────── -->
  <section class="card card--rec">
    <h2 class="card__h">
      מה כדאי לכתוב עליו היום
      <span class="adm-pill adm-pill--rec">
        {recommendation?.mode === 'heuristic' ? 'חישוב אוטומטי, ללא עלות' : 'AI'}
      </span>
    </h2>

    {
      !recommendation ? (
        <div class="empty">
          <p class="empty__t">אין עדיין מספיק נתונים להמלצה</p>
          <p class="empty__b">לחצו "איסוף עדכונים עכשיו" כדי לשלוף עדכונים, וההמלצה תופיע כאן אוטומטית.</p>
        </div>
      ) : (
        <>
          <div class="recs">
            {recommendation.picks.map((pick) => {
              const opp = opportunityById.get(pick.opportunityId);
              return (
                <div class="rec">
                  <div class="rec__rank">{pick.rank}</div>
                  <div class="rec__main">
                    <p class="rec__headline">{pick.headline}</p>
                    <p class="rec__reason"><strong>למה עכשיו:</strong> {pick.reason}</p>
                    <p class="rec__angle"><strong>זווית ל-LAHAV AI:</strong> {pick.angle}</p>
                    {opp && (
                      <a class="rec__source" href={opp.sourceUrl} target="_blank" rel="noopener">
                        מקור: {opp.sourceName} ←
                      </a>
                    )}
                  </div>
                  {
                    mayCreate && (
                      <div class="rec__actions">
                        <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`}>
                          <input type="hidden" name="opportunityId" value={pick.opportunityId} />
                          <button class="adm-btn adm-btn--primary" type="submit">כתיבת מאמר אמיתי</button>
                        </form>
                        <form method="post" action={`/api/admin/ai/generate?csrf=${csrf}`}>
                          <input type="hidden" name="opportunityId" value={pick.opportunityId} />
                          <button class="adm-btn adm-btn--ghost" type="submit">טיוטת בדיקה</button>
                        </form>
                      </div>
                    )
                  }
                </div>
              );
            })}
          </div>
          <p class="foot-note">
            ההמלצה מחושבת אוטומטית מנתונים אמיתיים שכבר נאספו (תאריך פרסום, מקור, שירות תואם,
            עדכונים קשורים) — ללא שימוש במודל שפה, ולכן ללא עלות. שכבת המלצה חכמה יותר מבוססת
            AI מחוברת בארכיטקטורה ומוכנה, אך כבויה עד שתאשרו הפעלה בתשלום.
          </p>
        </>
      )
    }
  </section>

  <!-- ─────────── manual brief: for when you already know the topic ─────────── -->
  {
    mayCreate && (
      <details class="card card--collapsed">
        <summary class="card__h card__h--summary">כתיבת בריף בעצמכם (אופציונלי)</summary>
        <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`} class="brief-form">
          <div class="adm-field">
            <label class="adm-label" for="topic">נושא</label>
            <input class="adm-input" id="topic" name="topic" required placeholder="לדוגמה: איך לבחור מערכת CRM ראשונה" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="goal">מטרת הכתבה</label>
            <input class="adm-input" id="goal" name="goal" placeholder="מה הקורא צריך להבין בסוף" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="audience">קהל יעד</label>
            <input class="adm-input" id="audience" name="audience" placeholder="לדוגמה: בעלי עסקים קטנים ללא צוות טכני" />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="contentKind">סוג תוכן</label>
            <select class="adm-select" id="contentKind" name="contentKind">
              {Object.entries(CONTENT_KIND_LABELS).map(([v, label]) => (
                <option value={v}>{label}</option>
              ))}
            </select>
          </div>
          <div class="adm-field">
            <label class="adm-label" for="serviceSlug">שירות רלוונטי</label>
            <select class="adm-select" id="serviceSlug" name="serviceSlug">
              <option value="">ללא</option>
              {SERVICES.map((s) => (
                <option value={s.slug}>{s.name}</option>
              ))}
            </select>
          </div>
          <div class="adm-field adm-field--wide">
            <label class="adm-label" for="notes">הערות (גם מקום להערה על טרנד שראיתם ברשת חברתית)</label>
            <textarea class="adm-textarea" id="notes" name="notes" rows={2} />
          </div>
          <div class="brief-actions">
            <button class="adm-btn adm-btn--primary" type="submit">כתיבת מאמר אמיתי</button>
            <button class="adm-btn adm-btn--ghost" type="submit" formaction={`/api/admin/ai/generate?csrf=${csrf}`}>
              טיוטת בדיקה בלבד
            </button>
          </div>
        </form>
      </details>
    )
  }

  <!-- ─────────── the full list: browsing everything yourself, secondary now ─────────── -->
  <details class="card card--collapsed">
    <summary class="card__h card__h--summary">כל ההזדמנויות שנאספו ({opportunities.length})</summary>
    {
      opportunities.length === 0 ? (
        <div class="empty">
          <p class="empty__t">אין עדיין הזדמנויות</p>
          <p class="empty__b">לחצו "איסוף עדכונים עכשיו" כדי לשלוף עדכונים אמיתיים ממקורות רשמיים חינמיים.</p>
        </div>
      ) : (
        <div class="opps">
          {opportunities.map((o) => (
            <div class="opp">
              <div class="opp__main">
                <a class="opp__title" href={o.sourceUrl} target="_blank" rel="noopener">{o.headline}</a>
                <div class="opp__meta">
                  <span>{o.sourceName}</span>
                  {o.publishedAt && <span>· {fmt(o.publishedAt)}</span>}
                  <span class:list={['adm-pill', `adm-pill--v-${o.verification}`]}>{VERIFICATION_LABEL[o.verification]}</span>
                  <span class:list={['adm-pill', `adm-pill--p-${o.priority}`]}>עדיפות {PRIORITY_LABEL[o.priority]}</span>
                  <span class="opp__kind">{CONTENT_KIND_LABELS[o.contentKind]}</span>
                </div>
                <p class="opp__why">{o.whyItMatters}</p>
              </div>
              {
                mayCreate && (
                  <div class="opp__actions">
                    <form method="post" action={`/api/admin/ai/manual-prepare?csrf=${csrf}`}>
                      <input type="hidden" name="opportunityId" value={o.id} />
                      <button class="adm-btn adm-btn--primary row__btn" type="submit">כתיבת מאמר אמיתי</button>
                    </form>
                    <form method="post" action={`/api/admin/ai/generate?csrf=${csrf}`}>
                      <input type="hidden" name="opportunityId" value={o.id} />
                      <button class="adm-btn adm-btn--ghost row__btn" type="submit">טיוטת בדיקה</button>
                    </form>
                    <form method="post" action={`/api/admin/ai/dismiss?csrf=${csrf}`}>
                      <input type="hidden" name="id" value={o.id} />
                      <button class="adm-btn adm-btn--ghost row__btn" type="submit">התעלמות</button>
                    </form>
                  </div>
                )
              }
            </div>
          ))}
        </div>
      )
    }
  </details>

  <!-- ─────────── recent generations ─────────── -->
  <section class="card">
    <h2 class="card__h">יצירות אחרונות</h2>
    {
      recentGenerations.length === 0 ? (
        <p class="empty__b">עוד לא נוצרה אף טיוטה.</p>
      ) : (
        <div class="tbl">
          <div class="tbl__head">
            <span>כותרת בריף</span>
            <span>סטטוס</span>
            <span>בדיקות איכות</span>
            <span>עלות</span>
            <span class="tbl__actions-h">פעולות</span>
          </div>
          {recentGenerations.map((g) => (
            <div class="row">
              <div class="row__main">
                <span class="row__title">{g.brief.topic}</span>
                <div class="row__meta">
                  <span class="row__date">{fmt(g.createdAt)}</span>
                </div>
              </div>
              <span>
                {
                  g.status === 'pending' ? (
                    <span class="adm-pill adm-pill--placeholder">ממתין להדבקה</span>
                  ) : (
                    <span class:list={['adm-pill', g.status === 'succeeded' ? 'adm-pill--published' : 'adm-pill--draft']}>
                      {g.status === 'succeeded' ? 'הצליח' : 'נכשל'}
                    </span>
                  )
                }
                {g.providerMode === 'manual' && <span class="row__mode">הדבקה ידנית</span>}
              </span>
              <span>
                {
                  g.status !== 'pending' && (
                    <span class:list={['adm-pill', g.gates.passed ? 'adm-pill--published' : 'adm-pill--placeholder']}>
                      {g.gates.passed ? 'עברו הכל' : `${g.gates.failures.length} דגלים`}
                    </span>
                  )
                }
              </span>
              <span class="row__date">${g.costUsd.toFixed(4)}</span>
              <span class="row__actions">
                {
                  g.status === 'pending' ? (
                    <a class="adm-btn adm-btn--primary row__btn" href={`/admin/ai/manual/${g.id}`}>המשך הדבקה</a>
                  ) : (
                    <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/ai/${g.id}`}>פרטים</a>
                  )
                }
                {g.articleId && (
                  <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${g.articleId}`}>עריכה</a>
                )}
              </span>
            </div>
          ))}
        </div>
      )
    }
  </section>
</AdminLayout>

<style>
  .hd {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .hd__h {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
  }
  .hd__sub {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-top: 0.25rem;
  }
  .foot-note {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    padding: 1.25rem 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .card__h {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* the primary card: today's recommendations */
  .card--rec {
    border-color: var(--color-royal);
    box-shadow: 0 0 0 1px var(--color-royal);
  }
  .adm-pill--rec {
    background: #eaf0ff;
    color: var(--color-royal);
    font-weight: 700;
  }
  .recs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .rec__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rec {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface-2);
  }
  .rec__rank {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-royal);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .rec__main {
    min-width: 0;
  }
  .rec__headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
  }
  .rec__reason,
  .rec__angle {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
    margin-bottom: 0.25rem;
  }
  .rec__source {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    text-decoration: none;
  }
  .rec__source:hover {
    color: var(--color-royal);
  }

  /* collapsed-by-default secondary sections (manual brief, full list) */
  .card--collapsed {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .card__h--summary {
    cursor: pointer;
    list-style: none;
    margin-bottom: 0;
  }
  .card--collapsed[open] .card__h--summary {
    margin-bottom: 1rem;
  }
  .card__h--summary::-webkit-details-marker {
    display: none;
  }
  .card__h--summary::before {
    content: '▸';
    color: var(--color-ink-3);
    font-size: 0.875rem;
  }
  .card--collapsed[open] .card__h--summary::before {
    content: '▾';
  }

  .brief-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: end;
  }
  .adm-field--wide {
    grid-column: 1 / -1;
  }
  .brief-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.625rem;
    justify-self: start;
  }

  .empty {
    text-align: center;
    padding: 2rem 1rem;
  }
  .empty__t {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .empty__b {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .opps {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .opp {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0.625rem;
    flex-wrap: wrap;
  }
  .opp__main {
    min-width: 0;
    flex: 1;
  }
  .opp__title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .opp__title:hover {
    color: var(--color-royal);
    text-decoration: underline;
  }
  .opp__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .opp__kind {
    font-weight: 700;
    color: var(--color-royal);
  }
  .opp__why {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  .opp__actions {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .adm-pill--v-unverified { background: #fff4e5; color: #8a5300; }
  .adm-pill--v-partial { background: #eaf0ff; color: var(--color-royal); }
  .adm-pill--v-verified { background: #e7f6ec; color: #15803d; }
  .adm-pill--p-high { background: #fdeceb; color: var(--color-error); }
  .adm-pill--p-medium { background: #fff4e5; color: #8a5300; }
  .adm-pill--p-low { background: #f1f3f7; color: #55627a; }

  .tbl {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .tbl__head,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem 8rem 6rem auto;
    gap: 1rem;
    align-items: center;
    padding: 0.875rem 1.125rem;
  }
  .tbl__head {
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-3);
  }
  .tbl__actions-h { text-align: start; }
  .row + .row, .tbl__head + .row { border-top: 1px solid var(--color-line); }
  .row__title { font-weight: 700; }
  .row__meta { margin-top: 0.25rem; }
  .row__date { font-size: 0.8125rem; color: var(--color-ink-3); }
  .row__mode { display: block; margin-top: 0.25rem; font-size: 0.75rem; color: var(--color-ink-3); }
  .row__actions { display: flex; gap: 0.375rem; }
  .row__btn { padding: 0.375rem 0.75rem; font-size: 0.8125rem; }

  @media (max-width: 900px) {
    .brief-form { grid-template-columns: 1fr; }
    .tbl__head { display: none; }
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
