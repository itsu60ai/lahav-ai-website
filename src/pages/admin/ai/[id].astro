---
// One generation, rebuilt as a real REVIEW screen (client feedback
// 2026-09-01): every issue is an actionable Hebrew card, not a raw gate
// name; the article itself is always one click away; "recheck" re-runs
// the gates against whatever the article looks like right now, without
// recreating anything. See docs/AI_ENGINE.md.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../lib/cms/types.ts';
import { csrfFor } from '../../../lib/cms/auth.ts';
import { getAiStores } from '../../../lib/ai/context.ts';
import { isSvgSafe } from '../../../lib/ai/validate.ts';
import type { GateFailure } from '../../../lib/ai/types.ts';

const user = Astro.locals.user!;
const { id } = Astro.params;
const aiStores = getAiStores();
const generation = await aiStores.generations.get(String(id));
if (!generation) return Astro.redirect('/admin/ai', 302);

const { articles } = Astro.locals.stores!;
const [assets, feedback, article] = await Promise.all([
  aiStores.assets.listByGeneration(generation.id),
  aiStores.feedback.listByGeneration(generation.id),
  generation.articleId ? articles.get(generation.articleId) : Promise.resolve(null),
]);
const visual = assets[0];
const csrf = await csrfFor(Astro.locals.sessionToken);
const mayCreate = can(user, 'article:create');
const mayPublish = can(user, 'article:publish');
const mayDelete = can(user, 'article:delete');
const feedbackSaved = Astro.url.searchParams.get('feedback') === 'saved';

const fmt = (iso: string) => new Date(iso).toLocaleString('he-IL', { dateStyle: 'medium', timeStyle: 'short' });

// Severity, not a flat pass/fail — see src/lib/ai/gates.ts.
const failures: GateFailure[] = generation.gates.failures;
const blocking = failures.filter((f) => f.severity === 'blocking');
const review = failures.filter((f) => f.severity === 'review');
const info = failures.filter((f) => f.severity === 'info');
const needsAttention = blocking.length + review.length;

const outcome: 'pass' | 'review' | 'blocked' =
  generation.status !== 'succeeded' ? 'blocked' : blocking.length > 0 ? 'blocked' : review.length > 0 ? 'review' : 'pass';
const OUTCOME_LABEL = { pass: 'תקין ✓', review: 'דורש בדיקה', blocked: 'חסום' } as const;
const OUTCOME_CLASS = { pass: 'adm-pill--published', review: 'adm-pill--placeholder', blocked: 'adm-pill--blocked' } as const;
const SEVERITY_LABEL = { blocking: 'חוסם', review: 'לבדיקה', info: 'הערה' } as const;
const SEVERITY_CLASS = { blocking: 'issue--blocking', review: 'issue--review', info: 'issue--info' } as const;

// ordered so the most serious issues render first
const orderedFailures = [...blocking, ...review, ...info];

// The browser is redirected here the moment a generation STARTS, so this
// screen is the first thing the user sees while the article is still being
// written in the background (see src/lib/ai/generate.ts). Without this the
// page reported the run as "חסום" -- blocked -- which is a lie: nothing is
// wrong, it simply is not finished. A manual generation is also 'pending',
// but that one is waiting for a person, not for the machine.
const isRunning = generation.status === 'pending' && generation.providerMode !== 'manual';
const isAwaitingPaste = generation.status === 'pending' && generation.providerMode === 'manual';
const runFailed = generation.status === 'failed';
---

<AdminLayout title={`בדיקת מאמר: ${generation.brief.topic}`}>
  {/* The run is DRIVEN from here, not polled: the fetch below holds a
      streaming connection open, and that is what keeps the Worker alive
      long enough to finish writing (see src/pages/api/admin/ai/run.ts).
      The meta refresh is only a fallback for a stalled row. */}

  <div class="crumbs">
    <a href="/admin/ai">מנוע תוכן AI</a>
    <span aria-hidden="true">›</span>
    <span>{generation.brief.topic}</span>
  </div>

  <div class="hd">
    <div>
      <h1 class="hd__h">{generation.brief.topic}</h1>
      <p class="hd__sub">
        {fmt(generation.createdAt)} · מודל: {generation.model} · עלות: ${generation.costUsd.toFixed(4)}
      </p>
    </div>
  </div>

  {
    isRunning && (
      <section class="card card--running" data-run-panel data-generation-id={generation.id} data-csrf={csrf}>
        <h2 class="running__h">הכתבה נכתבת עכשיו</h2>
        <p class="running__b" data-run-status>
          המערכת כותבת את הכתבה. זה לוקח בדרך כלל בין דקה לשלוש דקות.
          <strong>חשוב: אל תסגרו את החלון הזה עד שזה מסתיים.</strong>
        </p>
        <div class="run-bar" aria-hidden="true"><span class="run-bar__fill"></span></div>
        <p class="running__note">מצב: {generation.providerMode === 'api' ? 'כתיבה אוטומטית בתשלום' : 'יצירת שלד לדוגמה, ללא עלות'}</p>
      </section>
    )
  }

  {
    isAwaitingPaste && (
      <section class="card card--running">
        <h2 class="running__h">ממתין להדבקה שלכם</h2>
        <p class="running__b">
          הבקשה מוכנה. צריך להעתיק אותה למנוי ה-AI שלכם ולהדביק את התשובה בחזרה.
        </p>
        <a class="adm-btn adm-btn--primary" href={`/admin/ai/manual/${generation.id}`}>למסך ההדבקה</a>
      </section>
    )
  }

  {
    runFailed && !article && (
      <section class="card card--failed">
        <h2 class="running__h">הכתיבה נכשלה, לא נוצרה כתבה</h2>
        <p class="running__b">{generation.gates.failures[0]?.detail ?? 'לא התקבלו פרטים נוספים.'}</p>
        <p class="running__note">
          ההזדמנות נשארה ברשימה ואפשר לנסות שוב. אם זה חוזר, בדקו את מצב הספק במסך ההגדרות.
        </p>
        <a class="adm-btn adm-btn--ghost" href="/admin/ai?tab=latest">חזרה לרשימת הרעיונות</a>
      </section>
    )
  }

  <!-- ─────────── this page is a REVIEW screen: say so, and put the article one click away ─────────── -->
  <section class="card card--primary" hidden={isRunning || isAwaitingPaste || (runFailed && !article)}>
    <p class="review-kicker">זהו מסך בדיקה וסקירה. עריכת התוכן עצמו נעשית במאמר.</p>
    <div class="status-row">
      <span class:list={['adm-pill', 'adm-pill--outcome', OUTCOME_CLASS[outcome]]}>
        מצב המאמר: {OUTCOME_LABEL[outcome]}
      </span>
      {needsAttention > 0 && <span class="status-note status-note--warn">{needsAttention} נושאים דורשים טיפול</span>}
      {info.length > 0 && <span class="status-note">{info.length === 1 ? 'הערה אחת בלבד' : `${info.length} הערות בלבד`}</span>}
      {needsAttention === 0 && info.length === 0 && <span class="status-note status-note--ok">הכל תקין</span>}
    </div>

    <div class="primary-actions">
      {
        article && (
          <>
            <a class="adm-btn adm-btn--primary" href={`/admin/${article.id}`}>עריכת המאמר</a>
            <a class="adm-btn adm-btn--ghost" href={`/admin/preview/${article.id}`} target="_blank" rel="noopener">
              תצוגה מקדימה
            </a>
          </>
        )
      }
      {
        mayCreate && article && (
          <form method="post" action={`/api/admin/ai/recheck?csrf=${csrf}`}>
            <input type="hidden" name="generationId" value={generation.id} />
            <button class="adm-btn adm-btn--ghost" type="submit">בדיקה מחדש</button>
          </form>
        )
      }
      {
        article && mayPublish && (
          <button
            class="adm-btn adm-btn--primary"
            type="button"
            data-publish-toggle
            data-article-id={article.id}
            data-target-status={article.status === 'published' ? 'draft' : 'published'}
            data-csrf={csrf}
            disabled={outcome !== 'pass' && article.status !== 'published'}
          >
            {article.status === 'published' ? 'הסרה מפרסום' : 'פרסום המאמר'}
          </button>
        )
      }
      {
        // General "delete this draft" action -- previously this only
        // appeared buried inside one specific blocking-gate card, so a
        // draft you simply didn't want had no visible way to remove.
        // Never shown for a published article: that one goes through
        // /admin/[id].astro's own delete, which also unpublishes it from
        // the live site first.
        article && article.status !== 'published' && mayDelete && (
          <button
            class="adm-btn adm-btn--danger"
            type="button"
            data-discard-draft
            data-article-id={article.id}
            data-csrf={csrf}
          >
            מחיקת הטיוטה
          </button>
        )
      }
    </div>
    {
      article && outcome !== 'pass' && article.status !== 'published' && (
        <p class="foot-note">
          פרסום זמין רק כשהמצב הוא "תקין ✓". טפלו בנושאים למטה, לחצו "בדיקה מחדש", והכפתור ייפתח.
        </p>
      )
    }
    {
      article?.status === 'published' && (
        <p class="foot-note foot-note--ok">המאמר הזה מפורסם וגלוי באתר כרגע.</p>
      )
    }
  </section>

  <!-- ─────────── issue cards ─────────── -->
  <section class="card" hidden={isRunning || isAwaitingPaste || (runFailed && !article)}>
    <h2 class="card__h">בדיקות איכות</h2>
    {
      orderedFailures.length === 0 ? (
        <p class="empty__b">כל הבדיקות עברו. עדיין מומלץ לקרוא את המאמר לפני פרסום, זו לא ערובה מוחלטת.</p>
      ) : (
        <div class="issues">
          {orderedFailures.map((f) => (
            <div class:list={['issue', SEVERITY_CLASS[f.severity]]}>
              <div class="issue__head">
                <span class:list={['issue__badge', SEVERITY_CLASS[f.severity]]}>{SEVERITY_LABEL[f.severity]}</span>
                <h3 class="issue__title">{f.title}</h3>
              </div>
              <p class="issue__detail">{f.detail}</p>
              {f.evidence && (
                <p class="issue__evidence">
                  <span class="issue__label">המשפט הרלוונטי:</span> “{f.evidence}”
                </p>
              )}
              {f.location && (
                <p class="issue__meta"><span class="issue__label">מיקום:</span> {f.location}</p>
              )}
              {f.meta?.sourceChecked && (
                <p class="issue__meta"><span class="issue__label">מקורות שנבדקו:</span> {f.meta.sourceChecked}</p>
              )}
              {f.meta?.matchedArticleTitle && (
                <p class="issue__meta">
                  <span class="issue__label">מאמר תואם:</span> "{f.meta.matchedArticleTitle}"
                </p>
              )}
              {f.suggestion && <p class="issue__suggestion">💡 {f.suggestion}</p>}

              <div class="issue__actions">
                {article && <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${article.id}`}>עריכת המאמר</a>}
                {f.meta?.matchedArticleId && (
                  <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${f.meta.matchedArticleId}`}>
                    פתיחת המאמר הקיים
                  </a>
                )}
                {f.gate === 'duplicate-topic' && f.severity === 'review' && mayCreate && (
                  <form method="post" action={`/api/admin/ai/feedback?csrf=${csrf}`}>
                    <input type="hidden" name="generationId" value={generation.id} />
                    <input type="hidden" name="articleId" value={generation.articleId ?? ''} />
                    <input type="hidden" name="kind" value="approve" />
                    <input type="hidden" name="note" value={`הנושאים שונים בפועל (לא כפילות): ${f.meta?.matchedArticleTitle ?? ''}`} />
                    <button class="adm-btn adm-btn--ghost row__btn" type="submit">הנושאים שונים, המשך</button>
                  </form>
                )}
                {f.gate === 'duplicate-topic' && f.severity === 'blocking' && article && mayDelete && (
                  <button class="adm-btn adm-btn--danger row__btn" type="button" data-discard-draft data-article-id={article.id} data-csrf={csrf}>
                    ביטול הטיוטה
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <!-- ─────────── visual ─────────── -->
  {
    visual && (
      <section class="card">
        <h2 class="card__h">תמונת הכתבה</h2>
        <div class="visual-frame">
          {isSvgSafe(visual.svgMarkup) ? (
            <Fragment set:html={visual.svgMarkup} />
          ) : (
            <p class="empty__b">התמונה נחסמה משום שהכילה תוכן לא בטוח.</p>
          )}
        </div>
        <dl class="kv">
          <dt>קובץ</dt><dd dir="ltr">{visual.filename}</dd>
          <dt>טקסט חלופי (alt)</dt><dd>{visual.altText}</dd>
          <dt>מקור</dt>
          <dd>{visual.source === 'mock' ? 'תרשים ברירת מחדל (זמני)' : 'תרשים ייחודי לכתבה'}</dd>
        </dl>
        <p class="foot-note">
          {visual.source === 'generated'
            ? 'התרשים הזה ייחודי לכתבה ומופיע גם בתצוגה המקדימה ובעמוד הציבורי.'
            : 'זהו תרשים ברירת מחדל של השירות, לא תרשים ייחודי לכתבה. אפשר לשנות את סוג התרשים בעריכת המאמר.'}
        </p>
      </section>
    )
  }

  <!-- ─────────── SEO package ─────────── -->
  {
    generation.output && (
      <section class="card">
        <h2 class="card__h">חבילת SEO</h2>
        <dl class="kv">
          <dt>כותרת SEO</dt><dd>{generation.output.seo.seoTitle}</dd>
          <dt>meta title</dt><dd>{generation.output.seo.metaTitle}</dd>
          <dt>meta description</dt><dd>{generation.output.seo.metaDescription}</dd>
          <dt>slug</dt><dd dir="ltr">{generation.output.seo.slug}</dd>
          <dt>מילת מפתח ראשית</dt><dd>{generation.output.seo.primaryKeyword}</dd>
          <dt>כתובת קנונית</dt><dd dir="ltr">{generation.output.seo.canonicalPath}</dd>
          <dt>ניתן לאינדוקס</dt><dd>{generation.output.seo.indexable ? 'כן' : 'לא (טיוטה שאינה מפורסמת)'}</dd>
        </dl>
        {
          generation.output.seo.citations.length > 0 && (
            <>
              <p class="kv-label">מקורות</p>
              <ul class="cites">
                {generation.output.seo.citations.map((c) => (
                  <li>
                    <a href={c.url} target="_blank" rel="noopener">{c.label}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    )
  }

  <!-- ─────────── the assembled prompt, for transparency ─────────── -->
  <section class="card">
    <h2 class="card__h">הפרומפט שהורכב</h2>
    <p class="foot-note">
      זהו הטקסט המלא שנשלח (או הוכן להדבקה) עבור המודל. שום דבר כאן לא משתנה בעריכה או בבדיקה מחדש.
    </p>
    <details>
      <summary class="adm-btn adm-btn--ghost">הצגת הפרומפט המלא</summary>
      <pre class="prompt-pre">{generation.promptText}</pre>
    </details>
  </section>

  <!-- ─────────── learning feedback: explicitly NOT article approval ─────────── -->
  {
    mayCreate && (
      <section class="card">
        <h2 class="card__h">כיצד הייתה התוצאה? עזרו למנוע להשתפר</h2>
        <p class="foot-note">
          זה לא מפרסם ולא מאשר את המאמר, זה רק מלמד את המנוע מה עבד ומה לא בפעם הבאה.
        </p>
        {feedbackSaved && <p class="fb-saved">✓ המשוב נשמר, תודה.</p>}
        <form method="post" action={`/api/admin/ai/feedback?csrf=${csrf}`} class="fb-form">
          <input type="hidden" name="generationId" value={generation.id} />
          <input type="hidden" name="articleId" value={generation.articleId ?? ''} />
          <div class="adm-field adm-field--wide">
            <label class="adm-label" for="note">מה כדאי לשפר בפעם הבאה? (אופציונלי, אבל הכי מועיל)</label>
            <textarea class="adm-textarea" id="note" name="note" rows={2} />
          </div>
          <div class="fb-actions">
            <button class="adm-btn adm-btn--primary" type="submit" name="kind" value="approve">אהבתי את התוצאה</button>
            <button class="adm-btn adm-btn--ghost" type="submit" name="kind" value="reject">לא אהבתי</button>
          </div>
        </form>
        {
          feedback.length > 0 && (
            <ul class="fb-list">
              {feedback.map((f) => (
                <li>
                  <strong>{f.kind === 'approve' ? 'אהבו את התוצאה' : f.kind === 'reject' ? 'לא אהבו' : f.kind}</strong>
                  {f.note ? `: ${f.note}` : ''}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    )
  }
</AdminLayout>

<script>
  // Publish / unpublish from the review screen, reusing the existing
  // permission-safe CMS status endpoint exactly as the article editor
  // does — this button never publishes anything by itself; it only
  // becomes clickable once the review status is PASS (or to unpublish,
  // always available). After it succeeds, reload this same review page.
  document.querySelectorAll('[data-publish-toggle]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const id = el.dataset.articleId;
      const status = el.dataset.targetStatus;
      const csrf = el.dataset.csrf;
      el.disabled = true;
      try {
        const res = await fetch(`/api/admin/status?csrf=${csrf}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, status }),
        });
        if (res.ok) {
          location.reload();
        } else {
          const body = (await res.json().catch(() => ({}))) as { error?: string };
          alert(body.error || 'הפעולה נכשלה');
          el.disabled = false;
        }
      } catch {
        alert('הפעולה נכשלה, בדקו את החיבור ונסו שוב.');
        el.disabled = false;
      }
    });
  });

  // ── drive the generation ──
  // The Worker only stays alive while it is streaming to a client that is
  // still reading, so this fetch IS the thing that makes a long generation
  // possible at all. Reading the body to completion is not optional.
  (() => {
    const panel = document.querySelector('[data-run-panel]');
    if (!panel) return;
    const statusEl = panel.querySelector('[data-run-status]');
    const id = panel.getAttribute('data-generation-id') || '';
    const csrf = panel.getAttribute('data-csrf') || '';
    const started = Date.now();

    const tick = setInterval(() => {
      if (!statusEl) return;
      const secs = Math.round((Date.now() - started) / 1000);
      statusEl.innerHTML =
        'המערכת כותבת את הכתבה. עברו ' + secs + ' שניות. ' +
        '<strong>אל תסגרו את החלון הזה עד שזה מסתיים.</strong>';
    }, 1000);

    fetch('/api/admin/ai/run?csrf=' + encodeURIComponent(csrf), {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ generationId: id }),
    })
      .then(async (res) => {
        if (!res.body) return;
        const reader = res.body.getReader();
        // Drain it. Every chunk read is another few seconds of life for
        // the Worker doing the writing.
        for (;;) {
          const { done } = await reader.read();
          if (done) break;
        }
      })
      .catch(() => {})
      .finally(() => {
        clearInterval(tick);
        location.reload();
      });
  })();

  // Discard draft: same delete capability as the article list, just
  // reachable from the review screen for a genuine-duplicate case.
  document.querySelectorAll('[data-discard-draft]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      if (!confirm('לבטל את הטיוטה הזו? הפעולה אינה הפיכה.')) return;
      const id = el.dataset.articleId;
      const csrf = el.dataset.csrf;
      el.disabled = true;
      try {
        const res = await fetch(`/api/admin/delete?csrf=${csrf}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        if (res.ok) {
          location.href = '/admin/ai';
        } else {
          alert('הפעולה נכשלה');
          el.disabled = false;
        }
      } catch {
        alert('הפעולה נכשלה, בדקו את החיבור ונסו שוב.');
        el.disabled = false;
      }
    });
  });
</script>

<style>
  .card--running { border-inline-start: 3px solid var(--color-electric); }
  .card--failed { border-inline-start: 3px solid var(--color-error); }
  .running__h { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem; }
  .running__b { font-size: 0.9375rem; line-height: 1.7; color: var(--color-ink-2); max-width: 46rem; }
  .running__note { font-size: 0.8125rem; color: var(--color-ink-3); margin-top: 0.5rem; }
  .run-bar { height: 4px; border-radius: 999px; background: var(--color-line); overflow: hidden; margin-top: 1rem; }
  .run-bar__fill { display: block; height: 100%; width: 35%; border-radius: 999px; background: var(--color-electric); animation: run-slide 1.4s ease-in-out infinite; }
  @keyframes run-slide { 0% { transform: translateX(-120%) } 100% { transform: translateX(320%) } }
  @media (prefers-reduced-motion: reduce) { .run-bar__fill { animation: none; width: 100% } }

  .crumbs {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }
  .crumbs a { color: var(--color-ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--color-royal); }

  .adm-pill--outcome {
    font-size: 0.9375rem;
    padding: 0.375rem 0.875rem;
  }
  .adm-pill--blocked {
    background: var(--color-error-soft);
    color: var(--color-error);
