---
// C2: the editable learned-rule list. See docs/AI_ENGINE.md section 10.
//
// These rows are what the engine remembers about your corrections, in
// plain Hebrew, and they are injected into every prompt by prompt.ts.
// Nothing here calls a model and nothing here costs anything.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../lib/cms/types.ts';
import { csrfFor } from '../../../lib/cms/auth.ts';
import { getAiStores } from '../../../lib/ai/context.ts';

const user = Astro.locals.user!;
if (!can(user, 'article:create')) return Astro.redirect('/admin', 302);

const csrf = await csrfFor(Astro.locals.sessionToken);
const mayDelete = can(user, 'settings:manage');

const rules = await getAiStores().rules.listAll();
const activeCount = rules.filter((r) => r.active).length;

const done = Astro.url.searchParams.get('done');
const err = Astro.url.searchParams.get('err');

const DONE_TEXT: Record<string, string> = {
  added: 'הכלל נוסף',
  saved: 'הכלל עודכן',
  deleted: 'הכלל נמחק',
  activated: 'הכלל הופעל מחדש',
  deactivated: 'הכלל הושבת',
};

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' });
---

<AdminLayout title="הכללים שהמערכת למדה">
  <div class="hd">
    <div>
      <h1 class="hd__h">הכללים שהמערכת למדה</h1>
      <p class="hd__sub">
        זו הזיכרון של המערכת, בשפה רגילה. כל הערה שכתבתם בדחייה או בתיקון של טיוטה
        נשמרת כאן, והכללים הפעילים נוספים לכל בקשה חדשה שנשלחת לכתיבה.
        כלל שאינו נכון אפשר לתקן, להשבית או למחוק. אין כאן שום חישוב בתשלום.
      </p>
    </div>
    <a class="adm-btn adm-btn--ghost" href="/admin/ai">חזרה למנוע התוכן</a>
  </div>

  {done && DONE_TEXT[done] && <p class="flash flash--ok">{DONE_TEXT[done]}</p>}
  {err === 'empty' && <p class="flash flash--err">לא ניתן לשמור כלל ריק. כתבו את הכלל או השביתו אותו.</p>}

  <section class="card">
    <h2 class="card__h">הוספת כלל בעצמכם</h2>
    <form method="post" action={`/api/admin/ai/rules?csrf=${csrf}`} class="add">
      <input type="hidden" name="action" value="add" />
      <label class="adm-label" for="newRule">הכלל, במשפט אחד</label>
      <textarea
        class="adm-textarea"
        id="newRule"
        name="ruleText"
        rows="2"
        required
        placeholder="לדוגמה: לפתוח כל כתבה במשפט שמסביר מה הקורא ירוויח, ולא בהיסטוריה של הכלי"></textarea>
      <button class="adm-btn adm-btn--primary" type="submit">הוספת כלל</button>
    </form>
  </section>

  <section class="card">
    <h2 class="card__h">
      כל הכללים ({rules.length})
      <span class="adm-pill adm-pill--rec">{activeCount} פעילים</span>
    </h2>

    {
      rules.length === 0 ? (
        <div class="empty">
          <p class="empty__t">עוד לא נלמד אף כלל</p>
          <p class="empty__b">
            כללים נוצרים מעצמם כשאתם דוחים טיוטה או מתקנים אותה ומסבירים במשפט למה.
            אפשר גם להוסיף כלל ידנית בטופס שלמעלה.
          </p>
        </div>
      ) : (
        <div class="rules">
          {rules.map((r) => (
            <div class:list={['rule', !r.active && 'rule--off']}>
              <form method="post" action={`/api/admin/ai/rules?csrf=${csrf}`} class="rule__edit">
                <input type="hidden" name="action" value="edit" />
                <input type="hidden" name="id" value={r.id} />
                <textarea class="adm-textarea" name="ruleText" rows="2">{r.ruleText}</textarea>
                <div class="rule__meta">
                  <span class:list={['adm-pill', r.active ? 'adm-pill--published' : 'adm-pill--draft']}>
                    {r.active ? 'פעיל' : 'מושבת'}
                  </span>
                  <span>נרשם {r.sourceCount} פעמים</span>
                  <span>עודכן {fmt(r.updatedAt)}</span>
                </div>
                <button class="adm-btn adm-btn--ghost rule__btn" type="submit">שמירת הניסוח</button>
              </form>

              <div class="rule__acts">
                <form method="post" action={`/api/admin/ai/rules?csrf=${csrf}`}>
                  <input type="hidden" name="action" value={r.active ? 'deactivate' : 'activate'} />
                  <input type="hidden" name="id" value={r.id} />
                  <button class="adm-btn adm-btn--ghost rule__btn" type="submit">
                    {r.active ? 'השבתה' : 'הפעלה מחדש'}
                  </button>
                </form>
                {
                  mayDelete && (
                    <form method="post" action={`/api/admin/ai/rules?csrf=${csrf}`}>
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button class="adm-btn adm-btn--ghost rule__btn rule__btn--danger" type="submit">
                        מחיקה
                      </button>
                    </form>
                  )
                }
              </div>
            </div>
          ))}
        </div>
      )
    }

    <p class="foot-note">
      השבתה היא הפיכה: הכלל נשאר רשום ואפשר להחזיר אותו. מחיקה מוחקת אותו לתמיד,
      ולכן היא פתוחה רק למשתמש עם הרשאת ניהול הגדרות.
    </p>
  </section>
</AdminLayout>

<style>
  .hd {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .hd__h { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; }
  .hd__sub { font-size: 0.9375rem; color: var(--color-ink-3); margin-top: 0.35rem; max-width: 46rem; }

  .flash {
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
  }
  .flash--ok { background: #e7f6ec; color: #15803d; }
  .flash--err { background: #fdeceb; color: var(--color-error); }

  .card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .card__h {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .adm-pill--rec { background: #eaf0ff; color: var(--color-royal); font-weight: 700; }

  .add { display: grid; gap: 0.5rem; justify-items: start; }
  .add .adm-textarea { width: 100%; }

  .rules { display: flex; flex-direction: column; gap: 0.875rem; }
  .rule {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0.625rem;
    flex-wrap: wrap;
  }
  .rule--off { background: var(--color-surface-2); opacity: 0.75; }
  .rule__edit { flex: 1; min-width: 16rem; display: grid; gap: 0.5rem; justify-items: start; }
  .rule__edit .adm-textarea { width: 100%; }
  .rule__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .rule__acts { display: flex; flex-direction: column; gap: 0.375rem; }
  .rule__btn { padding: 0.375rem 0.75rem; font-size: 0.8125rem; }
  .rule__btn--danger { color: var(--color-error); }

  .empty { text-align: center; padding: 2rem 1rem; }
  .empty__t { font-family: var(--font-display); font-weight: 700; margin-bottom: 0.375rem; }
  .empty__b { font-size: 0.9375rem; color: var(--color-ink-2); max-width: 34rem; margin-inline: auto; }

  .foot-note {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 0.875rem;
    margin-top: 1.25rem;
  }

  :global(.adm-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }
  :global(.adm-pill--published) { background: #e7f6ec; color: #15803d; }
  :global(.adm-pill--draft) { background: #f1f3f7; color: #55627a; }
</style>
