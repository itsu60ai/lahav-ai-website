---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { can } from '../../lib/cms/types.ts';
import { ARTICLE_KINDS } from '../../lib/cms/types.ts';
import { csrfFor } from '../../lib/cms/auth.ts';

const { articles } = Astro.locals.stores!;
const user = Astro.locals.user!;
const all = await articles.list();
const published = all.filter((a) => a.status === 'published');
const drafts = all.filter((a) => a.status === 'draft');
const csrf = await csrfFor(Astro.locals.sessionToken);
const mayPublish = can(user, 'article:publish');
const mayCreate = can(user, 'article:create');
const mayDelete = can(user, 'article:delete');

// Plain query-param filter, same pattern already used on /admin/ai's tabs:
// works with no client JS, every combination is a shareable/bookmarkable
// URL, and the counts always reflect the REAL total, not the filtered view.
const statusParam = Astro.url.searchParams.get('status');
const statusFilter: 'all' | 'draft' | 'published' =
  statusParam === 'draft' || statusParam === 'published' ? statusParam : 'all';
const shown =
  statusFilter === 'draft' ? drafts : statusFilter === 'published' ? published : all;

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---

<AdminLayout title="מאמרים">
  <div class="hd">
    <div>
      <h1 class="hd__h">מאמרים</h1>
      <p class="hd__sub">
        {published.length} מפורסמים · {drafts.length} טיוטות
      </p>
      <nav class="statfilter" aria-label="סינון לפי סטטוס">
        <a class:list={['statfilter__pill', statusFilter === 'all' && 'is-on']} href="/admin">
          הכל ({all.length})
        </a>
        <a class:list={['statfilter__pill', statusFilter === 'draft' && 'is-on']} href="/admin?status=draft">
          רק טיוטות ({drafts.length})
        </a>
        <a class:list={['statfilter__pill', statusFilter === 'published' && 'is-on']} href="/admin?status=published">
          רק מפורסמים ({published.length})
        </a>
      </nav>
    </div>
    {
      mayCreate && (
        <div class="hd__acts">
          {/* The AI-write option used to exist only as a collapsed,
              unlabelled accordion at the bottom of a different page, with
              nothing here pointing to it -- this is the fix for that. */}
          <a class="adm-btn adm-btn--primary" href="/admin/ai#write-with-ai">+ מאמר חדש עם AI</a>
          <form method="post" action={`/api/admin/new?csrf=${csrf}`}>
            <button class="adm-btn adm-btn--ghost" type="submit">+ מאמר ריק (בלי AI)</button>
          </form>
        </div>
      )
    }
  </div>

  {
    mayDelete && shown.length > 0 && (
      <div class="bulkbar" data-bulkbar hidden>
        <span class="bulkbar__count" data-bulk-count></span>
        <button class="adm-btn adm-btn--ghost" type="button" data-bulk-clear>ביטול בחירה</button>
        <button class="adm-btn adm-btn--danger" type="button" data-bulk-delete>מחיקת הנבחרים</button>
      </div>
    )
  }

  {
    shown.length === 0 ? (
      <div class="empty">
        {statusFilter === 'all' ? (
          <>
            <p class="empty__t">עוד אין מאמרים</p>
            <p class="empty__b">
              התחילו מ"מאמר חדש עם AI" ותכתבו על מה, או מ"מאמר ריק" אם אתם רוצים לכתוב הכל בעצמכם.
              הוא ייווצר כטיוטה ולא יופיע באתר עד שתפרסמו אותו.
            </p>
          </>
        ) : (
          <>
            <p class="empty__t">{statusFilter === 'draft' ? 'אין כרגע טיוטות' : 'אין כרגע מאמרים מפורסמים'}</p>
            <p class="empty__b">
              <a href="/admin">חזרה לכל המאמרים</a>
            </p>
          </>
        )}
      </div>
    ) : (
      <div class:list={['tbl', mayDelete && 'tbl--check']} data-article-table data-csrf={csrf}>
        <div class="tbl__head">
          {mayDelete && (
            <span class="tbl__check">
              <input type="checkbox" data-select-all aria-label="בחירת כל המאמרים" />
            </span>
          )}
          <span>כותרת</span>
          <span>סוג</span>
          <span>סטטוס</span>
          <span>עודכן</span>
          <span class="tbl__actions-h">פעולות</span>
        </div>

        {shown.map((a) => (
          <div class="row" data-row data-row-id={a.id}>
            {mayDelete && (
              <span class="tbl__check">
                <input type="checkbox" data-row-check value={a.id} aria-label={`בחירת ${a.title || 'מאמר ללא כותרת'}`} />
              </span>
            )}
            <div class="row__main">
              <a class="row__title" href={`/admin/${a.id}`}>{a.title || '(ללא כותרת)'}</a>
              <div class="row__meta">
                <span class="row__slug" dir="ltr">/articles/{a.slug}/</span>
                {a.isPlaceholder && (
                  <span class="adm-pill adm-pill--placeholder">תוכן לדוגמה</span>
                )}
                {a.featured && <span class="row__feat">מוצג ראשי</span>}
              </div>
            </div>

            <span class="row__kind">{ARTICLE_KINDS[a.kind]?.label ?? a.kind}</span>

            <span>
              <span class:list={['adm-pill', `adm-pill--${a.status}`]}>
                <span class="adm-dot" />
                {a.status === 'published' ? 'מפורסם' : 'טיוטה'}
              </span>
            </span>

            <span class="row__date">{fmt(a.updatedAt)}</span>

            <span class="row__actions">
              <a class="adm-btn adm-btn--ghost row__btn" href={`/admin/${a.id}`}>עריכה</a>
              <a
                class="adm-btn adm-btn--ghost row__btn"
                href={`/admin/preview/${a.id}`}
                target="_blank"
                rel="noopener"
              >
                תצוגה
              </a>
              {
                mayPublish && (
                  <form method="post" action={`/api/admin/status?csrf=${csrf}`}>
                    <input type="hidden" name="id" value={a.id} />
                    <input
                      type="hidden"
                      name="status"
                      value={a.status === 'published' ? 'draft' : 'published'}
                    />
                    <button
                      class:list={[
                        'adm-btn row__btn',
                        a.status === 'published' ? 'adm-btn--ghost' : 'adm-btn--primary',
                      ]}
                      type="submit"
                    >
                      {a.status === 'published' ? 'הסרה מפרסום' : 'פרסום'}
                    </button>
                  </form>
                )
              }
            </span>
          </div>
        ))}
      </div>
    )
  }

  <p class="foot-note">
    מאמר בסטטוס טיוטה לא מופיע באתר כלל. פרסום מעלה אותו מיד, והסרה מפרסום מורידה אותו מיד.
  </p>
</AdminLayout>

<script is:inline>
  // Bulk select + delete. Reuses the exact same /api/admin/delete route a
  // single "מחיקת המאמר" button already calls (see admin/[id].astro) --
  // just handed an array of ids instead of one, so there is only ever one
  // deletion code path to trust, not two.
  (() => {
    const table = document.querySelector('[data-article-table]');
    const bar = document.querySelector('[data-bulkbar]');
    if (!table || !bar) return;
    const csrf = table.dataset.csrf;
    const selectAll = table.querySelector('[data-select-all]');
    const countEl = bar.querySelector('[data-bulk-count]');
    const clearBtn = bar.querySelector('[data-bulk-clear]');
    const deleteBtn = bar.querySelector('[data-bulk-delete]');

    const checks = () => Array.from(table.querySelectorAll('[data-row-check]'));

    function refresh() {
      const all = checks();
      const checked = all.filter((c) => c.checked);
      bar.hidden = checked.length === 0;
      countEl.textContent = checked.length === 1 ? 'מאמר אחד נבחר' : `${checked.length} מאמרים נבחרו`;
      all.forEach((c) => {
        const row = c.closest('[data-row]');
        if (row) row.classList.toggle('is-selected', c.checked);
      });
      if (selectAll) {
        selectAll.checked = all.length > 0 && checked.length === all.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
      }
    }

    selectAll?.addEventListener('change', () => {
      checks().forEach((c) => { c.checked = selectAll.checked; });
      refresh();
    });
    checks().forEach((c) => c.addEventListener('change', refresh));

    clearBtn?.addEventListener('click', () => {
      checks().forEach((c) => { c.checked = false; });
      refresh();
    });

    deleteBtn?.addEventListener('click', async () => {
      const ids = checks().filter((c) => c.checked).map((c) => c.value);
      if (ids.length === 0) return;
      const titles = ids
        .map((id) => table.querySelector(`[data-row-id="${id}"] .row__title`)?.textContent?.trim())
        .filter(Boolean)
        .slice(0, 5);
      const preview = titles.join('\n') + (ids.length > titles.length ? `\n...ועוד ${ids.length - titles.length}` : '');
      const confirmMsg =
        ids.length === 1
          ? `למחוק לצמיתות את המאמר "${titles[0] ?? ''}"? אי אפשר לבטל את זה.`
          : `למחוק לצמיתות ${ids.length} מאמרים? אי אפשר לבטל את זה.\n\n${preview}`;
      if (!confirm(confirmMsg)) return;

      deleteBtn.disabled = true;
      const originalLabel = deleteBtn.textContent;
      deleteBtn.textContent = 'מוחק...';
      try {
        const res = await fetch(`/api/admin/delete?csrf=${encodeURIComponent(csrf)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
          body: JSON.stringify({ ids }),
        });
        if (!res.ok) throw new Error('failed');
        // A full reload, not a DOM patch: the header count ("X מפורסמים ·
        // Y טיוטות") and the three filter pill counts are all rendered
        // server-side from the page-load snapshot, and deleting rows from
        // the table client-side left every one of those numbers stale
        // until a manual refresh -- confirmed live ("מחקתי הכל אבל זה
        // עדיין הראה 22"). Reloading is simpler and more robust than
        // hunting down and patching every place a count is shown.
        location.reload();
        return;
      } catch {
        alert('המחיקה נכשלה. אפשר לנסות שוב.');
        deleteBtn.disabled = false;
        deleteBtn.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  .hd {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hd__h {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
  }
  .hd__acts { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .hd__sub {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-top: 0.25rem;
  }
  .statfilter { display: flex; gap: 0.4rem; margin-top: 0.75rem; }
  .statfilter__pill {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-2);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    text-decoration: none;
  }
  .statfilter__pill:hover { background: var(--color-surface-2); }
  .statfilter__pill.is-on {
    background: var(--color-royal);
    border-color: var(--color-royal);
    color: #fff;
  }

  .tbl {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .tbl__head,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem 8rem 8rem auto;
    gap: 1rem;
    align-items: center;
    padding: 0.875rem 1.125rem;
  }
  .tbl--check .tbl__head,
  .tbl--check .row {
    grid-template-columns: 1.75rem minmax(0, 1fr) 7rem 8rem 8rem auto;
  }
  .tbl__check {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tbl__check input[type='checkbox'] {
    width: 1.05rem;
    height: 1.05rem;
    cursor: pointer;
  }
  .row.is-selected { background: #eef4ff; }

  .bulkbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
    padding: 0.75rem 1.125rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }
  .bulkbar__count { font-size: 0.875rem; font-weight: 700; color: var(--color-ink); margin-inline-end: auto; }
  .tbl__head {
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
  }
  .tbl__actions-h {
    text-align: start;
  }
  .row + .row,
  .tbl__head + .row {
    border-top: 1px solid var(--color-line);
  }
  .row:hover {
    background: #fbfcfd;
  }
  .row__main {
    min-width: 0;
  }
  .row__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .row__title:hover {
    color: var(--color-royal);
    text-decoration: underline;
  }
  .row__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .row__slug {
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
  .row__feat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-royal);
  }
  .row__kind,
  .row__date {
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }
  .row__actions {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }
  .row__btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }

  .empty {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .empty__t {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .empty__b {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .foot-note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 0.875rem;
  }

  @media (max-width: 900px) {
    .tbl__head {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
    .row__actions {
      flex-wrap: wrap;
    }
  }
</style>
