---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { can } from '../../lib/cms/types.ts';
import { ARTICLE_KINDS } from '../../lib/cms/types.ts';
import { csrfFor } from '../../lib/cms/auth.ts';

const { articles } = Astro.locals.stores!;
const user = Astro.locals.user!;
const all = await articles.list();
const published = all.filter((a) => a.status === 'published');
const drafts = all.filter((a) => a.status === 'draft');
const csrf = await csrfFor(Astro.locals.sessionToken);
const mayPublish = can(user, 'article:publish');
const mayCreate = can(user, 'article:create');

const fmt = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---

<AdminLayout title="מאמרים">
  <div class="hd">
    <div>
      <h1 class="hd__h">מאמרים</h1>
      <p class="hd__sub">
        {published.length} מפורסמים · {drafts.length} טיוטות
      </p>
    </div>
    {
      mayCreate && (
        <form method="post" action={`/api/admin/new?csrf=${csrf}`}>
          <button class="ad-btn ad-btn--primary" type="submit">+ מאמר חדש</button>
        </form>
      )
    }
  </div>

  {
    all.length === 0 ? (
      <div class="empty">
        <p class="empty__t">עוד אין מאמרים</p>
        <p class="empty__b">התחילו מ"מאמר חדש". הוא ייווצר כטיוטה ולא יופיע באתר עד שתפרסמו אותו.</p>
      </div>
    ) : (
      <div class="tbl">
        <div class="tbl__head">
          <span>כותרת</span>
          <span>סוג</span>
          <span>סטטוס</span>
          <span>עודכן</span>
          <span class="tbl__actions-h">פעולות</span>
        </div>

        {all.map((a) => (
          <div class="row">
            <div class="row__main">
              <a class="row__title" href={`/admin/${a.id}`}>{a.title || '(ללא כותרת)'}</a>
              <div class="row__meta">
                <span class="row__slug" dir="ltr">/articles/{a.slug}/</span>
                {a.isPlaceholder && (
                  <span class="ad-pill ad-pill--placeholder">תוכן לדוגמה</span>
                )}
                {a.featured && <span class="row__feat">מוצג ראשי</span>}
              </div>
            </div>

            <span class="row__kind">{ARTICLE_KINDS[a.kind]?.label ?? a.kind}</span>

            <span>
              <span class:list={['ad-pill', `ad-pill--${a.status}`]}>
                <span class="ad-dot" />
                {a.status === 'published' ? 'מפורסם' : 'טיוטה'}
              </span>
            </span>

            <span class="row__date">{fmt(a.updatedAt)}</span>

            <span class="row__actions">
              <a class="ad-btn ad-btn--ghost row__btn" href={`/admin/${a.id}`}>עריכה</a>
              <a
                class="ad-btn ad-btn--ghost row__btn"
                href={`/admin/preview/${a.id}`}
                target="_blank"
                rel="noopener"
              >
                תצוגה
              </a>
              {
                mayPublish && (
                  <form method="post" action={`/api/admin/status?csrf=${csrf}`}>
                    <input type="hidden" name="id" value={a.id} />
                    <input
                      type="hidden"
                      name="status"
                      value={a.status === 'published' ? 'draft' : 'published'}
                    />
                    <button
                      class:list={[
                        'ad-btn row__btn',
                        a.status === 'published' ? 'ad-btn--ghost' : 'ad-btn--primary',
                      ]}
                      type="submit"
                    >
                      {a.status === 'published' ? 'הסרה מפרסום' : 'פרסום'}
                    </button>
                  </form>
                )
              }
            </span>
          </div>
        ))}
      </div>
    )
  }

  <p class="foot-note">
    מאמר בסטטוס טיוטה לא מופיע באתר כלל. פרסום מעלה אותו מיד, והסרה מפרסום מורידה אותו מיד.
  </p>
</AdminLayout>

<style>
  .hd {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hd__h {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
  }
  .hd__sub {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-top: 0.25rem;
  }

  .tbl {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .tbl__head,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem 8rem 8rem auto;
    gap: 1rem;
    align-items: center;
    padding: 0.875rem 1.125rem;
  }
  .tbl__head {
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
  }
  .tbl__actions-h {
    text-align: start;
  }
  .row + .row,
  .tbl__head + .row {
    border-top: 1px solid var(--color-line);
  }
  .row:hover {
    background: #fbfcfd;
  }
  .row__main {
    min-width: 0;
  }
  .row__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }
  .row__title:hover {
    color: var(--color-royal);
    text-decoration: underline;
  }
  .row__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .row__slug {
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
  .row__feat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-royal);
  }
  .row__kind,
  .row__date {
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }
  .row__actions {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }
  .row__btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }

  .empty {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .empty__t {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .empty__b {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .foot-note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 0.875rem;
  }

  @media (max-width: 900px) {
    .tbl__head {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
    .row__actions {
      flex-wrap: wrap;
    }
  }
</style>
