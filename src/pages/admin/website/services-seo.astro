---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EditorChrome from '../../../components/admin/EditorChrome.astro';
import { SERVICES_INDEX_DEFAULT, getDraftContent } from '../../../lib/cms/content.ts';
import { can } from '../../../lib/cms/types.ts';

const { content } = Astro.locals.stores!;
const user = Astro.locals.user!;
const idx = await getDraftContent(content, 'services', SERVICES_INDEX_DEFAULT);
const meta = await content.meta('services');
---

<AdminLayout title="עמוד השירותים - SEO">
  <EditorChrome
    title="עמוד השירותים - SEO"
    previewHref="/services/?preview=1"
    canPublish={can(user, 'content:publish')}
    hasUnpublishedChanges={meta?.hasUnpublishedChanges}
    publishedAt={meta?.publishedAt}
  >
    <p class="ad-hint" style="margin-bottom:1rem">
      תוכן עמוד השירותים עצמו קבוע בעיצוב. כאן ניתן לערוך רק את הופעתו
      בגוגל. לעריכת כל שירות בנפרד, חזרו ל<a href="/admin/website">תוכן האתר</a>.
    </p>
    <fieldset class="ad-fieldset">
      <legend>קידום באתרי חיפוש (SEO)</legend>
      <div class="ad-field">
        <label class="ad-label" for="f-seo-title">כותרת הדף</label>
        <input class="ad-input" id="f-seo-title" data-f="seo.title" value={idx.seo.title} />
      </div>
      <div class="ad-field">
        <label class="ad-label" for="f-seo-desc">תיאור הדף</label>
        <textarea class="ad-textarea" id="f-seo-desc" data-f="seo.description" rows="2">{idx.seo.description}</textarea>
      </div>
    </fieldset>
  </EditorChrome>
</AdminLayout>

<script>
  import { wireEditor } from '../../../lib/cms/admin-editor-client.ts';
  const val = (sel: string) => (document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value ?? '');
  const csrf = document.body.dataset.csrf!;

  wireEditor({
    store: 'content',
    id: 'services',
    csrf,
    canPublish: !!document.querySelector('[data-publish]'),
    collect: () => ({
      seo: {
        title: val('[data-f="seo.title"]'),
        description: val('[data-f="seo.description"]'),
        ogTitle: val('[data-f="seo.title"]'),
        ogDescription: val('[data-f="seo.description"]'),
      },
    }),
  });
</script>
