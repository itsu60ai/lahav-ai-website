---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EditorChrome from '../../../components/admin/EditorChrome.astro';
import { ABOUT_DEFAULT, getDraftContent } from '../../../lib/cms/content.ts';
import { can } from '../../../lib/cms/types.ts';

const { content } = Astro.locals.stores!;
const user = Astro.locals.user!;
const about = await getDraftContent(content, 'about', ABOUT_DEFAULT);
const meta = await content.meta('about');
---

<AdminLayout title="אודות">
  <EditorChrome
    title="אודות"
    previewHref="/about/?preview=1"
    canPublish={can(user, 'content:publish')}
    hasUnpublishedChanges={meta?.hasUnpublishedChanges}
    publishedAt={meta?.publishedAt}
  >
    <fieldset class="adm-fieldset">
      <legend>הכותרת הראשית</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-eyebrow">תווית קטנה מעל הכותרת</label>
        <input class="adm-input" id="f-eyebrow" data-f="hero.eyebrow" value={about.hero.eyebrow} />
      </div>
      <div class="adm-field-row">
        <div class="adm-field">
          <label class="adm-label" for="f-h1">שורה ראשונה בכותרת</label>
          <input class="adm-input" id="f-h1" data-f="hero.headlineLine1" value={about.hero.headlineLine1} />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-h2">שורה שנייה בכותרת</label>
          <input class="adm-input" id="f-h2" data-f="hero.headlineLine2" value={about.hero.headlineLine2} />
        </div>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-lead">טקסט מתחת לכותרת</label>
        <textarea class="adm-textarea" id="f-lead" data-f="hero.lead" rows="3">{about.hero.lead}</textarea>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>פסקת הפתיחה, מציגה את השותפים</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-intro">הפסקה שמופיעה מיד אחרי התמונה המשותפת</label>
        <textarea class="adm-textarea" id="f-intro" data-f="intro" rows="4">{about.intro}</textarea>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>השותפים</legend>
      <p class="adm-hint" style="margin-bottom:1rem">
        התמונות עצמן (הפורטרטים והתמונה המשותפת) אינן חלק מהעורך הזה, בדיוק כמו תמונת המייסד הקודמת: הן נכסים קבועים של האתר, לא תוכן שמוחלף כאן.
      </p>
      <div class="adm-field-row">
        <div class="adm-field">
          <label class="adm-label" for="f-yehiel-role">יחיאל, תפקיד</label>
          <input class="adm-input" id="f-yehiel-role" data-f="partners.yehiel.role" value={about.partners.yehiel.role} />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-yehiel-focus">יחיאל, תחום אחריות</label>
          <input class="adm-input" id="f-yehiel-focus" data-f="partners.yehiel.focus" value={about.partners.yehiel.focus} />
        </div>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-yehiel-bio">יחיאל, כמה מילים עליו (לא חובה)</label>
        <textarea class="adm-textarea" id="f-yehiel-bio" data-f="partners.yehiel.bio" rows="3">{about.partners.yehiel.bio}</textarea>
        <span class="adm-hint">כתבו רק עובדות מדויקות. שדה ריק פשוט לא מציג פסקה, ולא מוצג טקסט גנרי במקומו.</span>
      </div>

      <div class="adm-field-row" style="margin-top:1.5rem">
        <div class="adm-field">
          <label class="adm-label" for="f-ethan-role">איתן, תפקיד</label>
          <input class="adm-input" id="f-ethan-role" data-f="partners.ethan.role" value={about.partners.ethan.role} />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-ethan-focus">איתן, תחום אחריות</label>
          <input class="adm-input" id="f-ethan-focus" data-f="partners.ethan.focus" value={about.partners.ethan.focus} />
        </div>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-ethan-bio">איתן, כמה מילים עליו (לא חובה)</label>
        <textarea class="adm-textarea" id="f-ethan-bio" data-f="partners.ethan.bio" rows="3">{about.partners.ethan.bio}</textarea>
        <span class="adm-hint">כתבו רק עובדות מדויקות. שדה ריק פשוט לא מציג פסקה, ולא מוצג טקסט גנרי במקומו.</span>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>קידום באתרי חיפוש (SEO)</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-title">כותרת הדף</label>
        <input class="adm-input" id="f-seo-title" data-f="seo.title" value={about.seo.title} />
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-desc">תיאור הדף</label>
        <textarea class="adm-textarea" id="f-seo-desc" data-f="seo.description" rows="2">{about.seo.description}</textarea>
      </div>
    </fieldset>
  </EditorChrome>
</AdminLayout>

<script>
  import { wireEditor } from '../../../lib/cms/admin-editor-client.ts';
  const val = (sel: string) => (document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value ?? '');
  const csrf = document.body.dataset.csrf!;

  wireEditor({
    store: 'content',
    id: 'about',
    csrf,
    canPublish: !!document.querySelector('[data-publish]'),
    collect: () => ({
      hero: {
        eyebrow: val('[data-f="hero.eyebrow"]'),
        headlineLine1: val('[data-f="hero.headlineLine1"]'),
        headlineLine2: val('[data-f="hero.headlineLine2"]'),
        lead: val('[data-f="hero.lead"]'),
      },
      intro: val('[data-f="intro"]'),
      partners: {
        yehiel: {
          role: val('[data-f="partners.yehiel.role"]'),
          focus: val('[data-f="partners.yehiel.focus"]'),
          bio: val('[data-f="partners.yehiel.bio"]'),
        },
        ethan: {
          role: val('[data-f="partners.ethan.role"]'),
          focus: val('[data-f="partners.ethan.focus"]'),
          bio: val('[data-f="partners.ethan.bio"]'),
        },
      },
      seo: {
        title: val('[data-f="seo.title"]'),
        description: val('[data-f="seo.description"]'),
        ogTitle: val('[data-f="seo.title"]'),
        ogDescription: val('[data-f="seo.description"]'),
      },
    }),
  });
</script>
