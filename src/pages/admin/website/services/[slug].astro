---
export const prerender = false;

// One editor template for all five services. The row COUNTS below
// (3 points, 4 symptoms, 4 build steps) match the current approved
// structure exactly and are not adjustable here -- adding or removing a
// row would change a grid the design assumes has that many items. Text
// only, per row.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import EditorChrome from '../../../../components/admin/EditorChrome.astro';
import { serviceDefault, getDraftContent, SERVICE_SLUGS } from '../../../../lib/cms/content.ts';
import { can } from '../../../../lib/cms/types.ts';

const SERVICE_LABELS: Record<string, string> = {
  crm: 'מערכות CRM חכמות',
  automations: 'אוטומציות עסקיות',
  'web-development': 'פיתוח אתרים',
  'app-development': 'פיתוח אפליקציות',
  'ai-content': 'יצירת תוכן באמצעות AI',
};

const { slug } = Astro.params;
if (!slug || !SERVICE_SLUGS.includes(slug)) return Astro.redirect('/admin/website', 302);

const { services } = Astro.locals.stores!;
const user = Astro.locals.user!;
const s = await getDraftContent(services, slug, serviceDefault(slug));
const meta = await services.meta(slug);
const label = SERVICE_LABELS[slug] ?? slug;
---

<AdminLayout title={label}>
  <EditorChrome
    title={label}
    previewHref={`/services/${slug}/?preview=1`}
    canPublish={can(user, 'content:publish')}
    hasUnpublishedChanges={meta?.hasUnpublishedChanges}
    publishedAt={meta?.publishedAt}
  >
    <fieldset class="adm-fieldset">
      <legend>שם ותקציר (מופיע בכרטיס, בתפריט ובפוטר)</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-name">שם השירות</label>
        <input class="adm-input" id="f-name" data-f="name" value={s.name} />
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-lead">משפט תקציר קצר</label>
        <textarea class="adm-textarea" id="f-lead" data-f="lead" rows="2">{s.lead}</textarea>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-pain">פסקת ההסבר בכרטיס</label>
        <textarea class="adm-textarea" id="f-pain" data-f="pain" rows="3">{s.pain}</textarea>
      </div>
      <div class="adm-field">
        <label class="adm-label">שלוש נקודות בכרטיס</label>
        {s.points.map((p, i) => (
          <input class="adm-input" style="margin-bottom:0.5rem" data-f={`points.${i}`} value={p} />
        ))}
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>כותרת עמוד השירות</legend>
      <div class="adm-field-row">
        <div class="adm-field">
          <label class="adm-label" for="f-h1a">שורה ראשונה</label>
          <input class="adm-input" id="f-h1a" data-f="h1a" value={s.h1a} />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-h1b">שורה שנייה</label>
          <input class="adm-input" id="f-h1b" data-f="h1b" value={s.h1b} />
        </div>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-pagelead">טקסט מוביל בעמוד השירות</label>
        <textarea class="adm-textarea" id="f-pagelead" data-f="pageLead" rows="2">{s.pageLead}</textarea>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-note">הערה קטנה מתחת לתרשים</label>
        <textarea class="adm-textarea" id="f-note" data-f="note" rows="2">{s.note}</textarea>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>הסימנים</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-symt">כותרת הקטע</label>
        <input class="adm-input" id="f-symt" data-f="symptomsTitle" value={s.symptomsTitle} />
      </div>
      {s.symptoms.map((sym, i) => (
        <input class="adm-input" style="margin-bottom:0.5rem" data-f={`symptoms.${i}`} value={sym} />
      ))}
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>מה נבנה בפועל</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-buildt">כותרת הקטע</label>
        <input class="adm-input" id="f-buildt" data-f="buildTitle" value={s.buildTitle} />
      </div>
      {s.build.map((b, i) => (
        <div class="build-row">
          <input class="adm-input" data-f={`build.${i}.t`} value={b.t} placeholder="כותרת" />
          <textarea class="adm-textarea" data-f={`build.${i}.d`} rows="2" placeholder="תיאור">{b.d}</textarea>
        </div>
      ))}
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>סיום העמוד</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-closing">כותרת הסיום</label>
        <input class="adm-input" id="f-closing" data-f="closing" value={s.closing} />
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-closingbody">טקסט הסיום</label>
        <textarea class="adm-textarea" id="f-closingbody" data-f="closingBody" rows="2">{s.closingBody}</textarea>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>קידום באתרי חיפוש (SEO)</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-title">כותרת הדף</label>
        <input class="adm-input" id="f-seo-title" data-f="seo.title" value={s.seo.title} />
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-desc">תיאור הדף</label>
        <textarea class="adm-textarea" id="f-seo-desc" data-f="seo.description" rows="2">{s.seo.description}</textarea>
      </div>
    </fieldset>
  </EditorChrome>
</AdminLayout>

<script>
  import { wireEditor } from '../../../../lib/cms/admin-editor-client.ts';
  const val = (sel: string) => (document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value ?? '');
  const vals = (prefix: string) =>
    Array.from(document.querySelectorAll<HTMLInputElement>(`[data-f^="${prefix}."]`))
      .filter((el) => /^\d+$/.test(el.dataset.f!.slice(prefix.length + 1)))
      .map((el) => el.value);
  const csrf = document.body.dataset.csrf!;
  // /admin/website/services/<slug> -- the last path segment.
  const slug = location.pathname.split('/').filter(Boolean).pop()!;

  wireEditor({
    store: 'services',
    id: slug,
    csrf,
    canPublish: !!document.querySelector('[data-publish]'),
    collect: () => {
      const buildRows = Array.from(document.querySelectorAll<HTMLInputElement>('[data-f$=".t"]')).length;
      const build = Array.from({ length: buildRows }, (_, i) => ({
        t: val(`[data-f="build.${i}.t"]`),
        d: val(`[data-f="build.${i}.d"]`),
      }));
      return {
        name: val('[data-f="name"]'),
        lead: val('[data-f="lead"]'),
        pain: val('[data-f="pain"]'),
        points: vals('points'),
        h1a: val('[data-f="h1a"]'),
        h1b: val('[data-f="h1b"]'),
        pageLead: val('[data-f="pageLead"]'),
        note: val('[data-f="note"]'),
        symptomsTitle: val('[data-f="symptomsTitle"]'),
        symptoms: vals('symptoms'),
        buildTitle: val('[data-f="buildTitle"]'),
        build,
        closing: val('[data-f="closing"]'),
        closingBody: val('[data-f="closingBody"]'),
        seo: {
          title: val('[data-f="seo.title"]'),
          description: val('[data-f="seo.description"]'),
          ogTitle: val('[data-f="seo.title"]'),
          ogDescription: val('[data-f="seo.description"]'),
        },
      };
    },
  });
</script>

<style>
  .build-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
</style>
