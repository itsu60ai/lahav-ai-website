---
export const prerender = false;

// Portfolio list: add/reorder/enable-disable/delete a project, and jump
// into its own editor to write the story and publish it. Same
// draft/published discipline as everything else -- see
// docs/WEBSITE_CMS.md and migrations/0010_portfolio.sql. Each item
// publishes on its OWN (from its editor page), not all at once, because
// each one is really its own small page, same as a service.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { csrfFor } from '../../../../lib/cms/auth.ts';

const { portfolioList } = Astro.locals.stores!;
const items = await portfolioList.listDraftMeta();
const csrf = await csrfFor(Astro.locals.sessionToken);
---

<AdminLayout title="תיק עבודות">
  <div class="hd">
    <div>
      <h1 class="hd__h">תיק עבודות - הפרויקטים</h1>
      <p class="hd__sub">
        פרויקטים לדוגמה, לא לקוחות אמיתיים. כל פרויקט מתפרסם בנפרד, מהעורך
        שלו. <a href="/admin/website/portfolio-seo">כותרת העמוד ו-SEO</a>
        · <a href="/portfolio/?preview=1" target="_blank" rel="noopener">תצוגה מקדימה של העמוד</a>
      </p>
    </div>
    <button class="adm-btn adm-btn--primary" type="button" id="add-btn">פרויקט חדש</button>
  </div>

  <ul class="list" id="pf-list">
    {items.map((item, i) => (
      <li class="row" data-id={item.id}>
        <div class="row__order">
          <button class="ord" type="button" data-up disabled={i === 0}>↑</button>
          <button class="ord" type="button" data-down disabled={i === items.length - 1}>↓</button>
        </div>
        <a class="row__name" href={`/admin/website/portfolio/${item.id}`}>{item.name}</a>
        {item.publishedAt && (
          <span class:list={['adm-pill', item.hasUnpublishedChanges ? 'adm-pill--draft' : 'adm-pill--published']}>
            <span class="adm-dot"></span>
            {item.hasUnpublishedChanges ? 'לא פורסם' : 'מפורסם'}
          </span>
        )}
        <div class="row__acts">
          <label class="chk">
            <input type="checkbox" data-enabled checked={item.enabled} />
            מוצג
          </label>
          <a class="adm-btn adm-btn--ghost" href={`/admin/website/portfolio/${item.id}`}>עריכה</a>
          <button class="adm-btn adm-btn--ghost is-danger" type="button" data-delete>מחיקה</button>
        </div>
      </li>
    ))}
  </ul>

  {items.length === 0 && <p class="empty">עוד אין פרויקטים. לחצו "פרויקט חדש" כדי להתחיל.</p>}
</AdminLayout>

<script define:vars={{ csrf }}>
  const post = (body) =>
    fetch('/api/admin/portfolio', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
      body: JSON.stringify(body),
    });

  document.getElementById('add-btn')?.addEventListener('click', async () => {
    const res = await post({ action: 'create' });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.id) {
      location.href = `/admin/website/portfolio/${data.id}`;
    }
  });

  document.querySelectorAll('[data-id]').forEach((row) => {
    const id = row.dataset.id;

    row.querySelector('[data-enabled]')?.addEventListener('change', async (e) => {
      await post({ action: 'setEnabled', id, enabled: e.target.checked });
    });

    row.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm('להסיר את הפרויקט הזה? אם הוא כבר פורסם, הוא ייעלם מהאתר החי רק אחרי שתפרסמו את השינוי הזה מתוך העורך שלו.')) return;
      const res = await post({ action: 'delete', id });
      if (res.ok) row.remove();
    });

    row.querySelector('[data-up]')?.addEventListener('click', () => move(row, -1));
    row.querySelector('[data-down]')?.addEventListener('click', () => move(row, 1));
  });

  async function move(row, dir) {
    const list = document.getElementById('pf-list');
    const rows = Array.from(list.children);
    const idx = rows.indexOf(row);
    const swapWith = rows[idx + dir];
    if (!swapWith) return;
    if (dir === -1) list.insertBefore(row, swapWith);
    else list.insertBefore(swapWith, row);
    const ids = Array.from(list.children).map((r) => r.dataset.id);
    await post({ action: 'reorder', ids });
    location.reload();
  }
</script>

<style>
  .hd { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .hd__h { font-size: 1.5rem; font-weight: 800; margin: 0; }
  .hd__sub { color: var(--color-ink-3); margin: 0.35rem 0 0; max-width: 42rem; }
  .hd__sub a { color: var(--color-royal); }

  .list { list-style: none; margin: 0; padding: 0; max-width: 50rem; }
  .row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    margin-bottom: 0.6rem;
  }
  .row__order { display: flex; flex-direction: column; gap: 0.2rem; flex: none; }
  .ord {
    width: 1.6rem; height: 1.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: #fff;
    cursor: pointer;
    font-size: 0.75rem;
  }
  .ord:disabled { opacity: 0.3; cursor: default; }
  .row__name { flex: 1; min-width: 0; font-weight: 700; color: var(--color-ink); text-decoration: none; }
  .row__name:hover { color: var(--color-royal); }
  .row__acts { display: flex; align-items: center; gap: 0.5rem; flex: none; }
  .chk { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; white-space: nowrap; }
  .is-danger { color: #c23; border-color: #f3c8c8; }
  .empty { color: var(--color-ink-3); }

  :global(.adm-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    flex: none;
  }
  :global(.adm-pill--published) { background: #e7f6ec; color: #15803d; }
  :global(.adm-pill--draft) { background: #f1f3f7; color: #55627a; }
  :global(.adm-dot) { width: 0.4375rem; height: 0.4375rem; border-radius: 50%; background: currentColor; }
</style>
