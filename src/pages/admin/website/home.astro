---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EditorChrome from '../../../components/admin/EditorChrome.astro';
import { HOME_DEFAULT, getDraftContent } from '../../../lib/cms/content.ts';
import { can } from '../../../lib/cms/types.ts';

const { content } = Astro.locals.stores!;
const user = Astro.locals.user!;
const home = await getDraftContent(content, 'home', HOME_DEFAULT);
const meta = await content.meta('home');
---

<AdminLayout title="בית">
  <EditorChrome
    title="בית"
    previewHref="/?preview=1"
    canPublish={can(user, 'content:publish')}
    hasUnpublishedChanges={meta?.hasUnpublishedChanges}
    publishedAt={meta?.publishedAt}
  >
    <fieldset class="ad-fieldset">
      <legend>הכותרת הראשית</legend>

      <div class="ad-field">
        <label class="ad-label" for="f-eyebrow">תווית קטנה מעל הכותרת</label>
        <input class="ad-input" id="f-eyebrow" data-f="hero.eyebrow" value={home.hero.eyebrow} />
      </div>

      <div class="ad-field-row">
        <div class="ad-field">
          <label class="ad-label" for="f-h1">שורה ראשונה בכותרת</label>
          <input class="ad-input" id="f-h1" data-f="hero.headlineLine1" value={home.hero.headlineLine1} />
        </div>
        <div class="ad-field">
          <label class="ad-label" for="f-h2">שורה שנייה בכותרת</label>
          <input class="ad-input" id="f-h2" data-f="hero.headlineLine2" value={home.hero.headlineLine2} />
          <span class="ad-hint">שתי שורות נפרדות, כי הן מונפשות בנפרד באתר.</span>
        </div>
      </div>

      <div class="ad-field">
        <label class="ad-label" for="f-lead">טקסט מתחת לכותרת</label>
        <textarea class="ad-textarea" id="f-lead" data-f="hero.lead" rows="3">{home.hero.lead}</textarea>
      </div>
    </fieldset>

    <fieldset class="ad-fieldset">
      <legend>קידום באתרי חיפוש (SEO)</legend>
      <div class="ad-field">
        <label class="ad-label" for="f-seo-title">כותרת הדף (מופיע בלשונית הדפדפן ובגוגל)</label>
        <input class="ad-input" id="f-seo-title" data-f="seo.title" value={home.seo.title} />
      </div>
      <div class="ad-field">
        <label class="ad-label" for="f-seo-desc">תיאור הדף (מופיע בגוגל מתחת לכותרת)</label>
        <textarea class="ad-textarea" id="f-seo-desc" data-f="seo.description" rows="2">{home.seo.description}</textarea>
      </div>
    </fieldset>
  </EditorChrome>
</AdminLayout>

<script>
  import { wireEditor } from '../../../lib/cms/admin-editor-client.ts';

  const val = (sel: string) => (document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value ?? '');
  const csrf = document.body.dataset.csrf!;

  wireEditor({
    store: 'content',
    id: 'home',
    csrf,
    canPublish: !!document.querySelector('[data-publish]'),
    collect: () => ({
      hero: {
        eyebrow: val('[data-f="hero.eyebrow"]'),
        headlineLine1: val('[data-f="hero.headlineLine1"]'),
        headlineLine2: val('[data-f="hero.headlineLine2"]'),
        lead: val('[data-f="hero.lead"]'),
      },
      // ogImage / noindex are intentionally NOT sent: this editor has no
      // field for them, and /api/admin/website/save-draft merges onto
      // the existing draft rather than overwriting it, so leaving them
      // out here preserves whatever is already stored.
      seo: {
        title: val('[data-f="seo.title"]'),
        description: val('[data-f="seo.description"]'),
        ogTitle: val('[data-f="seo.title"]'),
        ogDescription: val('[data-f="seo.description"]'),
      },
    }),
  });
</script>
