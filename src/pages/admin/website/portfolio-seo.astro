---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EditorChrome from '../../../components/admin/EditorChrome.astro';
import { PORTFOLIO_INDEX_DEFAULT, getDraftContent } from '../../../lib/cms/content.ts';
import { can } from '../../../lib/cms/types.ts';

const { content } = Astro.locals.stores!;
const user = Astro.locals.user!;
const page = await getDraftContent(content, 'portfolio', PORTFOLIO_INDEX_DEFAULT);
const meta = await content.meta('portfolio');
---

<AdminLayout title="תיק עבודות - כותרת">
  <EditorChrome
    title="תיק עבודות - כותרת ו-SEO"
    previewHref="/portfolio/?preview=1"
    canPublish={can(user, 'content:publish')}
    hasUnpublishedChanges={meta?.hasUnpublishedChanges}
    publishedAt={meta?.publishedAt}
  >
    <p class="adm-hint" style="margin-bottom:1rem">
      כאן עורכים רק את הכותרת הגדולה של עמוד תיק העבודות. הפרויקטים
      עצמם (הלקוחות לדוגמה) נמצאים ב<a href="/admin/website/portfolio">רשימת תיק העבודות</a>.
      כל עוד קישור התפריט לעמוד הזה כבוי (בעמוד <a href="/admin/website/navigation">ניווט</a>),
      גולשים רגילים לא ימצאו אותו.
    </p>
    <fieldset class="adm-fieldset">
      <legend>הכותרת הראשית</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-eyebrow">תווית קטנה מעל הכותרת</label>
        <input class="adm-input" id="f-eyebrow" data-f="hero.eyebrow" value={page.hero.eyebrow} />
      </div>
      <div class="adm-field-row">
        <div class="adm-field">
          <label class="adm-label" for="f-h1">שורה ראשונה בכותרת</label>
          <input class="adm-input" id="f-h1" data-f="hero.headlineLine1" value={page.hero.headlineLine1} />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="f-h2">שורה שנייה בכותרת</label>
          <input class="adm-input" id="f-h2" data-f="hero.headlineLine2" value={page.hero.headlineLine2} />
        </div>
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-lead">טקסט מתחת לכותרת</label>
        <textarea class="adm-textarea" id="f-lead" data-f="hero.lead" rows="2">{page.hero.lead}</textarea>
      </div>
    </fieldset>

    <fieldset class="adm-fieldset">
      <legend>קידום באתרי חיפוש (SEO)</legend>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-title">כותרת הדף</label>
        <input class="adm-input" id="f-seo-title" data-f="seo.title" value={page.seo.title} />
      </div>
      <div class="adm-field">
        <label class="adm-label" for="f-seo-desc">תיאור הדף</label>
        <textarea class="adm-textarea" id="f-seo-desc" data-f="seo.description" rows="2">{page.seo.description}</textarea>
      </div>
      <label class="chk">
        <input type="checkbox" id="f-noindex" data-f="seo.noindex" checked={page.seo.noindex} />
        להסתיר ממנועי חיפוש (noindex) -- מומלץ להשאיר מסומן כל עוד הפרויקטים לדוגמה
      </label>
    </fieldset>
  </EditorChrome>
</AdminLayout>

<script>
  import { wireEditor } from '../../../lib/cms/admin-editor-client.ts';
  const val = (sel: string) => (document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value ?? '');
  const checked = (sel: string) => document.querySelector<HTMLInputElement>(sel)?.checked ?? false;
  const csrf = document.body.dataset.csrf!;

  wireEditor({
    store: 'content',
    id: 'portfolio',
    csrf,
    canPublish: !!document.querySelector('[data-publish]'),
    collect: () => ({
      hero: {
        eyebrow: val('[data-f="hero.eyebrow"]'),
        headlineLine1: val('[data-f="hero.headlineLine1"]'),
        headlineLine2: val('[data-f="hero.headlineLine2"]'),
        lead: val('[data-f="hero.lead"]'),
      },
      seo: {
        title: val('[data-f="seo.title"]'),
        description: val('[data-f="seo.description"]'),
        ogTitle: val('[data-f="seo.title"]'),
        ogDescription: val('[data-f="seo.description"]'),
        noindex: checked('[data-f="seo.noindex"]'),
      },
    }),
  });
</script>

<style>
  .chk { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-ink-2); }
</style>
