---
import { NAV, SITE, WHATSAPP_HREF } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="u-container ftr__top">
    <div class="ftr__brand">
      <img src="/brand/lahav-white-lockup.svg" alt="LAHAV AI" width="130" height="96" />
      <p class="t-small ftr__tagline">
        מערכות CRM, אוטומציות ותוכנה מותאמת לעסקים קטנים ובינוניים בישראל.
      </p>
    </div>

    <nav class="ftr__col" aria-label="ניווט בתחתית העמוד">
      <h3 class="t-eyebrow ftr__heading">ניווט</h3>
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="ftr__col">
      <h3 class="t-eyebrow ftr__heading">יצירת קשר</h3>
      <a href="/contact/">קביעת שיחת Discovery</a>
      <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">שיחה בוואטסאפ</a>
      <a href="/privacy/">מדיניות פרטיות</a>
    </div>
  </div>

  <div class="u-container ftr__bottom">
    <span>© {year} {SITE.name}. כל הזכויות שמורות.</span>
    <span>{SITE.legalLine}</span>
  </div>
</footer>

<style>
  .ftr {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.68);
    padding-block: clamp(3.5rem, 6vw, 5.5rem) 2rem;
  }
  .ftr__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .ftr__brand img {
    width: 130px;
    height: auto;
    margin-bottom: 1rem;
  }
  .ftr__tagline {
    color: rgba(255, 255, 255, 0.62);
    max-width: 34ch;
  }
  .ftr__heading {
    color: var(--color-electric);
    margin-bottom: 1rem;
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ftr__col a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: var(--text-small);
  }
  .ftr__col a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .ftr__bottom {
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: var(--text-micro);
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 760px) {
    .ftr__top {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
</style>
