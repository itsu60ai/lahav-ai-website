---
// Site footer, V3.
//
// The reference ends on a large, quiet, type-led block rather than a
// dense link farm: an oversized closing statement, then small columns.
// Same shape here, with LAHAV's own content and legal line.
import { SITE, NAV, SERVICES, WHATSAPP_HREF, CTA_PRIMARY } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="ftr band band--blue">
  <!-- The footer arrives on a curve, not a hard horizontal seam. -->
  <span class="ftr__curve" aria-hidden="true">
    <svg viewBox="0 0 1440 90" preserveAspectRatio="none" focusable="false">
      <path d="M0 90 C 280 90 380 0 720 0 C 1060 0 1160 90 1440 90 Z" fill="currentColor" />
    </svg>
  </span>

  <div class="u-container u-container--wide">
    <!-- oversized closing statement -->
    <div class="ftr__top">
      <p class="t-eyebrow" data-reveal>בואו נתחיל</p>
      <a class="ftr__big" href={CTA_PRIMARY.href} data-reveal style="--mo-delay:80ms">
        <span>נדבר על מה</span>
        <span>שתקוע<span class="ftr__dot">.</span></span>
        <span class="ftr__arrow" aria-hidden="true">←</span>
      </a>
      <p class="ftr__note" data-reveal style="--mo-delay:160ms">
        30 דקות, בלי התחייבות.
      </p>
    </div>

    <hr class="ftr__rule" />

    <div class="ftr__cols">
      <div class="ftr__col ftr__col--brand">
        <img class="ftr__logo" src="/brand/lahav-white-lockup.svg" alt="LAHAV AI" width="120" height="89" />
        <p class="ftr__blurb">
          מערכות ואוטומציות שעושות סדר בעסק.
        </p>
      </div>

      <nav class="ftr__col" aria-label="ניווט תחתון">
        <p class="ftr__h">ניווט</p>
        <ul class="ftr__list">
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="שירותים">
        <p class="ftr__h">שירותים</p>
        <ul class="ftr__list">
          {SERVICES.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="ftr__col">
        <p class="ftr__h">יצירת קשר</p>
        <ul class="ftr__list">
          <li><a href="/contact/">תיאום שיחת היכרות</a></li>
          <li>
            <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">שיחה בוואטסאפ</a>
          </li>
          <li><a href="/privacy/">מדיניות פרטיות</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr__base">
      <p class="t-micro">© {year} {SITE.name}. כל הזכויות שמורות.</p>
      <p class="t-micro">{SITE.legalLine}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    /* Flat brand blue, not the band gradient: the curve above has to be
       painted in one solid colour to line up seamlessly, and the
       reference's footer is a single bright blue too. */
    background: var(--color-royal);
    /* .band--blue clips, which would eat the curve sitting above it */
    overflow: visible;
    padding-block: clamp(5rem, 9vw, 9rem) 2.5rem;
  }
  /* the curve is painted in the footer's own colour and pulled up over
     whatever section sits above it */
  .ftr__curve {
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    display: block;
    height: clamp(48px, 6vw, 90px);
    color: var(--color-royal);
    pointer-events: none;
  }
  .ftr__curve svg { display: block; width: 100%; height: 100%; }

  .ftr__top { padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .ftr__big {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: #fff;
    text-decoration: none;
  }
  .ftr__dot { color: #bfe0ff; }
  .ftr__arrow {
    display: inline-block;
    font-size: 0.55em;
    color: #bfe0ff;
    transition: transform var(--dur) var(--ease-out);
  }
  .ftr__big:hover .ftr__arrow { transform: translateX(-0.35em); }
  .ftr__note { margin-top: 1.25rem; color: rgba(255, 255, 255, 0.86); font-size: var(--text-small); }

  .ftr__rule { border: 0; height: 1px; background: rgba(255, 255, 255, 0.28); margin: 0; }

  .ftr__cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .ftr__logo { width: clamp(92px, 8vw, 120px); height: auto; margin-bottom: 1rem; }
  .ftr__blurb { color: rgba(255, 255, 255, 0.88); font-size: var(--text-small); max-width: 32ch; }
  .ftr__h {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.875rem;
  }
  .ftr__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .ftr__list a {
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    font-size: var(--text-small);
    transition: color var(--dur) var(--ease-out);
  }
  .ftr__list a:hover { color: #fff; }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }
  .ftr__base :global(.t-micro) { color: rgba(255, 255, 255, 0.72); }

  @media (max-width: 900px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
    .ftr__col--brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .ftr__cols { grid-template-columns: 1fr; }
  }
</style>
