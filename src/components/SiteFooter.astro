---
// SITE FOOTER, V4.
//
// The last visual moment of the site, not a dark rectangle bolted on the
// end. It stays in the LIGHT system: a warm surface, an oversized Hebrew
// invitation that behaves when you point at it, and quiet columns
// underneath.
//
// The previous version was a flat navy block. That is exactly the "finish
// the website with a generic black rectangle" the brief rules out.
import { SITE, NAV, SERVICES, WHATSAPP_HREF } from '../lib/site';
import Curve from './Curve.astro';
import {
  FOOTER_DEFAULT,
  NAVIGATION_DEFAULT,
  getPublicContent,
  getDraftContent,
  getServiceNames,
  buildWhatsappHref,
} from '../lib/cms/content.ts';
const year = new Date().getFullYear();

interface Props { preview?: boolean }
const { preview = false } = Astro.props;

// Same resilience pattern as SiteHeader: Astro.locals.stores is undefined
// during the build-time prerender of the few pages that stay fully
// static (404, /privacy/, /system/), which then show the last-deployed
// footer until the next code deploy -- documented in docs/WEBSITE_CMS.md.
const stores = Astro.locals.stores;
const footer = stores
  ? preview
    ? await getDraftContent(stores.content, 'footer', FOOTER_DEFAULT)
    : await getPublicContent(stores.content, 'footer', FOOTER_DEFAULT)
  : FOOTER_DEFAULT;
const navContent = stores
  ? preview
    ? await getDraftContent(stores.content, 'navigation', NAVIGATION_DEFAULT)
    : await getPublicContent(stores.content, 'navigation', NAVIGATION_DEFAULT)
  : NAVIGATION_DEFAULT;
const navLabel = new Map(navContent.items.map((i) => [i.key, i]));
const visibleNav = NAV.filter((item) => navLabel.get(item.href)?.enabled !== false).map((item) => ({
  ...item,
  label: navLabel.get(item.href)?.label || item.label,
}));
const settings: Record<string, string> = stores
  ? await (preview ? stores.settings.getDraft() : stores.settings.getPublished()).catch(() => ({}))
  : {};
const waHref = Object.keys(settings).length ? buildWhatsappHref(settings) : WHATSAPP_HREF;

// One published name per service, so the footer list agrees with the
// header, the index cards and the service's own page (F-33/F-37).
const serviceNames: Record<string, string> = stores
  ? await getServiceNames(stores.services, preview).catch(() => ({}))
  : {};
---

<footer class="ftr band band--warm">
  <Curve tone="warm" shape="wave" />

  <!--
    F-44 (2026-09-02): the footer's own big invitation band (eyebrow,
    giant heading, note, WhatsApp line) was removed sitewide. It
    duplicated ContactBlock.astro word for word, which sits directly
    above the footer on every page that has one. FooterContent's
    invitationLine1/2 and note fields stay defined in content.ts even
    though nothing reads them now, so no migration is needed.
  -->
  <div class="u-container u-container--wide ftr__inner">
    <div class="ftr__cols">
      <div class="ftr__col ftr__col--brand">
        <img class="ftr__logo" src="/brand/lahav-primary-lockup.svg" alt="LAHAV AI" width="120" height="89" />
        <p class="ftr__blurb">{footer.blurb}</p>
      </div>

      <nav class="ftr__col" aria-label="ניווט תחתון">
        <p class="ftr__h">ניווט</p>
        <ul class="ftr__list">
          {visibleNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="שירותים">
        <p class="ftr__h">שירותים</p>
        <ul class="ftr__list">
          {SERVICES.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{serviceNames[s.slug] || s.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="ftr__col">
        <p class="ftr__h">יצירת קשר</p>
        <ul class="ftr__list">
          <li><a href="/contact/">לסגור פגישה ביומן</a></li>
          <li><a href={waHref} target="_blank" rel="noopener noreferrer">לדבר איתנו בוואטסאפ (מענה מהיר)</a></li>
          <li><a href="/privacy/">מדיניות פרטיות</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr__base">
      <p class="t-micro">© {year} {SITE.name}. כל הזכויות שמורות. נבנה כדי לחסוך לכם זמן.</p>
      <p class="t-micro">{SITE.legalLine}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 8rem) 2rem;
  }
  .ftr__inner { position: relative; z-index: 1; }

  /* ---- the drawn mark behind the invitation ---- */
  .ftr__art {
    position: absolute;
    inset-block-start: 8%;
    inset-inline-end: -6%;
    width: min(46rem, 74%);
    aspect-ratio: 2 / 1;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
  }
  .ftr__art svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .ftr__art-path {
    fill: none;
    stroke: var(--color-royal);
    stroke-width: 1.4;
    stroke-opacity: 0.3;
    stroke-linecap: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: ftr-draw 2400ms var(--ease-out) forwards;
  }
  @keyframes ftr-draw { to { stroke-dashoffset: 0 } }
  .ftr__art-dot { fill: var(--color-electric); opacity: 0.5; animation: ftr-pulse 4s var(--ease-inout) infinite; }
  .ftr__art-dot--2 { animation-delay: -1.3s; }
  .ftr__art-dot--3 { animation-delay: -2.6s; }
  @keyframes ftr-pulse {
    0%, 100% { opacity: 0.25; r: 5 }
    50%      { opacity: 0.7;  r: 8 }
  }

  /* ---- the invitation ---- */
  .ftr__top { padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .ftr__big {
    display: flex;
    flex-direction: column;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: normal;
    color: var(--color-ink);
    text-decoration: none;
    max-width: 14ch;
  }
  .ftr__big-l { display: block; }
  .ftr__dot { color: var(--color-royal); }
  .ftr__arrow {
    display: inline-block;
    /* Sized and spaced as its own mark rather than as a stray glyph
       jammed against a 100px word. It used to sit hard against the
       period with no air on either side. */
    margin-inline-start: 0.25em;
    font-size: 0.42em;
    line-height: 1;
    vertical-align: 0.12em;
    color: var(--color-royal);
    transition: transform var(--dur) var(--ease-out);
  }
  .ftr__big:hover .ftr__arrow { transform: translateX(-0.4em); }
  .ftr__big:hover { color: var(--color-royal); }
  .ftr__note { margin-top: 1.25rem; color: var(--color-ink-2); font-size: var(--text-small); }

  .ftr__routes { margin-top: clamp(1.25rem, 2.5vw, 2rem); }
  .ftr__route {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 0.2rem;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .ftr__route:hover { color: var(--color-royal); border-bottom-color: var(--color-royal); }
  .ftr__route :global(svg) { width: 1.15rem; height: 1.15rem; color: #25d366; }

  .ftr__rule { border: 0; height: 1px; background: var(--color-line-strong); margin: 0; }

  /* ---- columns ---- */
  .ftr__cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .ftr__logo { width: clamp(92px, 8vw, 116px); height: auto; margin-bottom: 1rem; }
  .ftr__blurb { color: var(--color-ink-2); font-size: var(--text-small); max-width: 30ch; }
  .ftr__h {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-ink-3);
    margin-bottom: 0.875rem;
  }
  .ftr__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .ftr__list a {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: var(--text-small);
    transition: color var(--dur) var(--ease-out);
  }
  .ftr__list a:hover { color: var(--color-royal); }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .ftr__base :global(.t-micro) { color: var(--color-ink-3); }

  @media (max-width: 900px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
    .ftr__col--brand { grid-column: 1 / -1; }
    .ftr__art { inset-block-start: 4%; width: 90%; opacity: 0.35; }
  }
  @media (max-width: 560px) {
    .ftr__cols { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ftr__art-path { animation: none; stroke-dashoffset: 0; }
    .ftr__art-dot { animation: none; }
  }
</style>
