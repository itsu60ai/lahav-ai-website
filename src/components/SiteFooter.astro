---
// SITE FOOTER, V4.
//
// The last visual moment of the site, not a dark rectangle bolted on the
// end. It stays in the LIGHT system: a warm surface, an oversized Hebrew
// invitation that behaves when you point at it, and quiet columns
// underneath.
//
// The previous version was a flat navy block. That is exactly the "finish
// the website with a generic black rectangle" the brief rules out.
import { SITE, NAV, SERVICES, WHATSAPP_HREF, CTA_PRIMARY } from '../lib/site';
import WhatsApp from './icons/WhatsApp.astro';
import Curve from './Curve.astro';
const year = new Date().getFullYear();
---

<footer class="ftr band band--warm">
  <Curve tone="warm" shape="wave" />

  <!-- an original mark, drawn, sitting behind the invitation -->
  <span class="ftr__art" aria-hidden="true">
    <svg viewBox="0 0 600 300" preserveAspectRatio="none" focusable="false">
      <path class="ftr__art-path" d="M580 250 C 460 250 430 90 300 90 C 175 90 150 230 20 230" />
      <circle class="ftr__art-dot" cx="580" cy="250" r="6" />
      <circle class="ftr__art-dot ftr__art-dot--2" cx="300" cy="90" r="6" />
      <circle class="ftr__art-dot ftr__art-dot--3" cx="20" cy="230" r="6" />
    </svg>
  </span>

  <div class="u-container u-container--wide ftr__inner">
    <!-- the invitation -->
    <div class="ftr__top">
      <p class="t-eyebrow" data-reveal>בואו נתחיל</p>
      <a class="ftr__big" href={CTA_PRIMARY.href} data-reveal style="--mo-delay:80ms">
        <span class="ftr__big-l">נדבר על מה</span>
        <span class="ftr__big-l">
          שתקוע<span class="ftr__dot">.</span>
          <span class="ftr__arrow" aria-hidden="true">←</span>
        </span>
      </a>
      <p class="ftr__note" data-reveal style="--mo-delay:160ms">30 דקות, בלי התחייבות.</p>

      <div class="ftr__routes" data-reveal style="--mo-delay:220ms">
        <a class="ftr__route" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
          <WhatsApp />
          <span>מעדיפים וואטסאפ? זה בסדר גמור.</span>
        </a>
      </div>
    </div>

    <hr class="ftr__rule" />

    <div class="ftr__cols">
      <div class="ftr__col ftr__col--brand">
        <img class="ftr__logo" src="/brand/lahav-primary-lockup.svg" alt="LAHAV AI" width="120" height="89" />
        <p class="ftr__blurb">מערכות ואוטומציות שעושות סדר בעסק.</p>
      </div>

      <nav class="ftr__col" aria-label="ניווט תחתון">
        <p class="ftr__h">ניווט</p>
        <ul class="ftr__list">
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="שירותים">
        <p class="ftr__h">שירותים</p>
        <ul class="ftr__list">
          {SERVICES.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="ftr__col">
        <p class="ftr__h">יצירת קשר</p>
        <ul class="ftr__list">
          <li><a href="/contact/">תיאום שיחת היכרות</a></li>
          <li><a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">שיחה בוואטסאפ</a></li>
          <li><a href="/privacy/">מדיניות פרטיות</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr__base">
      <p class="t-micro">© {year} {SITE.name}. כל הזכויות שמורות.</p>
      <p class="t-micro">{SITE.legalLine}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 8rem) 2rem;
  }
  .ftr__inner { position: relative; z-index: 1; }

  /* ---- the drawn mark behind the invitation ---- */
  .ftr__art {
    position: absolute;
    inset-block-start: 8%;
    inset-inline-end: -6%;
    width: min(46rem, 74%);
    aspect-ratio: 2 / 1;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
  }
  .ftr__art svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .ftr__art-path {
    fill: none;
    stroke: var(--color-royal);
    stroke-width: 1.4;
    stroke-opacity: 0.3;
    stroke-linecap: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: ftr-draw 2400ms var(--ease-out) forwards;
  }
  @keyframes ftr-draw { to { stroke-dashoffset: 0 } }
  .ftr__art-dot { fill: var(--color-electric); opacity: 0.5; animation: ftr-pulse 4s var(--ease-inout) infinite; }
  .ftr__art-dot--2 { animation-delay: -1.3s; }
  .ftr__art-dot--3 { animation-delay: -2.6s; }
  @keyframes ftr-pulse {
    0%, 100% { opacity: 0.25; r: 5 }
    50%      { opacity: 0.7;  r: 8 }
  }

  /* ---- the invitation ---- */
  .ftr__top { padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .ftr__big {
    display: flex;
    flex-direction: column;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: normal;
    color: var(--color-ink);
    text-decoration: none;
    max-width: 14ch;
  }
  .ftr__big-l { display: block; }
  .ftr__dot { color: var(--color-royal); }
  .ftr__arrow {
    display: inline-block;
    /* Sized and spaced as its own mark rather than as a stray glyph
       jammed against a 100px word. It used to sit hard against the
       period with no air on either side. */
    margin-inline-start: 0.25em;
    font-size: 0.42em;
    line-height: 1;
    vertical-align: 0.12em;
    color: var(--color-royal);
    transition: transform var(--dur) var(--ease-out);
  }
  .ftr__big:hover .ftr__arrow { transform: translateX(-0.4em); }
  .ftr__big:hover { color: var(--color-royal); }
  .ftr__note { margin-top: 1.25rem; color: var(--color-ink-2); font-size: var(--text-small); }

  .ftr__routes { margin-top: clamp(1.25rem, 2.5vw, 2rem); }
  .ftr__route {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 0.2rem;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .ftr__route:hover { color: var(--color-royal); border-bottom-color: var(--color-royal); }
  .ftr__route :global(svg) { width: 1.15rem; height: 1.15rem; color: #25d366; }

  .ftr__rule { border: 0; height: 1px; background: var(--color-line-strong); margin: 0; }

  /* ---- columns ---- */
  .ftr__cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .ftr__logo { width: clamp(92px, 8vw, 116px); height: auto; margin-bottom: 1rem; }
  .ftr__blurb { color: var(--color-ink-2); font-size: var(--text-small); max-width: 30ch; }
  .ftr__h {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-ink-3);
    margin-bottom: 0.875rem;
  }
  .ftr__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .ftr__list a {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: var(--text-small);
    transition: color var(--dur) var(--ease-out);
  }
  .ftr__list a:hover { color: var(--color-royal); }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .ftr__base :global(.t-micro) { color: var(--color-ink-3); }

  @media (max-width: 900px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
    .ftr__col--brand { grid-column: 1 / -1; }
    .ftr__art { inset-block-start: 4%; width: 90%; opacity: 0.35; }
  }
  @media (max-width: 560px) {
    .ftr__cols { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ftr__art-path { animation: none; stroke-dashoffset: 0; }
    .ftr__art-dot { animation: none; }
  }
</style>
