---
// HOME service showcase. The commercial centrepiece of the page.
//
// LAYOUT: a horizontal strip of five services across the full width, each
// with an icon, and the selected one opens a large panel underneath it.
//
// This replaces an earlier radio-driven version that had three faults, all
// of which this structure removes rather than patches:
//   - the panel spanned all rows, so the open content sat next to the FIRST
//     name in the list and the wrong service looked selected. Here the
//     panel is below the whole strip, so it cannot mis-align.
//   - the hidden radio was absolutely positioned against the page, so
//     clicking a service scrolled the window to the top. There is no
//     hidden input any more.
//   - a radio can never be un-checked, so the mobile accordion could not
//     close. A tab strip always has exactly one selection by design, so
//     closing is no longer a thing the user needs to do.
//
// NO-JAVASCRIPT BEHAVIOUR: the markup ships with every panel visible and
// no `hidden` attributes. The script adds them on start-up. So if the
// script fails or is blocked, the page degrades to all five services
// stacked and fully readable, never to an empty section.
import Viz from './Viz.astro';
import { SERVICES } from '../lib/site';

// Icons come from the shared module, so this strip and the mobile menu
// always show the same mark for the same service.
import { SERVICE_ICONS as ICONS } from '../lib/icons';
---

<div class="shw" data-shw>
  <!-- The strip. Without the script this is a plain list of links to the
       service pages, which is why each item is still a real anchor. -->
  <div class="shw__strip" role="tablist" aria-label="השירותים שלנו">
    {
      SERVICES.map((s, i) => (
        <button
          type="button"
          class="shw__tab"
          role="tab"
          id={`shwtab-${s.slug}`}
          aria-controls={`shwpanel-${s.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-shw-tab={s.slug}
        >
          <span class="shw__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={ICONS[s.slug]}
            />
          </span>
          <span class="shw__tname">{s.name}</span>
          <span class="shw__tshort">{s.short}</span>
        </button>
      ))
    }
  </div>

  <div class="shw__panels">
    {
      SERVICES.map((s) => (
        <section
          class="shw__panel"
          role="tabpanel"
          id={`shwpanel-${s.slug}`}
          aria-labelledby={`shwtab-${s.slug}`}
          data-shw-panel={s.slug}
          tabindex="0"
        >
          {/* the name repeats here so the no-script stack still reads */}
          <h3 class="shw__pname">{s.name}</h3>

          <div class="shw__grid">
            <div class="shw__copy">
              <p class="shw__lead">{s.lead}</p>
              <p class="shw__body">{s.pain}</p>
              <ul class="shw__pts">
                {s.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <a class="shw__cta" href={`/services/${s.slug}/`}>
                לפרטים על {s.name}
                <span class="arrow-inline" aria-hidden="true">
                  ←
                </span>
              </a>
            </div>

            <div class="shw__art">
              <Viz kind={s.viz as any} />
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  // Progressive enhancement. Everything is visible before this runs.
  document.querySelectorAll<HTMLElement>('[data-shw]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-shw-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-shw-panel]'));
    if (tabs.length === 0 || tabs.length !== panels.length) return;

    // Only now do panels start hiding, so a thrown error above leaves the
    // section fully readable.
    root.classList.add('shw--live');

    const select = (i: number, moveFocus: boolean) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        // roving tabindex: one stop for the whole strip
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, n) => {
        p.hidden = n !== i;
      });
      // Focus is moved deliberately and only on keyboard navigation, so a
      // mouse click never scrolls the page.
      if (moveFocus) tabs[i].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        // RTL strip: ArrowLeft advances, ArrowRight goes back
        if (e.key === 'ArrowLeft') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowRight') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next === null) return;
        e.preventDefault();
        select(next, true);
      });
    });

    select(0, false);
  });
</script>

<style>
  .shw {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  /* ---------- The strip ---------- */
  .shw__strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.625rem;
  }
  .shw__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: clamp(1.125rem, 2vw, 1.625rem) 0.75rem;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    color: var(--color-ink-2);
    text-align: center;
    font: inherit;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .shw__tab:hover {
    border-color: var(--color-line-strong);
    background: var(--color-surface-2);
    color: var(--color-ink);
    translate: 0 -2px;
  }
  .shw__tab:focus-visible {
    outline: 3px solid var(--color-electric);
    outline-offset: 2px;
  }

  .shw__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md, 0.75rem);
    background: var(--color-surface-2);
    color: var(--color-royal);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .shw__icon svg {
    width: 1.625rem;
    height: 1.625rem;
  }
  .shw__tname {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.82rem + 0.36vw, 1.125rem);
    font-weight: 700;
    line-height: 1.25;
  }
  /* the short form is only needed on narrow screens */
  .shw__tshort {
    display: none;
  }

  /* selected */
  .shw__tab[aria-selected='true'] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: #fff;
  }
  .shw__tab[aria-selected='true'] .shw__icon {
    background: rgba(41, 151, 255, 0.18);
    color: var(--color-electric);
  }

  /* ---------- The panel underneath ---------- */
  .shw__panels {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }
  .shw__panel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl, 1.5rem);
    background: var(--color-surface-2);
    padding: clamp(1.5rem, 3vw, 2.75rem);
  }
  .shw__panel:focus-visible {
    outline: 3px solid var(--color-electric);
    outline-offset: 3px;
  }
  /* stacked fallback spacing, only while the script has not taken over */
  .shw__panel + .shw__panel {
    margin-top: 1.25rem;
  }
  .shw--live .shw__panel + .shw__panel {
    margin-top: 0;
  }
  .shw--live .shw__panel {
    animation: shw-in 420ms var(--ease-out) both;
  }
  @keyframes shw-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* the repeated name is redundant once the tab strip labels the panel */
  .shw__pname {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    margin-bottom: 1.25rem;
  }
  .shw--live .shw__pname {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    clip-path: inset(50%);
    overflow: hidden;
  }

  .shw__grid {
    display: grid;
    /* RTL: column 1 is the RIGHT one, so the words come first */
    grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .shw__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .shw__lead {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 1.1vw, 1.875rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .shw__body {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .shw__pts {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .shw__pts li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink);
  }
  .shw__pts li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-electric);
    flex: none;
  }
  .shw__cta {
    align-self: start;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-royal);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--color-royal) 30%, transparent);
    padding-bottom: 0.125rem;
    transition: border-color var(--dur) var(--ease-out);
  }
  .shw__cta:hover {
    border-bottom-color: var(--color-royal);
  }

  .shw__art {
    background: var(--color-navy);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 2.5vw, 2rem);
    box-shadow: var(--shadow-lg);
  }

  /* ---------- Narrow screens ---------- */
  @media (max-width: 900px) {
    /* the strip becomes a swipeable rail rather than cramming five columns */
    .shw__strip {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
    .shw__tab {
      flex: 0 0 8.5rem;
      scroll-snap-align: start;
      padding-inline: 0.5rem;
    }
    .shw__tname {
      display: none;
    }
    .shw__tshort {
      display: block;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .shw__grid {
      grid-template-columns: 1fr;
    }
    /* on a small screen the picture reads better after the words */
    .shw__art {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shw__tab {
      transition: none !important;
      translate: none !important;
    }
    .shw--live .shw__panel {
      animation: none !important;
    }
  }
</style>
