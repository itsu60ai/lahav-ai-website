---
// HOME hero visual. It must explain itself with the paragraphs hidden.
//
// Hebrew reading order, so the story runs RIGHT to LEFT:
//   RIGHT   things that arrive, scattered and manual, each one labelled
//   CENTRE  one labelled process node, "התהליך האוטומטי"
//   LEFT    what came out of it, tidy and labelled
//
// The viewBox is authored close to the size this actually renders at
// (roughly 520-660px wide inside the hero column), so the label type
// lands near 14px on screen. Authoring it larger and letting it scale
// down is what made the previous version unreadable.
//
// Everything here is an illustrative example, stated on the visual
// itself. No vendor names, no fake dashboard, no invented metrics.

const rows = [92, 156, 220, 284];
const inputs = ['ליד חדש', 'טופס שנשלח', 'הודעה שהתקבלה', 'משימה שנוצרה'];
const outputs = ['המידע נרשם', 'משימה נפתחה', 'תזכורת נוצרה', 'הסטטוס עודכן'];
const tilt = [-2.2, 1.6, -1.4, 2];

// where each flow line meets the process node
const nodeIn = [160, 179, 198, 217];
---

<figure class="hs" data-reveal>
  <figcaption class="hs__cap">דוגמה לאוטומציה עסקית</figcaption>

  <svg
    class="hs__art"
    viewBox="0 0 600 340"
    role="img"
    aria-label="דוגמה לאוטומציה עסקית: ליד חדש, טופס שנשלח, הודעה שהתקבלה ומשימה שנוצרה נכנסים לתהליך אוטומטי, ומתוכו יוצאים המידע נרשם, משימה נפתחה, תזכורת נוצרה והסטטוס עודכן"
  >
    <defs>
      <linearGradient id="hsCore" x1="1" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2997FF"></stop>
        <stop offset="100%" stop-color="#1D4ED8"></stop>
      </linearGradient>
      <radialGradient id="hsGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2997FF" stop-opacity=".38"></stop>
        <stop offset="100%" stop-color="#2997FF" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <circle class="hs__glow" cx="300" cy="190" r="170" fill="url(#hsGlow)"></circle>

    <!-- column headings, right to left -->
    <text class="hs__col" x="505" y="26" text-anchor="middle">מה שנכנס</text>
    <text class="hs__col hs__col--m" x="300" y="26" text-anchor="middle">מה שקורה</text>
    <text class="hs__col hs__col--l" x="95" y="26" text-anchor="middle">מה שיוצא</text>

    <!-- inputs feed the process (right to centre) -->
    <g fill="none" stroke="rgba(41,151,255,.34)" stroke-width="1.5">
      {
        rows.map((y, i) => (
          <path
            class="hs__flow"
            style={`--d:${i * 220}ms`}
            d={`M421 ${y} C 402 ${y} 394 ${nodeIn[i]} 375 ${nodeIn[i]}`}
          />
        ))
      }
    </g>

    <!-- RIGHT: what arrives. Scattered, tilted, muted. -->
    {
      inputs.map((label, i) => (
        <g
          class="hs__in"
          style={`--d:${i * 220}ms`}
          transform={`translate(505 ${rows[i]}) rotate(${tilt[i]})`}
        >
          <rect x="-84" y="-26" width="168" height="52" rx="13" />
          <circle cx="68" cy="0" r="3.5" />
          <text x="52" y="5" text-anchor="start">
            {label}
          </text>
        </g>
      ))
    }

    <!-- CENTRE: one clearly named process -->
    <g class="hs__sys">
      <rect x="225" y="138" width="150" height="100" rx="24" fill="url(#hsCore)"></rect>
      <!-- brand mark, small and secondary: it decorates, it never explains -->
      <g class="hs__mark" opacity=".55">
        <path
          d="M281 158 L281 172 Q281 177 286 177 L294 177 Q298 177 300 174 L308 158"
          fill="none"
          stroke="#fff"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </g>
      <text class="hs__sys-t" x="300" y="200" text-anchor="middle">התהליך האוטומטי</text>
      <text class="hs__sys-s" x="300" y="220" text-anchor="middle">רץ לפי הכללים שהגדרנו</text>
    </g>

    <!-- the process feeds the outcomes (centre to left) -->
    <g fill="none" stroke="rgba(41,151,255,.5)" stroke-width="1.5">
      {
        rows.map((y, i) => (
          <path
            class="hs__flow"
            style={`--d:${1250 + i * 170}ms`}
            d={`M225 ${nodeIn[i]} C 206 ${nodeIn[i]} 198 ${y} 179 ${y}`}
          />
        ))
      }
    </g>

    <!-- LEFT: what came out. Aligned, confident, on brand. -->
    {
      outputs.map((label, i) => (
        <g class="hs__out" style={`--d:${1350 + i * 170}ms`} transform={`translate(95 ${rows[i]})`}>
          <rect x="-84" y="-26" width="168" height="52" rx="13" />
          <path
            class="hs__tick"
            d="M60 0 l6 6 l12 -13"
            fill="none"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <text x="46" y="5" text-anchor="start">
            {label}
          </text>
        </g>
      ))
    }
  </svg>

  <!-- MOBILE. The artwork above scales to ~0.5x on a phone, which puts its
       labels near 7px. Below 760px it is hidden and the same story is told
       here as real text: what goes in, what runs, what comes out. -->
  <div class="hsm" aria-hidden="true">
    <div class="hsm__col">
      <p class="hsm__k">מה שנכנס</p>
      <ul class="hsm__list">
        {inputs.map((label) => <li class="hsm__in">{label}</li>)}
      </ul>
    </div>

    <div class="hsm__sys">
      <b>התהליך האוטומטי</b>
      <span>רץ לפי הכללים שהגדרנו</span>
    </div>

    <div class="hsm__col">
      <p class="hsm__k hsm__k--out">מה שיוצא</p>
      <ul class="hsm__list">
        {outputs.map((label) => <li class="hsm__out">{label}</li>)}
      </ul>
    </div>
  </div>
</figure>

<style>
  .hs {
    margin: 0;
    width: 100%;
  }
  .hs__cap {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-electric);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .hs__art {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* column headings */
  .hs__col {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    fill: rgba(255, 255, 255, 0.5);
  }
  .hs__col--l {
    fill: var(--color-electric);
  }

  /* inputs: muted, irregular */
  .hs__in rect {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 1;
  }
  .hs__in circle {
    fill: rgba(255, 255, 255, 0.3);
  }
  .hs__in text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    fill: rgba(255, 255, 255, 0.85);
  }

  /* the process */
  .hs__sys {
    transform-box: fill-box;
    transform-origin: center;
  }
  .hs__sys-t {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    fill: #fff;
  }
  .hs__sys-s {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    fill: rgba(255, 255, 255, 0.85);
  }

  /* outputs: aligned, brand blue, ticked */
  .hs__out rect {
    fill: rgba(41, 151, 255, 0.14);
    stroke: rgba(41, 151, 255, 0.5);
    stroke-width: 1;
  }
  .hs__tick {
    stroke: var(--color-electric);
  }
  .hs__out text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    fill: #fff;
  }


  /* ---------------- Mobile ---------------- */
  .hsm {
    display: none;
  }
  .hsm__k {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 0.625rem;
  }
  .hsm__k--out {
    color: var(--color-electric);
  }
  .hsm__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hsm__in,
  .hsm__out {
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
  }
  .hsm__in {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .hsm__out {
    color: #fff;
    background: rgba(41, 151, 255, 0.14);
    border: 1px solid rgba(41, 151, 255, 0.5);
  }
  .hsm__out::before {
    content: '✓';
    color: var(--color-electric);
    font-weight: 700;
    margin-inline-end: 0.5rem;
  }
  .hsm__sys {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    align-items: center;
    text-align: center;
    margin-block: 1rem;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    background: linear-gradient(120deg, #2997ff, #1d4ed8);
  }
  .hsm__sys b {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    color: #fff;
  }
  .hsm__sys span {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.88);
  }

  @media (max-width: 760px) {
    .hs__art {
      display: none;
    }
    .hsm {
      display: block;
    }
  }

  /* ---------- Motion: one orchestrated pass, right to left ---------- */
  :global(html.reveal-ready) .hs__in,
  :global(html.reveal-ready) .hs__out,
  :global(html.reveal-ready) .hs__glow,
  :global(html.reveal-ready) .hs__sys,
  :global(html.reveal-ready) .hs__col {
    opacity: 0;
  }
  :global(html.reveal-ready) .hs__flow {
    stroke-dasharray: 5 8;
    stroke-dashoffset: 160;
    opacity: 0;
  }

  :global(html.reveal-ready) .hs.is-in .hs__col {
    animation: hs-in 700ms var(--ease-out) 150ms forwards;
  }
  :global(html.reveal-ready) .hs.is-in .hs__glow {
    animation:
      hs-in 1400ms var(--ease-out) 150ms forwards,
      hs-breathe 8s ease-in-out 2s infinite;
  }
  :global(html.reveal-ready) .hs.is-in .hs__sys {
    animation: hs-sys 800ms var(--ease-out) 800ms forwards;
  }
  :global(html.reveal-ready) .hs.is-in .hs__in {
    animation: hs-slide 650ms var(--ease-out) calc(250ms + var(--d)) forwards;
  }
  :global(html.reveal-ready) .hs.is-in .hs__out {
    animation: hs-slide 650ms var(--ease-out) var(--d) forwards;
  }
  :global(html.reveal-ready) .hs.is-in .hs__flow {
    animation:
      hs-in 400ms linear calc(250ms + var(--d)) forwards,
      hs-move 2.6s linear calc(650ms + var(--d)) infinite;
  }

  @keyframes hs-in {
    to {
      opacity: 1;
    }
  }
  @keyframes hs-breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes hs-sys {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  /* everything travels leftward, the direction the story runs */
  @keyframes hs-slide {
    from {
      opacity: 0;
      translate: 26px 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes hs-move {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs__in,
    .hs__out,
    .hs__glow,
    .hs__sys,
    .hs__col,
    .hs__flow {
      opacity: 1 !important;
      animation: none !important;
      translate: none !important;
    }
    .hs__flow {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>
