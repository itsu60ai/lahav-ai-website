---
// The אפיון position.
//
// This is the thing that separates us from a vendor who sells a package:
// we do not decide what to build until we understand how the business
// actually works. That belief has to be visible on the site, not implied
// by a step called "אפיון" in a six-step list.
//
// It appears on Home, on About and on the services index. `variant`
// changes the framing so it does not read as the same block three times.
//
// CLAIM DISCIPLINE: this says what WE do. It never says competitors skip
// it, never says we invented it, and carries no figures.
interface Props {
  variant?: 'home' | 'about' | 'services';
}
const { variant = 'home' } = Astro.props;

const COPY = {
  home: {
    eyebrow: 'איך אנחנו עובדים',
    title: 'לא נבנה לכם כלום',
    titleAccent: 'לפני שנבין איך אתם עובדים',
    lead: 'זה נשמע מובן מאליו, אבל זה בדיוק המקום שבו פרויקטים נכשלים. מערכת שנבנתה לפני שמישהו הבין את התהליך תמיד תרגיש כמו בגד שלא במידה.',
  },
  about: {
    eyebrow: 'העיקרון',
    title: 'האפיון הוא לא פורמליות.',
    titleAccent: 'הוא רוב העבודה.',
    lead: 'הרבה מהערך נוצר עוד לפני שנכתבה שורת קוד אחת, בשיחה שבה מסתבר שהבעיה האמיתית היא לא זו שחשבתם.',
  },
  services: {
    eyebrow: 'לפני שבוחרים שירות',
    title: 'קודם מבינים.',
    titleAccent: 'רק אחר כך בונים.',
    lead: 'לכן אף אחד לא צריך להגיע לכאן ולדעת איזה שירות הוא צריך. זה מה שנברר יחד.',
  },
};
const c = COPY[variant];

const points = [
  {
    t: 'נשאל הרבה שאלות',
    d: 'איך פנייה מגיעה אליכם, מי נוגע בה, איפה היא נתקעת, ומה קורה כשמישהו בחופש.',
  },
  {
    t: 'נגיד גם מה לא לבנות',
    d: 'לפעמים המסקנה היא שחצי מהרעיון מיותר, או שעדיף להתחיל ממשהו אחר לגמרי.',
  },
  {
    t: 'ההתאמה היא לכם',
    d: 'לא נתאים את העסק שלכם לחבילה מוכנה. המערכת נבנית סביב איך שאתם באמת עובדים.',
  },
];
---

<section class:list={['dp', `dp--${variant}`]}>
  <div class="u-container dp__grid">
    <div class="dp__intro">
      <p class="t-eyebrow">{c.eyebrow}</p>
      <h2 class="dp__title">
        <span>{c.title}</span>
        <span class="dp__accent">{c.titleAccent}</span>
      </h2>
      <p class="dp__lead">{c.lead}</p>
    </div>

    <ol class="dp__points">
      {
        points.map((p, i) => (
          <li class="dp__point" data-reveal style={`--i:${i}`}>
            <span class="dp__n tabular">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="dp__pt">{p.t}</h3>
              <p class="dp__pd">{p.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .dp {
    padding-block: var(--space-section);
    background: var(--color-navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .dp::before {
    content: '';
    position: absolute;
    inset-block-start: -30%;
    inset-inline-end: -10%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(41, 151, 255, 0.18), transparent 62%);
    pointer-events: none;
  }
  /* On About the section already sits inside a light run, so it keeps the
     dark treatment but loses the glow to stay quieter. */
  .dp--about::before {
    opacity: 0.5;
  }

  .dp__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .dp__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.1rem + 2.6vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.022em;
    margin-block: 1rem 1.25rem;
  }
  .dp__accent {
    color: var(--color-electric);
  }
  .dp__lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.76);
    max-width: 40ch;
  }

  .dp__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .dp__point {
    display: flex;
    gap: 1.25rem;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    transition:
      opacity 600ms var(--ease-out) calc(var(--i) * 110ms),
      translate 600ms var(--ease-out) calc(var(--i) * 110ms);
  }
  .dp__point:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  :global(html.reveal-ready) .dp__point {
    opacity: 0;
    translate: 0 14px;
  }
  :global(html.reveal-ready) .dp__point.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .dp__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-electric);
    flex: none;
    padding-top: 0.25rem;
  }
  .dp__pt {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.55vw, 1.4375rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.375rem;
  }
  .dp__pd {
    font-size: var(--text-small);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .dp__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dp__point {
      opacity: 1 !important;
      translate: none !important;
      transition: none !important;
    }
  }
</style>
