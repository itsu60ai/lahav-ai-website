---
// "לַהַב" — LAHAV's guide character.
//
// WHY THIS DESIGN, AND WHAT IT IS NOT
// The reference site's hero is anchored by a rendered 3D presenter. That
// asset is the reference owner's property, so it is not reused. Nor is a
// likeness of the founder generated: F-17 forbids AI-generating or
// altering it, and no approved character asset exists.
//
// So this is an ORIGINAL character, drawn as vector art and built from
// LAHAV's own geometry (the logo's arc and dot, the brand navy/electric).
// It is deliberately a *designed digital being* — visor face, floating
// stance — rather than an attempted human: that reads as intentional,
// stays clear of the uncanny valley, and cannot resemble a real person.
//
// It fills the same role as the reference's presenter: full-height in the
// hero, centred under the statement, entering on load, reacting to
// scroll, and able to speak.
//
// SPEECH IS DATA. `script` is an array of timed lines; nothing about the
// character hard-codes what it says. A real recorded or synthesised audio
// track can be attached later through `audioSrc` without touching this
// component's internals.
export interface SpeechLine {
  /** what is said/shown */
  text: string;
  /** ms this line stays on screen when the character is speaking */
  hold?: number;
}

export interface Props {
  /** Ambient lines, one per scroll step of an enclosing [data-swap-root]. */
  lines?: string[];
  /** Timed script used by the talk panel. */
  script?: SpeechLine[];
  /** Optional narration track. Absent by default: nothing autoplays. */
  audioSrc?: string;
  size?: 'sm' | 'md' | 'lg' | 'hero';
  /** Show the round talk trigger, as the reference does in its hero. */
  talkable?: boolean;
  talkLabel?: string;
  class?: string;
}

const {
  lines = [],
  script = [],
  audioSrc,
  size = 'lg',
  talkable = false,
  talkLabel = 'לחצו עליי',
  class: cls = '',
} = Astro.props;

const uid = 'av' + Math.random().toString(36).slice(2, 8);
---

<div class:list={['av', `av--${size}`, cls]} data-avatar data-uid={uid} data-script={JSON.stringify(script)}>
  <div class="av__figure">
    <!-- The character. Drawn, not rendered: it stays crisp at any size,
         recolours with the brand, and costs a few KB. -->
    <svg class="av__svg" viewBox="0 0 260 460" role="img" aria-label="לַהַב, המנחה של LAHAV AI" data-av-svg>
      <defs>
        <linearGradient id={`${uid}-skin`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f6d3b6" />
          <stop offset="1" stop-color="#e6ba97" />
        </linearGradient>
        <linearGradient id={`${uid}-hair`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3c2d22" />
          <stop offset="1" stop-color="#241a13" />
        </linearGradient>
        <linearGradient id={`${uid}-jacket`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#22386f" />
          <stop offset="1" stop-color="#12224a" />
        </linearGradient>
        <linearGradient id={`${uid}-sleeve`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2c4886" />
          <stop offset="1" stop-color="#1a2c5b" />
        </linearGradient>
        <linearGradient id={`${uid}-trouser`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3c4b6d" />
          <stop offset="1" stop-color="#2a3555" />
        </linearGradient>
        <radialGradient id={`${uid}-glow`} cx="50%" cy="50%">
          <stop offset="0" stop-color="#2997ff" stop-opacity="0.40" />
          <stop offset="1" stop-color="#2997ff" stop-opacity="0" />
        </radialGradient>
        <filter id={`${uid}-soft`} x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="7" />
        </filter>
      </defs>

      <ellipse class="av__shadow" cx="130" cy="432" rx="70" ry="11" fill="#0b1530" opacity="0.18" filter={`url(#${uid}-soft)`} />
      <circle cx="130" cy="180" r="132" fill={`url(#${uid}-glow)`} class="av__glow" />

      <g class="av__body">
        <g class="av__legs">
          <path d="M112 266 L104 400 Q103 410 113 410 L124 410 Q130 410 130 400 L130 266 Z" fill={`url(#${uid}-trouser)`} />
          <path d="M148 266 L156 400 Q157 410 147 410 L136 410 Q130 410 130 400 L130 266 Z" fill={`url(#${uid}-trouser)`} opacity="0.9" />
          <path d="M130 268 L130 404" stroke="#242e4a" stroke-width="2" opacity="0.85" />
          <path d="M101 402 q-7 13 4 15 h29 q6 0 6 -6 v-9 z" fill="#161f36" />
          <path d="M159 402 q7 13 -4 15 h-29 q-6 0 -6 -6 v-9 z" fill="#161f36" opacity="0.92" />
        </g>

        <!-- Sleeves are drawn before the torso and in their own, lighter
             tone: same-colour arms flush against the jacket turn the whole
             upper body into one rectangle at small sizes. -->
        <g class="av__arm av__arm--r">
          <path d="M86 146 C 64 158 54 206 58 252 C 59 266 73 269 79 257 C 85 238 82 188 96 164 Z" fill={`url(#${uid}-sleeve)`} />
          <circle cx="68" cy="259" r="10.5" fill={`url(#${uid}-skin)`} />
        </g>
        <g class="av__arm av__arm--l">
          <path d="M174 146 C 196 158 206 206 202 252 C 201 266 187 269 181 257 C 175 238 178 188 164 164 Z" fill={`url(#${uid}-sleeve)`} />
          <circle cx="192" cy="259" r="10.5" fill={`url(#${uid}-skin)`} />
        </g>

        <!-- Torso: sloped shoulders, a waist, and a hem that is not a
             straight horizontal cut. -->
        <path d="M130 122 C 158 122 174 136 180 160 L 188 232 C 191 254 180 268 160 268 L 100 268 C 80 268 69 254 72 232 L 80 160 C 86 136 102 122 130 122 Z" fill={`url(#${uid}-jacket)`} />
        <!-- shirt + lapels -->
        <path d="M113 125 L130 178 L147 125 C 141 121 119 121 113 125 Z" fill="#f8fafe" />
        <path d="M113 125 L130 178 L118 128 Z" fill="#0b1530" opacity="0.22" />
        <path d="M147 125 L130 178 L142 128 Z" fill="#0b1530" opacity="0.14" />
        <path d="M130 178 L123 198 L130 216 L137 198 Z" fill="#2997ff" />

        <rect x="118" y="98" width="24" height="34" rx="11" fill={`url(#${uid}-skin)`} />
        <path d="M106 128 C 116 140 144 140 154 128 L 152 124 C 142 134 118 134 108 124 Z" fill="#0d1a38" opacity="0.16" />

        <g class="av__head">
          <!-- A younger man, not a doll. The first pass read back as "a
               woman, looking very old and boring": a perfectly round
               head, a hair shape that stopped above the ears so the
               sides looked bald, blush on both cheeks, and a red mouth.
               This version has a jawline, hair that comes down past the
               ears with a side part, straighter and lower brows, smaller
               eyes, and no blush. -->
          <!-- face: a chin and a jaw, drawn rather than an ellipse -->
          <path
            d="M95 64 C 95 38 111 24 130 24 C 149 24 165 38 165 64
               C 165 86 161 99 153 108 C 147 115 139 120 130 120
               C 121 120 113 115 107 108 C 99 99 95 86 95 64 Z"
            fill={`url(#${uid}-skin)`}
          />
          <!-- a shaved jaw. Nothing else in a flat drawing this simple
               reads as male as fast, and it replaces the pair of pink
               cheek ellipses that made the first version read feminine. -->
          <path d="M105 96 C 109 111 118 121 130 121 C 142 121 151 111 155 96 C 149 109 141 114 130 114 C 119 114 111 109 105 96 Z" fill="#4a3526" opacity="0.1" />

          <!-- HAIR: a short men's cut. The previous shape came down past
               the jaw on both sides, which is a bob, and is most of why
               this was read back as "the character is a woman". It now
               stops above the ears, with sideburns rather than strands. -->
          <path
            d="M94 84 C 91 54 104 23 130 23 C 156 23 169 54 166 84
               C 165 72 163 62 159 55 C 152 62 141 57 131 53
               C 119 48 107 53 100 62 C 96 68 95 76 94 84 Z"
            fill={`url(#${uid}-hair)`}
          />
          <path d="M102 58 C 114 40 144 38 160 52 C 149 46 132 47 120 54 C 112 58 106 59 102 58 Z" fill={`url(#${uid}-hair)`} opacity="0.8" />
          <path d="M95 80 L99 80 L100 92 Q97 93 95 88 Z" fill={`url(#${uid}-hair)`} />
          <path d="M165 80 L161 80 L160 92 Q163 93 165 88 Z" fill={`url(#${uid}-hair)`} />

          <!-- ears, drawn after the hair so the short cut actually shows them -->
          <ellipse cx="95" cy="86" rx="5" ry="7.5" fill={`url(#${uid}-skin)`} />
          <ellipse cx="165" cy="86" rx="5" ry="7.5" fill={`url(#${uid}-skin)`} />
          <path d="M94 84 q3 2 1 5" stroke="#c98f6a" stroke-width="1.3" fill="none" stroke-linecap="round" />
          <path d="M166 84 q-3 2 -1 5" stroke="#c98f6a" stroke-width="1.3" fill="none" stroke-linecap="round" />

          <!-- brows: straighter, lower and heavier than the arched pair -->
          <path d="M107 65 q9 -3.5 18 -0.5" stroke="#2a1d14" stroke-width="3.2" stroke-linecap="round" fill="none" />
          <path d="M135 64.5 q9 -3 18 0.5" stroke="#2a1d14" stroke-width="3.2" stroke-linecap="round" fill="none" />

          <g class="av__eyes">
            <ellipse class="av__eye" cx="117" cy="77" rx="4.4" ry="4.8" fill="#243244" />
            <ellipse class="av__eye" cx="143" cy="77" rx="4.4" ry="4.8" fill="#243244" />
            <circle cx="118.4" cy="75.2" r="1.35" fill="#fff" opacity="0.9" />
            <circle cx="144.4" cy="75.2" r="1.35" fill="#fff" opacity="0.9" />
            <path d="M112 74 q5 -3.6 10 0" stroke="#b9825d" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.75" />
            <path d="M138 74 q5 -3.6 10 0" stroke="#b9825d" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.75" />
          </g>

          <path d="M130 80 q-3.5 10 1.5 12.5" stroke="#c1875f" stroke-width="2" stroke-linecap="round" fill="none" />
          <!-- flat at rest, so it reads as a closed lip line rather than
               a permanently open oval; the speech animation scales it -->
          <ellipse class="av__mouth" cx="130" cy="101" rx="8" ry="1.7" fill="#7d4340" />
        </g>
      </g>
    </svg>

    <!-- Inside the figure on purpose. The hero places this as a
         percentage of the character, and percentages resolve against the
         containing block, so the containing block has to be the drawing
         rather than the avatar column. -->
    {talkable && script.length > 0 && (
      <button class="av__talk btn-disc" type="button" data-av-talk aria-expanded="false">
        {talkLabel}
      </button>
    )}
  </div>

  <!-- Ambient caption: the line changes with the scroll state of an
       enclosing [data-swap-root]. Real text, so it is selectable and
       announced by screen readers. -->
  {lines.length > 0 && (
    <p class="av__speech" aria-live="polite">
      {lines.map((line: string, i: number) => (
        <span class="av__line" data-active={i === 0 ? 'true' : 'false'}>{line}</span>
      ))}
    </p>
  )}

</div>

<!-- The talk surface. Captions are always the source of truth; audio,
     when a track is supplied, is an enhancement on top. Nothing plays
     until the visitor asks, so there is no autoplay and no surprise
     sound. -->
{talkable && script.length > 0 && (
  <div class="avtalk" data-av-panel={uid} hidden>
    <button class="avtalk__scrim" type="button" data-av-close aria-label="סגירה"></button>
    <div class="avtalk__box" role="dialog" aria-modal="true" aria-label="שיחה עם לַהַב">
      <button class="avtalk__x" type="button" data-av-close aria-label="סגירה">
        <span aria-hidden="true">✕</span>
        <span class="avtalk__x-t">סגירה</span>
      </button>
      <div class="avtalk__stage" data-av-stage></div>
      <p class="avtalk__caption" data-av-caption aria-live="polite"></p>
      <div class="avtalk__bar">
        <button class="btn btn-primary avtalk__replay" type="button" data-av-play>עצירה</button>
        <button class="btn btn-secondary avtalk__mute" type="button" data-av-mute aria-pressed="false">השתקה</button>
        <a class="btn btn-secondary" href="/contact/">לתיאום שיחת היכרות</a>
      </div>
      {audioSrc && <audio data-av-audio src={audioSrc} preload="none"></audio>}
    </div>
  </div>
)}

<style>
  .av { display: flex; flex-direction: column; align-items: center; gap: clamp(1rem, 2vw, 1.75rem); width: min(100%, 34rem); }
  .av__figure { position: relative; width: var(--av-w); flex: none; }
  .av__svg { width: 100%; height: auto; overflow: visible; }

  .av--hero { --av-w: clamp(11rem, 27svh, 19rem); }
  .av--lg   { --av-w: clamp(10rem, 20vw, 16rem); }
  .av--md   { --av-w: clamp(7rem, 13vw, 10rem); }
  .av--sm   { --av-w: clamp(5rem, 9vw, 7rem); }

  /* ---------- idle life ---------- */
  /* A person standing still is not motionless, but they do not float:
     this is a breath, roughly 5s in and out, not the old hover. */
  .av__body { animation: av-bob 5200ms var(--ease-inout) infinite; transform-origin: 130px 440px; }
  @keyframes av-bob {
    0%, 100% { transform: translateY(0) scaleY(1) }
    50%      { transform: translateY(-3px) scaleY(1.006) }
  }
  .av__shadow { animation: av-shadow 5200ms var(--ease-inout) infinite; }
  @keyframes av-shadow {
    0%, 100% { transform: scale(1); opacity: 0.16 }
    50%      { transform: scale(0.9); opacity: 0.11 }
  }
  .av__glow { animation: av-glow 6400ms var(--ease-inout) infinite; transform-origin: 130px 170px; }
  @keyframes av-glow {
    0%, 100% { opacity: 0.55; transform: scale(1) }
    50%      { opacity: 0.9;  transform: scale(1.08) }
  }

  /* blink: scaleY on the eye group, on an irregular-feeling cycle */
  .av__eyes { animation: av-blink 6100ms steps(1, end) infinite; transform-origin: 130px 74px; }
  @keyframes av-blink {
    0%, 96%   { transform: scaleY(1) }
    97%, 98%  { transform: scaleY(0.12) }
    99%, 100% { transform: scaleY(1) }
  }
  .av__arm--r { animation: av-arm 6800ms var(--ease-inout) infinite; transform-origin: 88px 156px; }
  .av__arm--l { animation: av-arm 6800ms var(--ease-inout) infinite reverse; transform-origin: 172px 156px; }
  @keyframes av-arm {
    0%, 100% { transform: rotate(0deg) }
    50%      { transform: rotate(2.2deg) }
  }
  .av__head { animation: av-head 8200ms var(--ease-inout) infinite; transform-origin: 130px 118px; }
  @keyframes av-head {
    0%, 100% { transform: rotate(0deg) translateY(0) }
    35%      { transform: rotate(-1.6deg) translateY(-2px) }
    70%      { transform: rotate(1.4deg) translateY(1px) }
  }

  /* ---------- speaking ---------- */
  /* No keyframes: the mouth is driven from JS by the actual voice signal
     (audio amplitude, or the speech engine's word boundaries). All the
     stylesheet owns is the origin and a short smoothing transition. */
  .av__mouth {
    /* `transform-box: fill-box` makes transform-origin relative to the
       ELEMENT'S OWN fill box, which for this ellipse is 18x5 units. The
       origin used to be given as 130px 96px, i.e. the mouth's position
       in the SVG's user space, which lands about 112 units to the right
       of and 92 units below a box that small. Scaling 4x about a point
       that far away is what threw the lips off the screen while it
       spoke. With fill-box the origin has to be expressed inside the
       box; 30% down is where a jaw hinges. */
    transform-box: fill-box;
    transform-origin: 50% 30%;
    transition: transform 60ms linear;
  }
  /* the head settles while speaking, so the mouth is the moving part */
  .av.is-talking .av__head { animation-duration: 5200ms; }

  /* ---------- entrance ---------- */
  html.mo-ready .av__figure { opacity: 0; transform: translateY(26px) scale(0.94); }
  html.mo-ready .av.is-in .av__figure {
    opacity: 1; transform: none;
    transition: opacity 900ms var(--ease-out) 120ms, transform 1100ms var(--ease-out) 120ms;
  }

  /* ---------- ambient caption ---------- */
  .av__speech {
    position: relative; margin: 0; width: 100%; max-width: 26ch;
    min-height: 3.4em; text-align: center;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.3vw, 1.25rem);
    font-weight: 700; line-height: 1.35;
  }
  .av__line {
    position: absolute; inset: 0; opacity: 0; transform: translateY(12px);
    transition: opacity 560ms var(--ease-out), transform 560ms var(--ease-out);
  }
  .av__line[data-active='true'] { opacity: 1; transform: none; }
  /* With no JS every line would stack invisibly, so only the first shows. */
  html:not(.mo-ready) .av__line { position: static; opacity: 1; transform: none; }
  html:not(.mo-ready) .av__line:not(:first-child) { display: none; }

  /* Reported as "completely static, I want it to pop out somehow". The
     disc now breathes and carries an outward halo, so it reads as the
     thing to press. Both stop on hover and focus, where the pointer has
     already found it and the motion would only be noise. */
  .av__talk {
    margin-top: 0.25rem;
    max-width: 100%;
    position: relative;
    animation: av-talk-bob 2.8s var(--ease-inout) infinite;
  }
  .av__talk::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    border: 2px solid var(--color-royal);
    animation: av-talk-halo 2.8s var(--ease-out) infinite;
    pointer-events: none;
  }
  .av__talk:hover, .av__talk:focus-visible { animation-play-state: paused; }
  .av__talk:hover::after, .av__talk:focus-visible::after { animation-play-state: paused; opacity: 0; }
  /* `translate` and `scale`, NOT `transform`. In the hero the disc is
     centred on the figure with `transform: translateX(50%)`, and
     animating `transform` here replaced that and shifted the button
     44px off the character. The individual properties compose with it
     instead of overwriting it. */
  @keyframes av-talk-bob {
    0%, 100% { translate: 0 0;    scale: 1 }
    42%      { translate: 0 -6px; scale: 1.035 }
    62%      { translate: 0 0;    scale: 0.995 }
  }
  @keyframes av-talk-halo {
    0%   { transform: scale(1);    opacity: 0.55 }
    70%  { transform: scale(1.38); opacity: 0 }
    100% { transform: scale(1.38); opacity: 0 }
  }
  @media (prefers-reduced-motion: reduce) {
    .av__talk, .av__talk::after { animation: none; }
  }

  /* ---------- talk panel ---------- */
  .avtalk { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; }
  .avtalk[hidden] { display: none; }
  .avtalk__scrim {
    position: absolute; inset: 0; border: 0; padding: 0;
    background: rgba(11, 21, 48, 0.55);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity: 0; transition: opacity var(--dur) var(--ease-out);
    cursor: pointer;
  }
  .avtalk[data-open='true'] .avtalk__scrim { opacity: 1; }
  .avtalk__box {
    position: relative;
    width: min(92vw, 26rem);
    background: var(--gradient-hero);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-lg);
    text-align: center;
    opacity: 0; transform: translateY(22px) scale(0.97);
    transition: opacity var(--dur) var(--ease-out), transform 520ms var(--ease-out);
  }
  .avtalk[data-open='true'] .avtalk__box { opacity: 1; transform: none; }
  .avtalk__x {
    position: absolute; inset-inline-end: 0.6rem; top: 0.6rem;
    display: inline-flex; align-items: center; gap: 0.4rem;
    min-height: 2.75rem; padding-inline: 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong); background: #fff;
    box-shadow: 0 6px 18px rgba(11, 26, 66, 0.14);
    cursor: pointer; font-size: 0.875rem; font-weight: 700; color: var(--color-ink);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .avtalk__x:hover { background: var(--color-soft); transform: translateY(-1px); }
  .avtalk__x-t { font-family: var(--font-display); }
  .avtalk__stage { display: grid; place-items: center; }
  .avtalk__stage :global(.av) { gap: 0; }
  .avtalk__stage :global(.av__figure) { width: clamp(9rem, 34vw, 12rem); opacity: 1 !important; transform: none !important; }
  .avtalk__caption {
    min-height: 4.5em; margin: 1rem auto 0; max-width: 24ch;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.4;
  }
  .avtalk__bar { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; }
  .avtalk__bar .btn { min-height: 46px; padding-inline: 1.2rem; font-size: var(--text-small); }

  @media (prefers-reduced-motion: reduce) {
    .av__body, .av__shadow, .av__glow, .av__mouth,
    .av__eyes, .av__arm--r, .av__arm--l, .av__head { animation: none; }
    .av__mouth { transition: none; }
    html.mo-ready .av__figure { opacity: 1; transform: none; }
    .av__line, .avtalk__scrim, .avtalk__box { transition: none; }
  }
</style>

<script>
  type Line = { text: string; hold?: number };

  document.querySelectorAll<HTMLElement>('[data-avatar]').forEach((av) => {
    // ---- entrance ----
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { av.classList.add('is-in'); io.unobserve(e.target); } }),
      { threshold: 0.15 }
    );
    io.observe(av);

    // ---- ambient caption follows the section's scroll state ----
    const swapRoot = av.closest<HTMLElement>('[data-swap-root]');
    const lines = Array.from(av.querySelectorAll<HTMLElement>('.av__line'));
    if (swapRoot && lines.length > 1) {
      const apply = () => {
        const raw = Number(swapRoot.getAttribute('data-swap') ?? '0');
        const idx = Math.min(Math.max(raw, 0), lines.length - 1);
        lines.forEach((l, i) => l.setAttribute('data-active', String(i === idx)));
      };
      new MutationObserver(apply).observe(swapRoot, { attributes: true, attributeFilter: ['data-swap'] });
      apply();
    }
  });

  // ---- talk panel ----
  document.querySelectorAll<HTMLButtonElement>('[data-av-talk]').forEach((btn) => {
    const host = btn.closest<HTMLElement>('[data-avatar]');
    if (!host) return;
    const uid = host.dataset.uid!;
    const panel = document.querySelector<HTMLElement>(`[data-av-panel="${uid}"]`);
    if (!panel) return;

    // PORTAL THE PANEL TO <body>.
    //
    // `.avtalk` is position:fixed with z-index 80, but it is rendered
    // inside `.hero__figure`, which has `position: relative; z-index: 2`
    // and therefore creates a stacking context. That traps the panel's
    // z-index INSIDE that context, and `.hero__inner` (the headline) sits
    // at z-index 3 in the same parent, so the hero copy painted straight
    // over the open modal. Moving the panel to <body> takes it out of
    // every ancestor context for good.
    if (panel.parentElement !== document.body) document.body.appendChild(panel);

    const stage = panel.querySelector<HTMLElement>('[data-av-stage]')!;
    const caption = panel.querySelector<HTMLElement>('[data-av-caption]')!;
    const audio = panel.querySelector<HTMLAudioElement>('[data-av-audio]');
    const box = panel.querySelector<HTMLElement>('.avtalk__box')!;
    const playBtn = panel.querySelector<HTMLButtonElement>('[data-av-play]')!;
    // Reported as "I can't even stop it, so very very bad". There was no
    // stop at all: the only controls were replay and mute, and muting
    // cancels the current sentence while the script marches on to the
    // next one. This is now an explicit stop/replay toggle.
    let playing = false;
    const paintPlay = () => {
      playBtn.textContent = playing ? 'עצירה' : 'להשמיע שוב';
      playBtn.setAttribute('aria-pressed', String(playing));
    };

    // The panel shows the same character: clone the figure so the visitor
    // keeps talking to who they clicked, not a different illustration.
    const figure = host.querySelector('.av__figure');
    let panelAv: HTMLElement | null = null;
    if (figure && !stage.childElementCount) {
      panelAv = document.createElement('div');
      panelAv.className = 'av av--md';
      const clone = figure.cloneNode(true) as HTMLElement;
      // The trigger now lives INSIDE the figure, so a straight clone
      // would put a second "לחצו עליי" disc inside the dialog the disc
      // just opened, still carrying data-av-talk.
      clone.querySelector('[data-av-talk]')?.remove();
      panelAv.appendChild(clone);
      stage.appendChild(panelAv);
    }

    let script: Line[] = [];
    try { script = JSON.parse(host.dataset.script || '[]'); } catch {}

    let timer: number | undefined;
    // Each play gets its own token. An older run that is still waiting on
    // `speak()` checks the token when it wakes up and bails, so pressing
    // "שוב" twice cannot leave two scripts racing each other. Declared
    // here, above stop(), so stop() can never read it in its dead zone.
    let runToken = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // SPEECH.
    //
    // The browser's own speech engine reads the script out loud in
    // Hebrew. No API, no key, no per-visit cost, and it works offline.
    // Every device ships at least one he-IL voice (Carmit on Apple,
    // Asaf on Windows, Google's on Android); if none is installed the
    // captions still carry the whole script, so nothing is lost.
    //
    // An `audioSrc` recording, when one is supplied, always wins: a real
    // narration track is better than a synthesiser.
    const synth = 'speechSynthesis' in window ? window.speechSynthesis : null;
    let heVoice: SpeechSynthesisVoice | null = null;
    const pickVoice = () => {
      if (!synth) return;
      const voices = synth.getVoices();
      heVoice =
        voices.find((v) => v.lang === 'he-IL') ??
        voices.find((v) => v.lang?.toLowerCase().startsWith('he')) ??
        null;
    };
    pickVoice();
    // Chrome populates the voice list asynchronously.
    synth?.addEventListener?.('voiceschanged', pickVoice);

    // Muting is remembered, so a visitor who does not want sound is not
    // asked twice in the same session.
    let muted = false;
    try { muted = sessionStorage.getItem('lahav-av-muted') === '1'; } catch {}

    // Resolves when the line has finished being spoken. If there is no
    // speech engine, no Hebrew voice, or the visitor muted it, it
    // resolves immediately and the caller falls back to a timer.
    // ---------------- MOUTH ----------------
    //
    // The mouth is driven by the VOICE, not by a fixed loop.
    //
    //  · With a real audio track a Web Audio AnalyserNode reads the signal
    //    every frame and the opening follows its amplitude. That is the
    //    path a produced narration will use, and it is why `audioSrc`
    //    exists as a prop.
    //  · With the browser speech engine there is no audio stream to
    //    analyse, so the next best REAL signal is used: the utterance's
    //    own `boundary` events, which fire per word on the actual speech
    //    timeline. Between boundaries the opening decays.
    //
    // Either way the mouth closes the moment speech stops, and the value
    // is smoothed so it never jitters. Introducing phoneme/viseme data
    // later means changing what feeds `mouthTarget`, nothing else.
    const mouthEl = () => panelAv?.querySelector('.av__mouth') as SVGElement | null;
    let mouthRaf = 0;
    let mouthOff = 0;
    let mouthTarget = 0;
    let mouthValue = 0;

    const paintMouth = () => {
      // fast to open, slower to close, so it reads as speech not a blink
      const k = mouthTarget > mouthValue ? 0.45 : 0.18;
      mouthValue += (mouthTarget - mouthValue) * k;
      const el = mouthEl();
      if (el) {
        const open = 1 + mouthValue * 3.2;
        const wide = 1 - mouthValue * 0.14;
        el.style.transform = `scaleY(${open.toFixed(3)}) scaleX(${wide.toFixed(3)})`;
      }
      mouthRaf = requestAnimationFrame(paintMouth);
    };

    // play() calls stop() before it starts, so the delayed teardown below
    // has to be cancellable or it fires 260ms into the NEW run and kills
    // the animation that just began.
    const startMouth = () => {
      if (mouthOff) { window.clearTimeout(mouthOff); mouthOff = 0; }
      if (!mouthRaf) paintMouth();
    };
    const stopMouth = () => {
      mouthTarget = 0;
      window.clearTimeout(mouthOff);
      mouthOff = window.setTimeout(() => {
        mouthOff = 0;
        if (mouthRaf) { cancelAnimationFrame(mouthRaf); mouthRaf = 0; }
        mouthValue = 0;
        const el = mouthEl();
        if (el) el.style.transform = '';
      }, 260);
    };

    // Real audio: amplitude drives the opening.
    let analyser: AnalyserNode | null = null;
    const attachAnalyser = () => {
      if (!audio || analyser) return;
      try {
        const Ctx = (window.AudioContext || (window as any).webkitAudioContext) as typeof AudioContext;
        const ctx = new Ctx();
        const src = ctx.createMediaElementSource(audio);
        analyser = ctx.createAnalyser();
        analyser.fftSize = 512;
        src.connect(analyser);
        analyser.connect(ctx.destination);
        const data = new Uint8Array(analyser.frequencyBinCount);
        const pump = () => {
          if (!analyser) return;
          analyser.getByteTimeDomainData(data);
          let sum = 0;
          for (let i = 0; i < data.length; i++) {
            const v = (data[i] - 128) / 128;
            sum += v * v;
          }
          const rms = Math.sqrt(sum / data.length);
          mouthTarget = audio!.paused ? 0 : Math.min(1, rms * 4.5);
          requestAnimationFrame(pump);
        };
        pump();
      } catch {
        // No Web Audio available: captions still carry the whole script.
      }
    };

    const speak = (text: string): Promise<boolean> =>
      new Promise((resolve) => {
        if (!synth || muted || audio) { resolve(false); return; }
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'he-IL';
        if (heVoice) u.voice = heVoice;
        u.rate = 0.98;
        u.pitch = 1.0;
        let settled = false;
        const done = (ok: boolean) => { if (!settled) { settled = true; resolve(ok); } };
        u.onstart = () => startMouth();
        u.onend = () => { mouthTarget = 0; done(true); };
        u.onerror = () => { mouthTarget = 0; done(false); };
        // Word boundaries are the only real timing signal a speech engine
        // exposes. Each one opens the mouth; it decays until the next.
        u.onboundary = () => {
          mouthTarget = 0.55 + Math.random() * 0.45;
          window.setTimeout(() => { mouthTarget *= 0.25; }, 90);
        };
        // Some engines never fire onend on a long utterance. This is the
        // escape hatch so the script can never hang half way through.
        window.setTimeout(() => done(false), Math.max(6000, text.length * 220));
        synth.speak(u);
      });

    const stop = () => {
      runToken += 1;
      playing = false;
      paintPlay();
      window.clearTimeout(timer);
      panelAv?.classList.remove('is-talking');
      if (audio) { audio.pause(); audio.currentTime = 0; }
      synth?.cancel();
      stopMouth();
    };

    const play = async () => {
      stop();
      if (!script.length) return;
      const myRun = ++runToken;
      playing = true;
      paintPlay();
      panelAv?.classList.add('is-talking');
      startMouth();
      if (audio) {
        attachAnalyser();
        audio.play().catch(() => { /* no track, captions carry it */ });
      }

      for (const line of script) {
        if (myRun !== runToken) return;
        caption.textContent = line.text;

        // CAPTION SYNC. The caption used to advance on a fixed timer while
        // the voice spoke at its own pace, so the two drifted apart within
        // two lines. Now the caption waits for the line to actually finish
        // being spoken, and only falls back to the timer when there is no
        // speech to wait for.
        const spoken = await speak(line.text);
        if (myRun !== runToken) return;

        if (spoken) {
          // a short beat between lines, the way a person pauses
          await new Promise((r) => { timer = window.setTimeout(r, reduced ? 700 : 380); });
        } else {
          const hold = line.hold ?? Math.max(1800, line.text.length * 70);
          await new Promise((r) => { timer = window.setTimeout(r, reduced ? hold + 400 : hold); });
        }
        if (myRun !== runToken) return;
      }

      playing = false;
      paintPlay();
      panelAv?.classList.remove('is-talking');
      stopMouth();
    };

    const setOpen = (open: boolean) => {
      if (open) panel.hidden = false;
      panel.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        requestAnimationFrame(play);
      } else {
        stop();
        caption.textContent = '';
        window.setTimeout(() => { if (panel.dataset.open !== 'true') panel.hidden = true; }, 420);
      }
    };

    btn.addEventListener('click', () => setOpen(true));
    playBtn.addEventListener('click', () => { if (playing) stop(); else play(); });
    paintPlay();

    const muteBtn = panel.querySelector<HTMLButtonElement>('[data-av-mute]');
    const paintMute = () => {
      if (!muteBtn) return;
      muteBtn.textContent = muted ? 'הפעלת קול' : 'השתקה';
      muteBtn.setAttribute('aria-pressed', String(muted));
    };
    paintMute();
    // No speech engine at all: hide the control rather than offer a
    // toggle that does nothing.
    if (!synth && muteBtn) muteBtn.hidden = true;
    muteBtn?.addEventListener('click', () => {
      muted = !muted;
      try { sessionStorage.setItem('lahav-av-muted', muted ? '1' : '0'); } catch {}
      if (muted) synth?.cancel();
      paintMute();
    });
    const close = () => { setOpen(false); btn.focus(); };
    panel.querySelectorAll('[data-av-close]').forEach((c) => c.addEventListener('click', close));
    // Reported as "I can't even click outside, I have to try many keys to
    // be able to close it". The scrim is a sibling of the dialog, so on a
    // phone, where the dialog fills almost the whole screen, there was
    // barely any scrim left to hit. Any pointer that lands outside the
    // dialog box now closes, whatever it actually landed on.
    panel.addEventListener('pointerdown', (e) => {
      if (!box.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.dataset.open === 'true') { setOpen(false); btn.focus(); }
    });
  });
</script>
