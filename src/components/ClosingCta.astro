---
// Reusable closing conversion band, appears once, near the end of every
// page (PRD §6, "every page must include ... a primary CTA, a WhatsApp
// route"). Same component everywhere so the CTA hierarchy never drifts.
import { CTA_PRIMARY, WHATSAPP_HREF } from '../lib/site';
import WhatsApp from './icons/WhatsApp.astro';

interface Props {
  heading: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<section class="cta-band on-dark">
  <div class="u-container cta-band__inner">
    <h2 class="t-h1 cta-band__heading">{heading}</h2>
    {body && <p class="t-lead cta-band__body">{body}</p>}
    <div class="cta-band__actions">
      <a class="btn btn-primary btn-lg cta-band__primary" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
      <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
        <WhatsApp />
        שיחה בוואטסאפ
      </a>
    </div>
  </div>
</section>

<style>
  /* Fades IN to the brand gradient rather than starting with it: the
     section begins transparent (showing whatever the body's own gradient
     looks like at that scroll position) and only reaches full brand
     vividness by its lower half, where the buttons sit. This is what
     removes the hard horizontal seam the flat gradient used to create
     against the section above it. */
  .cta-band {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(29, 78, 216, 0.4) 45%,
      #1d4ed8 75%,
      #2997ff 100%
    );
    text-align: center;
    padding-block: var(--space-section);
  }
  .cta-band__heading {
    color: #fff;
    max-width: 20ch;
    margin-inline: auto;
  }
  .cta-band__body {
    color: rgba(255, 255, 255, 0.88);
    max-width: 56ch;
    margin: 1.25rem auto 0;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }
  .cta-band__primary {
    background: #fff;
    color: var(--color-royal);
  }
  .cta-band__primary:hover {
    background: #eef2ff;
  }

  @media (max-width: 560px) {
    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
