---
// Reusable closing conversion band — appears once, near the end of every
// page (PRD §6, "every page must include ... a primary CTA, a WhatsApp
// route"). Same component everywhere so the CTA hierarchy never drifts.
import { CTA_PRIMARY, WHATSAPP_HREF } from '../lib/site';

interface Props {
  heading: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<section class="cta-band on-dark">
  <div class="u-container cta-band__inner">
    <h2 class="t-h1 cta-band__heading">{heading}</h2>
    {body && <p class="t-lead cta-band__body">{body}</p>}
    <div class="cta-band__actions">
      <a class="btn btn-primary btn-lg cta-band__primary" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
      <a class="btn btn-secondary btn-lg" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23Z"
          ></path></svg
        >
        שיחה בוואטסאפ
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--gradient-brand);
    text-align: center;
    padding-block: var(--space-section);
  }
  .cta-band__heading {
    color: #fff;
    max-width: 20ch;
    margin-inline: auto;
  }
  .cta-band__body {
    color: rgba(255, 255, 255, 0.88);
    max-width: 56ch;
    margin: 1.25rem auto 0;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }
  .cta-band__primary {
    background: #fff;
    color: var(--color-royal);
  }
  .cta-band__primary:hover {
    background: #eef2ff;
  }

  @media (max-width: 560px) {
    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
