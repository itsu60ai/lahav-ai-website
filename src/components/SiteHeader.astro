---
import WhatsApp from './icons/WhatsApp.astro';
import { SERVICE_ICONS } from '../lib/icons';
import { NAV, CTA_PRIMARY, WHATSAPP_HREF, SERVICES } from '../lib/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="hdr" data-header>
  <div class="u-container hdr__inner">
    <a class="hdr__brand" href="/" aria-label="LAHAV AI, לדף הבית">
      <img src="/brand/lahav-primary-lockup.svg" alt="LAHAV AI" width="118" height="87" />
    </a>

    <nav class="hdr__nav" aria-label="ניווט ראשי">
      {
        NAV.map((item) =>
          'children' in item ? (
            <div class="hdr__dd" data-dropdown>
              <button
                class="hdr__link hdr__dd-btn"
                type="button"
                aria-expanded="false"
                aria-controls="services-menu"
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-dropdown-btn
              >
                {item.label}
                <svg class="hdr__caret" width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
                  <path d="M1 1.5 5.5 5.5 10 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>

              <div class="hdr__dd-panel" id="services-menu" data-dropdown-panel>
                <a class="hdr__dd-all" href={item.href}>
                  כל השירותים
                  <span class="arrow-inline" aria-hidden="true">←</span>
                </a>
                {SERVICES.map((s) => (
                  <a class="hdr__dd-item" href={`/services/${s.slug}/`}>
                    <span class="hdr__dd-name">{s.name}</span>
                    <span class="hdr__dd-lead">{s.lead}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a class="hdr__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <a class="btn btn-primary hdr__cta" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="hdr__burger-bars" aria-hidden="true"></span>
      <span class="sr-only">פתיחת תפריט</span>
    </button>
  </div>

  <div class="hdr__mobile" id="mobile-nav" data-menu-panel>
    <div class="u-container hdr__mobile-inner">
      <a class="hdr__mobile-link" href="/" style="--i:0">
        בית
        <span class="hdr__mobile-arr" aria-hidden="true">←</span>
      </a>

      <div class="hdr__mobile-group" style="--i:1">
        <a class="hdr__mobile-link hdr__mobile-link--head" href="/services/">
          שירותים
          <span class="hdr__mobile-all">לכל השירותים</span>
        </a>
        <div class="hdr__mobile-sub">
          {
            SERVICES.map((sv, i) => (
              <a href={`/services/${sv.slug}/`} style={`--j:${i}`}>
                <span class="hdr__svc-ico" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={SERVICE_ICONS[sv.slug]}
                  />
                </span>
                <span class="hdr__svc-txt">
                  <b>{sv.name}</b>
                  <small>{sv.lead}</small>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <a class="hdr__mobile-link" href="/about/" style="--i:2">
        אודות
        <span class="hdr__mobile-arr" aria-hidden="true">←</span>
      </a>
      <a class="hdr__mobile-link" href="/contact/" style="--i:3">
        צור קשר
        <span class="hdr__mobile-arr" aria-hidden="true">←</span>
      </a>

      <div class="hdr__mobile-foot" style="--i:4">
        <p class="hdr__mobile-note">30 דקות, בלי התחייבות.</p>
        <a class="btn btn-primary" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
        <a class="btn btn-secondary" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
          <WhatsApp />
          שיחה בוואטסאפ
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // ---- Services dropdown: pointer + keyboard, both first class ----
  const dd = document.querySelector<HTMLElement>('[data-dropdown]');
  const ddBtn = document.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
  const ddPanel = document.querySelector<HTMLElement>('[data-dropdown-panel]');

  if (dd && ddBtn && ddPanel) {
    let closeTimer: number | undefined;
    // Hover opens the panel transiently. A click "pins" it so moving the
    // pointer away no longer closes it. Without this, hovering opens the
    // panel and the click that follows immediately toggles it shut.
    let pinned = false;

    const openDd = () => {
      window.clearTimeout(closeTimer);
      dd.classList.add('is-open');
      ddBtn.setAttribute('aria-expanded', 'true');
    };
    const closeDd = () => {
      pinned = false;
      dd.classList.remove('is-open');
      ddBtn.setAttribute('aria-expanded', 'false');
    };

    ddBtn.addEventListener('click', () => {
      if (pinned) {
        closeDd();
      } else {
        pinned = true;
        openDd();
      }
    });

    // Mouse users get hover, with a small grace period so the pointer can
    // travel from the button to the panel without it snapping shut.
    dd.addEventListener('mouseenter', openDd);
    dd.addEventListener('mouseleave', () => {
      if (pinned) return;
      closeTimer = window.setTimeout(closeDd, 160);
    });

    // Keyboard: close on Escape, and close once focus leaves the group.
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDd();
        ddBtn.focus();
      }
    });
    dd.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!dd.contains(document.activeElement)) closeDd();
      }, 0);
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) closeDd();
    });
  }

  // ---- Mobile menu ----
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const close = () => {
      panel.classList.remove('is-open');
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      panel.classList.add('is-open');
      toggle.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>('a, button')?.focus();
    };

    toggle.addEventListener('click', () => {
      panel.classList.contains('is-open') ? close() : open();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        close();
        toggle.focus();
      }
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const f = panel.querySelectorAll<HTMLElement>('a, button');
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  // ---- Header gains a hairline + stronger blur once the page scrolls ----
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .hdr.is-scrolled {
    border-bottom-color: var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 80px;
  }
  .hdr__brand {
    flex: 0 0 auto;
    line-height: 0;
  }
  .hdr__brand img {
    width: 116px;
    height: auto;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.5rem);
    margin-inline-start: auto;
  }
  .hdr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-small);
    font-family: var(--font-body);
    padding: 0.6rem 0.75rem;
    border: 0;
    background: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .hdr__link:hover {
    color: var(--color-royal);
    background: color-mix(in srgb, var(--color-royal) 6%, transparent);
  }
  .hdr__link[aria-current='page'] {
    color: var(--color-royal);
    font-weight: 700;
  }

  /* ---------- Services dropdown ---------- */
  .hdr__dd {
    position: relative;
  }
  .hdr__caret {
    transition: transform var(--dur) var(--ease-out);
  }
  .hdr__dd.is-open .hdr__caret {
    transform: rotate(180deg);
  }
  .hdr__dd-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-start: 0;
    width: min(23rem, calc(100vw - 2rem));
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition:
      opacity var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out),
      visibility var(--dur);
  }
  .hdr__dd.is-open .hdr__dd-panel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }
  .hdr__dd-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-out);
  }
  .hdr__dd-item:hover {
    background: var(--color-surface-2);
  }
  .hdr__dd-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--color-ink);
  }
  .hdr__dd-lead {
    font-size: var(--text-micro);
    color: var(--color-ink-3);
    line-height: 1.45;
  }
  .hdr__dd-all {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem 0.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-royal);
    text-decoration: none;
  }
  .hdr__dd-all:hover {
    text-decoration: underline;
  }

  .hdr__cta {
    flex: 0 0 auto;
    min-height: 46px;
    font-size: var(--text-small);
    padding-inline: 1.375rem;
  }

  /* ---------- Burger ---------- */
  .hdr__burger {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-surface);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .hdr__burger-bars,
  .hdr__burger-bars::before,
  .hdr__burger-bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .hdr__burger-bars {
    position: relative;
  }
  .hdr__burger-bars::before,
  .hdr__burger-bars::after {
    content: '';
    position: absolute;
    inset-inline: 0;
  }
  .hdr__burger-bars::before {
    top: -6px;
  }
  .hdr__burger-bars::after {
    top: 6px;
  }
  .hdr__burger.is-open .hdr__burger-bars {
    background: transparent;
  }
  .hdr__burger.is-open .hdr__burger-bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .hdr__burger.is-open .hdr__burger-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---------- Mobile panel ---------- */
  .hdr__mobile {
    display: none;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    max-height: calc(100dvh - 80px);
    overflow-y: auto;
  }
  .hdr__mobile.is-open {
    display: block;
  }
  .hdr__mobile-inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem 2rem;
  }

  /* items arrive in sequence when the panel opens */
  .hdr__mobile.is-open .hdr__mobile-link,
  .hdr__mobile.is-open .hdr__mobile-group,
  .hdr__mobile.is-open .hdr__mobile-foot {
    animation: hdr-in 380ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 55ms);
  }
  @keyframes hdr-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .hdr__mobile-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  .hdr__mobile-arr {
    color: var(--color-electric);
    font-size: 1rem;
  }
  .hdr__mobile-link--head {
    border-bottom: 0;
    padding-bottom: 0.625rem;
  }
  .hdr__mobile-all {
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-royal);
  }
  .hdr__mobile-group {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1rem;
  }

  /* the five services, as real rows rather than an indented list */
  .hdr__mobile-sub {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .hdr__mobile-sub a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    background: var(--color-surface-2);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-out);
  }
  .hdr__mobile-sub a:hover {
    background: color-mix(in srgb, var(--color-royal) 9%, transparent);
  }
  .hdr__svc-ico {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 0.625rem;
    background: #fff;
    color: var(--color-royal);
    border: 1px solid var(--color-line);
  }
  .hdr__svc-ico svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .hdr__svc-txt {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }
  .hdr__svc-txt b {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .hdr__svc-txt small {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hdr__mobile-foot {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .hdr__mobile-note {
    font-size: var(--text-small);
    color: var(--color-ink-3);
    margin-bottom: 0.125rem;
  }
  .hdr__mobile-foot .btn {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__mobile.is-open .hdr__mobile-link,
    .hdr__mobile.is-open .hdr__mobile-group,
    .hdr__mobile.is-open .hdr__mobile-foot {
      animation: none !important;
    }
  }

  @media (max-width: 980px) {
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
    .hdr__burger {
      display: flex;
      margin-inline-start: auto;
    }
  }
</style>
