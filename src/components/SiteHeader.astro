---
import { NAV, CTA_PRIMARY, WHATSAPP_HREF } from '../lib/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="hdr">
  <div class="u-container hdr__inner">
    <a class="hdr__brand" href="/" aria-label="LAHAV AI — לדף הבית">
      <img src="/brand/lahav-primary-lockup.svg" alt="LAHAV AI" width="118" height="87" />
    </a>

    <nav class="hdr__nav" aria-label="ניווט ראשי">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn-primary hdr__cta" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span></span>
      <span class="sr-only">פתיחת תפריט</span>
    </button>
  </div>

  <div class="hdr__mobile" id="mobile-nav" data-menu-panel>
    <div class="u-container hdr__mobile-inner">
      {
        NAV.map((item) => (
          <a class="hdr__mobile-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
      <a class="btn btn-secondary" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
        שיחה בוואטסאפ
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  if (toggle && panel) {
    const close = () => {
      panel.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>('a, button')?.focus();
    };
    toggle.addEventListener('click', () => {
      panel.classList.contains('is-open') ? close() : open();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        close();
        toggle.focus();
      }
    });
    // Simple focus trap while the panel is open
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = panel.querySelectorAll<HTMLElement>('a, button');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 76px;
  }
  .hdr__brand {
    flex: 0 0 auto;
    line-height: 0;
  }
  .hdr__brand img {
    width: 118px;
    height: auto;
  }
  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    margin-inline-start: auto;
  }
  .hdr__nav a {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-small);
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
  }
  .hdr__nav a:hover {
    border-bottom-color: var(--color-electric);
  }
  .hdr__nav a[aria-current='page'] {
    border-bottom-color: var(--color-royal);
    font-weight: 700;
  }
  .hdr__cta {
    flex: 0 0 auto;
    min-height: 46px;
    font-size: var(--text-small);
    padding-inline: 1.375rem;
  }

  .hdr__burger {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .hdr__burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
  }
  .hdr__burger span::before,
  .hdr__burger span::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 2px;
    background: var(--color-ink);
  }
  .hdr__burger span::before {
    top: -6px;
  }
  .hdr__burger span::after {
    top: 6px;
  }

  .hdr__mobile {
    display: none;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .hdr__mobile.is-open {
    display: block;
  }
  .hdr__mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.25rem 1.75rem;
  }
  .hdr__mobile-link {
    padding: 0.875rem 0;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  .hdr__mobile-inner .btn {
    margin-top: 0.75rem;
    width: 100%;
  }

  @media (max-width: 900px) {
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
    .hdr__burger {
      display: flex;
      margin-inline-start: auto;
    }
  }
</style>
