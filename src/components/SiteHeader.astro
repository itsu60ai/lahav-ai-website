---
// Site header, V3.
//
// Behaviour taken from the reference: a transparent bar over the hero
// that gains a solid surface and a hairline once you scroll, an
// oversized full-screen overlay menu rather than a dropdown drawer, and
// a persistent primary CTA. Labels and structure stay LAHAV's own.
import { NAV, CTA_PRIMARY, SERVICES } from '../lib/site';
import { SERVICE_ICONS } from '../lib/icons';

interface Props { currentPath: string; solid?: boolean }
const { currentPath, solid = false } = Astro.props;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class:list={['hdr', solid && 'is-solid']} data-header>
  <div class="u-container u-container--wide hdr__inner">
    <a class="hdr__brand" href="/" aria-label="LAHAV AI, לדף הבית">
      <img src="/brand/lahav-primary-lockup.svg" alt="LAHAV AI" width="104" height="77" />
    </a>

    <nav class="hdr__nav" aria-label="ניווט ראשי">
      {NAV.map((item) =>
        item.href === '/services/' ? (
          <div class="hdr__has-mega" data-mega-wrap>
            <a
              class:list={['hdr__link', isActive(item.href) && 'is-on']}
              href={item.href}
              aria-expanded="false"
              aria-controls="mega-services"
              data-mega-btn
            >
              <span>{item.label}</span>
              <span class="hdr__caret" aria-hidden="true"></span>
            </a>
          </div>
        ) : (
          <a
            class:list={['hdr__link', isActive(item.href) && 'is-on']}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
          </a>
        )
      )}
    </nav>

    <div class="hdr__end">
      <a class="btn btn-primary hdr__cta" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>

      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
        <span class="hdr__burger-bars" aria-hidden="true"></span>
        <span class="sr-only">פתיחת תפריט</span>
      </button>
    </div>
  </div>

  <!-- SERVICES MEGA MENU.
       Desktop only. It is a real region with a real heading, opened by
       hover OR click/keyboard, and it closes on Escape, on blur out of
       the whole group, and on pointer leave. -->
  <div class="mega" id="mega-services" data-mega hidden>
    <div class="u-container u-container--wide mega__inner">
      <div class="mega__lead">
        <p class="t-eyebrow">השירותים שלנו</p>
        <p class="mega__h">מתחילים במה שהכי מציק.</p>
        <a class="link-arrow mega__all" href="/services/">
          לכל השירותים <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>

      <ul class="mega__list">
        {SERVICES.map((s, i) => (
          <li>
            <a class="mega__card" href={`/services/${s.slug}/`}>
              <span class="mega__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="mega__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" set:html={SERVICE_ICONS[s.slug]} />
              </span>
              <span class="mega__name">{s.name}</span>
              <span class="mega__lead-t">{s.lead}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<!-- Full-screen overlay menu: oversized type, staggered entrance. -->
<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__inner u-container">
    <nav class="menu__nav" aria-label="ניווט">
      {NAV.map((item, i) => (
        <a class="menu__link" href={item.href} style={`--i:${i}`}>
          <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="menu__label">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="menu__side">
      <!-- Not the desktop mega menu squeezed onto a phone: an expandable
           group that behaves like a phone menu should. -->
      <details class="menu__svc-group" data-menu-svc>
        <summary>
          <span>כל השירותים</span>
          <span class="menu__svc-ico" aria-hidden="true"></span>
        </summary>
        <ul class="menu__svc">
          {SERVICES.map((s, i) => (
            <li>
              <a href={`/services/${s.slug}/`}>
                <span class="menu__svc-n tabular">{String(i + 1).padStart(2, '0')}</span>
                <span>{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a class="btn btn-primary btn-lg menu__cta" href={CTA_PRIMARY.href}>{CTA_PRIMARY.label}</a>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur) var(--ease-out),
                border-color var(--dur) var(--ease-out);
  }
  /* Solid once scrolled, so the hero reads full-bleed, or from the start
     on a page that opens on a colour block. */
  .hdr.is-solid,
  :global(body.is-scrolled) .hdr {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--color-line);
  }
  /* Reading order, not source order. The reference puts the mark at the
     far LEFT and the navigation at the reading-start (right) edge, so on
     an RTL page the brand has to be the LAST flex item. `order` does that
     without moving the logo out of first position in the DOM, where it
     belongs for keyboard and screen-reader users. */
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 84px;
  }
  .hdr__nav   { order: 1; }
  .hdr__end   { order: 2; }
  .hdr__brand { order: 3; margin-inline-start: auto; min-width: 0; }
  .hdr__brand { flex: none; display: block; }
  .hdr__brand img { width: clamp(74px, 6vw, 104px); height: auto; }

  .hdr__nav { display: flex; align-items: center; gap: 0.25rem; }
  .hdr__link {
    position: relative;
    padding: 0.6rem 0.9rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  /* underline grows from the inline-start edge, direction-aware */
  .hdr__link > span { position: relative; display: inline-block; }
  .hdr__link > span::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: -3px;
    width: 100%;
    height: 2px;
    background: var(--color-royal);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }
  .hdr__link:hover > span::after,
  .hdr__link.is-on > span::after { transform: scaleX(1); }

  .hdr__end { display: flex; align-items: center; gap: 0.625rem; flex: none; }
  /* WhatsApp lives in the persistent dock now (AvatarDock), the way the
     reference keeps it as a floating control rather than a header item. */
  .hdr__cta { min-height: 46px; padding-inline: 1.25rem; font-size: var(--text-small); }

  .hdr__burger {
    display: none;
    width: 46px; height: 46px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    place-items: center;
  }
  .hdr__burger-bars,
  .hdr__burger-bars::before,
  .hdr__burger-bars::after {
    display: block; width: 18px; height: 2px;
    background: var(--color-ink); border-radius: 2px;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .hdr__burger-bars { position: relative; }
  .hdr__burger-bars::before, .hdr__burger-bars::after { content: ''; position: absolute; inset-inline: 0; }
  .hdr__burger-bars::before { top: -6px; }
  .hdr__burger-bars::after { top: 6px; }
  :global(body.menu-open) .hdr__burger-bars { background: transparent; }
  :global(body.menu-open) .hdr__burger-bars::before { transform: translateY(6px) rotate(45deg); }
  :global(body.menu-open) .hdr__burger-bars::after { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- overlay menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--color-surface);
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out);
  }
  .menu[data-open='true'] { opacity: 1; pointer-events: auto; }
  .menu__inner {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    width: 100%;
    padding-block: 6rem 3rem;
  }
  .menu__nav { display: flex; flex-direction: column; }
  .menu__link {
    display: flex; align-items: baseline; gap: 1rem;
    padding-block: clamp(0.5rem, 1.4vw, 1rem);
    text-decoration: none; color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    opacity: 0; transform: translateY(24px);
    transition: opacity 620ms var(--ease-out) calc(var(--i) * 70ms + 120ms),
                transform 620ms var(--ease-out) calc(var(--i) * 70ms + 120ms),
                color var(--dur) var(--ease-out);
  }
  .menu[data-open='true'] .menu__link { opacity: 1; transform: none; }
  .menu__link:hover { color: var(--color-royal); }
  .menu__num { font-size: var(--text-micro); font-weight: 700; color: var(--color-ink-3); flex: none; }
  .menu__label {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 900; line-height: 1; letter-spacing: -0.02em;
  }

  .menu__side { display: flex; flex-direction: column; gap: 0.75rem; }
  .menu__svc { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .menu__svc a { color: var(--color-ink-2); text-decoration: none; font-size: var(--text-small); }
  .menu__svc a:hover { color: var(--color-royal); }
  .menu__cta { align-self: flex-start; }

  @media (max-width: 1024px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: grid; }
    /* NO auto margin here. `.hdr__brand` already carries
       `margin-inline-start: auto`, and two auto margins in a flex row
       split the free space between them, which parked the burger in the
       middle of the bar instead of at the reading edge. */
    .menu__inner { grid-template-columns: 1fr; align-content: start; gap: 2rem; }
    .menu__side { border-top: 1px solid var(--color-line); padding-top: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__link { transition: opacity 1ms, transform 1ms; }
  }
  /* ══════ services mega menu ══════ */
  .hdr__has-mega { position: relative; display: flex; }
  .hdr__caret {
    display: inline-block;
    width: 0.42em; height: 0.42em;
    margin-inline-start: 0.45em;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.55;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
  }
  [data-mega][data-open='true'] ~ * .hdr__caret,
  .hdr__has-mega:hover .hdr__caret { opacity: 1; }

  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
    box-shadow: 0 30px 60px rgba(11, 21, 48, 0.12);
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: opacity 220ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .mega[hidden] { display: none; }
  .mega[data-open='true'] { opacity: 1; transform: none; pointer-events: auto; }

  .mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 3fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
    align-items: start;
  }
  .mega__h {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-ink);
    margin-block: 0.5rem 1rem;
    max-width: 12ch;
  }

  .mega__list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .mega__card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: 1rem 0.9rem 1.1rem;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out),
                transform var(--dur) var(--ease-out);
  }
  .mega__card:hover {
    background: var(--color-surface-2);
    border-color: var(--color-line);
    transform: translateY(-3px);
  }
  .mega__n { font-family: var(--font-display); font-size: var(--text-micro); font-weight: 700; color: var(--color-electric); }
  .mega__mark {
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-royal) 9%, transparent);
    color: var(--color-royal);
  }
  .mega__mark :global(svg) { width: 1.1rem; height: 1.1rem; }
  .mega__name {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .mega__card:hover .mega__name { color: var(--color-royal); }
  .mega__lead-t { font-size: var(--text-micro); line-height: 1.5; color: var(--color-ink-3); }

  /* ══════ mobile services group ══════ */
  .menu__svc-group { border-top: 1px solid var(--color-line); }
  .menu__svc-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 800;
    color: var(--color-ink);
  }
  .menu__svc-group > summary::-webkit-details-marker { display: none; }
  .menu__svc-ico {
    position: relative; width: 1.1rem; height: 1.1rem; flex: none;
  }
  .menu__svc-ico::before, .menu__svc-ico::after {
    content: ''; position: absolute; inset-inline: 0; top: 50%;
    height: 2px; background: var(--color-royal);
    transition: transform var(--dur) var(--ease-out);
  }
  .menu__svc-ico::after { transform: rotate(90deg); }
  .menu__svc-group[open] .menu__svc-ico::after { transform: rotate(0deg); }
  .menu__svc-group[open] > summary { color: var(--color-royal); }
  .menu__svc-group .menu__svc { padding-bottom: 1rem; }
  .menu__svc-n { font-size: var(--text-micro); font-weight: 700; color: var(--color-electric); margin-inline-end: 0.6rem; }
  .menu__svc li a { display: flex; align-items: baseline; }

  @media (max-width: 1024px) {
    /* the mega menu is a desktop affordance only */
    .mega { display: none !important; }
    .hdr__caret { display: none; }
  }

</style>

<script>
  // Scroll state for the header surface.
  const setScrolled = () => document.body.classList.toggle('is-scrolled', window.scrollY > 12);
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  // Overlay menu. `hidden` is only removed on first open, so the panel is
  // not in the accessibility tree at all until it is actually used.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      if (open) menu.hidden = false;
      menu.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (!open) {
        window.setTimeout(() => {
          if (menu.dataset.open !== 'true') menu.hidden = true;
        }, 420);
      }
    };
    btn.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  }

  // ---------------- SERVICES MEGA MENU ----------------
  // Opens on hover for a pointer, and on click or keyboard for everyone
  // else. It closes on Escape, when focus leaves the whole group, and
  // when the pointer leaves. There is a small close delay so a diagonal
  // mouse path from the trigger to the panel does not dismiss it.
  const megaWrap = document.querySelector<HTMLElement>('[data-mega-wrap]');
  const megaBtn = document.querySelector<HTMLAnchorElement>('[data-mega-btn]');
  const mega = document.querySelector<HTMLElement>('[data-mega]');

  if (megaWrap && megaBtn && mega) {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let closeTimer = 0;

    const setMega = (open: boolean) => {
      window.clearTimeout(closeTimer);
      if (open) mega.hidden = false;
      mega.dataset.open = String(open);
      megaBtn.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('mega-open', open);
      if (!open) {
        closeTimer = window.setTimeout(() => {
          if (mega.dataset.open !== 'true') mega.hidden = true;
        }, 300);
      }
    };
    const openNow = () => { window.clearTimeout(closeTimer); setMega(true); };
    const closeSoon = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setMega(false), 140);
    };

    if (canHover) {
      megaWrap.addEventListener('pointerenter', openNow);
      megaWrap.addEventListener('pointerleave', closeSoon);
      mega.addEventListener('pointerenter', openNow);
      mega.addEventListener('pointerleave', closeSoon);
    }

    // A click opens the panel rather than following the link, but only
    // while it is closed: a second click goes through to /services/.
    megaBtn.addEventListener('click', (e) => {
      if (mega.dataset.open === 'true') return;
      if (window.matchMedia('(max-width: 1024px)').matches) return;
      e.preventDefault();
      setMega(true);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mega.dataset.open === 'true') {
        setMega(false);
        megaBtn.focus();
      }
    });

    // Focus leaving BOTH the trigger and the panel closes it.
    document.addEventListener('focusin', (e) => {
      if (mega.dataset.open !== 'true') return;
      const t = e.target as Node;
      if (!mega.contains(t) && !megaWrap.contains(t)) setMega(false);
    });

    mega.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMega(false)));
  }

</script>
