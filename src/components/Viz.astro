---
// Bespoke page visuals. One per service story, each with its own mechanism
// so no two pages look alike.
//
// TWO RULES THESE MUST PASS
//  1. Direction. Hebrew reads right to left, so every story starts at the
//     RIGHT, passes through the CENTRE and resolves on the LEFT.
//  2. Self-explanation. Hide every paragraph on the page and a non
//     technical business owner should still be able to say what the
//     picture is about. That means real words on the artwork, not shapes
//     and arrows alone.
//
// Everything is abstract and illustrative: no vendor names, no fake
// dashboards, no invented metrics, nothing that reads as a factual claim.
//
// SIZING. These render at roughly 600px (inside an article), 700px
// (inside the home showcase) and 1150px (a service page stage). The
// viewBox is 860 wide so that range lands between 0.7x and 1.35x, which
// keeps every label legible. Authoring at 1100+ and letting it shrink is
// what made the labels unreadable before.
interface Props {
  kind: 'crm' | 'automation' | 'web' | 'app' | 'content' | 'services' | 'about' | 'broken';
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;

// CRM: the same lead, seen at five points in its life. The card under
// each stop shows what the business knows at that moment, and the stack
// of bars grows as information accumulates.
const crmStages = [
  { x: 774, t: 'ליד חדש', s: 'שם וטלפון', bars: 1 },
  { x: 602, t: 'שיחה', s: 'מה הוא צריך', bars: 2 },
  { x: 430, t: 'הצעה', s: 'מה הצענו', bars: 3 },
  { x: 258, t: 'מעקב', s: 'מתי לחזור', bars: 4 },
  { x: 86, t: 'לקוח', s: 'סגור, ממשיכים', bars: 4 },
];

const contentStages = [
  { x: 780, t: 'מטרה עסקית', s: 'למי כותבים ולמה' },
  { x: 605, t: 'בריף', s: 'נושא וזווית' },
  { x: 430, t: 'טיוטה', s: 'בסיוע AI' },
  { x: 255, t: 'בקרה ועריכה', s: 'אתם קוראים' },
  { x: 80, t: 'שימוש', s: 'רק אחרי אישור' },
];

const webSteps = [
  { x: 760, t: 'נכנס', s: 'מגיע לאתר' },
  { x: 545, t: 'מבין', s: 'איפה הוא ומה יש כאן' },
  { x: 330, t: 'מוצא', s: 'המידע שחסר לו' },
  { x: 115, t: 'פועל', s: 'משאיר פרטים' },
];

const ecosystem = [
  { x: 770, t: 'CRM', s: 'הלקוחות' },
  { x: 600, t: 'אוטומציות', s: 'העבודה החוזרת' },
  { x: 430, t: 'אתרים', s: 'הפנים החוצה' },
  { x: 260, t: 'אפליקציות', s: 'התהליך שלכם' },
  { x: 90, t: 'תוכן', s: 'מה שאתם אומרים' },
];
// ---------------------------------------------------------------------
// MOBILE
//
// Below 760px the SVGs are hidden and this data is rendered as a stacked
// list of real HTML text instead. Same story, same words, but at a size a
// person can actually read on a phone. Keep the two in sync: if a step
// changes in the artwork above, change it here too.
// ---------------------------------------------------------------------
type MStep = { t: string; s?: string };
type MFlow = {
  kicker?: string;
  steps: MStep[];
  branch?: { label: string; items: MStep[] };
  outcome?: MStep;
};

const MOBILE: Record<string, MFlow> = {
  crm: {
    kicker: 'מסלול של פנייה אחת',
    steps: crmStages.map((c) => ({ t: c.t, s: c.s })),
    outcome: { t: 'כרטיס לקוח אחד', s: 'תמיד ברור מה קרה ומה הצעד הבא' },
  },
  automation: {
    kicker: 'איך אוטומציה מחליטה',
    steps: [
      { t: 'קורה משהו', s: 'נכנסת פנייה, מתקבל תשלום, מגיע תאריך' },
      { t: 'המערכת בודקת את הכללים', s: 'אלה שהגדרתם מראש' },
    ],
    branch: {
      label: 'ומכאן אחת משתיים',
      items: [
        { t: 'רצה לבד', s: 'כשברור מה לעשות: שולחת, מעדכנת, מזכירה' },
        { t: 'עוברת אליכם', s: 'כשצריך שיקול דעת, אתם מחליטים' },
      ],
    },
    outcome: { t: 'אתם נשארים בשליטה', s: 'המערכת לא מחליטה במקומכם' },
  },
  web: {
    kicker: 'המסלול של מבקר',
    steps: webSteps.map((w) => ({ t: w.t, s: w.s })),
    outcome: { t: 'הפנייה נכנסת לתהליך בעסק', s: 'ומשם ממשיכים לטפל בה' },
  },
  app: {
    kicker: 'איור המחשה, לא צילום מסך של מוצר',
    steps: [
      { t: 'צורך בעסק', s: 'משהו שאין לו כלי מתאים' },
      { t: 'מי משתמש', s: 'ומה הוא צריך לעשות' },
      { t: 'מסכים ופעולות', s: 'רק מה שבאמת צריך' },
    ],
    outcome: { t: 'תהליך שעובד', s: 'והמידע נשמר במקום אחד' },
  },
  content: {
    kicker: 'סדר העבודה על תוכן',
    steps: contentStages.map((c) => ({ t: c.t, s: c.s })),
    outcome: { t: 'שום דבר לא יוצא בלי אישור שלכם', s: '' },
  },
  services: {
    kicker: 'חמישה חלקים, מערכת אחת',
    steps: ecosystem.map((e) => ({ t: e.t, s: e.s })),
    outcome: { t: 'העסק שלכם', s: 'החלקים מדברים ביניהם' },
  },
  about: {
    kicker: 'קודם התהליך, אחר כך הטכנולוגיה',
    steps: [
      { t: 'התהליך', s: 'איך העסק עובד היום' },
      { t: 'הצוואר', s: 'איפה זה נתקע' },
      { t: 'הפתרון', s: 'רק אז בוחרים כלים' },
    ],
  },
};

const m = MOBILE[kind];
---

<div class:list={['viz', `viz--${kind}`, cls]} data-reveal>
  {
    kind === 'crm' && (
      <svg
        viewBox="0 0 860 390"
        role="img"
        aria-label="איור: חיי פנייה בחמישה שלבים, ליד חדש, שיחה, הצעה, מעקב ולקוח. בכל שלב נוסף מידע, והכל נאסף לכרטיס לקוח אחד"
      >
        <defs>
          <linearGradient id="vzCrm" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="#2997FF" />
            <stop offset="100%" stop-color="#1D4ED8" />
          </linearGradient>
        </defs>

        <text x="838" y="24" text-anchor="start" class="vz-kicker">
          מסלול של פנייה אחת
        </text>

        {/* the rail runs right to left */}
        <path
          class="vz-rail"
          d="M774 58 L86 58"
          stroke="rgba(41,151,255,.3)"
          stroke-width="2"
          fill="none"
        />

        {crmStages.map((s, i) => (
          <g class="vz-stop" style={`--d:${i * 170}ms`}>
            <circle
              cx={s.x}
              cy="58"
              r="11"
              fill={i === 4 ? 'url(#vzCrm)' : 'rgba(255,255,255,.09)'}
              stroke="rgba(41,151,255,.6)"
              stroke-width="2"
            />
            {/* what the business knows at this point */}
            <rect
              x={s.x - 78}
              y="92"
              width="156"
              height="122"
              rx="16"
              fill={i === 4 ? 'rgba(41,151,255,.14)' : 'rgba(255,255,255,.05)'}
              stroke={i === 4 ? 'rgba(41,151,255,.55)' : 'rgba(255,255,255,.18)'}
            />
            <text x={s.x} y="120" text-anchor="middle" class="vz-title-sm">
              {s.t}
            </text>
            <text x={s.x} y="143" text-anchor="middle" class="vz-sub">
              {s.s}
            </text>
            {[0, 1, 2, 3].map((b) => (
              <rect
                x={s.x - 52}
                y={161 + b * 13}
                width={b < s.bars ? 104 : 104}
                height="7"
                rx="3.5"
                fill={b < s.bars ? 'rgba(41,151,255,.5)' : 'rgba(255,255,255,.08)'}
              />
            ))}
          </g>
        ))}

        {/* everything lands on one record */}
        <g
          class="vz-feed"
          stroke="rgba(41,151,255,.28)"
          stroke-width="1.5"
          fill="none"
          stroke-dasharray="4 6"
        >
          {crmStages.map((s) => (
            <path d={`M${s.x} 214 C ${s.x} 256 ${430 + (s.x - 430) * 0.25} 258 430 288`} />
          ))}
        </g>

        <g class="vz-record">
          <rect
            x="215"
            y="288"
            width="430"
            height="78"
            rx="20"
            fill="rgba(255,255,255,.06)"
            stroke="rgba(255,255,255,.24)"
          />
          <text x="430" y="322" text-anchor="middle" class="vz-title">
            כרטיס לקוח אחד
          </text>
          <text x="430" y="349" text-anchor="middle" class="vz-next">
            תמיד ברור מה קרה ומה הצעד הבא
          </text>
        </g>
      </svg>
    )
  }

  {
    kind === 'automation' && (
      <svg
        viewBox="0 0 860 430"
        role="img"
        aria-label="איור: משהו קורה בעסק, המערכת בודקת את הכללים שהוגדרו, ואז או שהפעולה רצה לבד או שהיא עוברת אליכם להחלטה"
      >
        <defs>
          <linearGradient id="vzAu" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="#2997FF" />
            <stop offset="100%" stop-color="#1D4ED8" />
          </linearGradient>
        </defs>

        <text x="838" y="24" text-anchor="start" class="vz-kicker">
          איך אוטומציה מחליטה
        </text>

        {/* 1. the trigger, on the right */}
        <g class="vz-stop" style="--d:0ms">
          <rect
            x="672"
            y="168"
            width="172"
            height="86"
            rx="20"
            fill="rgba(255,255,255,.06)"
            stroke="rgba(255,255,255,.22)"
          />
          <text x="758" y="203" text-anchor="middle" class="vz-title-sm">
            קורה משהו
          </text>
          <text x="758" y="228" text-anchor="middle" class="vz-sub">
            פנייה, תשלום, תאריך
          </text>
        </g>

        <path
          class="vz-line"
          style="--d:220ms"
          d="M672 211 L556 211"
          stroke="rgba(41,151,255,.5)"
          stroke-width="2"
          fill="none"
        />

        {/* 2. the rule check. A soft round shape, deliberately not the
             node-and-port look of a workflow builder. */}
        <g class="vz-stop" style="--d:400ms">
          <rect
            x="384"
            y="160"
            width="172"
            height="102"
            rx="46"
            fill="rgba(41,151,255,.13)"
            stroke="rgba(41,151,255,.55)"
            stroke-width="2"
          />
          <text x="470" y="199" text-anchor="middle" class="vz-title-sm">
            בודקת את הכללים
          </text>
          <text x="470" y="224" text-anchor="middle" class="vz-sub">
            שהגדרתם מראש
          </text>
        </g>

        {/* 3. two ways out */}
        <path
          class="vz-line"
          style="--d:640ms"
          d="M384 188 C 320 188 300 112 236 112"
          stroke="rgba(41,151,255,.5)"
          stroke-width="2"
          fill="none"
        />
        <path
          class="vz-line"
          style="--d:820ms"
          d="M384 234 C 320 234 300 314 236 314"
          stroke="rgba(255,255,255,.34)"
          stroke-width="2"
          fill="none"
          stroke-dasharray="6 8"
        />
        <text x="330" y="140" text-anchor="middle" class="vz-tag">
          ברור מה לעשות
        </text>
        <text x="330" y="300" text-anchor="middle" class="vz-tag">
          צריך שיקול דעת
        </text>

        {/* the automatic branch */}
        <g class="vz-stop" style="--d:900ms">
          <rect x="36" y="72" width="200" height="80" rx="20" fill="url(#vzAu)" />
          <text x="136" y="106" text-anchor="middle" class="vz-title-sm" fill="#fff">
            רצה לבד
          </text>
          <text x="136" y="131" text-anchor="middle" class="vz-sub" fill="rgba(255,255,255,.88)">
            שולחת, מעדכנת, מזכירה
          </text>
        </g>

        {/* the human branch, given equal visual weight on purpose */}
        <g class="vz-stop" style="--d:1080ms">
          <rect
            x="36"
            y="274"
            width="200"
            height="80"
            rx="20"
            fill="rgba(255,255,255,.07)"
            stroke="#2997FF"
            stroke-width="2"
          />
          <circle cx="70" cy="306" r="7" fill="none" stroke="#2997FF" stroke-width="2" />
          <path
            d="M58 328 C 58 316 82 316 82 328"
            fill="none"
            stroke="#2997FF"
            stroke-width="2"
            stroke-linecap="round"
          />
          <text x="222" y="303" text-anchor="start" class="vz-title-sm">
            עוברת אליכם
          </text>
          <text x="222" y="328" text-anchor="start" class="vz-sub">
            אתם מחליטים
          </text>
        </g>

        <text x="136" y="392" text-anchor="middle" class="vz-note vz-stop" style="--d:1260ms">
          אתם נשארים בשליטה
        </text>
      </svg>
    )
  }

  {
    kind === 'web' && (
      <svg
        viewBox="0 0 860 430"
        role="img"
        aria-label="איור: מסלול מבקר באתר, נכנס, מבין איפה הוא, מוצא את המידע שחסר לו, ומשאיר פרטים. משם הפנייה נכנסת לתהליך בעסק"
      >
        <defs>
          <linearGradient id="vzWeb" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2997FF" />
            <stop offset="100%" stop-color="#1D4ED8" />
          </linearGradient>
        </defs>

        <text x="838" y="24" text-anchor="start" class="vz-kicker">
          המסלול של מבקר
        </text>

        {webSteps.map((s, i) => (
          <g class="vz-stop" style={`--d:${i * 200}ms`}>
            {/* an illustrative page, not a screenshot of anything */}
            <rect
              x={s.x - 90}
              y="52"
              width="180"
              height="196"
              rx="14"
              fill="rgba(255,255,255,.05)"
              stroke="rgba(255,255,255,.2)"
            />
            {/* browser chrome */}
            <path
              d={`M${s.x - 90} 76 L${s.x + 90} 76`}
              stroke="rgba(255,255,255,.18)"
              stroke-width="1"
            />
            <circle cx={s.x + 78} cy="64" r="3" fill="rgba(255,255,255,.3)" />
            <circle cx={s.x + 66} cy="64" r="3" fill="rgba(255,255,255,.22)" />

            {i === 0 && (
              <>
                <rect
                  x={s.x - 70}
                  y="96"
                  width="140"
                  height="52"
                  rx="8"
                  fill="rgba(41,151,255,.22)"
                />
                <rect x={s.x - 70} y="160" width="96" height="8" rx="4" fill="rgba(255,255,255,.22)" />
              </>
            )}
            {i === 1 && (
              <>
                <rect x={s.x - 70} y="96" width="120" height="12" rx="6" fill="rgba(255,255,255,.4)" />
                <rect x={s.x - 70} y="122" width="140" height="8" rx="4" fill="rgba(255,255,255,.2)" />
                <rect x={s.x - 70} y="140" width="128" height="8" rx="4" fill="rgba(255,255,255,.2)" />
                <rect x={s.x - 70} y="158" width="104" height="8" rx="4" fill="rgba(255,255,255,.2)" />
              </>
            )}
            {i === 2 && (
              <>
                {[0, 1, 2].map((r) => (
                  <>
                    <rect
                      x={s.x - 70}
                      y={98 + r * 34}
                      width="140"
                      height="26"
                      rx="7"
                      fill="rgba(255,255,255,.07)"
                    />
                    <rect
                      x={s.x - 60}
                      y={107 + r * 34}
                      width={r === 1 ? 92 : 68}
                      height="8"
                      rx="4"
                      fill="rgba(255,255,255,.26)"
                    />
                  </>
                ))}
              </>
            )}
            {i === 3 && (
              <>
                <rect x={s.x - 70} y="96" width="104" height="10" rx="5" fill="rgba(255,255,255,.34)" />
                <rect
                  x={s.x - 70}
                  y="118"
                  width="140"
                  height="22"
                  rx="7"
                  fill="rgba(255,255,255,.09)"
                  stroke="rgba(255,255,255,.2)"
                />
                <rect
                  x={s.x - 70}
                  y="148"
                  width="140"
                  height="22"
                  rx="7"
                  fill="rgba(255,255,255,.09)"
                  stroke="rgba(255,255,255,.2)"
                />
                <rect x={s.x - 70} y="182" width="110" height="30" rx="9" fill="url(#vzWeb)" />
              </>
            )}

            <text x={s.x} y="278" text-anchor="middle" class="vz-title-sm">
              {s.t}
            </text>
            <text x={s.x} y="301" text-anchor="middle" class="vz-sub">
              {s.s}
            </text>
          </g>
        ))}

        {/* the journey moves leftward */}
        {[0, 1, 2].map((i) => (
          <path
            class="vz-line"
            style={`--d:${180 + i * 200}ms`}
            d={`M${webSteps[i].x - 90} 150 L${webSteps[i + 1].x + 90} 150`}
            stroke="rgba(41,151,255,.5)"
            stroke-width="2"
            fill="none"
          />
        ))}

        {/* and the result feeds the business */}
        <path
          class="vz-line"
          style="--d:900ms"
          d="M115 316 C 115 372 300 386 430 386"
          stroke="rgba(41,151,255,.45)"
          stroke-width="2"
          fill="none"
          stroke-dasharray="6 8"
        />
        <g class="vz-stop" style="--d:1000ms">
          <rect
            x="430"
            y="360"
            width="290"
            height="52"
            rx="16"
            fill="rgba(41,151,255,.13)"
            stroke="rgba(41,151,255,.5)"
          />
          <text x="575" y="392" text-anchor="middle" class="vz-title-sm">
            הפנייה נכנסת לתהליך בעסק
          </text>
        </g>
      </svg>
    )
  }

  {
    kind === 'app' && (
      <svg
        viewBox="0 0 860 430"
        role="img"
        aria-label="איור: צורך בעסק, מי משתמש, המסכים והפעולות, המידע שנשמר, ובסוף תהליך שעובד"
      >
        <defs>
          <linearGradient id="vzApp" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2997FF" />
            <stop offset="100%" stop-color="#1D4ED8" />
          </linearGradient>
        </defs>

        <text x="838" y="24" text-anchor="start" class="vz-kicker">
          איור המחשה, לא צילום מסך של מוצר
        </text>

        {/* 1. the business need */}
        <g class="vz-stop" style="--d:0ms">
          <rect
            x="686"
            y="156"
            width="158"
            height="94"
            rx="20"
            fill="rgba(255,255,255,.06)"
            stroke="rgba(255,255,255,.22)"
          />
          <text x="765" y="192" text-anchor="middle" class="vz-title-sm">
            צורך בעסק
          </text>
          <text x="765" y="216" text-anchor="middle" class="vz-sub">
            אין כלי מתאים
          </text>
        </g>
        <path
          class="vz-line"
          style="--d:160ms"
          d="M686 203 L622 203"
          stroke="rgba(41,151,255,.5)"
          stroke-width="2"
          fill="none"
        />

        {/* 2. who uses it */}
        <g class="vz-stop" style="--d:300ms">
          <circle
            cx="570"
            cy="203"
            r="46"
            fill="rgba(41,151,255,.12)"
            stroke="rgba(41,151,255,.5)"
            stroke-width="2"
          />
          <circle cx="570" cy="190" r="10" fill="none" stroke="#2997FF" stroke-width="2" />
          <path
            d="M552 220 C 552 202 588 202 588 220"
            fill="none"
            stroke="#2997FF"
            stroke-width="2"
            stroke-linecap="round"
          />
          <text x="570" y="282" text-anchor="middle" class="vz-title-sm">
            מי משתמש
          </text>
          <text x="570" y="305" text-anchor="middle" class="vz-sub">
            ומה הוא צריך לעשות
          </text>
        </g>
        <path
          class="vz-line"
          style="--d:440ms"
          d="M524 203 L466 203"
          stroke="rgba(41,151,255,.5)"
          stroke-width="2"
          fill="none"
        />

        {/* 3. the screens, drawn as obvious wireframes */}
        {[
          { x: 300, y: 84 },
          { x: 300, y: 222 },
        ].map((s, i) => (
