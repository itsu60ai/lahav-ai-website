<style>
  .viz {
    width: 100%;
  }
  .viz svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Type scale is tuned so that at the smallest place these appear
     (roughly 0.7x) the smallest label still lands above 11px. */
  .vz-sub {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    fill: rgba(255, 255, 255, 0.62);
  }
  .vz-title {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 800;
    fill: #fff;
