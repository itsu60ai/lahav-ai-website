  .vz-title-sm {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    fill: #fff;
  }
  .vz-next,
  .vz-note {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    fill: var(--color-electric);
  }
  /* the small line that names the whole picture */
  .vz-kicker {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    fill: rgba(255, 255, 255, 0.42);
  }
  /* labels that sit on a branch rather than in a box */
  .vz-tag {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    fill: rgba(255, 255, 255, 0.55);
  }


  /* ---------------- Mobile flow ----------------
     Hidden on desktop. Below 760px it replaces the SVG entirely, because
     the artwork scales to a point where its labels are 5-8px. The words
     are identical, so nothing is lost, and here they are real text. */
  .vzm {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vzm__kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 0.875rem;
  }
  .vzm__step,
  .vzm__out {
    position: relative;
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .vzm__step + .vzm__step,
  .vzm__branchlabel,
  .vzm__out {
    margin-top: 1.5rem;
  }
  /* the connector between steps */
  .vzm__step + .vzm__step::before,
  .vzm__out::before {
    content: '';
    position: absolute;
    top: -1.125rem;
    inset-inline-start: 50%;
    width: 1px;
    height: 0.75rem;
    background: rgba(41, 151, 255, 0.5);
  }
  .vzm__n {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-electric);
    padding-top: 0.2rem;
  }
  .vzm__body {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }
  .vzm__t {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }
  .vzm__s {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
  }
  .vzm__branchlabel {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
  }
  .vzm__step--branch {
    margin-top: 0.625rem;
  }
  .vzm__step--branch::before {
    display: none;
  }
  .vzm__step--branch.is-auto {
    background: linear-gradient(120deg, rgba(41, 151, 255, 0.9), rgba(29, 78, 216, 0.9));
    border-color: transparent;
  }
  .vzm__step--branch.is-auto .vzm__s {
    color: rgba(255, 255, 255, 0.9);
  }
  .vzm__step--branch:not(.is-auto) {
    border-color: var(--color-electric);
  }
  .vzm__out {
    background: rgba(41, 151, 255, 0.14);
    border-color: rgba(41, 151, 255, 0.5);
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
    align-items: center;
  }

  @media (max-width: 760px) {
    .viz svg {
      display: none;
    }
    .vzm {
      display: block;
    }
  }

  /* Motion: staged reveal along the story, then rest. */
  :global(html.reveal-ready) .vz-stop,
  :global(html.reveal-ready) .vz-record {
    opacity: 0;
  }
  :global(html.reveal-ready) .vz-line,
  :global(html.reveal-ready) .vz-rail,
  :global(html.reveal-ready) .vz-feed {
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
  }

  :global(html.reveal-ready) .viz.is-in .vz-stop,
  :global(html.reveal-ready) .viz.is-in .vz-record {
    animation: vz-in 700ms var(--ease-out) calc(200ms + var(--d, 0ms)) forwards;
  }
  :global(html.reveal-ready) .viz.is-in .vz-rail,
  :global(html.reveal-ready) .viz.is-in .vz-feed {
    animation: vz-draw 1800ms var(--ease-out) 150ms forwards;
  }
  :global(html.reveal-ready) .viz.is-in .vz-line {
    animation: vz-draw 900ms var(--ease-out) calc(200ms + var(--d, 0ms)) forwards;
  }

  @keyframes vz-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes vz-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-stop,
    .vz-record {
      opacity: 1 !important;
      animation: none !important;
      translate: none !important;
    }
    .vz-line,
    .vz-rail,
    .vz-feed {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
  }
</style>
