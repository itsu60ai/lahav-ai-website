---
// ONE ARTICLE, RENDERED. V3 editorial rebuild.
//
// Used by the public article page AND by the admin preview, so what an
// author previews is literally what a visitor gets. The data contract
// (Article, blocks, aiviz safety revalidation) is untouched; only the
// presentation changed.
//
// Composition, in the same language as the rest of the site:
//   opener      full-bleed type on the hero gradient, no card
//   meta rail   hairline row of kind / topic / reading time
//   body        one narrow reading measure, generous leading
//   figures     break the measure, the one moment the page opens up
//   related     oversized hairline rows, never cards
import Viz from './Viz.astro';
import { ARTICLE_KINDS } from '../lib/cms/types.ts';
import type { Article } from '../lib/cms/types.ts';
import { CTA_PRIMARY } from '../lib/site';
import { isSvgSafe } from '../lib/ai/validate.ts';
import { linkifyText } from '../lib/cms/linkify.ts';

interface Props {
  a: Article;
  more?: Article[];
}
const { a, more = [] } = Astro.props;
---

<article class="art">
  <!-- COVER.
       Structure taken from the reference's own article page: a full-bleed
       cover with a curved light panel overlapping its lower corner, and
       the title, author and date sitting inside that panel. -->
  <header class="art__cover">
    {/* No automatic diagram above every article. The cover used to render
        one whether the piece needed it or not, so every post opened on a
        generic picture the reader had no reason to look at. A diagram now
        appears only inside the body, and only where the writing asked for
        one. */}
    <div class="art__plate">
      <p class="art__kicker">
        <span class="art__kind">{ARTICLE_KINDS[a.kind].label}</span>
        <span class="art__topic">{a.topic}</span>
        <span class="art__time">{a.readingTime}</span>
      </p>
      <h1 class="art__title">
        <span class="mo-line" style="--mo-delay:60ms"><span>{a.title}</span></span>
      </h1>
      <p class="art__standfirst" data-reveal style="--mo-delay:220ms">{a.standfirst}</p>
    </div>
  </header>

  <div class="art__body u-container">
    {
      a.body.map((b) => {
        if (b.t === 'h2') return <h2>{b.x}</h2>;
        if (b.t === 'h3') return <h3>{b.x}</h3>;
        if (b.t === 'quote') return <blockquote set:html={linkifyText(b.x)} />;
        if (b.t === 'ul')
          return (
            <ul>
              {b.items.map((li) => (
                <li set:html={linkifyText(li)} />
              ))}
            </ul>
          );
        if (b.t === 'img')
          return (
            <figure class="art__fig art__fig--photo" data-clip>
              <img class="art__photo" src={b.src} alt={b.alt} loading="lazy" decoding="async" />
              {b.caption && <figcaption>{b.caption}</figcaption>}
            </figure>
          );
        if (b.t === 'aiviz') {
          // Re-validated at render time, not just at creation — belt and
          // suspenders for anything that reaches the public page.
          if (isSvgSafe(b.svg)) {
            return (
              <figure class="art__fig" data-clip>
                <div class="art__fig-stage on-dark art__fig-stage--ai" set:html={b.svg} />
                {b.caption && <figcaption>{b.caption}</figcaption>}
                <span class="sr-only">{b.alt}</span>
              </figure>
            );
          }
          // Unsafe content should never reach here (validated well before
          // this point), but if it somehow did, fall back to the site's
          // own diagram rather than rendering nothing or something unsafe.
          return (
            <figure class="art__fig" data-clip>
              <div class="art__fig-stage on-dark">
                <Viz kind={a.viz as any} />
              </div>
              <figcaption>{a.vizCaption}</figcaption>
            </figure>
          );
        }
        if (b.t === 'viz')
          return (
            <figure class="art__fig" data-clip>
              <div class="art__fig-stage on-dark">
                <Viz kind={a.viz as any} />
              </div>
              <figcaption>{a.vizCaption}</figcaption>
            </figure>
          );
        return <p set:html={linkifyText(b.x)} />;
      })
    }
  </div>

  <!-- The service connection, kept quiet. It reads as a related link,
       not as a sales block interrupting the article. -->
  <aside class="art__rel u-container" data-reveal>
    <p class="art__rel-k">קשור לנושא</p>
    <a class="art__rel-a" href={`/services/${a.serviceSlug}/`}>
      {a.serviceName}
      <span class="arrow-inline" aria-hidden="true">←</span>
    </a>
  </aside>

  <footer class="art__foot u-container">
    <p class="art__foot-line">
      אם המאמר הזכיר לכם משהו שקורה גם אצלכם בעסק, אפשר לדבר על זה.
    </p>
    <a class="link-arrow art__foot-cta" href={CTA_PRIMARY.href}>
      {CTA_PRIMARY.label} <span class="arrow-inline" aria-hidden="true">←</span>
    </a>
  </footer>
</article>

{
  more.length > 0 && (
    <section class="more band band--soft u-section-tight">
      <div class="u-container u-container--wide">
        <p class="t-eyebrow more__k" data-reveal>
          עוד באותו נושא
        </p>
        <ul class="more__list">
          {more.map((m, i) => (
            <li class="more__row" data-reveal style={`--mo-delay:${i * 90}ms`}>
              <a class="more__item" href={`/articles/${m.slug}/`}>
                <span class="more__n tabular">{String(i + 1).padStart(2, '0')}</span>
                <span class="more__main">
                  <span class="more__topic">{m.topic}</span>
                  <span class="more__t">{m.title}</span>
                  <span class="more__x">{m.excerpt}</span>
                </span>
                <span class="more__arrow arrow-inline" aria-hidden="true">
                  ←
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link-arrow more__all" href="/articles/">
          כל המאמרים <span class="arrow-inline" aria-hidden="true">←</span>
        </a>
      </div>
    </section>
  )
}

<!-- reading progress: a single hairline, no numbers, no widget -->
<div class="art-prog" aria-hidden="true"><span class="art-prog__bar"></span></div>

<script is:inline>
  (() => {
    const bar = document.querySelector('.art-prog__bar');
    const art = document.querySelector('.art');
    if (!bar || !art) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = art.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const done = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      bar.style.transform = `scaleX(${done})`;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  })();
</script>

<style>
  /* ══════ reading progress ══════ */
  .art-prog {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .art-prog__bar {
    display: block;
    height: 100%;
    /* RTL: the bar should fill from the right, where reading starts */
    transform-origin: right center;
    transform: scaleX(0);
    background: linear-gradient(90deg, #2997ff, #1d4ed8);
  }

  /* ══════ cover ══════ */
  .art__cover {
    position: relative;
    /* clears the fixed header, plus the band of colour the title plate
       used to overlap when a cover diagram sat here */
    padding-top: calc(84px + clamp(2.5rem, 7vw, 6rem));
    /* Brand blue, not near-black. Every article opened on a full-width
       #0b1530 band, which is what "getting the black page" was. */
    background: linear-gradient(158deg, #17347f 0%, #1d4ed8 55%, #2564e0 100%);
  }
  .art__cover-art {
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 5vw, 5rem) clamp(6rem, 14vw, 11rem);
    max-width: var(--container-wide);
    margin-inline: auto;
  }
  /* the light plate that the title sits on, curving up out of the cover */
  .art__plate {
    position: relative;
    z-index: 2;
    /* was a negative margin that pulled the plate up over the cover
       artwork. With no artwork there is nothing to overlap, and the
       negative value dragged the title under the site header. */
    margin-top: 0;
    margin-inline: auto;
    width: min(100% - 2 * clamp(1rem, 4vw, 3rem), var(--container-max));
    background: var(--color-surface);
    border-start-start-radius: var(--radius-xl);
    border-start-end-radius: clamp(3rem, 9vw, 8rem);
    padding: clamp(1.75rem, 4vw, 3.25rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: 0 -20px 60px rgba(11, 21, 48, 0.18);
  }
  .art__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--text-micro);
    font-weight: 700;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  .art__kind {
    color: #fff;
    background: var(--color-royal);
    border-radius: 999px;
    padding: 0.28rem 0.75rem;
    letter-spacing: 0.05em;
  }
  .art__topic {
    color: var(--color-electric);
    letter-spacing: 0.06em;
  }
  .art__time { color: var(--color-ink-3); font-weight: 600; }

  /* Editorial scale: the headline is the page. No cap at a "safe" size. */
  .art__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: normal;
    max-width: 18ch;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .art__standfirst {
    font-size: clamp(1.125rem, 1.6vw, 1.75rem);
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 44ch;
  }

  /* ══════ reading column ══════ */
  /* one measure for body, related and footer, so the article reads as a
     single column even though the figures break out of it */
  .art__body,
  .art__rel,
  .art__foot {
    max-width: 44rem;
  }

  .art__body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .art__body p {
    font-size: clamp(1.125rem, 1.25vw, 1.3125rem);
    line-height: 1.85;
    color: var(--color-ink);
    max-width: none;
  }
  /* links pasted from a generated draft (see src/lib/cms/linkify.ts) */
  .art__body :global(a) {
    color: var(--color-royal);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .art__body :global(a:hover) { color: var(--color-electric); }
  .art__body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: normal;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }
  .art__body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.25rem;
    color: var(--color-ink);
  }
  .art__body ul {
    margin: 0;
    padding-inline-start: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .art__body li {
    font-size: clamp(1.0625rem, 1.15vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-ink);
    padding-block: 0.85rem;
    padding-inline-start: 2.25rem;
    border-top: 1px solid var(--color-line);
    position: relative;
  }
  .art__body li:last-child { border-bottom: 1px solid var(--color-line); }
  /* a hairline tick instead of a bullet: same rhythm as the list rows
     used on the index and the service pages */
  .art__body li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 1.55em;
    width: 1.25rem;
    height: 2px;
    background: var(--color-electric);
  }
  .art__body blockquote {
    margin-block: clamp(1rem, 2.5vw, 2rem);
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--color-ink);
  }
  /* the pull quote is set off by space and scale, not by a rule or a box */
  .art__body blockquote::before {
    content: '';
    display: block;
    width: 3.5rem;
    height: 2px;
    background: var(--color-electric);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  /* ══════ figures ══════ */
  /* Deliberately wider than the measure: the one moment the page opens up. */
  /* The figure breaks out of the reading measure, but only when there is
     genuinely room. `100vw` includes the scrollbar gutter, which pushed
     the figure 13px past the viewport at tablet width. */
  .art__fig { margin-block: clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 62rem) {
    .art__fig {
      width: min(100% + 12rem, 62rem);
      margin-inline: calc((44rem - min(100% + 12rem, 62rem)) / 2);
    }
  }
  .art__fig-stage {
    background: linear-gradient(158deg, #17347f 0%, #1d4ed8 55%, #2564e0 100%);
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 3vw, 2.75rem);
  }
  /* the AI-generated diagram is a full SVG document, not markup we
     control — size it to the frame instead of its own hard-coded viewBox */
  .art__fig-stage--ai :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* A photograph fills its frame instead of sitting on the blue diagram
     stage, which is built for line art on a dark ground. */
  .art__fig--photo { border-radius: var(--radius-xl); overflow: hidden; }
  .art__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }
  .art__fig--photo figcaption { padding-inline: 0.5rem; }

  .art__fig figcaption {
    margin-top: 1rem;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-3);
    text-align: center;
  }

  /* ══════ related service ══════ */
  /* a hairline row, not a tinted box */
  .art__rel {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
  }
  .art__rel-k {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
    margin-bottom: 0.5rem;
  }
  .art__rel-a {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 2rem);
    font-weight: 800;
    letter-spacing: normal;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }
  .art__rel-a:hover { color: var(--color-royal); }
  .art__rel-a:hover .arrow-inline { transform: translateX(-5px); }

  /* ══════ article footer ══════ */
  .art__foot {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .art__foot-line {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-2);
    margin-bottom: 1rem;
    max-width: none;
  }
  .art__foot-cta { font-size: var(--text-lead); font-weight: 700; }

  /* ══════ more articles, as rows ══════ */
  .more__k { margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .more__list { list-style: none; margin: 0 0 2rem; padding: 0; }
  .more__row { border-top: 1px solid var(--color-line-strong); }
  .more__row:last-child { border-bottom: 1px solid var(--color-line-strong); }
  .more__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem);
    text-decoration: none;
    color: inherit;
  }
  .more__n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--color-electric);
  }
  .more__main { display: flex; flex-direction: column; gap: 0.45rem; min-width: 0; }
  .more__topic {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-electric);
  }
  .more__t {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.3vw, 2.125rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: normal;
    color: var(--color-ink);
    transition: color var(--dur) var(--ease-out);
  }
  .more__row:hover .more__t { color: var(--color-royal); }
  .more__x {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-3);
    max-width: 60ch;
  }
  .more__arrow { color: var(--color-royal); justify-self: end; }
  .more__row:hover .more__arrow { transform: translateX(-5px); }

  @media (max-width: 760px) {
    .art__fig { width: 100%; margin-inline: 0; }
    .more__item { grid-template-columns: 2.25rem 1fr 1.25rem; gap: 0.875rem; }
  }
</style>
