---
// PERSISTENT PAGE FURNITURE.
//
// Back-to-top, and nothing else.
//
// TWO THINGS WERE DELIBERATELY REMOVED FROM THIS CORNER:
//
// 1. A floating WhatsApp button. The reference has one on every page, but
//    SOURCE_OF_TRUTH.md D-Q2 says "no floating WhatsApp" and that is an
//    approved product decision. The reference is the visual and motion
//    authority, not the product-requirements authority.
//
// 2. The character, as a circular portrait that opened its own scripted
//    introduction. A face in the corner of a website promises a chat, and
//    replaying a hero monologue instead is a broken promise.
//
// WhatsApp still appears where it belongs: inside the contact block, on
// the contact page, and in the footer.
---

<div class="dock" data-dock hidden>
  <div class="dock__side">
    <button class="dock__top" type="button" data-dock-top aria-label="חזרה לראש העמוד">
      <span aria-hidden="true">↑</span>
    </button>
  </div>

</div>

<script>
  (() => {
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    if (!dock) return;
    const topBtn = dock.querySelector<HTMLButtonElement>('[data-dock-top]');
    dock.hidden = false;

    let raf = 0;
    const update = () => {
      raf = 0;
      dock.classList.toggle('is-top', window.scrollY > 900);
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();

    topBtn?.addEventListener('click', () => {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  })();
</script>

<style>
  .dock {
    position: fixed;
    inset-block-end: clamp(1rem, 2.5vw, 1.75rem);
    inset-inline-end: clamp(1rem, 2.5vw, 1.75rem);
    z-index: 50;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }
  .dock > * { pointer-events: auto; }

  .dock__side { display: flex; flex-direction: column; align-items: center; }
  .dock__top {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
    color: var(--color-ink-2);
    font-size: 1.125rem;
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .dock.is-top .dock__top { opacity: 1; transform: none; pointer-events: auto; }
  .dock__top:hover { color: var(--color-royal); border-color: var(--color-royal); }

  @media (max-width: 720px) {
    @media (prefers-reduced-motion: reduce) {
    .dock__top { transition: none; }
  }
</style>
