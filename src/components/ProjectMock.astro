---
// PROJECT MOCK: a product screen drawn as real DOM, one per service kind,
// so a portfolio page always has "images of the project" even before the
// client uploads screenshots. Each mock is the KIND of thing LAHAV builds
// for that service, dressed with the project's own name and industry.
//
// TRUTH RULE: these are illustrations of a mechanism, not screenshots of
// a shipped product, and they carry no metrics, money or results. The
// caption under each one says so on the page.
interface Props {
  kind: 'web-development' | 'crm' | 'automations' | 'app-development' | 'ai-content' | '';
  name: string;
  industry: string;
  /** a media url to use as the product's imagery, if there is one */
  image?: string;
  /** 'desktop' draws a browser/app window, 'phone' a handset */
  device?: 'desktop' | 'phone';
  class?: string;
}
const { kind, name, industry, image = '', device = 'desktop', class: cls = '' } = Astro.props;
const stages = ['פנייה חדשה', 'בשיחה', 'הצעה נשלחה', 'במעקב', 'לקוח'];
---

<div class:list={['pm', `pm--${kind || 'generic'}`, `pm--${device}`, cls]} aria-hidden="true">
  {device === 'desktop' ? (
    <span class="pm__bar"><i></i><i></i><i></i><span class="pm__url">{name}</span></span>
  ) : (
    <span class="pm__notch"></span>
  )}

  <div class="pm__screen">
    {/* ── WEB: a storefront / business site ── */}
    {kind === 'web-development' && (
      <div class="pm-web">
        <header class="pm-web__nav"><b>{name}</b><span>בית</span><span>שירותים</span><span>אודות</span><span class="pm-web__cta">לתיאום</span></header>
        <div class="pm-web__hero" style={image ? `background-image:url(${image})` : ''}>
          <p class="pm-web__h">{industry}<br />שעובדת בשבילכם.</p>
          <span class="pm-web__btn">השאירו פרטים</span>
        </div>
        <div class="pm-web__grid"><i></i><i></i><i></i></div>
        <div class="pm-web__form"><span></span><span></span><span class="pm-web__send">שליחה</span></div>
      </div>
    )}

    {/* ── CRM: a pipeline board with a card that moves ── */}
    {kind === 'crm' && (
      <div class="pm-crm">
        <aside class="pm-crm__side"><b>{name}</b><span>לקוחות</span><span class="on">פניות</span><span>משימות</span><span>יומן</span></aside>
        <div class="pm-crm__board">
          {stages.map((s, i) => (
            <div class="pm-crm__col">
              <p>{s}</p>
              <div class="pm-crm__slot">
                {i === 0 && <span class="pm-crm__card pm-crm__card--go"><b>ליד חדש</b><i>{industry}</i></span>}
                {i === 1 && <span class="pm-crm__card"><b>שיחה מחר</b><i>10:30</i></span>}
                {i === 3 && <span class="pm-crm__card"><b>לחזור היום</b><i>תזכורת</i></span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ── AUTOMATIONS: a canvas of connected steps + a live log ── */}
    {kind === 'automations' && (
      <div class="pm-auto">
        <div class="pm-auto__canvas">
          {['פנייה נכנסת', 'בדיקת כלל', 'הודעת וואטסאפ', 'משימה ב-CRM', 'פגישה ביומן'].map((t, i) => (
            <span class:list={['pm-auto__node', { 'pm-auto__node--on': i !== 4 }]} style={`--i:${i}`}>{t}</span>
          ))}
          <span class="pm-auto__wire"></span>
          <span class="pm-auto__pulse"></span>
        </div>
        <ol class="pm-auto__log">
          <li><span>09:41</span> פנייה מ{name}</li>
          <li><span>09:41</span> נשלח וואטסאפ ללקוח</li>
          <li><span>09:41</span> נפתחה משימה</li>
          <li class="wait"><span>עכשיו</span> ממתין לאישור שלכם</li>
        </ol>
      </div>
    )}

    {/* ── APP: a phone-first ordering / booking app ── */}
    {kind === 'app-development' && (
      <div class="pm-app">
        <header class="pm-app__top"><b>{name}</b><span class="pm-app__dot"></span></header>
        <div class="pm-app__hero" style={image ? `background-image:url(${image})` : ''}></div>
        <p class="pm-app__h">{industry}</p>
        <ul class="pm-app__list">
          <li><b>הזמנה חדשה</b><i>בתהליך</i></li>
          <li><b>הזמנה קודמת</b><i>נמסרה</i></li>
          <li><b>מועדף</b><i>שמור</i></li>
        </ul>
        <span class="pm-app__btn">להזמין שוב</span>
        <nav class="pm-app__tabs"><i class="on"></i><i></i><i></i><i></i></nav>
      </div>
    )}

    {/* ── AI CONTENT: brief on one side, a draft typing itself ── */}
    {kind === 'ai-content' && (
      <div class="pm-ai">
        <div class="pm-ai__brief"><p class="k">בריף</p><span>למי: לקוחות של {name}</span><span>מה: פוסט על {industry}</span><span>טון: ישיר, בגובה העיניים</span></div>
        <div class="pm-ai__doc">
          <p class="k">טיוטה</p>
          <p class="pm-ai__type">איך {industry} טובה חוסכת לכם שעה ביום, ומה זה אומר על השבוע שלכם...</p>
          <span class="pm-ai__ok">לאישור שלכם</span>
        </div>
      </div>
    )}

    {kind === '' && (
      <div class="pm-web">
        <header class="pm-web__nav"><b>{name}</b><span>לוח</span><span>לקוחות</span><span>משימות</span></header>
        <div class="pm-web__grid pm-web__grid--tall"><i></i><i></i><i></i></div>
      </div>
    )}
  </div>
</div>

<style>
  .pm {
    --bg: #0f1a3a; --panel: #16234a; --line: rgba(255,255,255,.08); --tx: #eef2ff; --mut: rgba(238,242,255,.55);
    --acc: var(--color-electric, #2997ff);
    position: relative; overflow: hidden; border-radius: 10px;
    background: var(--bg); color: var(--tx); border: 1px solid var(--line);
    box-shadow: 0 30px 60px -24px rgba(0,0,0,.6);
    font-family: var(--font-body); font-size: 12px; line-height: 1.3;
  }
  .pm--desktop { aspect-ratio: 16 / 10; }
  .pm--phone { aspect-ratio: 9 / 19; border-radius: 2rem; max-width: 20rem; }
  .pm__bar { display: flex; align-items: center; gap: .35rem; padding: .5rem .7rem; background: var(--panel); border-bottom: 1px solid var(--line); }
  .pm__bar i { width: .5rem; height: .5rem; border-radius: 50%; background: rgba(255,255,255,.25); }
  .pm__url { margin-inline-start: .6rem; padding: .15rem .6rem; border-radius: 999px; background: rgba(255,255,255,.08); color: var(--mut); font-size: 10px; }
  .pm__notch { display: block; height: 1.6rem; }
  .pm__notch::after { content: ''; position: absolute; top: .55rem; left: 50%; transform: translateX(-50%); width: 34%; height: .55rem; border-radius: 999px; background: #000; }
  .pm__screen { position: absolute; inset: 2.2rem 0 0; padding: .8rem; }
  .pm--phone .pm__screen { inset: 1.6rem 0 0; }
  .k { margin: 0 0 .4rem; font-size: 9px; letter-spacing: .12em; color: var(--mut); font-weight: 800; }

  /* web */
  .pm-web { display: flex; flex-direction: column; gap: .6rem; height: 100%; }
  .pm-web__nav { display: flex; align-items: center; gap: .8rem; font-size: 10px; color: var(--mut); }
  .pm-web__nav b { color: var(--tx); font-size: 12px; margin-inline-end: auto; }
  .pm-web__cta { padding: .2rem .55rem; border-radius: 999px; background: var(--acc); color: #041127; font-weight: 800; }
  .pm-web__hero { position: relative; flex: 1 1 auto; min-height: 38%; border-radius: 8px; background: linear-gradient(135deg, #1d4ed8, #2997ff); background-size: cover; background-position: center; display: flex; flex-direction: column; justify-content: flex-end; gap: .4rem; padding: .8rem; }
  .pm-web__hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4,17,39,0) 30%, rgba(4,17,39,.85)); border-radius: 8px; }
  .pm-web__h { position: relative; margin: 0; font-family: var(--font-display); font-weight: 900; font-size: 16px; line-height: 1.15; }
  .pm-web__btn { position: relative; align-self: flex-start; padding: .25rem .7rem; border-radius: 999px; background: #fff; color: #041127; font-weight: 800; font-size: 10px; }
  .pm-web__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .pm-web__grid i { height: 2.2rem; border-radius: 6px; background: var(--panel); border: 1px solid var(--line); }
  .pm-web__grid--tall i { height: 5rem; }
  .pm-web__form { display: grid; grid-template-columns: 1fr 1fr auto; gap: .4rem; }
  .pm-web__form span { height: 1.5rem; border-radius: 6px; background: var(--panel); border: 1px solid var(--line); }
  .pm-web__send { display: grid; place-items: center; padding-inline: .7rem; background: var(--acc) !important; color: #041127; font-weight: 800; font-size: 10px; }

  /* crm */
  .pm-crm { display: grid; grid-template-columns: 5.5rem 1fr; gap: .6rem; height: 100%; }
  .pm-crm__side { display: flex; flex-direction: column; gap: .5rem; padding: .6rem; border-radius: 8px; background: var(--panel); font-size: 10px; color: var(--mut); }
  .pm-crm__side b { color: var(--tx); font-size: 11px; margin-bottom: .3rem; }
  .pm-crm__side .on { color: var(--acc); font-weight: 800; }
  .pm-crm__board { display: grid; grid-template-columns: repeat(5, 1fr); gap: .4rem; overflow: hidden; }
  .pm-crm__col p { margin: 0 0 .4rem; font-size: 9px; letter-spacing: .06em; color: var(--mut); font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pm-crm__slot { height: calc(100% - 1.2rem); border-radius: 6px; background: rgba(255,255,255,.04); padding: .3rem; position: relative; }
  .pm-crm__card { display: flex; flex-direction: column; gap: .1rem; padding: .4rem .45rem; border-radius: 6px; background: var(--acc); color: #041127; font-size: 9px; }
  .pm-crm__card b { font-weight: 800; } .pm-crm__card i { font-style: normal; opacity: .75; }
  .pm-crm__card--go { position: relative; animation: pm-go 12s ease-in-out infinite; }
  @keyframes pm-go {
    0%,12% { transform: translateX(0) } 24%,36% { transform: translateX(calc(-100% - .4rem - .6rem)) }
    48%,60% { transform: translateX(calc(-200% - .8rem - 1.2rem)) } 72%,84% { transform: translateX(calc(-300% - 1.2rem - 1.8rem)) }
    92%,100% { transform: translateX(calc(-400% - 1.6rem - 2.4rem)) }
  }

  /* automations */
  .pm-auto { display: grid; grid-template-rows: 1fr auto; gap: .6rem; height: 100%; }
  .pm-auto__canvas { position: relative; border-radius: 8px; background: var(--panel); border: 1px solid var(--line); display: flex; align-items: center; justify-content: space-around; padding: .6rem; }
  .pm-auto__node { position: relative; z-index: 1; padding: .35rem .5rem; border-radius: 6px; background: rgba(255,255,255,.08); font-size: 9px; font-weight: 800; white-space: nowrap; opacity: 0; animation: pm-in .5s ease-out forwards; animation-delay: calc(var(--i) * .7s); }
  .pm-auto__node--on { background: var(--acc); color: #041127; }
  .pm-auto__wire { position: absolute; inset-inline: 1rem; top: 50%; height: 2px; background: rgba(255,255,255,.14); }
  .pm-auto__pulse { position: absolute; top: calc(50% - 4px); inset-inline-start: 1rem; width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 12px var(--acc); animation: pm-pulse 3.5s linear infinite; }
  @keyframes pm-pulse { to { inset-inline-start: calc(100% - 1.5rem); } }
  @keyframes pm-in { to { opacity: 1; } }
  .pm-auto__log { list-style: none; margin: 0; padding: .5rem .6rem; border-radius: 8px; background: rgba(0,0,0,.25); font-family: ui-monospace, monospace; font-size: 9px; color: var(--mut); display: grid; gap: .25rem; }
  .pm-auto__log li { opacity: 0; animation: pm-in .4s ease-out forwards; }
  .pm-auto__log li:nth-child(1){animation-delay:.6s} .pm-auto__log li:nth-child(2){animation-delay:1.4s} .pm-auto__log li:nth-child(3){animation-delay:2.2s} .pm-auto__log li:nth-child(4){animation-delay:3.2s}
  .pm-auto__log span { display: inline-block; min-width: 3em; opacity: .6; }
  .pm-auto__log .wait { color: var(--acc); font-weight: 800; }

  /* app */
  .pm-app { display: flex; flex-direction: column; gap: .5rem; height: 100%; }
  .pm-app__top { display: flex; justify-content: space-between; align-items: center; font-size: 11px; }
  .pm-app__dot { width: .8rem; height: .8rem; border-radius: 50%; background: var(--acc); }
  .pm-app__hero { height: 30%; border-radius: 10px; background: linear-gradient(135deg, #1d4ed8, #2997ff); background-size: cover; background-position: center; }
  .pm-app__h { margin: 0; font-family: var(--font-display); font-weight: 900; font-size: 14px; }
  .pm-app__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .pm-app__list li { display: flex; justify-content: space-between; padding: .45rem .55rem; border-radius: 8px; background: var(--panel); font-size: 10px; }
  .pm-app__list i { font-style: normal; color: var(--acc); font-weight: 800; }
  .pm-app__btn { margin-top: auto; padding: .55rem; border-radius: 999px; background: var(--acc); color: #041127; font-weight: 800; text-align: center; font-size: 11px; }
  .pm-app__tabs { display: flex; justify-content: space-around; padding-top: .4rem; border-top: 1px solid var(--line); }
  .pm-app__tabs i { width: 1rem; height: .35rem; border-radius: 999px; background: rgba(255,255,255,.2); }
  .pm-app__tabs .on { background: var(--acc); }

  /* ai content */
  .pm-ai { display: grid; grid-template-columns: .8fr 1.2fr; gap: .6rem; height: 100%; }
  .pm-ai__brief { display: flex; flex-direction: column; gap: .4rem; padding: .6rem; border-radius: 8px; background: var(--panel); font-size: 10px; color: var(--tx); }
  .pm-ai__doc { position: relative; padding: .6rem .7rem 2.2rem; border-radius: 8px; background: #fff; color: #0b1530; }
  .pm-ai__doc .k { color: #6a748c; }
  .pm-ai__type { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 13px; line-height: 1.5; overflow: hidden; white-space: nowrap; max-width: 0; border-inline-end: 2px solid var(--acc); animation: pm-type 4s steps(60) .8s forwards, pm-caret 1s step-end infinite; }
  @keyframes pm-type { to { max-width: 100%; white-space: normal; } }
  @keyframes pm-caret { 50% { border-color: transparent; } }
  .pm-ai__ok { position: absolute; inset-inline-start: .7rem; bottom: .6rem; padding: .25rem .6rem; border-radius: 999px; background: var(--acc); color: #041127; font-weight: 800; font-size: 9px; opacity: 0; animation: pm-in .4s ease-out 5s forwards; }

  @media (prefers-reduced-motion: reduce) {
    .pm * { animation: none !important; opacity: 1 !important; transform: none !important; }
    .pm-ai__type { max-width: none; white-space: normal; }
  }
</style>
