# dependencies
node_modules/

# build output
dist/
.astro/

# environment / secrets — never commit
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local scratch
*.local

# review batch exports: one-time internal review deliverables (~100MB of
# screenshots and standalone HTML snapshots), not application source,
# regenerated on demand — never part of the live site or its repo.
# MUST be root-anchored (/review/, not review/): the unanchored form also
# matched src/pages/review/ -- real, deployed site pages -- and silently
# kept them out of git entirely. Found while auditing what wasn't backed up.
/review/

# CMS database: content and users are data, never committed
data/
*.db
*.db-wal
*.db-shm

# generated admin credentials and seed, never commit
data/ADMIN_PASSWORD.txt
migrations/*_seed.sql
.wrangler/

# local Cloudflare secrets for `astro dev` / `wrangler dev`, never commit
.dev.vars

# curl cookie jars from manual/scripted admin-session testing -- can hold
# a real session token, never commit
cookies.txt
*cookies*.txt

# Third-party design reference (STG.AI mirror + screen recordings).
# Kept locally at docs/reference/stg/ so the redesign can be checked
# against it, but NEVER committed: this repository is public, and the
# mirror is another company's copyrighted HTML, CSS, media and brand
# assets. Only our own implementation and the written audit are tracked.
docs/reference/stg/
