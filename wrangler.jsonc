{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lahav-ai-website",
  "compatibility_date": "2026-08-01",
  // The Astro Cloudflare adapter (v14) generates the worker entry and the
  // static asset binding through the Cloudflare Vite plugin, so neither
  // "main" nor "assets" is declared here.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lahav-cms",
      // Created 2026-08-31 via `wrangler d1 create lahav-cms` (region WEUR).
      // Local development still uses miniflare's own separate database.
      "database_id": "b4af5779-63f6-4290-a483-aee5a4b2d0b2",
      "migrations_dir": "migrations"
    }
  ],
  // Native per-key rate limiting for the public contact form. Free, no
  // domain/zone required, keyed in code by a hash of the visitor's IP.
  // See src/lib/leads/spam.ts.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // The public AI assistant. Separate namespace from the contact form so
    // a chatty visitor can never lock themselves out of the lead form.
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Workers AI. This is what lets the assistant answer without any
  // external account: it runs on the same platform, inside the free
  // daily allocation. If ANTHROPIC_API_KEY is later set as a secret the
  // provider layer prefers it, because its Hebrew is markedly better.
  "ai": { "binding": "AI" }
  // RESEND_API_KEY, TURNSTILE_SECRET_KEY, ANTHROPIC_API_KEY and
  // CRON_SECRET are SECRETS, not config, so they are never written here.
  // Local dev reads them from `.dev.vars` (gitignored, see
  // .dev.vars.example). Production: `wrangler secret put <NAME>`.
  //
  // ───────────────────────────────────────────────────────────────────
  // SCHEDULED GENERATION: intentionally left commented out. Read this
  // before uncommenting it, because on its own it will NOT work.
  // ───────────────────────────────────────────────────────────────────
  // A Cloudflare Cron Trigger invokes the Worker's exported
  // `scheduled(event, env, ctx)` handler. It does not send an HTTP
  // request. The Worker entry for this project is generated by
  // @astrojs/cloudflare v14 and exports `fetch` ONLY:
  //
  //     var server_default = { fetch: handle };
  //
  // The adapter provides no supported way to contribute a `scheduled`
  // export (there is no occurrence of "scheduled" anywhere in the
  // installed adapter). Enabling the block below would therefore create
  // a trigger that fires into a Worker with no handler to receive it.
  //
  // The job is instead exposed at POST /api/ai-cron, guarded by the
  // CRON_SECRET bearer secret and a constant-time comparison. Drive it
  // with any scheduler that can make an HTTPS request, for example:
  //
  //     curl -X POST https://<site>/api/ai-cron \
  //          -H "authorization: Bearer $CRON_SECRET"
  //
  // or with a small separate Worker whose only job is a `scheduled`
  // handler that fetches that URL. Full reasoning: src/pages/api/ai-cron.ts.
  //
  // Uncomment ONLY if the adapter later gains a `scheduled` hook AND a
  // handler is actually wired to it:
  // "triggers": {
  //   "crons": ["0 4 * * *"]
  // }
}
